---
const msg = encodeURIComponent('আসসালামু আলাইকুম, পসরা নিয়ে জানতে চাই।');
const href = `https://wa.me/8801771553141?text=${msg}`;
---
<a class="fab" href={href} target="_blank" rel="noopener" aria-label="হোয়াটসঅ্যাপে কথা বলুন">
  <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M16 3C8.8 3 3 8.8 3 16c0 2.4.6 4.6 1.8 6.6L3 29l6.6-1.7C11.5 28.4 13.7 29 16 29c7.2 0 13-5.8 13-13S23.2 3 16 3zm0 23.6c-2 0-3.9-.5-5.6-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.5 10.5 0 0 1 5.4 16C5.4 10.2 10.2 5.4 16 5.4S26.6 10.2 26.6 16 21.8 26.6 16 26.6zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.2 1.3 3.4c.2.2 2.3 3.5 5.6 4.9.8.3 1.4.5 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/></svg>
  <span>হোয়াটসঅ্যাপ</span>
</a>

<style>
  .fab {
    position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 30;
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.7rem 1.1rem 0.7rem 0.9rem; border-radius: 999px;
    background: #25d366; color: #062b14; font-weight: 700; font-size: 15px; box-shadow: 0 10px 26px -8px rgba(37, 211, 102, 0.7), 0 2px 6px rgba(0,0,0,.15);
    transition: transform 0.15s ease, box-shadow 0.15s ease; animation: breathe 3.2s ease-in-out infinite;
  }
  .fab:hover { transform: translateY(-2px) scale(1.03); box-shadow: 0 14px 30px -8px rgba(37, 211, 102, 0.8), 0 2px 6px rgba(0,0,0,.15); animation: none; }
  @keyframes breathe { 0%, 100% { box-shadow: 0 10px 26px -8px rgba(37,211,102,.7), 0 0 0 0 rgba(37,211,102,.45); } 50% { box-shadow: 0 10px 26px -8px rgba(37,211,102,.7), 0 0 0 12px rgba(37,211,102,0); } }
  @media (max-width: 480px) { .fab span { display: none; } .fab { padding: 0.8rem; } }
</style>
