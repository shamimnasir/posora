---
/**
 * The price and the button, kept in reach on a phone while a long product page
 * scrolls. Steps aside whenever a `[data-buy-anchor]` button is already on
 * screen. The right side stays clear for the WhatsApp button.
 */
interface Props { href: string; title: string; price: string }
const { href, title, price } = Astro.props;
---
<div class="buybar" id="buybar" hidden>
  <span class="t"><small>{title}</small><b>{price}</b></span>
  <a class="btn btn-primary" href={href}>কিনুন →</a>
</div>

<style>
  .buybar { position: fixed; inset: auto 0 0 0; z-index: 25; display: flex; align-items: center; justify-content: space-between; gap: .7rem; padding: .6rem 4.6rem max(.6rem, env(safe-area-inset-bottom)) 1rem; background: var(--panel); border-top: 1px solid var(--line); box-shadow: 0 -8px 24px rgba(0, 0, 0, .2); }
  .buybar[hidden] { display: none; }
  .t { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
  .t small { color: var(--muted); font-size: 12px; }
  .t b { font-family: var(--font-display); font-size: 1.3rem; color: var(--brand-ink); }
  @media (min-width: 801px) { .buybar { display: none; } }
</style>

<script>
  const bar = document.getElementById('buybar');
  const anchors = document.querySelectorAll('[data-buy-anchor]');
  if (bar && anchors.length) {
    const seen = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) { if (e.isIntersecting) seen.add(e.target); else seen.delete(e.target); }
      bar.hidden = seen.size > 0;
    });
    anchors.forEach((a) => io.observe(a));
  }
</script>
