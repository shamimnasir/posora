---
/**
 * The mission shelf shared by every world, including the bespoke Space page.
 *
 * Keeping the shell here prevents the heading, fold, empty state and visual
 * hierarchy from drifting while MissionRow owns the individual activity card.
 */
import { bn } from '../../lib/bn';
import { missionSpec } from '../../data/missions';
import MissionRow from './MissionRow.astro';

interface Mission {
  n: string;
  d: string;
}

interface Props {
  world: string;
  missions: Mission[];
  missionCats?: (number | null)[];
  shown?: number;
}

const { world, missions, missionCats = [], shown = 4 } = Astro.props;
const rows = missions.map((m, i) => ({ m, i, cat: missionCats[i] ?? null }));
const playable = missions.filter((_m, i) => missionSpec(world, i)).length;
const first = rows.slice(0, shown);
const rest = rows.slice(shown);
---

<section class="card miss-card" id="miss-card" aria-labelledby="mission-title">
  <div class="mission-head">
    <span class="mission-mark" aria-hidden="true">◎</span>
    <span class="mission-title">
      <small>খেলে শেখো</small>
      <strong id="mission-title">মিশন</strong>
    </span>
    <span class="mission-count" id="miss-count">০ / {bn(playable)}</span>
  </div>

  {playable ? (
    <>
      <div class="miss">
        {first.map((r) => <MissionRow world={world} i={r.i} n={r.m.n} d={r.m.d} cat={r.cat} />)}
      </div>
      {rest.length > 0 && (
        <details class="miss-more" id="miss-more">
          <summary>আরও {bn(rest.length)}টি মিশন <span aria-hidden="true">▾</span></summary>
          <div class="miss">
            {rest.map((r) => <MissionRow world={world} i={r.i} n={r.m.n} d={r.m.d} cat={r.cat} />)}
          </div>
        </details>
      )}
      <p class="miss-foot" id="miss-foot">একটি মিশন বেছে নাও। প্রতিটিই ছোট, খেলতে খেলতে শেখার কাজ।</p>
    </>
  ) : (
    <p class="mission-empty">এই ভুবনের প্রথম মিশন তৈরি হচ্ছে। এর মধ্যে মডেল ঘুরিয়ে আর বিষয়গুলো খুলে দেখো।</p>
  )}
</section>

<style>
  .miss-card {
    position: relative;
    overflow: hidden;
    border-color: color-mix(in oklab, var(--w) 42%, var(--line));
    background:
      radial-gradient(circle at 90% -10%, color-mix(in oklab, var(--w) 24%, transparent), transparent 42%),
      linear-gradient(165deg, color-mix(in oklab, var(--w) 7%, var(--panel)), var(--panel));
    box-shadow: 0 18px 44px color-mix(in oklab, var(--w) 13%, transparent);
  }
  .mission-head {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 0.9rem 0.75rem;
    border-bottom: 1px solid color-mix(in oklab, var(--w) 28%, var(--line-soft));
    background: linear-gradient(110deg, color-mix(in oklab, var(--w) 18%, transparent), transparent 72%);
  }
  .mission-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(145deg, color-mix(in oklab, var(--w) 82%, white), var(--w));
    box-shadow: 0 5px 0 color-mix(in oklab, var(--w) 46%, #061326), inset 0 1px rgba(255,255,255,.34);
    font-size: 22px;
    font-weight: 900;
  }
  .mission-title { min-width: 0; }
  .mission-title small {
    display: block;
    color: var(--muted);
    font: 700 9px/1.2 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .mission-title strong {
    display: block;
    margin-top: 2px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.15;
  }
  .mission-count {
    padding: .28rem .58rem;
    border: 1px solid color-mix(in oklab, var(--w) 42%, var(--line));
    border-radius: 999px;
    color: var(--w);
    background: color-mix(in oklab, var(--w) 12%, var(--panel));
    font: 800 10px/1 var(--font-mono);
    white-space: nowrap;
  }
  .miss { display: flex; flex-direction: column; gap: 8px; padding: 10px; }
  .miss-more { border-top: 1px solid color-mix(in oklab, var(--w) 19%, var(--line-soft)); }
  .miss-more > summary {
    margin: 8px 10px 0;
    padding: .58rem .72rem;
    border: 1px dashed color-mix(in oklab, var(--w) 38%, var(--line));
    border-radius: 12px;
    color: var(--w);
    background: color-mix(in oklab, var(--w) 7%, var(--panel-2));
    cursor: pointer;
    font-size: 12px;
    font-weight: 800;
    text-align: center;
    list-style: none;
  }
  .miss-more > summary::-webkit-details-marker { display: none; }
  .miss-more[open] > summary span { display: inline-block; transform: rotate(180deg); }
  .miss-foot, .mission-empty {
    margin: 0;
    padding: 0 1rem 0.95rem;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.55;
  }
  .mission-empty { padding-top: 1rem; }
  @media (max-width: 460px) {
    .mission-head { grid-template-columns: 38px minmax(0, 1fr) auto; padding: .72rem; }
    .mission-mark { width: 38px; height: 38px; border-radius: 12px; font-size: 19px; }
    .mission-title strong { font-size: 17px; }
    .miss { padding: 8px; }
  }
</style>
