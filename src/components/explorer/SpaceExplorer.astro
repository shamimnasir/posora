---
import { bodies, branchesFor, FACTS, METRICS, type Body } from '../../data/space';
import { bn, pad2 } from '../../lib/bn';
interface Props { current: Body }
const { current: cur } = Astro.props;
const LEVELS = [['l1', 'ছোট', '৫–৮'], ['l2', 'মাঝারি', '৯–১২'], ['l3', 'বড়', '১৩+']] as const;
const payload = bodies.map(({ id, bn, en, tagline, chips, stats, gravity, au, l1, l2, l3, fun, visual, moons }) =>
  ({ id, bn, en, tagline, chips, stats, gravity, au, l1, l2, l3, fun, visual, moons, branches: branchesFor(id), facts: FACTS[id] }));
---
<div class="xp" id="explorer" data-current={cur.id}>
  <aside class="rail card" aria-label="সৌরজগতের তালিকা">
    <div class="card-h"><span class="lbl">সৌরজগৎ</span><span class="lbl num" id="seen-count">০ / {bn(bodies.length)} আবিষ্কৃত</span></div>
    <div class="rail-list" role="tablist">
      {bodies.map((b, i) => (
        <button role="tab" type="button" data-id={b.id} aria-selected={b.id === cur.id ? 'true' : 'false'} style={`--o:${b.visual.colors[0]};--o2:${b.visual.colors[1]}`}>
          <span class="rorb" aria-hidden="true"></span>
          <span class="rt"><span class="nm">{b.bn}</span><span class="tg">{b.tagline}</span></span>
          <span class="no lbl">{pad2(i + 1)}</span>
        </button>
      ))}
    </div>
  </aside>

  <div class="mid">
  <section class="stage card" aria-live="polite">
    <header class="stage-h">
      <div>
        <p class="eyebrow">মহাকাশ ভুবন · সৌরজগৎ</p>
        <h1 id="b-name">{cur.bn}</h1>
        <p class="tag"><span id="b-en">{cur.en}</span> · <span id="b-tag">{cur.tagline}</span></p>
      </div>
      <div class="chips" id="b-chips">{cur.chips.map((c) => <span class="pill">{c}</span>)}</div>
    </header>
    <div class="scene">
      <nav class="zoombar" aria-label="কোথায় আছো">
        <button type="button" class="crumb" id="crumb-system">সৌরজগৎ</button>
        <span class="sep" aria-hidden="true">›</span>
        <button type="button" class="crumb cur" id="crumb-body">{cur.bn}</button>
        <span class="sep" id="crumb-sep2" hidden aria-hidden="true">›</span>
        <button type="button" class="crumb" id="crumb-moon" hidden></button>
      </nav>
      <div class="host" id="planet-host" aria-label={`${cur.bn}ের থ্রিডি মডেল - টেনে ঘোরাও, ক্লিক করে ভেতরে যাও`} role="img">
        <canvas></canvas>
        <div class="labels" id="moon-labels"></div>
      </div>
      <div class="branchbar" id="branchbar" hidden>
        <span class="lbl" id="branch-title">ভেতরে কী কী আছে</span>
        <div class="branch-chips" id="branch-chips"></div>
      </div>
      <p class="hint" id="scene-hint">গ্রহে ক্লিক করো - ভেতরের বিষয়গুলো খুলবে</p>
      <noscript><p class="hint">থ্রিডি মডেল দেখতে জাভাস্ক্রিপ্ট চালু করো।</p></noscript>
    </div>
    <div class="actions">
      <button type="button" data-act="compare" aria-pressed="false">
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="7" cy="10" r="5" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="13" cy="10" r="5" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
        তুলনা
      </button>
      <button type="button" data-act="read" class="primary">
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M3 4h6a2 2 0 0 1 2 2v10a1.5 1.5 0 0 0-1.5-1.5H3zM17 4h-6a2 2 0 0 0-2 2v10a1.5 1.5 0 0 1 1.5-1.5H17z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
        পড়ো
      </button>
      <button type="button" data-act="next">পরেরটা →</button>
    </div>
  </section>

  <section class="card glance" id="glance">
    <div class="card-h">
      <span class="lbl">সৌরজগৎ এক নজরে</span>
      <span class="lbl gauto" id="gauto">নিজে নিজে বদলাচ্ছে</span>
    </div>
    <div class="gseg" role="tablist" aria-label="কোন হিসাবে তুলনা">
      {METRICS.map((m, i) => (
        <button type="button" role="tab" data-m={m.id} aria-selected={i === 0 ? 'true' : 'false'}>{m.bn}</button>
      ))}
    </div>
    <div class="gchart" id="gchart">
      {bodies.map((b) => (
        <button type="button" class="grow" data-id={b.id} style={`--o:${b.visual.colors[0]}`}>
          <span class="gn">{b.bn}</span>
          <span class="gtrack"><i></i></span>
          <span class="gv"></span>
        </button>
      ))}
    </div>
    <p class="gcap" id="gcap"></p>
    <div class="agebox">
      <label class="kg" for="age">তোমার বয়স <input type="number" id="age" inputmode="numeric" min="1" max="120" value="10" /> বছর</label>
      <p class="out" id="age-out"></p>
    </div>
  </section>
  </div>

  <aside class="info">
    <section class="card">
      <div class="card-h">
        <span class="lbl">পরিচিতি</span>
        <label class="cmp" id="cmp-wrap" hidden><span class="lbl">বনাম</span>
          <select id="cmp">{bodies.map((b) => <option value={b.id} selected={b.id === (cur.id === 'earth' ? 'mars' : 'earth')}>{b.bn}</option>)}</select>
        </label>
      </div>
      <div class="spec" id="spec">
        {cur.stats.map((s) => (
          <button type="button" class="row" aria-expanded="false">
            <span class="k">{s.k}</span>
            <span class="v">{s.v}</span><span class="v v2" hidden></span>
            <span class="meter"><i style={`--p:${Math.round(s.s * 100)}%`}></i><i class="m2" hidden></i></span>
            <span class="dig" aria-hidden="true">+</span>
          </button>
        ))}
      </div>
    </section>

    <section class="card">
      <div class="card-h">
        <span class="lbl">কত বড়</span>
        <button type="button" class="mini" id="cmp3d" aria-pressed="false">পাশে পৃথিবী রাখো</button>
      </div>
      <div class="size">
        <div class="size-bars" id="size-bars" aria-hidden="true"></div>
        <p class="size-out" id="size-out"></p>
      </div>
    </section>

    <section class="card">
      <div class="card-h"><span class="lbl">কতদিনে পৌঁছাবে</span><span class="lbl" id="trav-dist"></span></div>
      <div class="trav" id="trav"></div>
    </section>

    <section class="card sub" id="subtopic" hidden>
      <div class="card-h"><span class="lbl" id="sub-k">শাখা</span><button type="button" class="x" id="sub-close" aria-label="বন্ধ করো">✕</button></div>
      <p class="text" id="sub-text"></p>
    </section>

    <section class="card read" id="read">
      <div class="card-h">
        <span class="lbl">পড়ো</span>
        <div class="seg" role="tablist" aria-label="পড়ার গভীরতা">
          {LEVELS.map(([k, l, a]) => <button type="button" role="tab" data-l={k} aria-selected={k === 'l1' ? 'true' : 'false'}>{l} <small>{a}</small></button>)}
        </div>
      </div>
      <p class="text" id="b-text">{cur.l1}</p>
      <p class="fun"><span class="lbl">মজার তথ্য</span><span id="b-fun">{cur.fun}</span></p>
    </section>

    <section class="card">
      <div class="card-h"><span class="lbl">রেকর্ড</span><span class="lbl">সৌরজগতে</span></div>
      <div class="recs" id="recs"></div>
    </section>

    <section class="card">
      <div class="card-h"><span class="lbl">মিশন</span><span class="lbl">+১০ জ্ঞানবিন্দু</span></div>
      <div class="miss">
        <div class="m">
          <span class="mb">০১</span>
          <div>
            <b>ওজন মাপো</b>
            <label class="kg">তোমার ওজন <input type="number" id="kg" inputmode="numeric" min="1" max="500" value="30" /> কেজি</label>
            <p id="kg-out" class="out"></p>
          </div>
        </div>
        <div class="m">
          <span class="mb">০২</span>
          <div><b>আলো কতক্ষণে পৌঁছায়</b><p id="light-out" class="out"></p></div>
        </div>
        <div class="m">
          <span class="mb">০৩</span>
          <div><b>তুলনা করো</b><p class="out">উপরে “তুলনা” চেপে অন্য একটি গ্রহ বেছে নাও - সংখ্যাগুলো পাশাপাশি দেখাবে।</p></div>
        </div>
      </div>
    </section>
  </aside>
</div>

<div class="status card">
  <span class="lbl">অভিযান লগ</span>
  <span class="bar"><i id="log-bar"></i></span>
  <span class="lbl num" id="log-text">০ / {bn(bodies.length)}</span>
</div>

<script is:inline type="application/json" id="space-data" set:html={JSON.stringify(payload)}></script>

<style>
  .xp { display: grid; grid-template-columns: 250px minmax(0, 1fr) 292px; gap: 0.85rem; align-items: start; }
  .xp > * { min-width: 0; }
  .rail { overflow: hidden; }
  .card-h { padding: 0.7rem 0.95rem; border-bottom: 1px solid var(--line-soft); display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }

  /* rail */
  .rail-list { padding: 6px; display: flex; flex-direction: column; gap: 2px; max-height: 640px; overflow-y: auto; }
  .rail-list button { display: flex; align-items: center; gap: 0.7rem; width: 100%; text-align: left; padding: 8px 9px; border-radius: 11px; border-left: 3px solid transparent; transition: background 0.15s ease; }
  .rail-list button:hover { background: var(--panel-2); }
  .rail-list button[aria-selected="true"] { background: color-mix(in oklab, var(--o) 13%, var(--panel)); border-left-color: var(--o); }
  .rorb { width: 30px; height: 30px; border-radius: 50%; flex: none; background: radial-gradient(circle at 32% 30%, #fff 0%, var(--o) 30%, var(--o2) 100%); box-shadow: inset -3px -4px 8px rgba(0,0,0,.25); transition: transform 0.2s ease; }
  .rail-list button:hover .rorb { transform: scale(1.1); }
  .rail-list button.seen .rorb { box-shadow: inset -3px -4px 8px rgba(0,0,0,.25), 0 0 0 2px var(--panel), 0 0 0 4px var(--ok); }
  .rt { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
  .nm { font-family: var(--font-display); font-weight: 700; font-size: 15px; }
  .tg { font-size: 11.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .no { margin-left: auto; font-size: 10px; }

  /* stage */
  .mid { display: flex; flex-direction: column; gap: 0.85rem; min-width: 0; }
  .stage { display: flex; flex-direction: column; min-height: 620px; overflow: hidden; }
  .stage-h { display: flex; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.4rem 0; flex-wrap: wrap; }
  .stage-h h1 { font-size: clamp(2rem, 4vw, 2.8rem); letter-spacing: -0.01em; line-height: 1.15; font-weight: 800; margin-top: 0.1rem; }
  .tag { color: var(--muted); font-size: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; padding-top: 0.4rem; }
  .scene { position: relative; flex: 1; min-height: min(62vh, 560px); display: grid; place-items: center; overflow: hidden;
    background: radial-gradient(ellipse at 50% 42%, color-mix(in oklab, var(--w) 22%, #141c2e) 0%, #0c1220 52%, #05070e 100%); }
  .host { position: absolute; inset: 0; cursor: grab; touch-action: none; overflow: hidden; }
  .host.dragging { cursor: grabbing; }
  .host canvas { width: 100%; height: 100%; }
  .labels { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .labels :global(.moon-label), .labels :global(.sky-label), .labels :global(.cmp-label) {
    position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); margin-top: -24px;
    display: flex; flex-direction: column; align-items: center; line-height: 1.15; transition: opacity 0.25s ease; will-change: transform; cursor: pointer;
    padding: 3px 10px; border-radius: 999px; background: rgba(9, 14, 24, 0.72); border: 1px solid rgba(255, 255, 255, 0.16); backdrop-filter: blur(4px); white-space: nowrap; }
  .labels :global(.cmp-label) { cursor: default; }
  .labels :global(.moon-label:hover), .labels :global(.sky-label:hover) { border-color: color-mix(in oklab, var(--w) 70%, #fff); background: rgba(9, 14, 24, 0.92); }
  .labels :global(.moon-label b), .labels :global(.sky-label b), .labels :global(.cmp-label b) { font-family: var(--font-display); font-size: 13px; color: #f2f6fb; }
  .labels :global(.moon-label span) { font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(226, 235, 245, 0.62); }
  /* zoom breadcrumb */
  .zoombar { position: absolute; top: 10px; left: 12px; z-index: 3; display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .crumb { font-size: 12.5px; font-weight: 600; color: #e6eef8; background: rgba(9, 14, 24, 0.6); border: 1px solid rgba(255, 255, 255, 0.16); padding: 0.22rem 0.7rem; border-radius: 999px; backdrop-filter: blur(6px); transition: background 0.15s ease; }
  .crumb:hover { background: rgba(9, 14, 24, 0.9); }
  .crumb.cur { background: var(--w); color: #fff; border-color: transparent; }
  .zoombar .sep { color: rgba(226, 235, 245, 0.5); font-size: 12px; }

  /* branch strip revealed by clicking the body */
  .branchbar { position: absolute; left: 0; right: 0; bottom: 0; z-index: 4; padding: 1.6rem 1rem 0.9rem;
    background: linear-gradient(to top, rgba(5, 7, 14, 0.94) 45%, rgba(5, 7, 14, 0.72) 72%, transparent);
    display: flex; flex-direction: column; gap: 0.5rem; }
  .branchbar .lbl { color: rgba(226, 235, 245, 0.66); }
  .branch-chips { display: flex; flex-wrap: wrap; gap: 7px; }
  .branch-chips :global(button) { font-size: 13px; font-weight: 600; padding: 0.35rem 0.85rem; border-radius: 999px; line-height: 1.3;
    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.24); color: #f2f6fb; backdrop-filter: blur(4px);
    transition: transform 0.15s ease, background 0.15s ease; }
  .branch-chips :global(button:hover) { transform: translateY(-1px); background: rgba(255, 255, 255, 0.2); }
  .branch-chips :global(button[aria-pressed="true"]) { background: var(--w); color: #fff; border-color: transparent; }
  .hint { position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); font-size: 12px; color: #d7e2f0; background: rgba(9, 14, 24, 0.72); padding: 3px 12px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.14); pointer-events: none; transition: opacity 0.4s ease; z-index: 2; }
  .actions { display: flex; justify-content: center; gap: 6px; padding: 0.75rem; border-top: 1px solid var(--line-soft); background: var(--panel-2); }
  .actions button { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1.05rem; border-radius: 999px; font-weight: 700; font-size: 14px; color: var(--ink-2); transition: background 0.15s ease, transform 0.15s ease; }
  .actions button:hover { background: var(--panel); transform: translateY(-1px); }
  .actions button[aria-pressed="true"] { background: var(--brand-soft); color: var(--brand-ink); }
  .actions .primary { background: var(--brand); color: var(--on-brand); }
  .actions .primary:hover { background: var(--brand-ink); }

  /* সৌরজগৎ এক নজরে - the animated comparison chart under the stage */
  .glance { overflow: hidden; }
  .gauto { color: var(--w); transition: opacity 0.3s ease; }
  .gauto[hidden] { display: none; }
  .gseg { display: flex; flex-wrap: wrap; gap: 6px; padding: 0.75rem 1.1rem 0.2rem; }
  .gseg button { font-size: 12.5px; font-weight: 700; padding: 0.28rem 0.8rem; border-radius: 999px; color: var(--ink-2);
    background: var(--panel-2); border: 1px solid var(--line-soft); transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease; }
  .gseg button:hover { transform: translateY(-1px); background: var(--panel); }
  .gseg button[aria-selected="true"] { background: var(--w); color: #fff; border-color: transparent; }
  .gchart { padding: 0.6rem 1.1rem 0.2rem; display: flex; flex-direction: column; gap: 1px; }
  .grow { display: grid; grid-template-columns: 84px minmax(0, 1fr) auto; align-items: center; column-gap: 0.7rem;
    width: 100%; text-align: left; padding: 0.3rem 0.4rem; border-radius: 8px; transition: background 0.15s ease; }
  .grow:hover { background: color-mix(in oklab, var(--w) 8%, transparent); }
  .grow[aria-current="true"] { background: color-mix(in oklab, var(--o) 14%, transparent); }
  .gn { font-size: 13px; font-weight: 600; color: var(--ink-2); white-space: nowrap; }
  .grow[aria-current="true"] .gn { color: var(--ink); font-weight: 800; }
  .gtrack { display: block; height: 13px; border-radius: 999px; background: var(--sunk); overflow: hidden; }
  .gtrack i { display: block; height: 100%; width: 0; border-radius: 999px;
    background: linear-gradient(90deg, color-mix(in oklab, var(--o) 55%, var(--panel)), var(--o));
    transition: width 0.75s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: calc(var(--i, 0) * 45ms); }
  .gv { font-size: 12.5px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; min-width: 92px; text-align: right; }
  .gv.none { color: var(--muted); font-weight: 500; font-size: 11.5px; white-space: normal; max-width: 210px; line-height: 1.4; }
  .gcap { padding: 0.5rem 1.15rem 0; font-size: 12px; color: var(--muted); line-height: 1.6; }
  .agebox { margin: 0.8rem 1.1rem 1rem; padding: 0.7rem 0.85rem; border-radius: 12px; background: var(--panel-2); border: 1px solid var(--line-soft); }
  .agebox .out { margin-top: 0.3rem; }
  @media (prefers-reduced-motion: reduce) { .gtrack i { transition: none; } }

  /* info */
  .info { display: flex; flex-direction: column; gap: 0.85rem; }
  .spec { padding: 0.3rem 0.95rem 0.7rem; }
  .row { display: grid; grid-template-columns: 1fr auto auto; grid-template-rows: auto auto; column-gap: 0.6rem; padding: 0.55rem 0.3rem; border-bottom: 1px solid var(--line-soft); align-items: baseline; width: 100%; text-align: left; border-radius: 8px; transition: background 0.15s ease; }
  .row:last-child { border-bottom: 0; }
  .row:hover { background: color-mix(in oklab, var(--w) 8%, transparent); }
  .row .dig { grid-column: 3; grid-row: 1; font-family: var(--font-mono); font-size: 13px; color: var(--w); width: 14px; text-align: center; transition: transform 0.2s ease; }
  .row[aria-expanded="true"] .dig { transform: rotate(45deg); }
  .row[aria-expanded="true"] { background: color-mix(in oklab, var(--w) 10%, transparent); }
  .spec :global(.dive) { padding: 0.2rem 0.3rem 0.8rem; }
  .spec :global(.dive canvas) { width: 100%; height: 118px; display: block; border-radius: 10px; background: var(--panel-2); border: 1px solid var(--line-soft); }
  .spec :global(.dive p) { margin-top: 0.5rem; font-size: 12.5px; color: var(--ink-2); line-height: 1.6; }
  .sub .text { padding-top: 0.7rem; }
  .mini { font-size: 11px; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid var(--line); color: var(--ink-2); background: var(--panel-2); }
  .mini:hover { background: var(--panel); }
  .mini[aria-pressed="true"] { background: var(--w); color: #fff; border-color: transparent; }
  .size { padding: 0.8rem 0.95rem 0.95rem; }
  .size-bars { display: flex; align-items: flex-end; gap: 0.75rem; height: 84px; margin-bottom: 0.7rem; }
  .size-bars :global(span) { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 10px; color: var(--muted); }
  .size-bars :global(i) { display: block; border-radius: 50%; background: var(--c, var(--w)); }
  .size-out { font-size: 13px; color: var(--ink-2); line-height: 1.65; }
  .size-out b { color: var(--ink); font-family: var(--font-display); font-size: 15px; }
  /* NOTE: everything below that the script creates at runtime must be :global().
     Astro scopes styles by stamping data-astro-cid onto elements at build time,
     so a JS-created .t or <button> would otherwise match nothing at all. */
  .trav { padding: 0.3rem 0.95rem 0.7rem; }
  .trav :global(.t) { display: flex; justify-content: space-between; gap: 0.6rem; padding: 0.45rem 0; border-bottom: 1px solid var(--line-soft); font-size: 13px; }
  .trav :global(.t:last-child) { border-bottom: 0; }
  .trav :global(.t span) { color: var(--muted); }
  .trav :global(.t b) { font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
  .recs { padding: 0.3rem 0.95rem 0.7rem; }
  .recs :global(button) { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem; width: 100%; text-align: left; padding: 0.45rem 0.3rem; border-radius: 8px; border-bottom: 1px solid var(--line-soft); font-size: 13px; }
  .recs :global(button:last-child) { border-bottom: 0; }
  .recs :global(button:hover) { background: color-mix(in oklab, var(--w) 10%, transparent); }
  .recs :global(button span) { color: var(--muted); font-size: 12px; }
  .recs :global(button b) { font-family: var(--font-display); }
  .recs :global(button.is-cur b) { color: var(--w); }
  .x { font-size: 13px; color: var(--muted); padding: 0 0.2rem; }
  .x:hover { color: var(--ink); }
  .k { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.13em; text-transform: uppercase; color: var(--muted); }
  .v { font-size: 13px; font-weight: 700; text-align: right; grid-column: 2; grid-row: 1; white-space: nowrap; }
  .v2 { color: var(--muted); font-weight: 600; font-size: 12px; }
  .meter { grid-column: 1 / -1; grid-row: 2; display: flex; flex-direction: column; gap: 2px; margin-top: 4px; max-width: 220px; }
  .meter i { display: block; height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--w) var(--p, 0%), var(--sunk) var(--p, 0%)); transition: --p 0.4s ease; }
  .meter i.m2 { background: linear-gradient(90deg, var(--muted) var(--p, 0%), var(--sunk) var(--p, 0%)); }
  .cmp { display: flex; align-items: center; gap: 0.4rem; }
  .cmp select { font: inherit; font-size: 13px; font-weight: 600; padding: 2px 6px; border-radius: 6px; border: 1px solid var(--line); background: var(--panel); color: var(--ink); }
  .seg { display: inline-flex; background: var(--panel-2); border: 1px solid var(--line-soft); border-radius: 999px; padding: 2px; }
  .seg button { padding: 0.2rem 0.6rem; border-radius: 999px; font-weight: 600; font-size: 12px; color: var(--muted); display: flex; gap: 0.25rem; align-items: baseline; }
  .seg button small { font-size: 9.5px; }
  .seg button[aria-selected="true"] { background: var(--panel); color: var(--ink); box-shadow: var(--shadow-sm); }
  .text { padding: 0.8rem 0.95rem 0.5rem; font-size: 14.5px; color: var(--ink-2); line-height: 1.75; }
  .fun { margin: 0 0.95rem 0.95rem; padding: 0.55rem 0.75rem; border-radius: 10px; background: color-mix(in oklab, var(--sun) 16%, var(--panel)); font-size: 13px; display: flex; flex-direction: column; gap: 0.1rem; }
  .fun .lbl { color: color-mix(in oklab, var(--sun) 60%, var(--ink)); }
  .miss { padding: 0.4rem 0.95rem 0.8rem; display: flex; flex-direction: column; }
  .m { display: flex; gap: 0.7rem; padding: 0.6rem 0; border-bottom: 1px solid var(--line-soft); }
  .m:last-child { border-bottom: 0; }
  .mb { width: 26px; height: 26px; border-radius: 8px; flex: none; display: grid; place-items: center; font-family: var(--font-mono); font-size: 10px; background: color-mix(in oklab, var(--w) 18%, var(--panel)); color: var(--w); border: 1px solid color-mix(in oklab, var(--w) 40%, var(--line)); }
  .m b { font-size: 14px; display: block; }
  .out { font-size: 12.5px; color: var(--muted); line-height: 1.5; }
  .out :global(strong) { color: var(--brand-ink); font-size: 15px; }
  .kg { font-size: 12.5px; color: var(--ink-2); display: flex; align-items: center; gap: 0.35rem; margin: 0.25rem 0; }
  .kg input { width: 62px; font: inherit; font-weight: 700; padding: 2px 6px; border-radius: 6px; border: 1px solid var(--line); background: var(--panel-2); color: var(--ink); text-align: center; }

  .status { margin-top: 0.85rem; display: flex; align-items: center; gap: 1rem; padding: 0.65rem 1.1rem; }
  .bar { flex: 1; max-width: 360px; height: 5px; background: var(--sunk); border-radius: 3px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: var(--brand); border-radius: 3px; transition: width 0.5s ease; }

  @media (max-width: 1080px) {
    .xp { grid-template-columns: 1fr; }
    .rail-list { flex-direction: row; overflow-x: auto; max-height: none; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; }
    .rail-list button { width: auto; flex: none; border-left: 0; border-bottom: 3px solid transparent; border-radius: 10px 10px 0 0; scroll-snap-align: start; }
    .rail-list button[aria-selected="true"] { border-bottom-color: var(--o); }
    .rail-list .tg, .rail-list .no { display: none; }
    .stage { min-height: 0; }
    .scene { min-height: min(96vw, 480px); }
  }
  @media (max-width: 460px) {
    .grow { grid-template-columns: 66px minmax(0, 1fr) auto; column-gap: 0.5rem; }
    .gn { font-size: 12px; }
    .gv { font-size: 11.5px; min-width: 70px; }
  }
</style>

<script>
  import { bn, bnNum } from '../../lib/bn';
  import { markSeen, getProgress } from '../../lib/progress';
  import { trackItem, trackDepth, trackPlay } from '../../lib/track';
  import { lightMinutes, EARTH_DIAMETER_KM, SPEEDS, fitsInside, METRICS, AU_KM, orbitYears, type Body, type Branch, type Facts } from '../../data/space';
  import type { CosmosHandle, Level, Pick } from './cosmos';
  import { mountStatViz, kindFor, parseNum, type VizHandle } from './statviz';
  type BodyX = Body & { branches: Branch[]; facts?: Facts };

  const root = document.getElementById('explorer')!;
  const data: BodyX[] = JSON.parse(document.getElementById('space-data')!.textContent!);
  const byId = (id: string) => data.find((b) => b.id === id)!;
  const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const rail = [...root.querySelectorAll<HTMLButtonElement>('.rail-list [data-id]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const WORLD = 'space';

  let cur = byId(root.dataset.current!);
  let level = (localStorage.getItem('posora:level') as 'l1' | 'l2' | 'l3' | null) ?? 'l1';
  let compare = false;
  let cosmos: CosmosHandle | null = null;
  let branchesOpen = false;

  /* ---- 3D: load after first paint so the HTML is readable immediately ---- */
  const host = $('#planet-host');
  import('./cosmos').then(({ mountCosmos }) => {
    cosmos = mountCosmos(host, $('#moon-labels'), data, cur.id, {
      onPick(pk: Pick) {
        if (pk.kind === 'body') { if (pk.id === cur.id) cosmos?.focusBody(pk.id); else select(pk.id); }
        else if (pk.kind === 'moon') { cosmos?.focusMoon(pk.index); showMoon(pk.index); }
        else toggleBranches(true);
      },
      onLevel(l: Level) { renderCrumbs(l); },
    });
    host.addEventListener('pointerdown', () => { $('#scene-hint').style.opacity = '0'; }, { once: true });
  });

  /* ---- zoom breadcrumbs ---- */
  const crumbBody = $('#crumb-body'), crumbMoon = $('#crumb-moon'), crumbSep2 = $('#crumb-sep2'), crumbSystem = $('#crumb-system');
  function renderCrumbs(l: Level, moonName?: string) {
    crumbBody.textContent = cur.bn;
    crumbSystem.classList.toggle('cur', l === 'system');
    crumbBody.classList.toggle('cur', l === 'body');
    crumbMoon.classList.toggle('cur', l === 'moon');
    const showMoonCrumb = l === 'moon';
    crumbMoon.hidden = crumbSep2.hidden = !showMoonCrumb;
    if (moonName) crumbMoon.textContent = moonName;
    $('#scene-hint').textContent = l === 'system' ? 'যেকোনো গ্রহে ক্লিক করো' : l === 'moon' ? 'পিছিয়ে যেতে উপরে গ্রহের নামে চাপো' : 'গ্রহে ক্লিক করো - ভেতরের বিষয়গুলো খুলবে';
    $('#scene-hint').style.opacity = branchesOpen ? '0' : '1';  // never fight the open branch strip
  }

  /* ---- branches: what clicking the body opens up ---- */
  const branchbar = $('#branchbar'), branchChips = $('#branch-chips');
  function renderBranches() {
    branchChips.replaceChildren(...(cur.branches ?? []).map((br) => {
      const b = document.createElement('button');
      b.type = 'button'; b.dataset.br = br.id; b.textContent = br.bn; b.setAttribute('aria-pressed', 'false');
      return b;
    }));
  }
  function toggleBranches(open: boolean) {
    branchesOpen = open && (cur.branches ?? []).length > 0;
    branchbar.hidden = !branchesOpen;
    if (branchesOpen) $('#scene-hint').style.opacity = '0';
  }
  function openBranch(id: string) {
    const br = (cur.branches ?? []).find((x) => x.id === id); if (!br) return;
    branchChips.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.br === id)));
    $('#sub-k').textContent = br.bn;
    $('#sub-text').textContent = br.text;
    $('#subtopic').hidden = false;
    cosmos?.frame(br.focus, br.moon ?? 0);
    if (br.focus === 'moon') renderCrumbs('moon', cur.moons[br.moon ?? 0]?.bn ?? '');
    $('#subtopic').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' });
  }
  function showMoon(i: number) {
    const m = cur.moons[i]; if (!m) return;
    $('#sub-k').textContent = `${cur.bn}ের চাঁদ`;
    $('#sub-text').textContent = `${m.bn} (${m.en}) - ${cur.bn}ের একটি চাঁদ। ক্যামেরা এখন এর সঙ্গে সঙ্গে ঘুরছে; টেনে চারপাশ থেকে দেখো, ফিরতে উপরে ${cur.bn}ের নামে চাপো।`;
    $('#subtopic').hidden = false;
    renderCrumbs('moon', m.bn);
  }

  /* ---- every number opens its own animation ---- */
  let openDive: { row: HTMLElement; el: HTMLElement; viz: VizHandle } | null = null;
  function closeDive() { if (openDive) { openDive.viz.destroy(); openDive.el.remove(); openDive.row.setAttribute('aria-expanded', 'false'); openDive = null; } }
  function toggleDive(row: HTMLElement, i: number) {
    const wasOpen = openDive?.row === row;
    closeDive();
    if (wasOpen) return;
    const st = cur.stats[i]; if (!st) return;
    const el = document.createElement('div'); el.className = 'dive';
    const cv = document.createElement('canvas'); const cap = document.createElement('p');
    el.append(cv, cap); row.after(el);
    const viz = mountStatViz(cv, {
      kind: kindFor(st.k), value: parseNum(st.v), s: st.s, bodyName: cur.bn,
      hue: getComputedStyle(document.body).getPropertyValue('--w').trim() || '#5A6BD4',
      gravity: cur.gravity, au: cur.au, k: st.k, v: st.v,
    });
    cap.textContent = viz.caption;
    row.setAttribute('aria-expanded', 'true');
    openDive = { row, el, viz };
  }

  /* ---- big numbers, said the way people say them ---- */
  function big(n: number): string {
    if (n >= 1e7) return `${bn((n / 1e7).toFixed(n >= 1e8 ? 0 : 1))} কোটি`;
    if (n >= 1e5) return `${bn((n / 1e5).toFixed(n >= 1e6 ? 0 : 1))} লাখ`;
    if (n >= 1000) return bnNum(Math.round(n));
    if (n >= 10) return bn(Math.round(n));
    return bn(n.toFixed(1));
  }
  function dur(hours: number): string {
    if (hours * 3600 < 90) return `${bn((hours * 3600).toFixed(1))} সেকেন্ড`;  // light to the Moon is 1.3s
    if (hours < 1) return `${bn(Math.round(hours * 60))} মিনিট`;
    if (hours < 48) return `${bn(hours.toFixed(1))} ঘণ্টা`;
    const days = hours / 24;
    if (days < 365) return `${bn(Math.round(days))} দিন`;
    const years = days / 365;
    return years >= 1000 ? `${big(years)} বছর` : `${bn(Math.round(years))} বছর`;
  }

  /* ---- how big is it, really ---- */
  function renderSize() {
    const f = cur.facts; const out = $('#size-out'), bars = $('#size-bars');
    if (!f) { out.textContent = ''; bars.replaceChildren(); return; }
    const rel = f.diameterKm / EARTH_DIAMETER_KM;
    // two circles at true relative scale, capped so the Sun doesn't blow out the card
    const maxPx = 76;
    const bigPx = rel >= 1 ? maxPx : maxPx * rel;
    const smallPx = rel >= 1 ? Math.max(3, maxPx / rel) : maxPx;
    const hue = getComputedStyle(document.body).getPropertyValue('--w').trim() || '#5A6BD4';
    const mk = (px: number, label: string, color: string) => {
      const w = document.createElement('span');
      const i = document.createElement('i');
      i.style.width = i.style.height = `${px}px`; i.style.setProperty('--c', color);
      w.append(i, document.createTextNode(label)); return w;
    };
    bars.replaceChildren(mk(bigPx, cur.bn, hue), mk(smallPx, 'পৃথিবী', '#3f9a4a'));
    const fits = fitsInside(f.diameterKm, EARTH_DIAMETER_KM);
    const line = cur.id === 'earth'
      ? 'এটাই আমাদের বাড়ি - বাকি সবাইকে আমরা এর সঙ্গেই মাপি।'
      : fits >= 1.6
        ? `এর ভেতরে <b>${big(fits)}টা পৃথিবী</b> এঁটে যাবে।`
        : `এর ভেতরে <b>${big(1 / fits)}টা ${cur.bn}</b> নিলে একটা পৃথিবী হয়।`;
    out.innerHTML = `ব্যাস <b>${bnNum(f.diameterKm)} কিমি</b> - পৃথিবীর চেয়ে ${rel >= 1 ? `${bn(rel.toFixed(1))} গুণ বড়` : `${bn((1 / rel).toFixed(1))} গুণ ছোট`}। ${line}`;
  }

  /* ---- how long would it take to get there ---- */
  function renderTravel() {
    const f = cur.facts; const box = $('#trav');
    if (!f || f.nearestKm === 0) {
      $('#trav-dist').textContent = '';
      box.innerHTML = '<div class="t"><span>তুমি তো এখানেই আছো!</span></div>';
      return;
    }
    $('#trav-dist').textContent = `${big(f.nearestKm)} কিমি`;
    box.replaceChildren(...SPEEDS.map((sp) => {
      const row = document.createElement('div'); row.className = 't';
      row.innerHTML = `<span>${sp.bn}</span><b>${dur(f.nearestKm / sp.kmh)}</b>`;
      return row;
    }));
  }

  /* ---- the questions people actually ask, answered from the data ---- */
  const statNum = (b: BodyX, key: string) => {
    const st = b.stats.find((x) => x.k.includes(key));
    return st ? parseNum(st.v) : null;
  };
  function renderRecords() {
    const planets = data.filter((b) => b.id !== 'sun' && b.id !== 'moon' && b.id !== 'pluto');
    const best = (label: string, pick: (list: BodyX[]) => BodyX | undefined, val: (b: BodyX) => string) => {
      const b = pick(planets); return b ? { label, b, val: val(b) } : null;
    };
    const byMax = (f: (b: BodyX) => number | null) => (l: BodyX[]) =>
      l.filter((b) => f(b) !== null).sort((x, y) => (f(y) as number) - (f(x) as number))[0];
    const byMin = (f: (b: BodyX) => number | null) => (l: BodyX[]) =>
      l.filter((b) => f(b) !== null).sort((x, y) => (f(x) as number) - (f(y) as number))[0];
    const dia = (b: BodyX) => b.facts?.diameterKm ?? null;
    const temp = (b: BodyX) => statNum(b, 'তাপমাত্রা');
    const moons = (b: BodyX) => statNum(b, 'চাঁদ');

    const recs = [
      best('সবচেয়ে বড় গ্রহ', byMax(dia), (b) => `${bnNum(b.facts!.diameterKm)} কিমি`),
      best('সবচেয়ে ছোট গ্রহ', byMin(dia), (b) => `${bnNum(b.facts!.diameterKm)} কিমি`),
      best('সবচেয়ে গরম গ্রহ', byMax(temp), (b) => `${bn(temp(b)!)} °সে`),
      best('সবচেয়ে ঠান্ডা গ্রহ', byMin(temp), (b) => `${bn(temp(b)!)} °সে`),
      best('সবচেয়ে বেশি চাঁদ', byMax(moons), (b) => `${bn(moons(b)!)}টি`),
    ].filter(Boolean) as { label: string; b: BodyX; val: string }[];

    $('#recs').replaceChildren(...recs.map((r) => {
      const btn = document.createElement('button');
      btn.type = 'button'; btn.dataset.id = r.b.id;
      btn.classList.toggle('is-cur', r.b.id === cur.id);
      btn.innerHTML = `<span>${r.label}</span><b>${r.b.bn} <small style="font-weight:500;color:var(--muted)">${r.val}</small></b>`;
      return btn;
    }));
  }

  /* ---- সৌরজগৎ এক নজরে: one animated chart, six ways to compare ---- */
  const gseg = [...root.querySelectorAll<HTMLButtonElement>('.gseg [data-m]')];
  const grows = [...root.querySelectorAll<HTMLElement>('.gchart .grow')];
  let metric = 0, autoTimer = 0;

  /** A body either has a plottable number for this metric, or a short honest reason it has none. */
  type MVal = { v: number } | { text: string };
  const NOTE: Record<string, Record<string, string>> = {
    dist:  { sun: 'সৌরজগতের কেন্দ্র', moon: 'পৃথিবীর সঙ্গী' },
    temp:  { sun: '৫,৫০০ °সে - তারা, তাই তুলনার বাইরে' },
    moons: { sun: '৮টি গ্রহ ঘোরে', moon: 'নিজেই একটা চাঁদ' },
    year:  { sun: 'কারও চারপাশে ঘোরে না', moon: 'পৃথিবীর সঙ্গে ৩৬৫ দিন' },
  };
  function metricValue(b: BodyX, id: string): MVal | null {
    const note = NOTE[id]?.[b.id];
    if (note) return { text: note };
    switch (id) {
      case 'dia': return b.facts ? { v: b.facts.diameterKm } : null;
      case 'dist': return b.au ? { v: b.au * AU_KM } : null;
      case 'temp': {
        const st = b.stats.find((x) => x.k.includes('তাপমাত্রা'));
        if (!st) return null;
        // "−১৮০ / +৪৩০" is a day/night range; picking one end and calling it the temperature would be wrong
        if (st.v.includes('/')) return { text: `${st.v.replace('°C', '°সে')} (রাত / দিন)` };
        const t = parseNum(st.v);
        return t === null ? null : { v: t };
      }
      case 'grav': return { v: b.gravity };
      case 'moons': { const n = statNum(b, 'চাঁদ'); return n === null ? null : { v: n }; }
      case 'year': return b.au ? { v: orbitYears(b.au) } : null;
      default: return null;
    }
  }
  function metricLabel(id: string, v: number): string {
    if (id === 'dia' || id === 'dist') return `${big(v)} কিমি`;
    if (id === 'temp') return `${bn(Math.round(v))} °সে`;
    if (id === 'grav') return `${bn(v.toFixed(2))}× পৃথিবী`;
    if (id === 'moons') return `${bn(v)}টি`;
    return v < 1 ? `${bn(Math.round(v * 365))} দিন` : `${bn(v.toFixed(v < 10 ? 1 : 0))} বছর`;
  }
  function renderGlance() {
    const m = METRICS[metric];
    const vals = data.map((b) => metricValue(b, m.id));
    const nums = vals.flatMap((x) => (x && 'v' in x ? [x.v] : []));
    const max = Math.max(...nums), min = Math.min(...nums, 0);
    gseg.forEach((b, i) => b.setAttribute('aria-selected', String(i === metric)));
    grows.forEach((row, i) => {
      const x = vals[i], bar = row.querySelector<HTMLElement>('.gtrack i')!, out = row.querySelector<HTMLElement>('.gv')!;
      row.style.setProperty('--i', String(i));
      row.setAttribute('aria-current', String(data[i].id === cur.id));
      if (!x || 'text' in x) {
        bar.style.width = '0%'; out.textContent = x ? x.text : 'জানা নেই'; out.classList.add('none');
        return;
      }
      // compressed metrics span orders of magnitude, so a linear bar would hide the small bodies
      const frac = m.compress ? Math.pow(x.v / max, 0.35) : (x.v - min) / (max - min || 1);
      bar.style.width = x.v === 0 ? '0%' : `${Math.max(2, Math.min(100, frac * 100))}%`;
      out.textContent = metricLabel(m.id, x.v); out.classList.remove('none');
    });
    $('#gcap').textContent = m.compress
      ? 'সংখ্যাগুলো এত আলাদা যে বারগুলো চাপা স্কেলে আঁকা, নইলে ছোটগুলো দেখাই যেত না। আসল সংখ্যা ডান পাশে লেখা।'
      : 'এখানে বারের লম্বা সরাসরি সংখ্যার অনুপাতে আঁকা।';
  }
  function stopAuto() {
    if (!autoTimer) return;
    clearInterval(autoTimer); autoTimer = 0; $('#gauto').hidden = true;
  }
  function startAuto() {
    if (autoTimer || reduced) return;
    autoTimer = window.setInterval(() => { metric = (metric + 1) % METRICS.length; renderGlance(); }, 6500);
  }
  if (reduced) $('#gauto').hidden = true;
  else new IntersectionObserver((es) => {                       // only cycle while it is actually on screen
    if (!$('#gauto').hidden) es[0].isIntersecting ? startAuto() : (clearInterval(autoTimer), autoTimer = 0);
  }, { threshold: 0.25 }).observe($('#glance'));

  function renderAge() {
    const yrs = Math.max(0, +$<HTMLInputElement>('#age').value || 0);
    const out = $('#age-out');
    if (!yrs) { out.textContent = 'তোমার বয়স লেখো, দেখি এই গ্রহে কত হতো।'; return; }
    if (cur.au === null) {
      out.innerHTML = `চাঁদ পৃথিবীর সঙ্গে সঙ্গেই সূর্যকে ঘোরে, তাই এখানে বয়স পৃথিবীর মতোই - <strong>${bn(yrs)} বছর</strong>।`;
    } else if (cur.au === 0) {
      out.textContent = 'সূর্য কারও চারপাশে ঘোরে না, তাই এখানে জন্মদিনের হিসাবই নেই।';
    } else {
      const p = orbitYears(cur.au), a = yrs / p;
      out.innerHTML = a >= 1
        ? `${cur.bn}ে তোমার বয়স হতো <strong>${bn(a.toFixed(1))} বছর</strong> - কারণ এখানে এক বছর মানে পৃথিবীর ${bn(p < 10 ? p.toFixed(1) : Math.round(p))} বছর।`
        : `${cur.bn}ে তুমি এখনো এক বছরও পূর্ণ করোনি! প্রথম জন্মদিন আসতে আরও <strong>${bn(((1 - a) * p).toFixed(1))} পৃথিবী-বছর</strong> লাগত।`;
    }
  }

  /* ---- render helpers ---- */
  const seg = [...root.querySelectorAll<HTMLButtonElement>('.seg [data-l]')];
  function renderText() {
    $('#b-text').textContent = cur[level];
    seg.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.l === level)));
  }
  function renderSpec() {
    const other = byId($<HTMLSelectElement>('#cmp').value);
    const rows = [...root.querySelectorAll<HTMLElement>('#spec .row')];
    cur.stats.forEach((s, i) => {
      const r = rows[i]; if (!r) return;
      r.querySelector('.k')!.textContent = s.k;
      r.querySelector('.v:not(.v2)')!.textContent = s.v;
      (r.querySelector('.meter i:not(.m2)') as HTMLElement).style.setProperty('--p', `${Math.round(s.s * 100)}%`);
      const v2 = r.querySelector<HTMLElement>('.v2')!, m2 = r.querySelector<HTMLElement>('.m2')!;
      const os = other.stats.find((x) => x.k === s.k);
      v2.hidden = m2.hidden = !(compare && os);
      if (compare && os) { v2.textContent = os.v; m2.style.setProperty('--p', `${Math.round(os.s * 100)}%`); }
    });
  }
  function renderMissions() {
    const kg = Math.max(0, +$<HTMLInputElement>('#kg').value || 0);
    const w = kg * cur.gravity;
    $('#kg-out').innerHTML = kg
      ? `${cur.bn}${cur.id === 'moon' ? 'ে' : 'তে'} তোমার ওজন হবে <strong>${bn(w < 10 ? w.toFixed(1) : Math.round(w))} কেজি</strong>${cur.gravity < 1 ? ' - হালকা লাগবে!' : cur.gravity > 1.5 ? ' - উঠে দাঁড়ানোই কঠিন!' : ''}`
      : 'তোমার ওজন লেখো।';
    let lt: string;
    if (cur.au === null) lt = 'চাঁদ থেকে পৃথিবীতে আলো আসতে লাগে মাত্র <strong>১.৩ সেকেন্ড</strong>।';
    else if (cur.au === 0) lt = 'সূর্যের আলো পৃথিবীতে পৌঁছাতে লাগে <strong>৮ মিনিট ২০ সেকেন্ড</strong>। তুমি এখন যে রোদ দেখছো, সেটা ৮ মিনিট আগের!';
    else { const m = lightMinutes(cur.au); lt = m < 60 ? `সূর্যের আলো ${cur.bn}তে পৌঁছাতে লাগে <strong>${bn(Math.round(m))} মিনিট</strong>।` : `সূর্যের আলো ${cur.bn}তে পৌঁছাতে লাগে <strong>${bn((m / 60).toFixed(1))} ঘণ্টা</strong>।`; }
    $('#light-out').innerHTML = lt;
  }
  function renderProgress() {
    const n = getProgress().seen[WORLD]?.length ?? 0;
    $('#seen-count').textContent = `${bn(n)} / ${bn(data.length)} আবিষ্কৃত`;
    (document.getElementById('log-bar') as HTMLElement).style.width = `${(n / data.length) * 100}%`;
    document.getElementById('log-text')!.textContent = `${bn(n)} / ${bn(data.length)}`;
    rail.forEach((b) => b.classList.toggle('seen', (getProgress().seen[WORLD] ?? []).includes(b.dataset.id!)));
  }
  function renderAll() {
    $('#b-name').textContent = cur.bn; $('#b-en').textContent = cur.en; $('#b-tag').textContent = cur.tagline;
    $('#b-chips').replaceChildren(...cur.chips.map((c) => Object.assign(document.createElement('span'), { className: 'pill', textContent: c })));
    $('#b-fun').textContent = cur.fun;
    host.setAttribute('aria-label', `${cur.bn}ের থ্রিডি মডেল - টেনে ঘোরাও`);
    rail.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.id === cur.id)));
    renderText(); renderSpec(); renderMissions(); renderBranches(); renderSize(); renderTravel(); renderRecords(); renderGlance(); renderAge();
    closeDive(); toggleBranches(false); $('#subtopic').hidden = true; renderCrumbs(cosmos?.level() ?? 'body');
    if (!reduced) $('.stage-h').animate([{ opacity: 0.3, transform: 'translateY(-4px)' }, { opacity: 1, transform: 'none' }], { duration: 300, easing: 'ease-out' });
  }

  function select(id: string, push = true) {
    if (id === cur.id) return;
    cur = byId(id);
    document.title = `${cur.bn} · মহাকাশ · পসরা`;
    if (push) history.pushState({ id }, '', `/space/${id}/`);
    cosmos?.focusBody(cur.id);
    renderAll();
    trackItem(WORLD, 'সৌরজগৎ', cur.bn);
    if (markSeen(WORLD, cur.id)) renderProgress();
    rail.find((b) => b.dataset.id === id)?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduced ? 'auto' : 'smooth' });
  }

  /* ---- wiring ---- */
  rail.forEach((b) => b.addEventListener('click', () => select(b.dataset.id!)));
  crumbSystem.addEventListener('click', () => { cosmos?.showSystem(); toggleBranches(false); $('#subtopic').hidden = true; });
  crumbBody.addEventListener('click', () => { cosmos?.focusBody(cur.id); $('#subtopic').hidden = true; });
  branchChips.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-br]'); if (b) openBranch(b.dataset.br!);
  });
  $('#sub-close').addEventListener('click', () => { $('#subtopic').hidden = true; branchChips.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', 'false')); });
  root.querySelectorAll<HTMLElement>('#spec .row').forEach((r, i) => r.addEventListener('click', () => toggleDive(r, i)));
  $('#cmp3d').addEventListener('click', (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const on = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', String(on));
    b.textContent = on ? 'পৃথিবী সরাও' : 'পাশে পৃথিবী রাখো';
    cosmos?.compareEarth(on);
  });
  $('#recs').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-id]');
    if (b) select(b.dataset.id!);
  });
  gseg.forEach((b, i) => b.addEventListener('click', () => { stopAuto(); metric = i; renderGlance(); }));
  $('#gchart').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-id]');
    if (b) { stopAuto(); select(b.dataset.id!); }
  });
  $<HTMLInputElement>('#age').addEventListener('input', () => { stopAuto(); renderAge(); });
  seg.forEach((b) => b.addEventListener('click', () => { level = b.dataset.l as typeof level; localStorage.setItem('posora:level', level); renderText(); trackDepth(WORLD, level); }));
  $<HTMLInputElement>('#kg').addEventListener('input', renderMissions);
  $<HTMLSelectElement>('#cmp').addEventListener('change', renderSpec);
  root.querySelector('[data-act="compare"]')!.addEventListener('click', (e) => {
    compare = !compare; (e.currentTarget as HTMLElement).setAttribute('aria-pressed', String(compare));
    $('#cmp-wrap').hidden = !compare; renderSpec();
  });
  root.querySelector('[data-act="read"]')!.addEventListener('click', () => $('#read').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' }));
  root.querySelector('[data-act="next"]')!.addEventListener('click', () => { const i = data.findIndex((b) => b.id === cur.id); select(data[(i + 1) % data.length].id); });
  window.addEventListener('popstate', () => { const id = location.pathname.split('/').filter(Boolean)[1] ?? 'earth'; if (byId(id)) select(id, false); });
  document.addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).tagName === 'INPUT' || (e.target as HTMLElement).tagName === 'SELECT') return;
    const i = data.findIndex((b) => b.id === cur.id);
    if (e.key === 'ArrowRight') select(data[(i + 1) % data.length].id);
    if (e.key === 'ArrowLeft') select(data[(i - 1 + data.length) % data.length].id);
  });

  host.addEventListener('pointerdown', () => trackPlay(WORLD, 'সৌরজগৎ'), { once: true });

  renderText(); renderMissions(); renderBranches(); renderSize(); renderTravel(); renderRecords();
  renderGlance(); renderAge(); markSeen(WORLD, cur.id); renderProgress();
  trackItem(WORLD, 'সৌরজগৎ', cur.bn);
</script>
