  function renderAll() {
    $('#b-name').textContent = cur.bn; $('#b-en').textContent = cur.en; $('#b-tag').textContent = cur.tagline;
    $('#b-chips').replaceChildren(...cur.chips.map((c) => Object.assign(document.createElement('span'), { className: 'pill', textContent: c })));
    $('#b-fun').textContent = cur.fun;
    host.setAttribute('aria-label', `${bnOf(cur.bn)} থ্রিডি মডেল - টেনে ঘোরাও`);
    rail.forEach((b) => { if (b.dataset.id === cur.id) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); });
    renderText(); renderSpec(); renderTools(); renderBranches(); renderSize(); renderTravel(); renderRecords(); renderGlance(); renderAge();
    closeDive(); toggleBranches(true); $('#subtopic').hidden = true; renderCrumbs(cosmos?.level() ?? 'body');
    if (!reduced) $('.stage-h').animate([{ opacity: 0.3, transform: 'translateY(-4px)' }, { opacity: 1, transform: 'none' }], { duration: 300, easing: 'ease-out' });
  }

  function select(id: string, push = true) {
    if (id === cur.id) return;
    cur = byId(id);
    document.title = `${cur.bn} · মহাকাশ · পসরা`;
    if (push) history.pushState({ id }, '', `/space/${id}/`);
    cosmos?.focusBody(cur.id);
    renderAll();
    trackItem(WORLD, 'সৌরজগৎ', cur.bn);
    if (markSeen(WORLD, cur.id)) { floatXp(10); noteItem(WORLD); renderProgress(); checkGoal(); }
    rail.find((b) => b.dataset.id === id)?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduced ? 'auto' : 'smooth' });
  }

  /* ---- wiring ---- */
  rail.forEach((b) => b.addEventListener('click', () => select(b.dataset.id!)));
  crumbSystem.addEventListener('click', () => { cosmos?.showSystem(); toggleBranches(false); $('#subtopic').hidden = true; });  // the strip belongs to a body, not the whole system
  crumbBody.addEventListener('click', () => { cosmos?.focusBody(cur.id); $('#subtopic').hidden = true; });
  branchChips.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-br]'); if (b) openBranch(b.dataset.br!);
  });
  $('#sub-close').addEventListener('click', () => { $('#subtopic').hidden = true; branchChips.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', 'false')); });
  $('#spec').addEventListener('click', (e) => {
    const r = (e.target as HTMLElement).closest<HTMLElement>('.row');
    if (!r || !r.parentElement) return;
    toggleDive(r, [...r.parentElement.querySelectorAll<HTMLElement>('.row')].indexOf(r));
  });
  $('#cmp3d').addEventListener('click', (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const on = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', String(on));
    b.textContent = on ? 'পৃথিবী সরাও' : 'পাশে পৃথিবী রাখো';
    cosmos?.compareEarth(on);
  });
  $('#recs').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-id]');
    if (b) select(b.dataset.id!);
  });
  gseg.forEach((b, i) => b.addEventListener('click', () => { stopAuto(); metric = i; renderGlance(); }));
  $('#gchart').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-id]');
    if (b) { stopAuto(); select(b.dataset.id!); }
  });
  $<HTMLInputElement>('#age').addEventListener('input', () => { stopAuto(); renderAge(); });
  seg.forEach((b) => b.addEventListener('click', () => { level = b.dataset.l as typeof level; localStorage.setItem('posora:level', level); renderText(); trackDepth(WORLD, level); }));
  $<HTMLInputElement>('#kg').addEventListener('input', renderTools);
  $<HTMLSelectElement>('#cmp').addEventListener('change', renderSpec);
  root.querySelector('[data-act="compare"]')!.addEventListener('click', (e) => {
    compare = !compare; (e.currentTarget as HTMLElement).setAttribute('aria-pressed', String(compare));
    $('#cmp-wrap').hidden = !compare; renderSpec();
  });
  root.querySelector('[data-act="read"]')!.addEventListener('click', () => $('#read').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' }));
  root.querySelector('[data-act="next"]')!.addEventListener('click', () => { const i = data.findIndex((b) => b.id === cur.id); select(data[(i + 1) % data.length].id); });
  window.addEventListener('popstate', () => { const id = location.pathname.split('/').filter(Boolean)[1] ?? DEFAULT_BODY; if (byId(id)) select(id, false); });
  document.addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).tagName === 'INPUT' || (e.target as HTMLElement).tagName === 'SELECT') return;
    const i = data.findIndex((b) => b.id === cur.id);
    if (e.key === 'ArrowRight') select(data[(i + 1) % data.length].id);
    if (e.key === 'ArrowLeft') select(data[(i - 1 + data.length) % data.length].id);
  });

  host.addEventListener('pointerdown', () => { playedEver = true; checkAwards(); });
  host.addEventListener('pointerdown', () => trackPlay(WORLD, 'সৌরজগৎ'), { once: true });

  renderText(); renderTools(); renderBranches(); toggleBranches(true); renderSize(); renderTravel(); renderRecords();
  renderGlance(); renderAge();
  if (markSeen(WORLD, cur.id)) noteItem(WORLD);
  renderPlayer(); renderAwards(); renderMissions(); renderQuestBtn(); renderProgress();
  trackItem(WORLD, 'সৌরজগৎ', cur.bn);

  /* ---- what today did to the streak ---- */
  if (day.froze) toast(`❄ একটা বরফ খরচ হলো, ${bn(streakDays)} দিনের ধারা টিকে গেছে`);
  else if (day.broke && day.brokeAt >= 3) toast(`ধারা ভেঙেছে ${bn(day.brokeAt)} দিনে। আজ থেকে আবার শুরু।`);
  const mile = reachedMilestone(streakDays);
  if (mile) {
    window.setTimeout(() => {
      const r = host.getBoundingClientRect(); fx.burst(r.width / 2, r.height * 0.4, '#f0b429', true);
      chime('win');
      toast(`${mile.emoji} ${mile.name} টানা! ${mile.note}`);
      track('milestone', { at: mile.at });
    }, 900);
  }
</script>
