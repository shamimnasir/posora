---
import { bodies, branchesFor, FACTS, METRICS, SPEEDS, EARTH_DIAMETER_KM, type Body } from '../../data/space';
import { bn, pad2, bnNum, bnDuration, bnOf } from '../../lib/bn';
import { worlds } from '../../data/worlds';
import { AWARDS, awardKey } from '../../lib/game';
import { bodyEmoji } from '../../data/cat-emoji';
import { labFor } from '../../data/labs';
import MissionPanel from './MissionPanel.astro';
interface Props { current: Body }
const { current: cur } = Astro.props;
const LEVELS = [['l1', 'ছোট', '৫–৮'], ['l2', 'মাঝারি', '৯–১২'], ['l3', 'বড়', '১৩+']] as const;
const payload = bodies.map(({ id, bn, en, tagline, chips, stats, gravity, au, l1, l2, l3, fun, visual, moons }) =>
  ({ id, bn, en, tagline, chips, stats, gravity, au, l1, l2, l3, fun, visual, moons, branches: branchesFor(id), facts: FACTS[id] }));
// The space page carries the same missions and the same player bar as every
// other world, read from the same place, so the two can never drift apart.
const world = worlds.find((w) => w.slug === 'space')!;
/**
 * The branch chips, the size comparison and the travel times used to be drawn
 * by script alone, which left three cards as a heading over an empty box until
 * it ran. They are all computed from this body's own figures, so the server can
 * draw them; the script still redraws them on every change, from the same
 * helpers in lib/bn.ts, so the two cannot say different things.
 */
const facts = FACTS[cur.id];
const seedSize = facts ? (() => {
  const rel = facts.diameterKm / EARTH_DIAMETER_KM;
  const maxPx = 76;
  return {
    bigPx: rel >= 1 ? maxPx : maxPx * rel,
    smallPx: rel >= 1 ? Math.max(3, maxPx / rel) : maxPx,
  };
})() : null;
/**
 * The hands-on lab for মহাকাশ, if one exists.
 *
 * Read from the lab registry rather than hard-coded, so adding a second space
 * lab later needs no edit here and removing one cannot leave a dead link.
 */
const spaceLab = (() => {
  const lab = labFor('space', 0);
  const cat = worlds.find((w) => w.slug === 'space')?.cats[0];
  return lab ? { href: '/space/lab/0/', n: lab.n ?? cat?.n ?? 'হাতে-কলমে', lede: lab.lede } : null;
})();

/** The five solar-system records, all read off the bodies themselves. */
const seedRecords = (() => {
  const planets = bodies.filter((b) => b.id !== 'sun' && b.id !== 'moon' && b.id !== 'pluto');
  const statNum = (b: Body, key: string) => {
    const st = b.stats.find((x) => x.k.includes(key));
    if (!st) return null;
    const m = st.v.replace(/,/g, '').match(/-?\d+(\.\d+)?/);
    return m ? Number(m[0]) : null;
  };
  const dia = (b: Body) => FACTS[b.id]?.diameterKm ?? null;
  const pick = (f: (b: Body) => number | null, max: boolean) =>
    planets.filter((b) => f(b) !== null).sort((x, y) => (max ? (f(y)! - f(x)!) : (f(x)! - f(y)!)))[0];
  const temp = (b: Body) => statNum(b, 'তাপমাত্রা');
  const moons = (b: Body) => statNum(b, 'চাঁদ');
  const rows: { label: string; b: Body; val: string }[] = [];
  const add = (label: string, b: Body | undefined, val: (b: Body) => string) => { if (b) rows.push({ label, b, val: val(b) }); };
  add('সবচেয়ে বড় গ্রহ', pick(dia, true), (b) => `${bnNum(dia(b)!)} কিমি`);
  add('সবচেয়ে ছোট গ্রহ', pick(dia, false), (b) => `${bnNum(dia(b)!)} কিমি`);
  add('সবচেয়ে গরম গ্রহ', pick(temp, true), (b) => `${bn(temp(b)!)} °সে`);
  add('সবচেয়ে ঠান্ডা গ্রহ', pick(temp, false), (b) => `${bn(temp(b)!)} °সে`);
  add('সবচেয়ে বেশি চাঁদ', pick(moons, true), (b) => `${bn(moons(b)!)}টি`);
  return rows;
})();
const seedTravel = facts && facts.nearestKm > 0
  ? SPEEDS.map((sp) => ({ bn: sp.bn, t: bnDuration(facts.nearestKm / sp.kmh) }))
  : null;
---
<div class="xp" id="explorer" data-current={cur.id}>
  <aside class="rail card" aria-label="সৌরজগতের তালিকা">
    <div class="card-h"><span class="lbl">সৌরজগৎ</span><span class="lbl num" id="seen-count">০ / {bn(bodies.length)} দেখা হয়েছে</span></div>
    <div class="rail-list">
      {bodies.map((b, i) => (
        <button type="button" data-id={b.id} aria-current={b.id === cur.id ? 'true' : undefined} style={`--o:${b.visual.colors[0]};--o2:${b.visual.colors[1]}`}>
          <span class="rorb" aria-hidden="true">{bodyEmoji(b.id)}</span>
          <span class="rt"><span class="nm">{b.bn}</span><span class="tg">{b.tagline}</span></span>
          <span class="no lbl">{pad2(i + 1)}</span>
        </button>
      ))}
    </div>
  </aside>

  <div class="mid">
  <section class="stage card">
    <header class="stage-h">
      <div>
        <p class="eyebrow">মহাকাশ ভুবন · সৌরজগৎ</p>
        <h1 id="b-name" aria-live="polite">{cur.bn}</h1>
        <p class="tag"><span id="b-en">{cur.en}</span> · <span id="b-tag">{cur.tagline}</span></p>
      </div>
      <div class="chips" id="b-chips">{cur.chips.map((c) => <span class="pill">{c}</span>)}</div>
    </header>
    {/* The player bar. Every number on it is earned on this device. */}
    <details class="progress-drawer">
      <summary>আমার অগ্রগতি</summary>
    <div class="player" id="player">
      <span class="pl-lvl"><b id="pl-lvl">স্তর ১</b><span id="pl-title">নবীন</span><span class="pl-bar" aria-hidden="true"><i id="pl-bar"></i></span></span>
      <span class="pl-xp">⚡ <b id="pl-xp">০</b> জ্ঞানবিন্দু</span>
      <span class="pl-streak">🔥 <b id="pl-days">১</b> দিন</span>
      <a class="pl-goal" id="pl-goal" href="/today/" title="আজকের লক্ষ্য - তিনটা কাজ">
        <span class="pg" aria-hidden="true"><i></i><i></i><i></i></span>আজ
      </a>
      <button type="button" class="pl-sound" id="pl-sound" aria-pressed="true" aria-label="খেলার শব্দ">🔔</button>
      <span class="xp-float" id="xp-float" aria-hidden="true"></span>
    </div>
    </details>
    <p class="award-toast" id="award-toast" role="status" aria-live="polite" hidden></p>
    <div class="scene">
      <p class="lesson-cue"><b>করে দেখো</b><span>গ্রহে চাপো, টেনে ঘোরাও, তারপর পৃথিবীর সঙ্গে তুলনা করো</span></p>
      <nav class="zoombar" aria-label="কোথায় আছো">
        <button type="button" class="crumb" id="crumb-system">সৌরজগৎ</button>
        <span class="sep" aria-hidden="true">›</span>
        <button type="button" class="crumb cur" id="crumb-body">{cur.bn}</button>
        <span class="sep" id="crumb-sep2" hidden aria-hidden="true">›</span>
        <button type="button" class="crumb" id="crumb-moon" hidden></button>
      </nav>
      <div class="host" id="planet-host" aria-label={`${bnOf(cur.bn)} থ্রিডি মডেল - টেনে ঘোরাও, ক্লিক করে ভেতরে যাও`} role="img">
        <canvas></canvas>
        <div class="labels" id="moon-labels"></div>
      </div>
      <div class="branchbar" id="branchbar" hidden>
        <span class="lbl" id="branch-title">ভেতরে কী কী আছে</span>
        <div class="branch-chips" id="branch-chips">
          {branchesFor(cur.id).map((br) => (
            <button type="button" data-br={br.id} aria-pressed="false">{br.bn}</button>
          ))}
        </div>
      </div>
      <canvas class="fx" id="fx" aria-hidden="true"></canvas>
      {/* খোঁজার খেলা: the cosmos asks for one body and the child has to find it
          out there. Nothing is read out; finding it in the sky is the game. */}
      <div class="quest" id="quest" hidden>
        <div class="q-card" id="q-card" role="status" aria-live="polite">
          <span class="lbl q-l">খুঁজে বের করো</span>
          <span class="q-target"><span class="q-emoji" id="q-emoji">🔭</span><b id="q-name"></b></span>
          <span class="q-meta"><span id="q-count">০ / ০</span> · <span id="q-time">০ সেকেন্ড</span></span>
          <button type="button" class="q-x" id="q-quit" aria-label="খেলা বন্ধ করো">✕</button>
        </div>
        <p class="q-hint" id="q-hint"></p>
      </div>
      <div class="qres" id="qres" hidden>
        <div class="qres-card">
          <p class="lbl">খোঁজার খেলা শেষ</p>
          <p class="q-stars" id="q-stars" aria-label="তারা">★★★</p>
          <h3 id="q-head">দারুণ!</h3>
          <p class="q-sum" id="q-sum"></p>
          <div class="q-btns">
            <button type="button" id="q-again">আবার খেলো</button>
            <button type="button" id="q-read" class="primary">পড়তে যাও</button>
          </div>
        </div>
      </div>
      <p class="hint" id="scene-hint">গ্রহে ক্লিক করো - আরও কাছ থেকে দেখো</p>
      <p class="model-note">কক্ষপথ, গ্রহের মাপ ও দূরত্ব একই অনুপাতে নয়</p>
      <noscript><p class="hint">থ্রিডি মডেল দেখতে জাভাস্ক্রিপ্ট চালু করো।</p></noscript>
    </div>
    <div class="actions">
      <button type="button" id="q-start" class="q-start">🎯 খোঁজার খেলা</button>
      <button type="button" data-act="compare" aria-pressed="false">
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="7" cy="10" r="5" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="13" cy="10" r="5" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
        তুলনা
      </button>
      <button type="button" data-act="read" class="primary">
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M3 4h6a2 2 0 0 1 2 2v10a1.5 1.5 0 0 0-1.5-1.5H3zM17 4h-6a2 2 0 0 0-2 2v10a1.5 1.5 0 0 1 1.5-1.5H17z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
        পড়ো
      </button>
      <button type="button" data-act="next">পরেরটা →</button>
    </div>
  </section>

  <section class="card glance" id="glance">
    <div class="card-h">
      <span class="lbl">সৌরজগৎ এক নজরে</span>
      <span class="lbl gauto" id="gauto">নিজে নিজে বদলাচ্ছে</span>
    </div>
    <div class="gseg" role="group" aria-label="কোন হিসাবে তুলনা">
      {METRICS.map((m, i) => (
        <button type="button" data-m={m.id} aria-pressed={i === 0 ? 'true' : 'false'}>{m.bn}</button>
      ))}
    </div>
    <div class="gchart" id="gchart">
      {bodies.map((b) => (
        <button type="button" class="grow" data-id={b.id} style={`--o:${b.visual.colors[0]}`}>
          <span class="gn">{b.bn}</span>
          <span class="gtrack"><i></i></span>
          <span class="gv"></span>
        </button>
      ))}
    </div>
    <p class="gcap" id="gcap"></p>
    <div class="agebox">
      <label class="kg" for="age">তোমার বয়স <input type="number" id="age" inputmode="numeric" min="1" max="120" value="10" /> বছর</label>
      <p class="out" id="age-out"></p>
    </div>
  </section>

  {/* The reading-and-mission rail must stay short enough that the next major
      section is visible after the stage. These richer tools belong in the
      wide middle column: they are easier to use here and fill the space that
      used to sit empty beside a very long sidebar. */}
  <section class="lower-tools" aria-labelledby="more-tools-title">
    <div class="lower-tools-h">
      <div>
        <p class="eyebrow">আরও ঘেঁটে দেখো</p>
        <h2 id="more-tools-title">{cur.bn} মাপো ও তুলনা করো</h2>
      </div>
      <p>পড়ার পর সংখ্যাগুলো নিয়ে খেলো · মাপ, দূরত্ব, রেকর্ড আর পরিচিতি একসঙ্গে।</p>
    </div>

    <section class="card">
      <div class="card-h">
        <span class="lbl">কত বড়</span>
        <button type="button" class="mini" id="cmp3d" aria-pressed="false">পাশে পৃথিবী রাখো</button>
      </div>
      <div class="size">
        <div class="size-bars" id="size-bars" aria-hidden="true">
          {seedSize && <><span><i style={`width:${seedSize.bigPx}px;height:${seedSize.bigPx}px;--c:${world?.hue ?? '#5A6BD4'}`}></i>{cur.bn}</span><span><i style={`width:${seedSize.smallPx}px;height:${seedSize.smallPx}px;--c:#3f9a4a`}></i>পৃথিবী</span></>}
        </div>
        <p class="size-out" id="size-out"></p>
      </div>
    </section>

    <section class="card">
      <div class="card-h"><span class="lbl">কতদিনে পৌঁছাবে</span><span class="lbl" id="trav-dist"></span></div>
      <div class="trav" id="trav">
        {seedTravel
          ? seedTravel.map((r) => <div class="t"><span>{r.bn}</span><b>{r.t}</b></div>)
          : <div class="t"><span>তুমি তো এখানেই আছো!</span></div>}
      </div>
    </section>

    <section class="card">
      <div class="card-h"><span class="lbl">রেকর্ড</span><span class="lbl">সৌরজগতে</span></div>
      <div class="recs" id="recs">
        {seedRecords.map((r) => (
          <button type="button" data-id={r.b.id} class={r.b.id === cur.id ? 'is-cur' : undefined}>
            <span>{r.label}</span><b>{r.b.bn} <small style="font-weight:500;color:var(--muted)">{r.val}</small></b>
          </button>
        ))}
      </div>
    </section>

    <section class="card">
      <div class="card-h"><span class="lbl">যন্ত্র</span><span class="lbl">এই জগতের হিসাব</span></div>
      <div class="miss tools">
        <div class="m">
          <span class="mb">০১</span>
          <div class="m-t">
            <b>ওজন মাপো</b>
            <label class="kg">তোমার ওজন <input type="number" id="kg" inputmode="numeric" min="1" max="500" value="30" /> কেজি</label>
            <p id="kg-out" class="out"></p>
          </div>
        </div>
        <div class="m">
          <span class="mb">০২</span>
          <div class="m-t"><b>আলো কতক্ষণে পৌঁছায়</b><p id="light-out" class="out"></p></div>
        </div>
        <div class="m">
          <span class="mb">০৩</span>
          <div class="m-t"><b>তুলনা করো</b><p class="out">উপরে “তুলনা” চেপে অন্য একটি গ্রহ বেছে নাও - সংখ্যাগুলো পাশাপাশি দেখাবে।</p></div>
        </div>
      </div>
    </section>

    <section class="card lower-spec">
      <div class="card-h">
        <span class="lbl">পরিচিতি</span>
        <label class="cmp" id="cmp-wrap" hidden><span class="lbl">বনাম</span>
          <select id="cmp">{bodies.map((b) => <option value={b.id} selected={b.id === (cur.id === 'earth' ? 'mars' : 'earth')}>{b.bn}</option>)}</select>
        </label>
      </div>
      <div class="spec" id="spec">
        {cur.stats.map((s) => (
          <button type="button" class="row" aria-expanded="false">
            <span class="k">{s.k}</span>
            <span class="v">{s.v}</span><span class="v v2" hidden></span>
            <span class="meter"><i style={`--p:${Math.round(s.s * 100)}%`}></i><i class="m2" hidden></i></span>
            <span class="dig" aria-hidden="true">+</span>
          </button>
        ))}
      </div>
    </section>
  </section>
  </div>

  <aside class="info">
    <section class="card read" id="read">
      <div class="card-h">
        <span class="lbl">পড়ো</span>
        <div class="seg" role="group" aria-label="পড়ার গভীরতা">
          {LEVELS.map(([k, l, a]) => <button type="button" data-l={k} aria-pressed={k === 'l1' ? 'true' : 'false'}>{l} <small>{a}</small></button>)}
        </div>
      </div>
      <p class="text" id="b-text">{cur.l1}</p>
      <p class="fun"><span class="lbl">মজার তথ্য</span><span id="b-fun">{cur.fun}</span></p>
    </section>

    {/* মহাকাশ got its first hands-on lab and nothing pointed at it. The other
        ten worlds surface theirs from the category rail; this rail lists
        bodies, not categories, so the link belongs here - directly under the
        reading card, where a child has just finished reading about a planet
        and can go put two of them side by side. */}
    {spaceLab && (
      <a class="card lab-link" href={spaceLab.href}>
        <span class="lbl">হাতে-কলমে</span>
        <b>{spaceLab.n}</b>
        <p>{spaceLab.lede}</p>
        <span class="lab-go">খুলে দেখো →</span>
      </a>
    )}

    {/* The same mission shelf used by every other world. */}
    <MissionPanel world="space" missions={world.missions} missionCats={world.missionCats} shown={4} />

    <section class="card sub" id="subtopic" hidden>
      <div class="card-h"><span class="lbl" id="sub-k">শাখা</span><button type="button" class="x" id="sub-close" aria-label="বন্ধ করো">✕</button></div>
      <p class="text" id="sub-text"></p>
    </section>

    <section class="card">
      <div class="card-h"><span class="lbl">অর্জন</span><span class="lbl num" id="aw-count">০ / {bn(AWARDS.length)}</span></div>
      <div class="awards" id="awards">
        {AWARDS.map((a) => (
          <span class="aw" data-id={awardKey(a, 'space')} title={a.desc}>
            <span class="aw-e" aria-hidden="true">{a.emoji}</span>
            <span class="aw-n">{a.name}</span>
          </span>
        ))}
      </div>
    </section>

  </aside>
</div>

<div class="status card">
  <span class="lbl">কতদূর হলো</span>
  <span class="bar"><i id="log-bar"></i></span>
  <span class="lbl num" id="log-text">০ / {bn(bodies.length)}</span>
</div>

<script is:inline type="application/json" id="space-data" set:html={JSON.stringify(payload)}></script>

<style>
  .xp { display: grid; grid-template-columns: 250px minmax(0, 1fr) 292px; gap: 0.85rem; align-items: start; }
  .xp > * { min-width: 0; }
  .rail { overflow: hidden; }
  .card-h { padding: 0.7rem 0.95rem; border-bottom: 1px solid var(--line-soft); display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }

  /* rail */
  .rail-list { padding: 6px; display: flex; flex-direction: column; gap: 2px; max-height: 640px; overflow-y: auto; }
  .rail-list button { display: flex; align-items: center; gap: 0.7rem; width: 100%; text-align: left; padding: 8px 9px; border-radius: 11px; border-left: 3px solid transparent; transition: background 0.15s ease; }
  .rail-list button:hover { background: var(--panel-2); }
  .rail-list button[aria-current="true"] { background: color-mix(in oklab, var(--o) 13%, var(--panel)); border-left-color: var(--o); }
  /* the body itself, not another identical bead: its own colour behind its own icon */
  .rorb { width: 32px; height: 32px; border-radius: 11px; flex: none; display: grid; place-items: center; font-size: 17px; line-height: 1;
    background: color-mix(in oklab, var(--o) 22%, var(--panel)); border: 1px solid color-mix(in oklab, var(--o) 45%, var(--line)); transition: transform 0.2s ease;
    /* The icon font is monochrome, so the mark takes the body's own colour
       instead of arriving in whatever hue the phone's emoji artist chose -
       the same rule [world]/index.astro applies to its own rail. */
    color: color-mix(in oklab, var(--o) 72%, var(--ink)); }
  .rail-list button:hover .rorb { transform: scale(1.1); }
  .rail-list button.seen .rorb { border-color: var(--ok); box-shadow: 0 0 0 2px color-mix(in oklab, var(--ok) 28%, transparent); }
  .rt { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
  .nm { font-family: var(--font-display); font-weight: 700; font-size: 15px; }
  .tg { font-size: 11.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .no { margin-left: auto; font-size: 10px; }

  /* stage */
  .mid { display: flex; flex-direction: column; gap: 0.85rem; min-width: 0; }
  .stage { display: flex; flex-direction: column; min-height: 620px; overflow: hidden; }
  .stage-h { display: flex; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.4rem 0; flex-wrap: wrap; }
  .stage-h h1 { font-size: clamp(2rem, 4vw, 2.8rem); letter-spacing: -0.01em; line-height: 1.15; font-weight: 800; margin-top: 0.1rem; }
  .tag { color: var(--muted); font-size: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; padding-top: 0.4rem; }
  .scene { position: relative; flex: 1; min-height: min(86vh, 980px); display: grid; place-items: center; overflow: hidden; isolation: isolate;
    background: radial-gradient(ellipse at 50% 42%, color-mix(in oklab, var(--w) 32%, var(--panel-2)) 0%, color-mix(in oklab, var(--paper) 84%, var(--w)) 52%, var(--paper-2) 100%); }
  .scene::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: 0.8;
    background-image: radial-gradient(circle at 12% 20%, color-mix(in oklab, var(--sun) 80%, transparent) 0 1px, transparent 2px), radial-gradient(circle at 78% 24%, color-mix(in oklab, var(--brand) 75%, transparent) 0 1px, transparent 2px), radial-gradient(circle at 64% 70%, color-mix(in oklab, var(--pink) 70%, transparent) 0 1px, transparent 2px), radial-gradient(circle at 28% 78%, color-mix(in oklab, var(--brand) 60%, transparent) 0 1px, transparent 2px); background-size: 170px 150px, 220px 180px, 190px 210px, 240px 190px; }
  .scene::after { content: ''; position: absolute; width: 70%; aspect-ratio: 1; left: 15%; top: 12%; z-index: -1; pointer-events: none; border-radius: 50%; background: color-mix(in oklab, var(--w) 18%, transparent); filter: blur(50px); opacity: 0.45; animation: scene-breathe 7s ease-in-out infinite; }
  @keyframes scene-breathe { 0%,100% { transform: scale(0.92); opacity: 0.28; } 50% { transform: scale(1.08); opacity: 0.55; } }
  .host { position: absolute; inset: 0; cursor: grab; touch-action: none; overflow: hidden; }
  .host.dragging { cursor: grabbing; }
  .host.dragging canvas { filter: saturate(1.18) brightness(1.08); }
  .host canvas { width: 100%; height: 100%; }
  .host :global(.model-fallback) { min-height: 100%; display: grid; place-content: center; gap: 0.45rem; padding: 2rem; text-align: center; color: #eef4fb; }
  .host :global(.model-fallback p) { max-width: 42ch; font-size: 15px; line-height: 1.6; }
  .host :global(.model-fallback p + p) { color: rgba(226, 235, 245, 0.72); font-size: 13.5px; }
  .lesson-cue { position: absolute; top: 52px; left: 12px; right: 12px; z-index: 4; display: flex; align-items: baseline; gap: 0.55rem; width: fit-content; max-width: min(72ch, calc(100% - 24px)); padding: 0.45rem 0.75rem; border-radius: 12px; background: color-mix(in oklab, var(--paper-2) 82%, var(--w)); border: 1px solid color-mix(in oklab, var(--w) 45%, var(--line)); color: var(--ink); font-size: 14px; line-height: 1.45; pointer-events: none; backdrop-filter: blur(6px); box-shadow: 0 8px 24px color-mix(in oklab, var(--paper-2) 65%, transparent); }
  .lesson-cue b { flex: none; color: #ffd76a; }
  .model-note { position: absolute; right: 12px; bottom: 108px; z-index: 3; max-width: 28ch; padding: 0.25rem 0.6rem; border-radius: 8px; background: color-mix(in oklab, var(--paper-2) 78%, var(--w)); color: var(--ink-2); border: 1px solid color-mix(in oklab, var(--w) 30%, var(--line-soft)); font-size: 12px; line-height: 1.4; text-align: right; pointer-events: none; }
  .labels { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .labels :global(.moon-label), .labels :global(.sky-label), .labels :global(.cmp-label) {
    position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); margin-top: -24px;
    display: flex; flex-direction: column; align-items: center; line-height: 1.15; transition: opacity 0.25s ease; will-change: transform; cursor: pointer;
    padding: 3px 10px; border-radius: 999px; background: rgba(9, 14, 24, 0.72); border: 1px solid rgba(255, 255, 255, 0.16); backdrop-filter: blur(4px); white-space: nowrap; }
  .labels :global(.cmp-label) { cursor: default; }
  .labels :global(.moon-label:hover), .labels :global(.sky-label:hover) { border-color: color-mix(in oklab, var(--w) 70%, #fff); background: rgba(9, 14, 24, 0.92); }
  .labels :global(.moon-label b), .labels :global(.sky-label b), .labels :global(.cmp-label b) { font-family: var(--font-display); font-size: 13px; color: #f2f6fb; }
  .labels :global(.moon-label span) { font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(226, 235, 245, 0.62); }
  /* zoom breadcrumb */
  .zoombar { position: absolute; top: 10px; left: 12px; z-index: 3; display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .crumb { font-size: 12.5px; font-weight: 600; color: #e6eef8; background: rgba(9, 14, 24, 0.6); border: 1px solid rgba(255, 255, 255, 0.16); padding: 0.22rem 0.7rem; border-radius: 999px; backdrop-filter: blur(6px); transition: background 0.15s ease; }
  .crumb:hover { background: rgba(9, 14, 24, 0.9); }
  .crumb.cur { background: var(--w); color: #fff; border-color: transparent; }
  .zoombar .sep { color: rgba(226, 235, 245, 0.5); font-size: 12px; }

  /* branch strip revealed by clicking the body */
  .branchbar { position: absolute; left: 0; right: 0; bottom: 0; z-index: 4; padding: 1.6rem 1rem 0.9rem;
    background: linear-gradient(to top, rgba(5, 7, 14, 0.94) 45%, rgba(5, 7, 14, 0.72) 72%, transparent);
    display: flex; flex-direction: column; gap: 0.5rem; }
  .branchbar .lbl { color: rgba(226, 235, 245, 0.66); }
  .branch-chips { display: flex; flex-wrap: wrap; gap: 7px; }
  .branch-chips :global(button) { font-size: 13px; font-weight: 600; padding: 0.35rem 0.85rem; border-radius: 999px; line-height: 1.3;
    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.24); color: #f2f6fb; backdrop-filter: blur(4px);
    transition: transform 0.15s ease, background 0.15s ease; }
  .branch-chips :global(button:hover) { transform: translateY(-1px); background: rgba(255, 255, 255, 0.2); }
  .branch-chips :global(button[aria-pressed="true"]) { background: var(--w); color: #fff; border-color: transparent; }
  .hint { position: absolute; bottom: 104px; left: 50%; transform: translateX(-50%); font-size: 12px; color: #d7e2f0; background: rgba(9, 14, 24, 0.72); padding: 3px 12px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.14); pointer-events: none; transition: opacity 0.4s ease; z-index: 2; }
  .actions { display: flex; justify-content: center; gap: 6px; padding: 0.75rem; border-top: 1px solid var(--line-soft); background: var(--panel-2); }
  .actions button { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1.05rem; border-radius: 999px; font-weight: 700; font-size: 14px; color: var(--ink-2); transition: background 0.15s ease, transform 0.15s ease; }
  .actions button:hover { background: var(--panel); transform: translateY(-1px); }
  .actions button[aria-pressed="true"] { background: var(--brand-soft); color: var(--brand-ink); }
  .actions .primary { background: var(--brand); color: var(--on-brand); }
  .actions .primary:hover { background: var(--brand-ink); }

  /* সৌরজগৎ এক নজরে - the animated comparison chart under the stage */
  .glance { overflow: hidden; }
  .gauto { color: var(--w); transition: opacity 0.3s ease; }
  .gauto[hidden] { display: none; }
  .gseg { display: flex; flex-wrap: wrap; gap: 6px; padding: 0.75rem 1.1rem 0.2rem; }
  .gseg button { font-size: 12.5px; font-weight: 700; padding: 0.28rem 0.8rem; border-radius: 999px; color: var(--ink-2);
    background: var(--panel-2); border: 1px solid var(--line-soft); transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease; }
  .gseg button:hover { transform: translateY(-1px); background: var(--panel); }
  .gseg button[aria-pressed="true"] { background: var(--w); color: #fff; border-color: transparent; }
  .gchart { padding: 0.6rem 1.1rem 0.2rem; display: flex; flex-direction: column; gap: 1px; }
  .grow { display: grid; grid-template-columns: 84px minmax(0, 1fr) auto; align-items: center; column-gap: 0.7rem;
    width: 100%; text-align: left; padding: 0.3rem 0.4rem; border-radius: 8px; transition: background 0.15s ease; }
  .grow:hover { background: color-mix(in oklab, var(--w) 8%, transparent); }
  .grow[aria-current="true"] { background: color-mix(in oklab, var(--o) 14%, transparent); }
  .gn { font-size: 13px; font-weight: 600; color: var(--ink-2); white-space: nowrap; }
  .grow[aria-current="true"] .gn { color: var(--ink); font-weight: 800; }
  .gtrack { display: block; height: 13px; border-radius: 999px; background: var(--sunk); overflow: hidden; }
  .gtrack i { display: block; height: 100%; width: 0; border-radius: 999px;
    background: linear-gradient(90deg, color-mix(in oklab, var(--o) 55%, var(--panel)), var(--o));
    transition: width 0.75s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: calc(var(--i, 0) * 45ms); }
  .gv { font-size: 12.5px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; min-width: 92px; text-align: right; }
  .gv.none { color: var(--muted); font-weight: 500; font-size: 11.5px; white-space: normal; max-width: 210px; line-height: 1.4; }
  .gcap { padding: 0.5rem 1.15rem 0; font-size: 12px; color: var(--muted); line-height: 1.6; }
  .agebox { margin: 0.8rem 1.1rem 1rem; padding: 0.7rem 0.85rem; border-radius: 12px; background: var(--panel-2); border: 1px solid var(--line-soft); }
  .agebox .out { margin-top: 0.3rem; }
  @media (prefers-reduced-motion: reduce) { .gtrack i { transition: none; } }

  /* Wide-column tools: these used to make the sidebar more than twice as tall
     as the stage. A two-column workbench keeps the next lesson section close
     and gives the interactive controls the room they need. */
  .lower-tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.85rem; }
  .lower-tools-h { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: end; gap: 1.25rem; padding: 0.85rem 0.2rem 0.1rem; }
  .lower-tools-h h2 { font-size: clamp(1.35rem, 2.5vw, 1.8rem); margin-top: 0.15rem; }
  .lower-tools-h > p { max-width: 40ch; color: var(--muted); font-size: 13.5px; line-height: 1.65; }
  .lower-tools .card { min-width: 0; overflow: hidden; }
  .lower-tools .lower-spec { grid-column: 1 / -1; }
  .lower-tools .lower-spec .spec { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1rem; }
  .lower-tools .lower-spec .row:nth-last-child(-n + 2) { border-bottom: 0; }

  /* info */
  .info { display: flex; flex-direction: column; gap: 0.85rem; }
  .spec { padding: 0.3rem 0.95rem 0.7rem; }
  .row { display: grid; grid-template-columns: 1fr auto auto; grid-template-rows: auto auto; column-gap: 0.6rem; padding: 0.55rem 0.3rem; border-bottom: 1px solid var(--line-soft); align-items: baseline; width: 100%; text-align: left; border-radius: 8px; transition: background 0.15s ease; }
  .row:last-child { border-bottom: 0; }
  .row:hover { background: color-mix(in oklab, var(--w) 8%, transparent); }
  .row .dig { grid-column: 3; grid-row: 1; font-family: var(--font-mono); font-size: 13px; color: var(--w); width: 14px; text-align: center; transition: transform 0.2s ease; }
  .row[aria-expanded="true"] .dig { transform: rotate(45deg); }
  .row[aria-expanded="true"] { background: color-mix(in oklab, var(--w) 10%, transparent); }
  .spec :global(.dive) { padding: 0.2rem 0.3rem 0.8rem; }
  .spec :global(.dive canvas) { width: 100%; height: 118px; display: block; border-radius: 10px; background: var(--panel-2); border: 1px solid var(--line-soft); }
  .spec :global(.dive p) { margin-top: 0.5rem; font-size: 12.5px; color: var(--ink-2); line-height: 1.6; }
  .sub .text { padding-top: 0.7rem; }
  .mini { font-size: 11px; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid var(--line); color: var(--ink-2); background: var(--panel-2); }
  .mini:hover { background: var(--panel); }
  .mini[aria-pressed="true"] { background: var(--w); color: #fff; border-color: transparent; }
  .size { padding: 0.8rem 0.95rem 0.95rem; }
  .size-bars { display: flex; align-items: flex-end; gap: 0.75rem; height: 84px; margin-bottom: 0.7rem; }
  .size-bars :global(span) { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 10px; color: var(--muted); }
  .size-bars :global(i) { display: block; border-radius: 50%; background: var(--c, var(--w)); }
  .size-out { font-size: 13px; color: var(--ink-2); line-height: 1.65; }
  .size-out :global(b) { color: var(--ink); font-family: var(--font-display); font-size: 15px; }
  /* NOTE: everything below that the script creates at runtime must be :global().
     Astro scopes styles by stamping data-astro-cid onto elements at build time,
     so a JS-created .t or <button> would otherwise match nothing at all. */
  .trav { padding: 0.3rem 0.95rem 0.7rem; }
  .trav :global(.t) { display: flex; justify-content: space-between; gap: 0.6rem; padding: 0.45rem 0; border-bottom: 1px solid var(--line-soft); font-size: 13px; }
  .trav :global(.t:last-child) { border-bottom: 0; }
  .trav :global(.t span) { color: var(--muted); }
  .trav :global(.t b) { font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
  .recs { padding: 0.3rem 0.95rem 0.7rem; }
  .recs :global(button) { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem; width: 100%; text-align: left; padding: 0.45rem 0.3rem; border-radius: 8px; border-bottom: 1px solid var(--line-soft); font-size: 13px; }
  .recs :global(button:last-child) { border-bottom: 0; }
  .recs :global(button:hover) { background: color-mix(in oklab, var(--w) 10%, transparent); }
  .recs :global(button span) { color: var(--muted); font-size: 12px; }
  .recs :global(button b) { font-family: var(--font-display); }
  .recs :global(button.is-cur b) { color: var(--w); }
  .x { font-size: 13px; color: var(--muted); padding: 0 0.2rem; }
  .x:hover { color: var(--ink); }
  .k { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.13em; text-transform: uppercase; color: var(--muted); }
  .v { font-size: 13px; font-weight: 700; text-align: right; grid-column: 2; grid-row: 1; white-space: nowrap; }
  .v2 { color: var(--muted); font-weight: 600; font-size: 12px; }
  .meter { grid-column: 1 / -1; grid-row: 2; display: flex; flex-direction: column; gap: 2px; margin-top: 4px; max-width: 220px; }
  .meter i { display: block; height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--w) var(--p, 0%), var(--sunk) var(--p, 0%)); transition: --p 0.4s ease; }
  .meter i.m2 { background: linear-gradient(90deg, var(--muted) var(--p, 0%), var(--sunk) var(--p, 0%)); }
  .cmp { display: flex; align-items: center; gap: 0.4rem; }
  .cmp select { font: inherit; font-size: 13px; font-weight: 600; padding: 2px 6px; border-radius: 6px; border: 1px solid var(--line); background: var(--panel); color: var(--ink); }
  .seg { display: inline-flex; background: var(--panel-2); border: 1px solid var(--line-soft); border-radius: 999px; padding: 2px; }
  .seg button { padding: 0.2rem 0.6rem; border-radius: 999px; font-weight: 600; font-size: 12px; color: var(--muted); display: flex; gap: 0.25rem; align-items: baseline; }
  .seg button small { font-size: 9.5px; }
  .seg button[aria-pressed="true"] { background: var(--panel); color: var(--ink); box-shadow: var(--shadow-sm); }
  .text { padding: 0.8rem 0.95rem 0.5rem; font-size: 14.5px; color: var(--ink-2); line-height: 1.75; }
  .fun { margin: 0 0.95rem 0.95rem; padding: 0.55rem 0.75rem; border-radius: 10px; background: color-mix(in oklab, var(--sun) 16%, var(--panel)); font-size: 13px; display: flex; flex-direction: column; gap: 0.1rem; }
  .fun .lbl { color: color-mix(in oklab, var(--sun) 60%, var(--ink)); }
  /* player bar */
  .progress-drawer { margin: 0.7rem 1.4rem 0; align-self: flex-start; }
  .progress-drawer summary { cursor: pointer; list-style: none; width: max-content; font-size: 13px; font-weight: 700; color: var(--ink-2); padding: 0.35rem 0.75rem; border: 1px solid var(--line-soft); border-radius: 999px; background: var(--panel-2); }
  .progress-drawer summary::-webkit-details-marker { display: none; }
  .progress-drawer summary::after { content: ' +'; color: var(--w); }
  .progress-drawer[open] summary::after { content: ' −'; }
  .player { position: relative; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin: 0.55rem 0 0; }
  .player > span, .pl-sound { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 12.5px; padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--panel-2); border: 1px solid var(--line-soft); color: var(--ink-2); }
  .player b { font-family: var(--font-display); font-size: 14px; color: var(--ink); }
  .pl-lvl { gap: 0.5rem; }
  .pl-lvl b { color: var(--w); }
  .pl-bar { display: block; width: 64px; height: 5px; border-radius: 3px; background: var(--sunk); overflow: hidden; }
  .pl-bar i { display: block; height: 100%; width: 0; background: var(--w); transition: width 0.6s ease; }
  .pl-sound { cursor: pointer; transition: background 0.15s ease; }
  .pl-sound[aria-pressed="false"] { opacity: 0.55; text-decoration: line-through; }
  .pl-goal { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 12.5px; padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--panel-2); border: 1px solid var(--line-soft); color: var(--ink-2); transition: border-color 0.15s ease, color 0.15s ease; }
  .pl-goal:hover { border-color: var(--w); color: var(--w); }
  .pl-goal.met { background: color-mix(in oklab, var(--w) 14%, var(--panel)); border-color: color-mix(in oklab, var(--w) 40%, var(--line-soft)); color: var(--w); font-weight: 700; }
  .pg { display: inline-flex; gap: 3px; }
  .pg i { width: 7px; height: 7px; border-radius: 50%; background: var(--line); display: block; transition: background 0.25s ease, transform 0.25s ease; }
  .pg i.on { background: var(--w); transform: scale(1.15); }
  .xp-float { position: absolute; left: 0; top: 0; pointer-events: none; font-family: var(--font-display); font-weight: 800; font-size: 15px; color: var(--w); opacity: 0; }
  .xp-float.go { animation: xpfloat 1.1s ease-out forwards; }
  @keyframes xpfloat { 0% { opacity: 0; transform: translateY(6px); } 15% { opacity: 1; } 100% { opacity: 0; transform: translateY(-34px); } }
  .stage { position: relative; }
  .award-toast { position: absolute; top: 84px; left: 50%; transform: translate(-50%, -8px); z-index: 8; font-size: 13.5px; font-weight: 700; color: #1a1408; background: linear-gradient(135deg, #ffe08a, #f0b429); padding: 0.45rem 1rem; border-radius: 999px; box-shadow: 0 8px 24px rgba(0,0,0,.35); opacity: 0; transition: opacity 0.3s ease, transform 0.3s ease; pointer-events: none; }
  .award-toast.show { opacity: 1; transform: translate(-50%, 0); }

  /* awards shelf */
  .awards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 0.7rem 0.95rem 0.95rem; }
  .aw { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 2px; padding: 0.55rem 0.3rem 0.5rem; border-radius: 12px; background: var(--panel-2); border: 1px solid var(--line-soft); color: var(--muted); }
  .aw-e { font-size: 24px; line-height: 1; filter: grayscale(1); opacity: 0.45; transition: filter 0.3s ease, opacity 0.3s ease, transform 0.3s ease; }
  .aw-n { font-size: 11px; font-weight: 700; line-height: 1.25; }
  .aw.on { background: color-mix(in oklab, var(--sun) 16%, var(--panel)); border-color: color-mix(in oklab, var(--sun) 55%, var(--line)); color: var(--ink); }
  .aw.on .aw-e { filter: none; opacity: 1; transform: scale(1.12); }

  /* খোঁজার খেলা, over the cosmos */
  .fx { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; }
  .quest { position: absolute; top: 48px; left: 0; right: 0; z-index: 6; display: flex; flex-direction: column; align-items: center; gap: 0.4rem; pointer-events: none; }
  .q-card { pointer-events: auto; display: grid; grid-template-columns: auto auto; grid-template-rows: auto auto; column-gap: 0.9rem; align-items: center; padding: 0.55rem 0.9rem 0.55rem 1rem; border-radius: 16px; background: rgba(9, 14, 24, 0.86); border: 1px solid rgba(255, 255, 255, 0.2); color: #f4f8fc; backdrop-filter: blur(8px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35); }
  .q-card.shake { animation: shake 0.4s ease; }
  @keyframes shake { 0%, 100% { transform: none; } 20% { transform: translateX(-7px); } 40% { transform: translateX(6px); } 60% { transform: translateX(-4px); } 80% { transform: translateX(3px); } }
  .q-l { color: #cfe0f2; grid-column: 1; }
  .q-target { grid-column: 1; grid-row: 2; display: flex; align-items: center; gap: 0.5rem; }
  .q-emoji { font-size: 28px; line-height: 1; }
  .q-target b { font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; }
  .q-meta { grid-column: 2; grid-row: 2; font-family: var(--font-mono); font-size: 11px; color: rgba(226, 235, 245, 0.75); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .q-x { grid-column: 2; grid-row: 1; justify-self: end; width: 24px; height: 24px; border-radius: 50%; background: rgba(255, 255, 255, 0.12); color: #fff; font-size: 12px; }
  .q-x:hover { background: rgba(255, 255, 255, 0.28); }
  .q-hint { font-size: 12.5px; color: #ffe08a; background: rgba(9, 14, 24, 0.7); padding: 3px 12px; border-radius: 999px; min-height: 1.6em; text-align: center; max-width: 90%; }
  .q-hint:empty { display: none; }
  .q-start { background: linear-gradient(135deg, var(--w), color-mix(in oklab, var(--w) 60%, #f0b429)); color: #fff; }
  .qres { position: absolute; inset: 0; z-index: 7; display: grid; place-items: center; background: rgba(5, 7, 14, 0.62); backdrop-filter: blur(3px); }
  .qres-card { text-align: center; padding: 1.3rem 1.5rem 1.2rem; border-radius: 20px; background: var(--panel); border: 2px solid var(--brand); box-shadow: 6px 6px 0 var(--pink),0 20px 50px rgba(0,0,0,.4); max-width: 92%; width: 380px; animation: qpop 0.45s cubic-bezier(.2,.9,.3,1.3); }
  @keyframes qpop { from { transform: scale(0.7); opacity: 0; } to { transform: none; opacity: 1; } }
  .q-stars { font-size: 34px; letter-spacing: 0.1em; color: var(--sun); line-height: 1.1; margin-top: 0.3rem; }
  .qres-card h3 { font-size: 1.5rem; font-weight: 800; margin-top: 0.2rem; }
  .q-sum { font-size: 13.5px; color: var(--ink-2); line-height: 1.6; margin-top: 0.4rem; }
  .q-btns { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; margin-top: 0.9rem; }
  .q-btns button { font-size: 13px; font-weight: 700; padding: 0.55rem 0.9rem; border-radius: 11px; border: 2px solid #070b2c; background: #f5f3ff; color: #172033; box-shadow: 3px 3px 0 #070b2c; transition: transform 0.15s ease,box-shadow .15s ease; }
  .q-btns button:hover { transform: translateY(-2px); box-shadow: 3px 5px 0 #070b2c; }
  .q-btns .primary { background: var(--sun); color: #101735; border-color: #070b2c; }
  @media (prefers-reduced-motion: reduce) { .q-card.shake, .qres-card { animation: none; } }

  .lab-link {
    display: block; padding: 0.9rem 1.1rem; text-decoration: none;
    border-color: color-mix(in oklab, var(--w) 38%, var(--line));
    background: color-mix(in oklab, var(--w) 8%, var(--panel));
    transition: background 0.16s ease, transform 0.16s ease;
  }
  .lab-link:hover { background: color-mix(in oklab, var(--w) 16%, var(--panel)); transform: translateY(-2px); }
  .lab-link b { display: block; font-size: 17px; font-family: var(--font-display); color: var(--ink); margin: 0.15rem 0 0.25rem; }
  .lab-link p { margin: 0 0 0.5rem; font-size: 13.5px; color: var(--ink-2); line-height: 1.7; }
  .lab-go { font-size: 13px; font-weight: 700; color: var(--brand-ink); }

  /* missions */
  .miss-card { border-color: color-mix(in oklab, var(--w) 30%, var(--line)); }
  .miss { padding: 0.45rem 0.7rem 0.6rem; display: flex; flex-direction: column; gap: 5px; }
  .m { display: flex; gap: 0.7rem; align-items: center; padding: 0.6rem; border-radius: 12px; width: 100%; text-align: left; border: 1px solid var(--line-soft); background: var(--panel-2); }
  .mission-play { cursor: pointer; transition: background 0.18s ease, transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease; }
  .mission-play:hover { transform: translateY(-2px); border-color: color-mix(in oklab, var(--w) 55%, var(--line)); background: color-mix(in oklab, var(--w) 10%, var(--panel)); box-shadow: 0 8px 20px color-mix(in oklab, var(--w) 18%, transparent); }
  .mission-play:hover .m-play { background: var(--w); color: #fff; }
  .mission-play.done { border-color: color-mix(in oklab, var(--sun) 55%, var(--line)); background: color-mix(in oklab, var(--sun) 10%, var(--panel)); }
  .mission-play.done .mb { background: color-mix(in oklab, var(--sun) 25%, var(--panel)); color: color-mix(in oklab, var(--sun) 55%, var(--ink)); border-color: color-mix(in oklab, var(--sun) 50%, var(--line)); }
  .m-t { min-width: 0; flex: 1; }
  .m-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; margin-top: 0.35rem; }
  .m-kind { font-size: 10px; font-weight: 700; padding: 1px 7px; border-radius: 999px; background: color-mix(in oklab, var(--w) 16%, var(--panel)); color: var(--w); }
  .m-len { font-family: var(--font-mono); font-size: 9.5px; color: var(--muted); letter-spacing: 0.04em; }
  .m-hearts { font-size: 10px; color: #e0556a; letter-spacing: 0.08em; }
  .m-vary { font-size: 10px; color: var(--w); font-weight: 700; }
  .m-go { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
  .m-play { font-size: 11.5px; font-weight: 800; padding: 0.22rem 0.6rem; border-radius: 999px; border: 1px solid color-mix(in oklab, var(--w) 45%, var(--line)); color: var(--w); transition: background 0.18s ease, color 0.18s ease; }
  .miss-foot { padding: 0 0.95rem 0.9rem; font-size: 12px; color: var(--muted); line-height: 1.55; }
  .m-soon { opacity: 0.66; border-style: dashed; background: transparent; }
  .try.soon { flex: none; font-weight: 500; color: var(--muted); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; }
  /* the three live calculators sit flat, they are tools rather than games */
  .tools .m { border: 0; border-bottom: 1px solid var(--line-soft); border-radius: 0; background: transparent; padding: 0.6rem 0; }
  .tools .m:last-child { border-bottom: 0; }
  .m:last-child { border-bottom: 0; }
  .mb { width: 26px; height: 26px; border-radius: 8px; flex: none; display: grid; place-items: center; font-family: var(--font-mono); font-size: 10px; background: color-mix(in oklab, var(--w) 18%, var(--panel)); color: var(--w); border: 1px solid color-mix(in oklab, var(--w) 40%, var(--line)); }
  .m b { font-size: 14px; display: block; }
  .out { font-size: 12.5px; color: var(--muted); line-height: 1.5; }
  .out :global(strong) { color: var(--brand-ink); font-size: 15px; }
  .kg { font-size: 12.5px; color: var(--ink-2); display: flex; align-items: center; gap: 0.35rem; margin: 0.25rem 0; }
  .kg input { width: 62px; font: inherit; font-weight: 700; padding: 2px 6px; border-radius: 6px; border: 1px solid var(--line); background: var(--panel-2); color: var(--ink); text-align: center; }

  .status { margin-top: 0.85rem; display: flex; align-items: center; gap: 1rem; padding: 0.65rem 1.1rem; }
  .bar { flex: 1; max-width: 360px; height: 5px; background: var(--sunk); border-radius: 3px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: var(--brand); border-radius: 3px; transition: width 0.5s ease; }

  @media (max-width: 1080px) {
    .xp { grid-template-columns: 1fr; }
    .rail-list { flex-direction: row; overflow-x: auto; max-height: none; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; }
    .rail-list button { width: auto; flex: none; border-left: 0; border-bottom: 3px solid transparent; border-radius: 10px 10px 0 0; scroll-snap-align: start; }
    .rail-list button[aria-current="true"] { border-bottom-color: var(--o); }
    .rail-list .tg, .rail-list .no { display: none; }
    .stage { min-height: 0; }
    .scene { min-height: min(118vw, 560px); }
    .lower-tools { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 460px) {
    .progress-drawer { margin-inline: 1rem; }
    .scene { min-height: min(160vw, 620px); }
    .lesson-cue { top: 48px; font-size: 13.5px; max-height: 4.8em; overflow: hidden; }
    .model-note { left: 12px; right: auto; bottom: 106px; max-width: calc(100% - 24px); text-align: left; }
    .actions { justify-content: flex-start; overflow-x: auto; }
    .actions button { flex: none; min-height: 44px; }
    .grow { grid-template-columns: 66px minmax(0, 1fr) auto; column-gap: 0.5rem; }
    .gn { font-size: 12px; }
    .gv { font-size: 11.5px; min-width: 70px; }
    .lower-tools { grid-template-columns: 1fr; }
    .lower-tools-h, .lower-tools .lower-spec { grid-column: auto; }
    .lower-tools-h { align-items: flex-start; flex-direction: column; gap: 0.35rem; }
    .lower-tools .lower-spec .spec { grid-template-columns: 1fr; }
    .lower-tools .lower-spec .row:nth-last-child(2) { border-bottom: 1px solid var(--line-soft); }
  }
</style>

<script>
  import { bn, bnNum, bnBig, bnDuration, bnOf, bnAt } from '../../lib/bn';
  import { markSeen, getProgress, addXp, grantAward, setMission, setBest, finishTask, todayState } from '../../lib/progress';
  import { levelOf, AWARDS, awardKey, chime, soundOn, setSound, confetti, starsFor, starText, secText } from '../../lib/game';
  import { goalParts, goalMet } from '../../lib/daily';
  import { beginSession, noteItem, noteAct, goalJustMet, reachedMilestone } from '../../lib/session';
  import { track, trackItem, trackDepth, trackPlay } from '../../lib/track';
  import { pad2 } from '../../lib/bn';
  import { lightMinutes, EARTH_DIAMETER_KM, SPEEDS, fitsInside, METRICS, AU_KM, orbitYears, DEFAULT_BODY, type Body, type Branch, type Facts } from '../../data/space';
  import type { CosmosHandle, Level, Pick } from './cosmos';
  import { mountStatViz, kindFor, parseNum, type VizHandle } from './statviz';
  type BodyX = Body & { branches: Branch[]; facts?: Facts };

  const root = document.getElementById('explorer')!;
  const data: BodyX[] = JSON.parse(document.getElementById('space-data')!.textContent!);
  const byId = (id: string) => data.find((b) => b.id === id)!;
  const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const rail = [...root.querySelectorAll<HTMLButtonElement>('.rail-list [data-id]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const WORLD = 'space';

  let cur = byId(root.dataset.current!);
  let level = (localStorage.getItem('posora:level') as 'l1' | 'l2' | 'l3' | null) ?? 'l1';
  let compare = false;
  let cosmos: CosmosHandle | null = null;
  let branchesOpen = false;

  /* ---- 3D: load after first paint so the HTML is readable immediately ---- */
  const host = $('#planet-host');
  import('./cosmos').then(({ mountCosmos }) => {
    cosmos = mountCosmos(host, $('#moon-labels'), data, cur.id, {
      onPick(pk: Pick) {
        if (quest.on) { if (pk.kind === 'body') questPick(pk.id); return; }
        if (pk.kind === 'body') { if (pk.id === cur.id) cosmos?.focusBody(pk.id); else select(pk.id); }
        else if (pk.kind === 'moon') { cosmos?.focusMoon(pk.index); showMoon(pk.index); }
        else toggleBranches(true);
      },
      onLevel(l: Level) { renderCrumbs(l); },
    });
    host.addEventListener('pointerdown', () => { $('#scene-hint').style.opacity = '0'; }, { once: true });
  }).catch(() => {
    const fallback = document.createElement('div'); fallback.className = 'model-fallback';
    const title = document.createElement('p'); title.textContent = 'এই ফোনে থ্রিডি সৌরজগৎ খোলা যায়নি।';
    const help = document.createElement('p'); help.textContent = 'বাঁ পাশের গ্রহের নাম চাপলে তার সব তথ্য, তুলনা আর তিন গভীরতার পাঠ তবু পাওয়া যাবে।';
    fallback.append(title, help); host.replaceChildren(fallback);
  });

  /* ---- zoom breadcrumbs ---- */
  const crumbBody = $('#crumb-body'), crumbMoon = $('#crumb-moon'), crumbSep2 = $('#crumb-sep2'), crumbSystem = $('#crumb-system');
  function renderCrumbs(l: Level, moonName?: string) {
    crumbBody.textContent = cur.bn;
    crumbSystem.classList.toggle('cur', l === 'system');
    crumbBody.classList.toggle('cur', l === 'body');
    crumbMoon.classList.toggle('cur', l === 'moon');
    const showMoonCrumb = l === 'moon';
    crumbMoon.hidden = crumbSep2.hidden = !showMoonCrumb;
    if (moonName) crumbMoon.textContent = moonName;
    $('#scene-hint').textContent = l === 'system' ? 'যেকোনো গ্রহে ক্লিক করো' : l === 'moon' ? 'পিছিয়ে যেতে উপরে গ্রহের নামে চাপো' : 'গ্রহে ক্লিক করো - আরও কাছ থেকে দেখো';
  }

  /* ---- branches: what clicking the body opens up ---- */
  const branchbar = $('#branchbar'), branchChips = $('#branch-chips');
  function renderBranches() {
    branchChips.replaceChildren(...(cur.branches ?? []).map((br) => {
      const b = document.createElement('button');
      b.type = 'button'; b.dataset.br = br.id; b.textContent = br.bn; b.setAttribute('aria-pressed', 'false');
      return b;
    }));
  }
  function toggleBranches(open: boolean) {
    branchesOpen = open && (cur.branches ?? []).length > 0;
    branchbar.hidden = !branchesOpen;
  }
  function openBranch(id: string) {
    const br = (cur.branches ?? []).find((x) => x.id === id); if (!br) return;
    branchChips.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.br === id)));
    $('#sub-k').textContent = br.bn;
    $('#sub-text').textContent = br.text;
    $('#subtopic').hidden = false;
    cosmos?.frame(br.focus, br.moon ?? 0);
    if (br.focus === 'moon') renderCrumbs('moon', cur.moons[br.moon ?? 0]?.bn ?? cur.bn);
    $('#subtopic').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' });
  }
  function showMoon(i: number) {
    const m = cur.moons[i]; if (!m) return;
    $('#sub-k').textContent = `${bnOf(cur.bn)} চাঁদ`;
    $('#sub-text').textContent = `${m.bn} (${m.en}) - ${bnOf(cur.bn)} একটি চাঁদ। ক্যামেরা এখন এর সঙ্গে সঙ্গে ঘুরছে; টেনে চারপাশ থেকে দেখো, ফিরতে উপরে ${bnOf(cur.bn)} নামে চাপো।`;
    $('#subtopic').hidden = false;
    renderCrumbs('moon', m.bn);
  }

  /* ---- every number opens its own animation ---- */
  let openDive: { row: HTMLElement; el: HTMLElement; viz: VizHandle } | null = null;
  function closeDive() { if (openDive) { openDive.viz.destroy(); openDive.el.remove(); openDive.row.setAttribute('aria-expanded', 'false'); openDive = null; } }
  function toggleDive(row: HTMLElement, i: number) {
    const wasOpen = openDive?.row === row;
    closeDive();
    if (wasOpen) return;
    const st = cur.stats[i]; if (!st) return;
    const el = document.createElement('div'); el.className = 'dive';
    const cv = document.createElement('canvas'); const cap = document.createElement('p');
    el.append(cv, cap); row.after(el);
    const viz = mountStatViz(cv, {
      kind: kindFor(st.k), value: parseNum(st.v), s: st.s, bodyName: cur.bn,
      hue: getComputedStyle(document.body).getPropertyValue('--w').trim() || '#5A6BD4',
      gravity: cur.gravity, au: cur.au, k: st.k, v: st.v,
    });
    cap.textContent = viz.caption;
    row.setAttribute('aria-expanded', 'true');
    openDive = { row, el, viz };
  }

  /* ---- big numbers, said the way people say them ---- */
  // both live in lib/bn.ts now, because the server renders these same numbers
  const big = bnBig, dur = bnDuration;

  /* ---- how big is it, really ---- */
  function renderSize() {
    const f = cur.facts; const out = $('#size-out'), bars = $('#size-bars');
    if (!f) { out.textContent = ''; bars.replaceChildren(); return; }
    const rel = f.diameterKm / EARTH_DIAMETER_KM;
    // two circles at true relative scale, capped so the Sun doesn't blow out the card
    const maxPx = 76;
    const bigPx = rel >= 1 ? maxPx : maxPx * rel;
    const smallPx = rel >= 1 ? Math.max(3, maxPx / rel) : maxPx;
    const hue = getComputedStyle(document.body).getPropertyValue('--w').trim() || '#5A6BD4';
    const mk = (px: number, label: string, color: string) => {
      const w = document.createElement('span');
      const i = document.createElement('i');
      i.style.width = i.style.height = `${px}px`; i.style.setProperty('--c', color);
      w.append(i, document.createTextNode(label)); return w;
    };
    bars.replaceChildren(mk(bigPx, cur.bn, hue), mk(smallPx, 'পৃথিবী', '#3f9a4a'));
    const fits = fitsInside(f.diameterKm, EARTH_DIAMETER_KM);
    const line = cur.id === 'earth'
      ? 'এটাই আমাদের বাড়ি - বাকি সবাইকে আমরা এর সঙ্গেই মাপি।'
      : fits >= 1.6
        ? `এর ভেতরে <b>${big(fits)}টা পৃথিবী</b> এঁটে যাবে।`
        : `এর ভেতরে <b>${big(1 / fits)}টা ${cur.bn}</b> নিলে একটা পৃথিবী হয়।`;
    out.innerHTML = `ব্যাস <b>${bnNum(f.diameterKm)} কিমি</b> - পৃথিবীর চেয়ে ${rel >= 1 ? `${bn(rel.toFixed(1))} গুণ বড়` : `${bn((1 / rel).toFixed(1))} গুণ ছোট`}। ${line}`;
  }

  /* ---- how long would it take to get there ---- */
  function renderTravel() {
    const f = cur.facts; const box = $('#trav');
    if (!f || f.nearestKm === 0) {
      $('#trav-dist').textContent = '';
      box.innerHTML = '<div class="t"><span>তুমি তো এখানেই আছো!</span></div>';
      return;
    }
    $('#trav-dist').textContent = `${big(f.nearestKm)} কিমি`;
    box.replaceChildren(...SPEEDS.map((sp) => {
      const row = document.createElement('div'); row.className = 't';
      row.innerHTML = `<span>${sp.bn}</span><b>${dur(f.nearestKm / sp.kmh)}</b>`;
      return row;
    }));
  }

  /* ---- the questions people actually ask, answered from the data ---- */
  const statNum = (b: BodyX, key: string) => {
    const st = b.stats.find((x) => x.k.includes(key));
    return st ? parseNum(st.v) : null;
  };
  function renderRecords() {
    const planets = data.filter((b) => b.id !== 'sun' && b.id !== 'moon' && b.id !== 'pluto');
    const best = (label: string, pick: (list: BodyX[]) => BodyX | undefined, val: (b: BodyX) => string) => {
      const b = pick(planets); return b ? { label, b, val: val(b) } : null;
    };
    const byMax = (f: (b: BodyX) => number | null) => (l: BodyX[]) =>
      l.filter((b) => f(b) !== null).sort((x, y) => (f(y) as number) - (f(x) as number))[0];
    const byMin = (f: (b: BodyX) => number | null) => (l: BodyX[]) =>
      l.filter((b) => f(b) !== null).sort((x, y) => (f(x) as number) - (f(y) as number))[0];
    const dia = (b: BodyX) => b.facts?.diameterKm ?? null;
    const temp = (b: BodyX) => statNum(b, 'তাপমাত্রা');
    const moons = (b: BodyX) => statNum(b, 'চাঁদ');

    const recs = [
      best('সবচেয়ে বড় গ্রহ', byMax(dia), (b) => `${bnNum(b.facts!.diameterKm)} কিমি`),
      best('সবচেয়ে ছোট গ্রহ', byMin(dia), (b) => `${bnNum(b.facts!.diameterKm)} কিমি`),
      best('সবচেয়ে গরম গ্রহ', byMax(temp), (b) => `${bn(temp(b)!)} °সে`),
      best('সবচেয়ে ঠান্ডা গ্রহ', byMin(temp), (b) => `${bn(temp(b)!)} °সে`),
      best('সবচেয়ে বেশি চাঁদ', byMax(moons), (b) => `${bn(moons(b)!)}টি`),
    ].filter(Boolean) as { label: string; b: BodyX; val: string }[];

    $('#recs').replaceChildren(...recs.map((r) => {
      const btn = document.createElement('button');
      btn.type = 'button'; btn.dataset.id = r.b.id;
      btn.classList.toggle('is-cur', r.b.id === cur.id);
      btn.innerHTML = `<span>${r.label}</span><b>${r.b.bn} <small style="font-weight:500;color:var(--muted)">${r.val}</small></b>`;
      return btn;
    }));
  }

  /* ---- সৌরজগৎ এক নজরে: one animated chart, six ways to compare ---- */
  const gseg = [...root.querySelectorAll<HTMLButtonElement>('.gseg [data-m]')];
  const grows = [...root.querySelectorAll<HTMLElement>('.gchart .grow')];
  let metric = 0, autoTimer = 0;

  /** A body either has a plottable number for this metric, or a short honest reason it has none. */
  type MVal = { v: number } | { text: string };
  const NOTE: Record<string, Record<string, string>> = {
    dist:  { sun: 'সৌরজগতের কেন্দ্র', moon: 'পৃথিবীর সঙ্গী' },
    temp:  { sun: '৫,৫০০ °সে - তারা, তাই তুলনার বাইরে' },
    moons: { sun: '৮টি গ্রহ ঘোরে', moon: 'নিজেই একটা চাঁদ' },
    year:  { sun: 'কারও চারপাশে ঘোরে না', moon: 'পৃথিবীর সঙ্গে ৩৬৫ দিন' },
  };
  function metricValue(b: BodyX, id: string): MVal | null {
    const note = NOTE[id]?.[b.id];
    if (note) return { text: note };
    switch (id) {
      case 'dia': return b.facts ? { v: b.facts.diameterKm } : null;
      case 'dist': return b.au ? { v: b.au * AU_KM } : null;
      case 'temp': {
        const st = b.stats.find((x) => x.k.includes('তাপমাত্রা'));
        if (!st) return null;
        // "−১৮০ / +৪৩০" is a day/night range; picking one end and calling it the temperature would be wrong
        if (st.v.includes('/')) return { text: `${st.v.replace('°C', '°সে')} (রাত / দিন)` };
        const t = parseNum(st.v);
        return t === null ? null : { v: t };
      }
      case 'grav': return { v: b.gravity };
      case 'moons': { const n = statNum(b, 'চাঁদ'); return n === null ? null : { v: n }; }
      case 'year': return b.au ? { v: orbitYears(b.au) } : null;
      default: return null;
    }
  }
  function metricLabel(id: string, v: number): string {
    if (id === 'dia' || id === 'dist') return `${big(v)} কিমি`;
    if (id === 'temp') return `${bn(Math.round(v))} °সে`;
    if (id === 'grav') return `${bn(v.toFixed(2))}× পৃথিবী`;
    if (id === 'moons') return `${bn(v)}টি`;
    return v < 1 ? `${bn(Math.round(v * 365))} দিন` : `${bn(v.toFixed(v < 10 ? 1 : 0))} বছর`;
  }
  function renderGlance() {
    const m = METRICS[metric];
    const vals = data.map((b) => metricValue(b, m.id));
    const nums = vals.flatMap((x) => (x && 'v' in x ? [x.v] : []));
    const max = Math.max(...nums), min = Math.min(...nums, 0);
    gseg.forEach((b, i) => b.setAttribute('aria-pressed', String(i === metric)));
    grows.forEach((row, i) => {
      const x = vals[i], bar = row.querySelector<HTMLElement>('.gtrack i')!, out = row.querySelector<HTMLElement>('.gv')!;
      row.style.setProperty('--i', String(i));
      row.setAttribute('aria-current', String(data[i].id === cur.id));
      if (!x || 'text' in x) {
        bar.style.width = '0%'; out.textContent = x ? x.text : 'জানা নেই'; out.classList.add('none');
        return;
      }
      // compressed metrics span orders of magnitude, so a linear bar would hide the small bodies
      const frac = m.compress ? Math.pow(x.v / max, 0.35) : (x.v - min) / (max - min || 1);
      bar.style.width = x.v === 0 ? '0%' : `${Math.max(2, Math.min(100, frac * 100))}%`;
      out.textContent = metricLabel(m.id, x.v); out.classList.remove('none');
    });
    $('#gcap').textContent = m.compress
      ? 'সংখ্যাগুলো এত আলাদা যে বারগুলো চাপা স্কেলে আঁকা, নইলে ছোটগুলো দেখাই যেত না। আসল সংখ্যা ডান পাশে লেখা।'
      : 'এখানে বারের লম্বা সরাসরি সংখ্যার অনুপাতে আঁকা।';
  }
