---
/**
 * One row of the missions card.
 *
 * Pulled out of the world page when a world went from three missions to
 * eleven: the list now folds after the first few, which means the same row has
 * to be rendered in two places. Duplicating the markup is how the two copies
 * quietly drift apart.
 */
import { bn, pad2 } from '../../lib/bn';
import { missionSpec, missionKind, missionLength, varies } from '../../data/missions';

interface Props {
  world: string;
  /** Index into this world's missions - the mission's identity everywhere. */
  i: number;
  n: string;
  d: string;
  cat: number | null;
}
const { world, i, n, d, cat } = Astro.props;
const spec = missionSpec(world, i);
---
{spec ? (
  <button type="button" class="m mission-play" data-mi={i} data-cat={cat ?? ''}>
    <span class="mb">{pad2(i + 1)}</span>
    <div class="m-t">
      <b>{n}</b>
      <p>{d}</p>
      <span class="m-meta">
        <span class="m-kind">{missionKind(spec)}</span>
        <span class="m-len">{`${bn(missionLength(spec)[0])} ${missionLength(spec)[1]}`}</span>
        <span class="m-hearts" aria-hidden="true">♥♥♥</span>
        {varies(spec) && <span class="m-vary" title={`${varies(spec)}, তাই প্রতিবার নতুন খেলা`}>🎲 নতুন</span>}
      </span>
    </div>
    <span class="m-go">
      <span class="m-status" data-mk={`${world}:${i}`}>শুরু করা হয়নি</span>
      <span class="m-play">খেলো <span aria-hidden="true">→</span></span>
    </span>
  </button>
) : (
  <div class="m m-soon">
    <span class="mb">{pad2(i + 1)}</span>
    <div class="m-t"><b>{n}</b><p>{d}</p></div>
    <span class="try soon">শীঘ্রই আসছে</span>
  </div>
)}

<style>
  .m {
    position: relative;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 0.65rem;
    width: 100%;
    padding: 0.72rem;
    overflow: hidden;
    text-align: left;
    color: var(--ink);
    border: 1px solid color-mix(in oklab, var(--w) 24%, var(--line-soft));
    border-radius: 15px;
    background:
      radial-gradient(circle at 100% 0%, color-mix(in oklab, var(--w) 14%, transparent), transparent 46%),
      linear-gradient(145deg, color-mix(in oklab, var(--w) 7%, var(--panel-2)), var(--panel-2));
  }
  .mission-play {
    cursor: pointer;
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .mission-play::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(110deg, transparent 25%, color-mix(in oklab, var(--w) 13%, transparent) 48%, transparent 70%);
    transform: translateX(-110%);
    transition: transform .55s ease;
  }
  .mission-play:hover, .mission-play:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--w) 66%, var(--line));
    box-shadow: 0 9px 22px color-mix(in oklab, var(--w) 17%, transparent);
  }
  .mission-play:hover::after, .mission-play:focus-visible::after { transform: translateX(110%); }
  .mission-play:focus-visible { outline: 3px solid color-mix(in oklab, var(--w) 38%, transparent); outline-offset: 2px; }
  .mb {
    grid-column: 1;
    grid-row: 1 / span 2;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    font: 700 10px/1 var(--font-mono);
    color: var(--w);
    border: 1px solid color-mix(in oklab, var(--w) 44%, var(--line));
    background: color-mix(in oklab, var(--w) 17%, var(--panel));
    box-shadow: inset 0 1px color-mix(in oklab, white 18%, transparent);
  }
  .m-t { grid-column: 2; min-width: 0; }
  .m-t b { display: block; font-family: var(--font-display); font-size: 14px; line-height: 1.25; }
  .m-t p { margin-top: 3px; color: var(--muted); font-size: 11.5px; line-height: 1.45; }
  .m-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; margin-top: 0.48rem; }
  .m-kind, .m-len, .m-hearts, .m-vary { white-space: nowrap; }
  .m-kind { padding: 2px 7px; border-radius: 999px; color: var(--w); background: color-mix(in oklab, var(--w) 14%, var(--panel)); font-size: 9.5px; font-weight: 800; }
  .m-len { color: var(--muted); font: 9px/1.2 var(--font-mono); letter-spacing: .03em; }
  .m-hearts { color: #e35f78; font-size: 9px; letter-spacing: .08em; }
  .m-vary { color: var(--w); font-size: 9.5px; font-weight: 800; }
  .m-go { grid-column: 2; display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; }
  .m-status { color: var(--muted); font-size: 10px; line-height: 1.2; }
  .m-play { flex: none; padding: .28rem .66rem; border-radius: 999px; color: #fff; background: var(--w); font-size: 10.5px; font-weight: 800; box-shadow: 0 3px 0 color-mix(in oklab, var(--w) 45%, #07142b); }
  .mission-play.done { border-color: color-mix(in oklab, var(--ok) 54%, var(--line)); background: linear-gradient(145deg, color-mix(in oklab, var(--ok) 12%, var(--panel-2)), var(--panel-2)); }
  .mission-play.done .mb { color: var(--ok); border-color: color-mix(in oklab, var(--ok) 58%, var(--line)); background: color-mix(in oklab, var(--ok) 15%, var(--panel)); }
  .mission-play.done .m-status { color: var(--ok); font-weight: 800; }
  .m-soon { opacity: .7; border-style: dashed; }
  .m-soon .try { grid-column: 2; color: var(--muted); font: 9px/1.2 var(--font-mono); }
  @media (prefers-reduced-motion: reduce) {
    .mission-play, .mission-play::after { transition: none; }
  }
</style>
