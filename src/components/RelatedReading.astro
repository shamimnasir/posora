---
import { relatedPostsForTopic } from '../data/blog';
import { bn } from '../lib/bn';

interface Props {
  world: string;
  worldName: string;
  category: string;
  items: string[];
  compact?: boolean;
}

const { world, worldName, category, items, compact = false } = Astro.props;
const matches = relatedPostsForTopic(world, category, items);
---

{matches.length > 0 && (
  <aside class:list={['related-reading', { compact }]} aria-label={`${category} বিষয়ে আরও পড়া`}>
    <div class="copy">
      <p class="eyebrow">{matches[0].isOverview ? `${worldName} ভুবনের পরিচিতি` : 'এই বিষয়ের সঙ্গে মিলিয়ে পড়ো'}</p>
      <h3>{matches[0].isOverview ? `${worldName} নিয়ে আরও জানো` : `${category} নিয়ে আরও পড়ো`}</h3>
      {!compact && <p class="hint">{matches[0].isOverview ? 'এই বিভাগ নিয়ে আলাদা লেখা এখনও নেই; আপাতত পুরো ভুবনের পরিচিতি পড়ো।' : `${bn(items.length)}টি বিষয়ের সঙ্গে সম্পর্কিত লেখা ও হাতে-কলমে শেখার সূত্র।`}</p>}
    </div>
    <ul>
      {matches.map(({ post }) => (
        <li><a href={`/blog/${post.slug}/`}>{post.title}<span aria-hidden="true"> →</span></a></li>
      ))}
    </ul>
  </aside>
)}

<style>
  .related-reading { display: grid; grid-template-columns: minmax(180px, .65fr) minmax(0, 1.35fr); gap: .8rem 1.4rem; align-items: center; margin-top: 1.25rem; padding: 1rem 1.15rem; border: 1px solid color-mix(in oklab, var(--w, var(--brand)) 34%, var(--line)); border-radius: 16px; background: color-mix(in oklab, var(--w, var(--brand)) 7%, var(--panel)); }
  .copy h3 { margin: .12rem 0 .2rem; font-size: 1rem; }
  .eyebrow { margin: 0; color: var(--w, var(--brand)); font-size: .72rem; font-weight: 750; letter-spacing: .025em; }
  .hint { margin: 0; color: var(--muted); font-size: .83rem; line-height: 1.55; }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; }
  li { min-width: min(100%, 220px); flex: 1 1 220px; }
  li a { display: block; height: 100%; padding: .7rem .8rem; border-radius: 11px; background: var(--panel); border: 1px solid var(--line-soft); color: var(--ink); font-weight: 650; line-height: 1.45; text-decoration: none; }
  li a:hover { border-color: var(--w, var(--brand)); color: var(--brand-ink); }
  li span { color: var(--w, var(--brand)); white-space: nowrap; }
  .compact { grid-template-columns: 1fr; gap: .5rem; padding: .75rem .9rem; }
  .compact .copy h3 { font-size: .9rem; }
  .compact ul { gap: .4rem; }
  .compact li { flex: 1 1 190px; }
  .compact li a { padding: .55rem .7rem; font-size: .88rem; }
  @media (max-width: 620px) { .related-reading { grid-template-columns: 1fr; } }
</style>
