---
/**
 * One quiet offer card for the adult in the room: a real page from the PDF,
 * what it holds, and the price. It sits below the thing the visitor came for,
 * never inside a game or a reading, and never asks a child for anything.
 *
 * Renders nothing unless the bundle can really be bought. The Android app hides
 * it through the `shop-offer` rule in global.css, because Play does not allow
 * digital goods to be sold there outside its own billing.
 */
import { bundle, digitalPacks, PREVIEW_VERSION } from '../data/digital-packs';
import { digitalPackOnSale } from '../lib/shop';
import { library } from '../lib/pack-files';
import { bn } from '../lib/bn';

interface Props {
  /** Where this card sits; reported as offer_click so placements can be compared. */
  placement: string;
  /** The world this page belongs to, so the card can show that world's pack. */
  world?: string;
}
const { placement, world } = Astro.props;
const pack = world ? digitalPacks.find((p) => p.worldSlug === world) : undefined;
const on = digitalPackOnSale();
const total = on ? (await library()).totalPages : undefined;
const image = pack?.slug ?? 'math-worksheet';
---
{on && (
  <aside class="shop-offer" aria-label="অভিভাবকদের জন্য">
    <a class="page-shot" href="/digital-pack/" data-offer={placement}>
      <img src={`/digital-pack-preview/${image}.png?v=${PREVIEW_VERSION}`} alt={`${pack?.title ?? 'ছাপার বান্ডল'}: PDF-এর আসল পাতার নমুনা`} width="210" height="297" loading="lazy" decoding="async" />
    </a>
    <div class="copy">
      <p class="eyebrow">অভিভাবকদের জন্য</p>
      {pack ? (
        <>
          <h2>এই বিষয়টা এবার কাগজে: {pack.title}</h2>
          <p>{pack.hook}। {bn(pack.pdfPages)} পাতা, তার {bn(pack.workPages)}টিতে লেখার কাজ, শেষে উত্তরপত্র। ১১টি প্যাকের পুরো বান্ডলের সঙ্গে আসে।</p>
        </>
      ) : (
        <>
          <h2>পর্দা বন্ধ করেও শেখা চলুক</h2>
          <p>{total ? `${bn(total)} পাতা` : `${bn(bundle.packs)}টি প্যাক`} ছাপার কাজ: অনুশীলনী, কুইজ, তথ্য-কার্ড, সনদ আর উত্তরপত্র। ঘরে ছেপে নিন, যতবার খুশি।</p>
        </>
      )}
      <a class="btn btn-primary" href="/digital-pack/" data-offer={placement}>নমুনা দেখুন · ৳{bn(bundle.priceBdt)} →</a>
      <small>একবারের দাম · বিকাশে · সঙ্গে সঙ্গে ডাউনলোড</small>
    </div>
  </aside>
)}

<style>
  .shop-offer { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 1rem 1.2rem; align-items: center; padding: 1.1rem 1.2rem; margin-block: 1.5rem; border: 1px solid color-mix(in oklab, var(--brand) 40%, var(--line)); border-radius: 18px; background: color-mix(in oklab, var(--brand) 7%, var(--panel)); }
  .page-shot { display: block; transform: rotate(-2deg); }
  .page-shot img { display: block; width: 100%; height: auto; aspect-ratio: 210 / 297; object-fit: cover; object-position: top; border-radius: 6px; background: #fff; box-shadow: 0 8px 22px rgba(0, 0, 0, .22); }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: .4rem; min-width: 0; }
  .copy .eyebrow { margin: 0; }
  .copy h2 { margin: 0; font-size: 1.2rem; line-height: 1.35; }
  .copy p:not(.eyebrow) { margin: 0; color: var(--ink-2); font-size: 14px; line-height: 1.65; }
  .copy small { color: var(--muted); font-size: 12px; }
  @media (max-width: 480px) { .shop-offer { grid-template-columns: 84px minmax(0, 1fr); padding: 1rem; gap: .8rem; } .copy h2 { font-size: 1.05rem; } }
</style>

{on && <script>
  import { track } from '../lib/track';
  document.querySelectorAll<HTMLElement>('[data-offer]').forEach((el) => {
    el.addEventListener('click', () => track('offer_click', { placement: el.dataset.offer ?? '' }));
  });
</script>}
