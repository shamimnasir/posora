---
/**
 * One written piece.
 *
 * Article schema plus, where the piece has one, an FAQPage - and the FAQ
 * markup is only emitted because the questions and answers are visible on the
 * page in the same words. Structured data that disagrees with the page is
 * worse than none.
 */
import Base from '../../layouts/Base.astro';
import BlogSectionVisual from '../../components/BlogSectionVisual.astro';
import { postBySlug, postsIn, clusterOf, clusterHue, readMinutes, postImage, postImageAlt, CLUSTERS } from '../../data/blog';
import { bn } from '../../lib/bn';
import { POSORA_AUTHOR } from '../../data/authors';

export const prerender = false;

const p = postBySlug(Astro.params.slug!);
if (!p) return Astro.rewrite('/404');
const c = clusterOf(p.cluster);
if (!c) return Astro.rewrite('/404');

Astro.response.headers.set('cache-control', 'public, s-maxage=600, stale-while-revalidate=86400');

const url = new URL(Astro.url.pathname, Astro.site).href;
const siblings = postsIn(p.cluster).filter((x) => x.slug !== p.slug);
// Curated cross-world paths turn each article into a useful next step rather
// than a dead end. Every destination resolves through the live cluster list.
const relatedWorldIds: Record<string, string[]> = {
  physics: ['math', 'discovery', 'space'],
  nature: ['life', 'food', 'discovery'],
  language: ['social', 'discovery'],
  money: ['math', 'social'],
  space: ['physics', 'discovery', 'math'],
  chemistry: ['food', 'nature', 'discovery'],
  life: ['nature', 'food', 'chemistry'],
  food: ['life', 'money', 'nature'],
  math: ['money', 'physics', 'discovery'],
  social: ['language', 'life', 'money'],
  discovery: ['physics', 'nature', 'math'],
};
const relatedWorlds = (relatedWorldIds[p.cluster] ?? [])
  .map((id) => CLUSTERS.find((cluster) => cluster.id === id))
  .filter((cluster): cluster is NonNullable<typeof cluster> => !!cluster);
const relatedArticles = (relatedWorldIds[p.cluster] ?? [])
  .flatMap((id) => postsIn(id).filter((post) => post.slug !== p.slug).slice(0, 1));
const ownWorld = CLUSTERS.find((cluster) => cluster.id === p.cluster)!;
const worldHref = (world: (typeof CLUSTERS)[number]) => `/${world.world}/${world.world === 'space' ? '' : '#all'}`;
const words = (p.featuredAnswer?.length ?? 0) + p.intro.join('').length + p.sections.reduce((s, x) => s + x.h.length + x.p.join('').length + (x.bullets ?? []).join('').length + (x.steps ?? []).join('').length + (x.table?.rows.flat().join('') ?? '').length, 0);
const image = new URL(postImage(p), Astro.site).href;
const imageAlt = postImageAlt(p);
const localRefs = p.refs.filter((r) => r.href.startsWith('/'));
const sourceRefs = p.refs.filter((r) => /^https:\/\//i.test(r.href));

const schema: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': `https://posora.com${POSORA_AUTHOR.profile}#person`,
    name: POSORA_AUTHOR.name,
    url: `https://posora.com${POSORA_AUTHOR.profile}`,
    image: { '@type': 'ImageObject', url: new URL(POSORA_AUTHOR.image, Astro.site).href },
    description: POSORA_AUTHOR.bio,
  },
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: p.title,
    description: p.description,
    url,
    inLanguage: 'bn',
    datePublished: p.updated,
    dateModified: p.updated,
    author: { '@id': `https://posora.com${POSORA_AUTHOR.profile}#person` },
    publisher: { '@id': 'https://posora.com/#org' },
    isPartOf: { '@id': 'https://posora.com/blog/#blog' },
    mainEntityOfPage: { '@id': `${url}#page` },
    isAccessibleForFree: true,
    articleSection: c.n,
    wordCount: Math.round(words / 5.5),
    abstract: p.featuredAnswer,
    image: { '@type': 'ImageObject', url: image, width: 1200, height: 675, caption: imageAlt },
    about: [{ '@type': 'Thing', name: c.n }, { '@type': 'Thing', name: p.title }],
  },
];
if (p.faq?.length) {
  schema.push({
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: p.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---
<Base
  title={p.title}
  description={p.description}
  hue={clusterHue(c)}
  schema={schema}
  image={postImage(p)}
  imageAlt={imageAlt}
  ogType="article"
  crumbs={[
    { name: 'পসরা', url: 'https://posora.com/' },
    { name: 'লেখা', url: 'https://posora.com/blog/' },
  ]}
>
  <article class="wrap page">
    <p class="crumbs"><a href="/">পসরা</a> <span>/</span> <a href="/blog/">লেখা</a> <span>/</span> {c.n}</p>

    <header class="head">
      <p class="eyebrow">{c.n}</p>
      <h1>{p.title}</h1>
      <p class="meta">
        <span>{bn(readMinutes(p))} মিনিট পড়া</span>
        <span>·</span>
        <span>হালনাগাদ <time datetime={p.updated}>{p.updated}</time></span>
      </p>
      <a class="byline" href={POSORA_AUTHOR.profile} rel="author">
        <img src={POSORA_AUTHOR.image} alt={POSORA_AUTHOR.imageAlt} width="48" height="48" loading="eager" decoding="async" />
        <span><small>লেখক</small><b>{POSORA_AUTHOR.name}</b></span>
      </a>
      <section class="featured-answer" aria-labelledby="featured-answer-title">
        <h2 id="featured-answer-title">সরাসরি উত্তর</h2>
        <p>{p.featuredAnswer}</p>
      </section>
      <figure class="cover">
        <img src={postImage(p)} alt={imageAlt} width="1200" height="675" fetchpriority="high" decoding="async" />
      </figure>
      {p.intro.filter((t) => t !== p.featuredAnswer).map((t) => <p class="lede">{t}</p>)}
    </header>

    {p.sections.length > 3 && (
      <nav class="article-map" aria-label="এই লেখার বিষয়বস্তু">
        <b>এই লেখায়</b>
        <ul>{p.sections.map((s, index) => <li><a href={`#section-${index + 1}`}>{s.h}</a></li>)}</ul>
      </nav>
    )}

    {p.faq?.[0] && (
      <details class="quick-check">
        <summary><span>🧠</span><span><b>পড়তে পড়তে নিজেকে যাচাই করো</b><small>{p.faq[0].q}</small></span><span class="check-toggle">উত্তর দেখো</span></summary>
        <div class="check-answer"><b>ভাবনার সূত্র</b><p>{p.faq[0].a}</p></div>
      </details>
    )}

    {p.sections.map((s, index) => (
      <section class="sec" id={`section-${index + 1}`}>
        <h2>{s.h}</h2>
        {s.image && (
          <figure class="section-art">
            <img src={s.image.src} alt={s.image.alt} width="1200" height="560" loading="lazy" decoding="async" />
            {s.image.caption && <figcaption>{s.image.caption}</figcaption>}
          </figure>
        )}
        {!s.image && <BlogSectionVisual section={s} postSlug={p.slug} cluster={p.cluster} index={index} hue={clusterHue(c)} />}
        {s.p.map((t) => <p>{t}</p>)}
        {s.bullets && <ul class="article-list">{s.bullets.map((item) => <li>{item}</li>)}</ul>}
        {s.steps && <ol class="article-steps">{s.steps.map((item) => <li>{item}</li>)}</ol>}
        {s.table && (
          <div class="table-wrap" role="region" aria-label={s.table.caption} tabindex="0">
            <table>
              <caption>{s.table.caption}</caption>
              <thead><tr>{s.table.headers.map((head) => <th scope="col">{head}</th>)}</tr></thead>
              <tbody>{s.table.rows.map((row) => <tr>{row.map((cell, cellIndex) => cellIndex === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
            </table>
          </div>
        )}
      </section>
    ))}

    {p.faq && p.faq.length > 0 && (
      <section class="sec faq">
        <h2>সংক্ষেপে কিছু প্রশ্ন</h2>
        {p.faq.map((f) => (
          <div class="q">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </section>
    )}

    {localRefs.length > 0 && <section class="sec refs">
      <h2>এবার নিজে নেড়ে দেখো</h2>
      <div class="ref-list">
        {localRefs.map((r) => (
          <a class="ref" href={r.href}>
            <b>{r.label}</b>
            <span>{r.note}</span>
          </a>
        ))}
      </div>
    </section>}

    {sourceRefs.length > 0 && <section class="sec sources" aria-labelledby="sources-title">
      <h2 id="sources-title">আরও যাচাই করে পড়ো</h2>
      <p>নিচের সূত্রগুলো বিষয়টি আরও গভীরভাবে বুঝতে সাহায্য করবে। জরুরি, স্বাস্থ্য বা নিরাপত্তার সিদ্ধান্তে প্রযোজ্য স্থানীয় সরকারি নির্দেশও দেখো।</p>
      <ul>{sourceRefs.map((r) => <li><a href={r.href} target="_blank" rel="noopener noreferrer"><b>{r.label}</b></a><span> — {r.note}</span></li>)}</ul>
    </section>}

    <aside class="author-card" aria-label="লেখক পরিচিতি">
      <a href={POSORA_AUTHOR.profile} class="author-photo"><img src={POSORA_AUTHOR.image} alt={POSORA_AUTHOR.imageAlt} width="112" height="112" loading="lazy" decoding="async" /></a>
      <div><p class="eyebrow">লেখক সম্পর্কে</p><h2><a href={POSORA_AUTHOR.profile}>{POSORA_AUTHOR.name}</a></h2><p>{POSORA_AUTHOR.bio}</p><a class="author-more" href={POSORA_AUTHOR.profile}>লেখকের পরিচিতি ও সম্পাদনা-নীতি →</a></div>
    </aside>

    <section class="sec next-steps" aria-labelledby="next-title">
      <p class="eyebrow">এবার হাতে-কলমে</p>
      <h2 id="next-title">এই পড়া থেকে পরের ধাপে যাও</h2>
      <p>লেখায় ধারণাটা বুঝে নাও, তারপর পসরা ভুবনে বিষয়টি খুঁজে দেখো বা কাছের আরেকটি বিষয় শেখো।</p>
      <div class="next-grid">
        <a class="next-card primary-next" href={worldHref(ownWorld)}>
          <span>এই লেখার বিষয়</span><b>{ownWorld.n} ভুবন</b><small>বিভাগ ধরে বিষয় দেখো এবং মডেলে খুঁজে নাও →</small>
        </a>
        {relatedWorlds.slice(0, 3).map((world) => (
          <a class="next-card" href={worldHref(world)}>
            <span>সম্পর্কিত ভুবন</span><b>{world.n}</b><small>আরও জানো ও হাতে-কলমে দেখো →</small>
          </a>
        ))}
      </div>
      {siblings.length > 0 && (
        <div class="related-reading">
          <h3>এই বিষয়ের আরও লেখা</h3>
          <ul class="more">{siblings.slice(0, 3).map((s) => <li><a href={`/blog/${s.slug}/`}>{s.title}</a></li>)}</ul>
        </div>
      )}
      {relatedArticles.length > 0 && (
        <div class="related-reading">
          <h3>পাশের ভুবনের লেখা</h3>
          <ul class="more">{relatedArticles.slice(0, 3).map((post) => <li><a href={`/blog/${post.slug}/`}>{post.title}</a></li>)}</ul>
        </div>
      )}
    </section>

    <p class="back"><a href="/blog/">← সব লেখা</a> · <a href={worldHref(ownWorld)}>{c.n} ভুবনে যাও</a></p>
  </article>
</Base>

<style>
  .page { padding-block: 1rem 3rem; max-width: 74ch; }
  .crumbs { font-size: 13px; color: var(--muted); margin-bottom: 0.75rem; }
  .crumbs span { margin: 0 0.35rem; }
  .head { padding-bottom: 1.3rem; border-bottom: 1px solid var(--line-soft); margin-bottom: 1.6rem; }
  .head h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin: 0.2rem 0 0.5rem; line-height: 1.35; }
  .meta { display: flex; gap: 0.5rem; font-family: var(--font-mono); font-size: 11.5px; color: var(--muted); margin-bottom: 1rem; }
  .byline { display: inline-flex; align-items: center; gap: .65rem; margin: -.15rem 0 1rem; text-decoration: none; }
  .byline img { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; border: 2px solid color-mix(in oklab, var(--w) 65%, white); }
  .byline span { display: grid; gap: .1rem; }
  .byline small { color: var(--muted); font-size: 11px; }
  .byline b { color: var(--brand-ink); font-size: 13px; }
  .featured-answer { margin: 0 0 1.1rem; padding: 1rem 1.1rem; border: 1px solid color-mix(in oklab, var(--w) 42%, var(--line)); border-left: 4px solid var(--w); border-radius: 14px; background: color-mix(in oklab, var(--w) 11%, var(--panel)); }
  .featured-answer h2 { margin: 0 0 .35rem; color: var(--brand-ink); font-size: 15px; }
  .featured-answer p { margin: 0; color: var(--ink); font-size: 16px; line-height: 1.85; }
  .cover { margin: 0 0 1.2rem; overflow: hidden; border-radius: 18px; border: 1px solid var(--line-soft); background: var(--panel); aspect-ratio: 16 / 9; }
  .cover img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .lede { color: var(--ink-2); font-size: 16px; line-height: 1.9; margin-bottom: 0.8rem; }
  /* The site-wide .sec rule is for spacious landing-page bands. In an article
     it adds up to 11rem of vertical padding per section, which looks like
     missing content between paragraphs. Keep reading rhythm compact here. */
  .sec { padding-block: 0; margin-bottom: 1.45rem; }
  .article-map, .quick-check { margin: 1rem 0 1.2rem; padding: .9rem 1rem; border: 1px solid color-mix(in oklab, var(--w) 32%, var(--line)); border-radius: 16px; background: color-mix(in oklab, var(--w) 6%, var(--panel)); }
  .article-map > b { color: var(--brand-ink); }
  .article-map ul { display: flex; flex-wrap: wrap; gap: .35rem .9rem; padding: 0; margin: .45rem 0 0; list-style: none; }
  .article-map a { font-size: 13px; text-underline-offset: 3px; }
  .quick-check summary { display: flex; align-items: center; gap: .7rem; cursor: pointer; list-style: none; }
  .quick-check summary::-webkit-details-marker { display: none; }
  .quick-check summary > span:nth-child(2) { display: grid; gap: .2rem; flex: 1; }
  .quick-check summary b { color: var(--brand-ink); font-size: 14px; }
  .quick-check summary small { color: var(--ink-2); font-size: 13px; line-height: 1.6; }
  .check-toggle { border: 1px solid var(--line); border-radius: 999px; padding: .35rem .65rem; color: var(--brand-ink); font-size: 12px; white-space: nowrap; }
  .quick-check[open] .check-toggle { display: none; }
  .check-answer { margin: .75rem 0 0 2.2rem; padding: .7rem .85rem; border-left: 3px solid var(--w); background: color-mix(in oklab, var(--w) 9%, var(--panel)); border-radius: 0 10px 10px 0; }
  .check-answer > b { color: var(--brand-ink); font-size: 13px; }
  .check-answer p { margin: .2rem 0 0; }
  .article-list, .article-steps { padding-left: 1.35rem; color: var(--ink-2); line-height: 1.85; font-size: 15px; }
  .article-list li, .article-steps li { padding-left: .2rem; margin: .35rem 0; }
  .table-wrap { max-width: 100%; overflow-x: auto; margin: .85rem 0 1rem; border: 1px solid var(--line-soft); border-radius: 13px; background: var(--panel); }
  table { width: 100%; border-collapse: collapse; min-width: 440px; font-size: 14px; line-height: 1.65; }
  caption { padding: .7rem .8rem; text-align: left; color: var(--brand-ink); font-weight: 700; }
  th, td { padding: .6rem .75rem; text-align: left; vertical-align: top; border-top: 1px solid var(--line-soft); }
  thead th { color: var(--ink); background: color-mix(in oklab, var(--w) 11%, var(--panel)); }
  tbody th { color: var(--ink); font-weight: 650; }
  td { color: var(--ink-2); }
  .sources ul { padding-left: 1.2rem; line-height: 1.8; color: var(--ink-2); }
  .sources li { margin: .4rem 0; }
  .author-card { display: grid; grid-template-columns: 88px minmax(0,1fr); align-items: center; gap: 1rem; margin: 1.8rem 0; padding: 1rem; border: 1px solid color-mix(in oklab, var(--w) 35%, var(--line)); border-radius: 18px; background: color-mix(in oklab, var(--w) 6%, var(--panel)); }
  .author-photo img { display: block; width: 88px; height: 88px; object-fit: cover; border-radius: 50%; border: 2px solid color-mix(in oklab, var(--w) 55%, white); }
  .author-card .eyebrow { margin: 0 0 .1rem; }
  .author-card h2 { margin: 0 0 .3rem; font-size: 17px; }
  .author-card h2 a { text-decoration: none; }
  .author-card p:not(.eyebrow) { margin: 0 0 .35rem; color: var(--ink-2); font-size: 13.5px; line-height: 1.7; }
  .author-more { color: var(--brand-ink); font-size: 12px; font-weight: 700; }
  .section-art { margin: 1rem 0 1.15rem; overflow: hidden; border: 1px solid var(--line-soft); border-radius: 18px; background: color-mix(in oklab, var(--w) 6%, var(--panel)); }
  .section-art img { display: block; width: 100%; height: auto; aspect-ratio: 15 / 7; object-fit: cover; }
  .section-art figcaption { padding: 0.55rem 0.8rem 0.65rem; color: var(--muted); font-size: 12px; line-height: 1.65; }
  .sec h2 {
    font-size: 20px; margin: 0 0 0.7rem; padding-left: 0.7rem;
    border-left: 3px solid color-mix(in oklab, var(--w) 65%, var(--line));
  }
  .sec p { font-size: 15.5px; line-height: 1.95; color: var(--ink-2); margin-bottom: 0.75rem; }
  .faq .q { padding: 0.7rem 0; border-bottom: 1px solid var(--line-soft); }
  .faq h3 { font-size: 16px; margin: 0 0 0.3rem; color: var(--ink); }
  .faq p { margin: 0; }
  .ref-list { display: grid; gap: 0.5rem; }
  .ref {
    display: block; padding: 0.75rem 1rem; border-radius: 12px;
    border: 1px solid color-mix(in oklab, var(--w) 30%, var(--line));
    background: color-mix(in oklab, var(--w) 7%, var(--panel));
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .ref:hover { background: color-mix(in oklab, var(--w) 15%, var(--panel)); transform: translateY(-1px); }
  .ref b { display: block; font-size: 15.5px; color: var(--brand-ink); }
  .ref span { font-size: 13.5px; color: var(--ink-2); line-height: 1.7; }
  .more { margin: 0; padding-left: 1.1rem; }
  .more li { margin-bottom: 0.35rem; font-size: 15px; }
  .next-steps { padding: 1.2rem; border: 1px solid color-mix(in oklab, var(--w) 35%, var(--line)); border-radius: 20px; background: color-mix(in oklab, var(--w) 7%, var(--panel)); }
  .next-steps > h2 { margin: .25rem 0 .4rem; font-size: 1.35rem; }
  .next-steps > p:not(.eyebrow) { color: var(--ink-2); line-height: 1.7; }
  .next-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; margin-top: 1rem; }
  .next-card { min-width: 0; display: flex; flex-direction: column; gap: .28rem; padding: .9rem; border: 1px solid var(--line-soft); border-radius: 14px; background: var(--panel); text-decoration: none; transition: transform .15s ease, border-color .15s ease; }
  .next-card:hover, .next-card:focus-visible { transform: translateY(-2px); border-color: var(--w); }
  .next-card > span, .next-card small { color: var(--muted); font-size: 12px; line-height: 1.5; }
  .next-card b { color: var(--brand-ink); font-size: 15px; }
  .primary-next { border-color: color-mix(in oklab, var(--w) 45%, var(--line)); }
  .related-reading { margin-top: 1.2rem; padding-top: .8rem; border-top: 1px solid var(--line-soft); }
  .related-reading h3 { margin: 0 0 .45rem; font-size: 15px; }
  .back { margin-top: 1.6rem; font-size: 14px; color: var(--muted); }
  @media (max-width: 540px) { .next-steps { padding: .9rem; } .next-grid { grid-template-columns: 1fr; } .quick-check summary { align-items: flex-start; } .check-toggle { font-size: 11px; } .author-card { grid-template-columns: 64px minmax(0,1fr); gap: .7rem; padding: .8rem; } .author-photo img { width: 64px; height: 64px; } }
</style>
