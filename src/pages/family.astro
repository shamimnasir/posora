<script>
  import { track, trackShop } from '../lib/track';

  const shopItem = document.getElementById('shop-item')!.dataset;
  trackShop('view_item', { id: shopItem.item ?? '', name: shopItem.name ?? '', price: Number(shopItem.price) });

  const form = document.getElementById('fform') as HTMLFormElement;
  const msg = document.getElementById('fmsg')!;
  const btn = form.querySelector('button')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const get = (k: string) => String(fd.get(k) ?? '').trim();
    const person = get('person'), contact = get('contact');
    const place = get('place'), ages = get('ages'), message = get('message');

    if (person.length < 2 || contact.length < 5 || message.length < 5) {
      msg.className = 'msg err';
      msg.textContent = 'নাম, যোগাযোগ আর কোন জিনিসটা আগে দরকার - তিনটিই লাগবে।';
      return;
    }

    btn.disabled = true;
    msg.className = 'msg';
    msg.textContent = 'পাঠানো হচ্ছে...';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          topic: 'family',
          name: person,
          contact,
          message: `কোথায়: ${place || 'বলা হয়নি'}\nসন্তানের বয়স: ${ages || 'বলা হয়নি'}\n\n${message}`,
          website: get('website'),
        }),
      });
      const data = (await res.json()) as { ok?: boolean; error?: string };
      if (data.ok) {
        form.reset();
        msg.className = 'msg ok';
        msg.textContent = 'নাম উঠে গেছে। ব্যবস্থা হলে আমরাই আপনাকে লিখব - তার আগে কোনো ইমেইল পাঠাবো না।';
        track('family_waitlist');
        return;
      }
      msg.className = 'msg err';
      msg.textContent = data.error === 'email-unavailable'
        ? 'ফর্মটা এই মুহূর্তে কাজ করছে না। সরাসরি support@posora.com-এ লিখুন।'
        : 'পাঠানো গেল না। আরেকবার চেষ্টা করুন, বা support@posora.com-এ লিখুন।';
    } catch {
      msg.className = 'msg err';
      msg.textContent = 'ইন্টারনেট ধরা যাচ্ছে না। আরেকবার চেষ্টা করুন, বা support@posora.com-এ লিখুন।';
    } finally {
      btn.disabled = false;
    }
  });
</script>
