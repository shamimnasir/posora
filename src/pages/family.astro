---
/**
 * পসরা পরিবার - the family plan offer page.
 *
 * This is the page that talks about money, so the honesty rules bind hardest
 * here. Three things are kept true on purpose:
 *
 *  1. A year is sold as one bKash payment with no automatic renewal, and the
 *     page says so beside the button. When bKash is not live the button becomes
 *     the waiting list. Families abroad use the list too, until there is a way
 *     to take a card.
 *  2. Every line in the stack is marked আছে or হবে. A reader can tell at a
 *     glance which half of the offer exists today.
 *  3. The comparison prices are real, published prices of real alternatives,
 *     not invented "value" numbers. No struck-through fake retail price.
 *
 * The scarcity is a genuine cap the founder can honour, not a countdown.
 */
import Base from '../layouts/Base.astro';
import BuyBar from '../components/BuyBar.astro';
import { totals, worlds } from '../data/worlds';
import { bn, bnNum } from '../lib/bn';
import { COVERAGE } from '../lib/coverage';
import { sheets } from '../data/printables';
import { bundle as digitalBundle } from '../data/digital-packs';
import { catDetail, isReadable } from '../lib/explorers';
import { buildWorksheet } from '../lib/worksheet';
import { digitalPackOnSale, digitalPackReady, familyOnSale, DIGITAL_PACK_AMOUNT, FAMILY_AMOUNT, FAMILY_PRODUCT, FAMILY_REFUND_DAYS } from '../lib/shop';

export const prerender = false;
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');

// Worksheet counts are computed the same way /[world]/pack/ builds them, so
// the offer cannot drift from what the pack actually prints.
const ws = { worlds: 0, cats: 0, blanks: 0, matches: 0 };
for (const w of worlds) {
  if (w.open) continue;
  let any = false;
  w.cats.forEach((c, i) => {
    if (!isReadable(w, i)) return;
    const d = catDetail(w.slug, i);
    if (!d) return;
    const sheet = buildWorksheet(w.slug, i, c.items, d);
    if (!sheet) return;
    any = true; ws.cats++; ws.blanks += sheet.blanks.length; ws.matches += sheet.matchKey.length;
  });
  if (any) ws.worlds++;
}

const FOUNDING_SEATS = 100;
const KIDS = 6;

/** One membership, one price, for the whole family. The amount lives in shop.ts. */
const YEARLY_BDT = FAMILY_AMOUNT;
const YEARLY_USD = 39;
const perDay = (yearly: number) => (yearly / 365).toFixed(1);
const buyable = familyOnSale();
const buyHref = buyable ? '/digital-pack/checkout/?plan=family' : '#join';

/**
 * The stack.
 *
 * `have` is three-valued on purpose. The weekly letter is written, scheduled
 * and deployed, but no letter has ever actually reached an inbox, because
 * production had no paying family until now. Calling that "আজই চালু" would be
 * a claim the logs do not support, and calling it "বানানো হয়নি" is simply
 * false. On the page that asks for money, the honest answer is the third one.
 */
type Have = true | false | 'testing';
const stack: { t: string; d: string; have: Have }[] = [
  { have: true,  t: `${bn(COVERAGE.readable)}টি বিষয়ের পুরো পাঠ, তিন গভীরতায়`, d: `${bn(COVERAGE.labs)}টি হাতে-কলমে ল্যাব আর ${bn(COVERAGE.missions)}টি খেলার মিশন আছে। মহাকাশ, পদার্থ, রসায়ন, প্রাণিজগৎ, প্রকৃতি, খাদ্য, গণিত, টাকা, ভাষা, সামাজিক দক্ষতা, আবিষ্কার - একই লেখা ছোট, মাঝারি আর বড়, তাই পাঁচ বছরের আর তেরো বছরের সন্তান একই পাতায় বসতে পারে।` },
  { have: true,  t: `${bn(COVERAGE.cats)}টি বিভাগে জীবন্ত থ্রিডি মডেল`, d: 'ঢালু তল, দোলক, কেলাস, ঋতুচক্র, বর্ণমালা - টেনে ঘোরানো যায়, স্লাইডারে বদলায়। ভিডিও নয়, সত্যিকারের চালু মডেল।' },
  { have: true,  t: 'যেকোনো বিভাগ এক চাপে ছেপে নেওয়া', d: '“ছাপাও” চাপলেই পুরো বিভাগ কাগজে নেমে আসে - মডেল আর মেনু বাদ দিয়ে, আপনার বেছে নেওয়া গভীরতায়।' },
  { have: true,  t: `${bn(sheets.length)}টি ছাপার শিট`, d: 'বর্ণমালার হাতের লেখা, যুক্তবর্ণ ভাঙা চার্ট, কার চিহ্ন, সংখ্যা ০-১০০, সৌরজগৎ তথ্যপত্র, টাকা চেনা।' },
  { have: true,  t: `${bn(KIDS)} জন সন্তান পর্যন্ত, প্রত্যেকের নিজের প্রোফাইল`, d: 'নিজের নাম, নিজের বয়স, নিজের গভীরতা। ভাইবোন আর যে কাজিন ট্যাবটা ভাগ করে নেয় - সবার জায়গা হবে।' },
  { have: true,  t: 'যেকোনো ডিভাইসে অগ্রগতি', d: 'বাসার ফোন, স্কুলের ল্যাপটপ, দাদুর বাড়ির ট্যাব - একই সন্তানের হিসাব সব জায়গায় মিলে যায়। প্ল্যান ছাড়া হিসাবটা এক ব্রাউজারেই থাকে।' },
  { have: 'testing', t: 'প্রতি সপ্তাহে অভিভাবকের ইমেইল', d: 'কে কত দিন এসেছে, কী কী খুলেছে, কটা যাচাই দিয়েছে - আর রাতের খাবারে জিজ্ঞেস করার মতো কয়েকটা প্রশ্ন। যে সপ্তাহে কিছুই হয়নি, সে সপ্তাহে কোনো চিঠি যায় না।' },
  { have: true,t: 'যাচাই ও সার্টিফিকেট', d: 'প্রতি বিভাগের শেষে আটটি প্রশ্ন, পড়ার লেখা থেকেই বানানো, ফল সন্তানের নামে জমা থাকে। সব বিষয় দেখা আর সব যাচাই পাশ হলে ভুবনের সার্টিফিকেট, নাম-তারিখ সহ, ছাপার মতো।' },
  { have: true,t: 'অনুশীলনী প্যাক', d: `${bn(ws.worlds)}টি ভুবনের ${bn(ws.cats)}টি বিভাগের ছাপার অনুশীলনী - ${bn(ws.blanks)}টি শূন্যস্থান আর ${bn(ws.matches)}টি মিলানো, উত্তরপত্র আলাদা পাতায়। এক ভুবনের পুরোটা এক চাপে ছাপানো যায়, আগে সব প্রশ্ন তারপর সব উত্তর।` },
  { have: digitalPackReady(), t: 'সব-ডাউনলোড বান্ডল সঙ্গে', d: `আলাদা কিনলে যেটার দাম ৳${bn(DIGITAL_PACK_AMOUNT)}: ১১টি ভুবনের অনুশীলনী প্যাক, তথ্য-কার্ড, অনুশীলনী, কুইজ, উত্তরপত্র আর সনদ, PDF আর ZIP-এ, ফোন বা কম্পিউটারে নামিয়ে রাখার মতো।` },
  { have: false, t: 'পর্দা ছাড়া কার্ড', d: 'প্রতি বিষয়ে একটা কাজ যা পর্দা ছাড়াই করা যায় - ছায়া মাপা, ডিম ভাসানো, গাছের বয়স গোনা।' },
  { have: false, t: 'অফলাইন প্যাক', d: 'ইন্টারনেট দুর্বল হলেও মডেলগুলো চলবে। গ্রামের স্কুল আর যাত্রাপথের জন্য।' },
  { have: false, t: 'দাদু-দিদার সঙ্গে', d: 'প্রতি বিষয়ে একটা প্রশ্ন, যেটা সন্তান বাংলায় দাদু-দিদাকে জিজ্ঞেস করবে। দেশের বাইরের পরিবারের জন্য এটাই আসল কারণ।' },
];

const haveCount = stack.filter((s) => s.have === true).length;
const nowItems = stack.filter((s) => s.have !== false);
const nextItems = stack.filter((s) => s.have === false);

const onSale = digitalPackOnSale();
const faqs = [
  { q: 'টাকা কীভাবে দেব?', a: buyable ? `বিকাশে, একবারে ৳${bnNum(YEARLY_BDT)}। পেমেন্টের সঙ্গে সঙ্গে প্ল্যান চালু হয়। ইমেইল ছাড়া আর কিছু দিতে হয় না, কার্ডও লাগে না।` : 'পেমেন্ট চালু হওয়ার আগে কিছু দিতে হবে না। নিচের তালিকায় নাম লেখালে আমরা জানাব।' },
  { q: 'বছর শেষে নিজে থেকে টাকা কাটবে?', a: 'না। এটা একবারের পেমেন্ট। মেয়াদ শেষ হলে আপনি আবার নিলে তবেই চলবে, আগে নিলে বাকি দিনগুলোও যোগ হয়ে যায়।' },
  { q: 'কিনে ভালো না লাগলে?', a: `পুরো টাকা ফেরত। পেমেন্টের ${bn(FAMILY_REFUND_DAYS)} দিনের মধ্যে এক লাইন লিখলেই হবে, কারণ জানতে চাইব না।` },
  { q: 'ডাউনলোড বান্ডল আর পরিবার প্ল্যানের পার্থক্য কী?', a: `ডাউনলোড বান্ডল ৳${bn(DIGITAL_PACK_AMOUNT)}-এর একবারের কেনা: ১১টি ভুবনের ছাপার PDF ও ZIP, কোনো অ্যাকাউন্ট সুবিধা ছাড়া। পরিবার প্ল্যানে সন্তানের প্রোফাইল, অগ্রগতির হিসাব, যাচাই ও সনদ আছে, আর এই পুরো বান্ডলও তার ভেতরে। তাই প্ল্যান নিলে বান্ডল আলাদা কিনতে হয় না।` },
  { q: 'যেগুলো এখন ফ্রি, সেগুলো কি পরে টাকার পেছনে চলে যাবে?', a: `না, কখনো না। আজ যে ${bn(COVERAGE.total)}টি বিষয়, থ্রিডি মডেল আর ছাপার শিট ফ্রি, সেগুলো ফ্রিই থাকবে - ${bn(COVERAGE.readable)}টি বিষয়ের পাঠ, ${bn(COVERAGE.labs)}টি হাতে-কলমে ল্যাব আর ${bn(COVERAGE.missions)}টি মিশনসহ। পরিবার প্ল্যান বিক্রি করে সেগুলোর চারপাশের জিনিস - প্রোফাইল, রিপোর্ট, অনুশীলনী।` },
  { q: 'সন্তানের কোনো তথ্য নেবেন?', a: 'সন্তানের কোনো অ্যাকাউন্ট থাকবে না। অ্যাকাউন্ট থাকবে শুধু অভিভাবকের। সন্তানের জন্য যা লাগবে তা হলো আপনার দেওয়া একটা ডাকনাম আর একটা স্তর - নাম-ঠিকানা, ছবি, ইমেইল কিছুই নয়।' },
  { q: 'দেশের বাইরে থাকি, টাকা দেব কীভাবে?', a: 'এখন পেমেন্ট শুধু বিকাশে। কার্ডে ডলারে নেওয়ার ব্যবস্থা হলে জানাতে চাইলে পাতার নিচের তালিকায় নাম লিখুন।' },
];

// The questions parents actually ask, in a form an answer engine can quote
// whole. Same array the page renders, so the answer on screen and the answer
// in the markup can never say different things.
const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base
  schema={schema}
  title="পসরা পরিবার"
  description={`পসরা পরিবার: বছরে ৳${bnNum(YEARLY_BDT)}, ${bn(KIDS)} জন সন্তান পর্যন্ত। প্রত্যেকের প্রোফাইল, যাচাই, সনদ আর পুরো ছাপার বান্ডল। ${bn(COVERAGE.total)}টি বিষয় ফ্রিই থাকবে।`}
>
  <div class="wrap page">
    <p class="crumbs"><a href="/">পসরা</a> <span>/</span> পসরা পরিবার</p>

    <header class="hero">
      <p class="eyebrow">পসরা পরিবার · অভিভাবকদের জন্য</p>
      <h1>আপনার সন্তান বাংলায় পড়বে, ভাববে, প্রশ্ন করবে</h1>
      <p class="lede">
        পড়া আর মডেল ফ্রি, ফ্রিই থাকবে। পরিবার প্ল্যানে আসে তার চারপাশের জিনিস:
        প্রত্যেক সন্তানের নিজের হিসাব, যাচাই ও সনদ, আর ছাপার পুরো বান্ডল।
      </p>

      <div class="buybox">
        <div class="price-line"><strong>৳{bnNum(YEARLY_BDT)}</strong><span>বছরে, পুরো পরিবারের জন্য</span></div>
        <p class="unit">দিনে ৳{bn(perDay(YEARLY_BDT))} · {bn(KIDS)} জন সন্তান পর্যন্ত · অনলাইন কোচিংয়ের বছরে ২০-২৫ হাজারের বিশ ভাগের এক ভাগ</p>
        <a class="btn btn-primary buy" data-buy-anchor href={buyHref}>{buyable ? `বিকাশে নিন · ৳${bnNum(YEARLY_BDT)} →` : 'প্রতিষ্ঠাতা তালিকায় নাম লেখাও →'}</a>
        <ul class="assure">
          <li><b>একবারের পেমেন্ট</b>, নিজে থেকে আর টাকা কাটবে না</li>
          <li><b>{bn(FAMILY_REFUND_DAYS)} দিনের শর্তহীন ফেরত</b>, এক লাইন লিখলেই</li>
          <li><b>{digitalPackOnSale() ? `৳${bn(DIGITAL_PACK_AMOUNT)}-এর ডাউনলোড বান্ডল` : 'ডাউনলোড বান্ডল'}</b> সঙ্গেই আসে</li>
        </ul>
        <p class="ask"><a href="#compare">ফ্রি, বান্ডল আর প্ল্যানের তুলনা ↓</a> · <a href="/account/">আগেই সদস্য? ঢোকো</a></p>
      </div>
    </header>

    <section class="sec" id="compare">
      <div class="sec-h"><h2>কোনটা আপনার জন্য</h2></div>
      <div class="cmp-wrap">
        <table class="cmp">
          <thead><tr><th></th><th>ফ্রি</th><th>বান্ডল<small>৳{bn(DIGITAL_PACK_AMOUNT)} একবার</small></th><th class="pick">পরিবার<small>৳{bnNum(YEARLY_BDT)} বছরে</small></th></tr></thead>
          <tbody>
            <tr><th>সব পড়া, থ্রিডি মডেল, ল্যাব, মিশন</th><td>✓</td><td>✓</td><td class="pick">✓</td></tr>
            <tr><th>{bn(sheets.length)}টি ফ্রি ছাপার শিট</th><td>✓</td><td>✓</td><td class="pick">✓</td></tr>
            <tr><th>১১টি প্যাকের ছাপার PDF, উত্তরপত্রসহ</th><td>-</td><td>✓</td><td class="pick">✓</td></tr>
            <tr><th>প্রত্যেক সন্তানের নিজের প্রোফাইল</th><td>-</td><td>-</td><td class="pick">✓</td></tr>
            <tr><th>সব ডিভাইসে অগ্রগতি</th><td>-</td><td>-</td><td class="pick">✓</td></tr>
            <tr><th>যাচাই, ফল জমা আর ভুবনের সনদ</th><td>-</td><td>-</td><td class="pick">✓</td></tr>
          </tbody>
        </table>
      </div>
      <p class="sec-note">শুধু কাগজের কাজ চাইলে <a href="/digital-pack/">বান্ডলই যথেষ্ট</a>। সন্তানের অগ্রগতিও দেখতে চাইলে পরিবার প্ল্যান।</p>
