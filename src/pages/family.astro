---
/**
 * পসরা পরিবার - the family plan offer page.
 *
 * This is the page that talks about money, so the honesty rules bind hardest
 * here. Three things are kept true on purpose:
 *
 *  1. Nothing can be bought. There is no payment rail and no account system, so
 *     the only action is joining the founding list, which is free and says so
 *     twice before the form.
 *  2. Every line in the stack is marked আছে or হবে. A reader can tell at a
 *     glance which half of the offer exists today.
 *  3. The comparison prices are real, published prices of real alternatives,
 *     not invented "value" numbers. No struck-through fake retail price.
 *
 * The scarcity is a genuine cap the founder can honour, not a countdown.
 */
import Base from '../layouts/Base.astro';
import { totals } from '../data/worlds';
import { bn, bnNum } from '../lib/bn';
import { COVERAGE } from '../lib/coverage';
import { sheets } from '../data/printables';

export const prerender = false;
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');

const FOUNDING_SEATS = 100;
const KIDS = 6;

/**
 * One membership, two ways to pay. Kept as constants because the price is the
 * most likely thing to change and it must change in exactly one place.
 *
 * The annual price is ten months of the monthly one, so "দুই মাস ফ্রি" is a
 * fact rather than a slogan. Anything steeper would tell the reader the
 * monthly price is decoration.
 */
const MONTHLY_BDT = 120;
const YEARLY_BDT = 1200;
const YEARLY_USD = 39;
const perDay = (yearly: number) => (yearly / 365).toFixed(1);
const monthsFree = Math.round(12 - YEARLY_BDT / MONTHLY_BDT);

/**
 * The stack.
 *
 * `have` is three-valued on purpose. The weekly letter is written, scheduled
 * and deployed, but no letter has ever actually reached an inbox, because
 * production had no paying family until now. Calling that "আজই চালু" would be
 * a claim the logs do not support, and calling it "বানানো হয়নি" is simply
 * false. On the page that asks for money, the honest answer is the third one.
 */
type Have = true | false | 'testing';
const stack: { t: string; d: string; have: Have; annual?: boolean }[] = [
  { have: true,  t: `${bn(COVERAGE.covered)}টি বিষয়ের পুরো পাঠ, তিন গভীরতায়`, d: 'মহাকাশ, পদার্থ, রসায়ন, প্রাণিজগৎ, প্রকৃতি, খাদ্য, গণিত, টাকা, ভাষা, সামাজিক দক্ষতা, আবিষ্কার। একই লেখা ছোট, মাঝারি আর বড় - তাই পাঁচ বছরের আর তেরো বছরের সন্তান একই পাতায় বসতে পারে।' },
  { have: true,  t: `${bn(COVERAGE.cats)}টি বিভাগে জীবন্ত থ্রিডি মডেল`, d: 'ঢালু তল, দোলক, কেলাস, ঋতুচক্র, বর্ণমালা - টেনে ঘোরানো যায়, স্লাইডারে বদলায়। ভিডিও নয়, সত্যিকারের চালু মডেল।' },
  { have: true,  t: 'যেকোনো বিভাগ এক চাপে ছেপে নেওয়া', d: '“ছাপাও” চাপলেই পুরো বিভাগ কাগজে নেমে আসে - মডেল আর মেনু বাদ দিয়ে, আপনার বেছে নেওয়া গভীরতায়।' },
  { have: true,  t: `${bn(sheets.length)}টি ছাপার শিট`, d: 'বর্ণমালার হাতের লেখা, যুক্তবর্ণ ভাঙা চার্ট, কার চিহ্ন, সংখ্যা ১-১০০, সৌরজগৎ তথ্যপত্র, টাকা চেনা।' },
  { have: true,  t: `${bn(KIDS)} জন সন্তান পর্যন্ত, প্রত্যেকের নিজের প্রোফাইল`, d: 'নিজের নাম, নিজের বয়স, নিজের গভীরতা। ভাইবোন আর যে কাজিন ট্যাবটা ভাগ করে নেয় - সবার জায়গা হবে।' },
  { have: true,  t: 'যেকোনো ডিভাইসে অগ্রগতি', d: 'বাসার ফোন, স্কুলের ল্যাপটপ, দাদুর বাড়ির ট্যাব - একই সন্তানের হিসাব সব জায়গায় মিলে যায়। প্ল্যান ছাড়া হিসাবটা এক ব্রাউজারেই থাকে।' },
  { have: 'testing', t: 'প্রতি সপ্তাহে অভিভাবকের ইমেইল', d: 'কে কত দিন এসেছে, কী কী খুলেছে, কটা যাচাই দিয়েছে - আর রাতের খাবারে জিজ্ঞেস করার মতো কয়েকটা প্রশ্ন। যে সপ্তাহে কিছুই হয়নি, সে সপ্তাহে কোনো চিঠি যায় না।' },
  { have: true,  annual: true, t: 'যাচাই ও সার্টিফিকেট', d: 'প্রতি বিভাগের শেষে আটটি প্রশ্ন, পড়ার লেখা থেকেই বানানো, ফল সন্তানের নামে জমা থাকে। সব বিষয় দেখা আর সব যাচাই পাশ হলে ভুবনের সার্টিফিকেট, নাম-তারিখ সহ, ছাপার মতো।' },
  { have: true,  annual: true, t: 'অনুশীলনী প্যাক', d: 'প্রতিটি বিভাগের জন্য ছাপার অনুশীলনী - শূন্যস্থান পূরণ, শব্দভাণ্ডার, মিলানো, আর আলাদা পাতায় উত্তরপত্র।' },
  { have: false, t: 'পর্দা ছাড়া কার্ড', d: 'প্রতি বিষয়ে একটা কাজ যা পর্দা ছাড়াই করা যায় - ছায়া মাপা, ডিম ভাসানো, গাছের বয়স গোনা।' },
  { have: false, t: 'অফলাইন প্যাক', d: 'ইন্টারনেট দুর্বল হলেও মডেলগুলো চলবে। গ্রামের স্কুল আর যাত্রাপথের জন্য।' },
  { have: false, t: 'দাদু-দিদার সঙ্গে', d: 'প্রতি বিষয়ে একটা প্রশ্ন, যেটা সন্তান বাংলায় দাদু-দিদাকে জিজ্ঞেস করবে। দেশের বাইরের পরিবারের জন্য এটাই আসল কারণ।' },
];

const haveCount = stack.filter((s) => s.have === true).length;
const annualOnly = stack.filter((s) => s.annual);

const faqs = [
  { q: 'মাসিক না বার্ষিক, কোনটা নেব?', a: `যদি আগে দেখে নিতে চান, মাসিক নিন - এক মাস পরেই থামিয়ে দিতে পারবেন, কিছু জিজ্ঞেস করা হবে না। যদি জানেন সন্তান সারা বছর ব্যবহার করবে, বার্ষিকটাই সস্তা: ${bn(monthsFree)} মাসের টাকা বেঁচে যায়, আর ছাপার অনুশীলনী প্যাক আর সার্টিফিকেট বার্ষিকের সঙ্গেই আসে।` },
  { q: 'এখন টাকা দিতে হবে?', a: 'না। পেমেন্ট গেটওয়ে এখনো বসানো হয়নি, তাই কেনার ব্যবস্থা নেই। অ্যাকাউন্ট আছে - ইমেইলের লিংকে ঢোকা যায় - আর প্রতিষ্ঠাতা পরিবারগুলোর প্ল্যান আমরা হাতে চালু করে দিই। নিচের তালিকায় নাম লেখালে কার্ড লাগে না, টাকাও কাটা যায় না।' },
  { q: 'তাহলে তালিকায় নাম লিখে লাভ কী?', a: 'দুটো। এক, প্রতিষ্ঠাতা দামটা আপনার জন্য আজীবন একই থাকবে। দুই, আমরা আগে আপনার কথা শুনে তারপর বানাবো - কোন জিনিসটা আগে দরকার, সেটা আপনিই বলবেন।' },
  { q: 'যেগুলো এখন ফ্রি, সেগুলো কি পরে টাকার পেছনে চলে যাবে?', a: `না, কখনো না। আজ যে ${bn(COVERAGE.total)}টি বিষয়, থ্রিডি মডেল আর ছাপার শিট ফ্রি, সেগুলো ফ্রিই থাকবে। পরিবার প্ল্যান বিক্রি করে সেগুলোর চারপাশের জিনিস - প্রোফাইল, রিপোর্ট, অনুশীলনী। পুরোনো জিনিসের চারপাশে বেড়া দেওয়া হবে না।` },
  { q: 'সন্তানের কোনো তথ্য নেবেন?', a: 'সন্তানের কোনো অ্যাকাউন্ট থাকবে না। অ্যাকাউন্ট থাকবে শুধু অভিভাবকের। সন্তানের জন্য যা লাগবে তা হলো আপনার দেওয়া একটা ডাকনাম আর একটা স্তর - নাম-ঠিকানা, ছবি, ইমেইল কিছুই নয়।' },
  { q: 'দেশের বাইরে থাকি, টাকা দেব কীভাবে?', a: 'কার্ডে, ডলারে। দেশের ভেতরে বিকাশ, নগদ, রকেট বা কার্ড - দুই দিকের জন্য দুই ব্যবস্থা থাকবে।' },
  { q: 'এক বছর পরে ভালো না লাগলে?', a: 'পুরো টাকা ফেরত। শর্ত নেই, প্রশ্ন নেই। যে জিনিস এক বছরেও কাজে লাগল না, তার টাকা আমাদের রাখার কথা নয়।' },
];

// The questions parents actually ask, in a form an answer engine can quote
// whole. Same array the page renders, so the answer on screen and the answer
// in the markup can never say different things.
const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base
  schema={schema}
  title="পসরা সদস্যপদ"
  description={`পসরা সদস্যপদ - একটাই প্ল্যান, মাসে ৳${bn(MONTHLY_BDT)} বা বছরে ৳${bnNum(YEARLY_BDT)}, ${bn(KIDS)} জন সন্তান পর্যন্ত। ${bn(COVERAGE.total)}টি বিষয় ফ্রিই থাকবে। এখন টাকা লাগবে না, তালিকায় নাম লেখালেই হয়।`}
>
  <div class="wrap page">
    <p class="crumbs"><a href="/">পসরা</a> <span>/</span> পসরা সদস্যপদ</p>

    <header class="hero">
      <p class="eyebrow">পসরা পরিবার · প্রতিষ্ঠাতা তালিকা</p>
      <h1>আপনার সন্তান বাংলায় পড়বে, ভাববে, প্রশ্ন করবে</h1>
      <p class="lede">
        পসরার {bn(totals.items)}টি বিষয় ওয়েবসাইটে ফ্রি, আর ফ্রিই থাকবে। পরিবার
        প্ল্যান সেই পড়াটা বিক্রি করে না - বিক্রি করে তার চারপাশের জিনিসটা।
        প্রত্যেক সন্তানের নিজের হিসাব, প্রতি সপ্তাহে আপনার হাতে একটা রিপোর্ট,
        আর এমন কাজ যা পর্দা বন্ধ করেও করা যায়।
      </p>

      <div class="statusbox">
        <p><b>পরিষ্কার করে বলি:</b> এখনো কিছু বিক্রি হচ্ছে না, কারণ পেমেন্টের ব্যবস্থা
        বসানো হয়নি। প্রতিষ্ঠাতা পরিবারগুলোর প্ল্যান আমরা হাতে চালু করে দিচ্ছি। নিচে নাম লেখালে
        <b>কার্ড লাগে না, এক পয়সাও কাটা যায় না।</b>
        তালিকার {bn(haveCount)}টি জিনিস <em>আজই চালু</em>, বাকিগুলো <em>এখনো বানানো হয়নি</em> -
        কোনটা কী, প্রতিটা লাইনের পাশে লেখা আছে।</p>
      </div>

      <div class="hero-cta">
        <a class="btn btn-primary" href="#join">প্রতিষ্ঠাতা তালিকায় নাম লেখাও</a>
        <a class="btn" href="/printables/">আগে ফ্রি শিটগুলো নিয়ে যান →</a>
        <a class="btn" href="/account/">আগেই সদস্য? ঢোকো</a>
      </div>
    </header>

    <section class="sec">
      <div class="sec-h">
        <h2>প্রথমে যেটা বিনামূল্যে নিয়ে যাবেন</h2>
        <p class="sec-note">কিছু না কিনেই, আজ, এই মুহূর্তে। ইমেইলও চাওয়া হবে না।</p>
      </div>
      <div class="sgrid">
        {sheets.map((s) => (
          <a class="scard" href={`/printables/${s.slug}/`}>
            <span class="semoji" aria-hidden="true">{s.emoji}</span>
            <b>{s.bn}</b>
            <span class="stag">{s.pages}</span>
          </a>
        ))}
      </div>
      <p class="sec-note">
        এগুলো টোপ নয় - ছাপিয়ে নিয়ে চলে গেলে আমাদের কোনো আপত্তি নেই। যদি কাজে লাগে,
        তখন নিচের কথাটা পড়ুন।
      </p>
    </section>

    <section class="sec">
      <div class="sec-h">
        <h2>সদস্যপদে কী কী আছে</h2>
        <p class="sec-note">
          {bn(stack.length)}টি জিনিস, তার {bn(haveCount)}টি আজই চালু। সবুজ মানে এখন কাজ করছে,
          হলুদ মানে বানানো হয়ে গেছে কিন্তু এখনো পরীক্ষা চলছে, ধূসর মানে এখনো বানানো হয়নি।
          প্রতিষ্ঠাতা পরিবারগুলোই ঠিক করবে ধূসরগুলোর কোনটা আগে বানানো হবে।
        </p>
      </div>
      <ol class="stack">
        {stack.map((s, i) => (
          <li class={s.have === true ? 'on' : s.have === 'testing' ? 'mid' : 'off'}>
            <span class="sn">{bn(i + 1)}</span>
            <span class="sicon" aria-hidden="true">{s.have === true ? '✓' : s.have === 'testing' ? '◐' : '○'}</span>
            <div>
              <b>{s.t}</b>
              <p>{s.d}</p>
              <span class={s.have === true ? 'badge yes' : s.have === 'testing' ? 'badge mid' : 'badge no'}>
                {s.have === true ? 'আজই চালু' : s.have === 'testing' ? 'বানানো আছে, প্রথম চিঠি এখনো যায়নি' : 'এখনো বানানো হয়নি'}
              </span>
              {s.annual && <span class="badge ann">বার্ষিকের সঙ্গে</span>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec">
      <div class="sec-h">
        <h2>দাম</h2>
        <p class="sec-note">
          একটাই সদস্যপদ, দুইভাবে দেওয়া যায়। এক পরিবার, {bn(KIDS)} জন সন্তান পর্যন্ত -
