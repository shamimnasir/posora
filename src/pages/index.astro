---
import Base from '../layouts/Base.astro';
import HeroOrbit from '../components/HeroOrbit.astro';
import WorldCard from '../components/WorldCard.astro';
import { getWorlds, getBody, computeTotals } from '../lib/content';
import { isLoggedIn } from '../lib/auth';
import { bn } from '../lib/bn';
import { COVERAGE } from '../lib/coverage';

// Content now comes from D1 at request time, so this route can't be prerendered.
export const prerender = false;

// Drafts are visible only to a logged-in admin who asks for them.
const wantsPreview = Astro.url.searchParams.get('preview') === '1';
const preview = wantsPreview && (await isLoggedIn(Astro));

const worlds = await getWorlds({ includeDrafts: preview, fresh: preview });
const totals = computeTotals(worlds);
const saturn = (await getBody('saturn'))!;

Astro.response.headers.set(
  'cache-control',
  preview ? 'private, no-store' : 'public, max-age=0, s-maxage=60, stale-while-revalidate=300',
);

/**
 * The questions a first-time visitor arrives with. Each answer is self
 * contained, so it reads correctly whether someone sees it on the page, in a
 * search result, or quoted by an assistant that never shows the page at all.
 * Counts come from COVERAGE, never typed by hand.
 */
const faqs = [
  {
    q: 'পসরা কী?',
    a: `পসরা বাংলা ভাষায় শিশুদের জন্য একটি ফ্রি ইন্টারঅ্যাকটিভ শেখার ওয়েবসাইট, ঠিকানা posora.com। এখানে ${bn(worlds.length)}টি ভুবনে ${bn(COVERAGE.total)}টি বিষয়ের পুরো পাঠ আছে। ${bn(COVERAGE.cats)}টি বিভাগের প্রতিটিতে একটি থ্রিডি মডেল আর পড়ার বাইরে করার মতো একটি হাতে-কলমে কাজ আছে। পড়তে কোনো অ্যাকাউন্ট লাগে না, কোনো টাকা লাগে না, কোনো বিজ্ঞাপনও নেই।`,
  },
  {
    q: 'এটা কোন বয়সের জন্য?',
    a: 'পাঁচ থেকে তেরো, একই পাতায়। প্রতিটি লেখা তিনটি গভীরতায় লেখা আছে - ছোট (৫-৮), মাঝারি (৯-১২) আর বড় (১৩+)। উপরের বোতামে গভীরতা বদলে দিলে একই বিষয় ছোট ভাইবোন আর বড় ভাইবোন দুজনেই পড়তে পারে।',
  },
  {
    q: 'টাকা লাগে?',
    a: `না। ${bn(COVERAGE.total)}টি বিষয়ের তিন গভীরতার পাঠ, থ্রিডি মডেল, হাতে-কলমে টুল, মিশন আর ফ্রি ছাপার শিটগুলো সম্পূর্ণ ফ্রি, আর ফ্রিই থাকবে। পরিবার প্ল্যানে যোগ হবে অগ্রগতি সিঙ্ক, সাপ্তাহিক রিপোর্ট, পুরো ভুবনের অনুশীলনী প্যাক আর সার্টিফিকেট। এখন পেমেন্টের ব্যবস্থা নেই, তাই কিছু কেনারও উপায় নেই।`,
  },
  {
    q: 'বাচ্চার কোনো তথ্য লাগে?',
    a: 'না। সন্তানের কোনো অ্যাকাউন্ট হয় না। পড়ার হিসাব শুধু ওই ব্রাউজারেই জমা থাকে, আমাদের কাছে আসে না। অ্যাকাউন্ট খুললে সেটা অভিভাবকের, আর সন্তানের জন্য শুধু একটা ডাকনাম আর একটা স্তর লাগে - নাম, ছবি বা ঠিকানা কিছুই নয়।',
  },
  {
    q: 'অ্যাপ ডাউনলোড করতে হবে?',
    a: 'না, কিছু নামাতে হয় না। পসরা ব্রাউজারেই চলে - ফোন, ট্যাব বা কম্পিউটার, যেকোনোটায়। posora.com খুললেই হলো।',
  },
  {
    q: 'কী কী শেখা যায়?',
    a: `${worlds.map((w) => w.bn).join(', ')} - মোট ${bn(worlds.length)}টি ভুবন। প্রতিটি ভুবনে কয়েকটি বিভাগ, প্রতিটি বিভাগে থ্রিডি মডেল আর খোঁজার খেলা। মোট ${bn(COVERAGE.cats)}টি বিভাগ, আর প্রতিটিতেই পড়ার বাইরে করার মতো কিছু আছে - সব মিলিয়ে ${bn(COVERAGE.missions)}টি মিশন আর ${bn(COVERAGE.labs)}টি বিভাগে হাতে-কলমে টুল।`,
  },
  {
    q: 'ইন্টারনেট ছাড়া চলে?',
    a: 'না, পাতা খুলতে ইন্টারনেট লাগে। তবে ছাপার প্যাকের শিটগুলো একবার ছেপে নিলে পর্দা ছাড়াই কাজে লাগে, আর সেগুলোর জন্য অ্যাকাউন্টও লাগে না।',
  },
  {
    q: 'স্কুলে ব্যবহার করা যাবে?',
    a: 'যাবে। প্রতিটি বিভাগের পুরো লেখা এক ক্লিকে হ্যান্ডআউট হিসেবে ছাপানো যায়, আর ছাপার প্যাকের শিটগুলো ক্লাসে সরাসরি বিলি করা যায়। স্কুলের জন্য আলাদা সুবিধা এখনো পাইলট পর্যায়ে, বিস্তারিত /schools/ পাতায় লেখা আছে।',
  },
];

const homeSchema = [
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'ItemList',
    name: 'পসরার ভুবন',
    numberOfItems: worlds.length,
    itemListElement: worlds.map((w, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: w.bn,
      description: w.tag,
      url: `https://posora.com/${w.slug}/`,
    })),
  },
];
---
<Base title="পসরা" description="শিশু ও বড়দের জন্য বাংলায় ইন্টারঅ্যাকটিভ শেখার জায়গা - মহাকাশ, বিজ্ঞান, গণিত, ভাষা, প্রকৃতি। প্রতিটি জিনিস ছোঁয়া যায়, ঘোরানো যায়, খেলা যায়।" schema={homeSchema}>

  <section class="hero wrap">
    <div class="copy">
      <p class="eyebrow" style="--w:var(--brand)">বাংলায় · শিশু ও বড়দের জন্য</p>
      <h1>শেখা হোক <em>খেলার মতো</em></h1>
      <p class="lede">{bn(totals.worlds)}টি ভুবন, {bn(totals.items)}টি জিনিস - ঘোরানো যায়, নাড়াচাড়া করা যায়, খুলে দেখা যায়। পড়ে নয়, নেড়েচেড়ে শেখা।</p>
      <div class="cta">
        <a class="btn btn-primary" href="/today/">আজকেরটা দেখো →</a>
        <a class="btn" href="/space/">মহাকাশে যাও</a>
        <a class="btn" href="#worlds">সব ভুবন</a>
      </div>
      <p class="hint">রোজ একটা নতুন জিনিস, পাঁচটা প্রশ্ন আর একটা খেলা - সবার জন্য একই।</p>
    </div>
    <HeroOrbit />
  </section>

  <section class="stats wrap" id="stats">
    {[
      [totals.worlds, 'ভুবন'], [totals.cats, 'বিভাগ'], [totals.items, 'ক্লিকযোগ্য জিনিস'], [3, 'পড়ার গভীরতা'],
    ].map(([n, l]) => (
      <div class="stat"><b class="num" data-count={n}>০</b><span class="lbl">{l}</span></div>
    ))}
  </section>

  <section class="sec wrap" id="worlds">
    <div class="sec-h">
      <h2>{bn(totals.worlds)}টি ভুবন</h2>
      <p>প্রতিটি ভুবনের প্রতিটি বিভাগে একটি জীবন্ত থ্রিডি দৃশ্য আর পড়ার বাইরে করার মতো একটি কাজ আছে।{' '}
        {COVERAGE.uncovered === 0
          ? `${bn(totals.items)}টি বিষয়ের প্রতিটির পুরো কথা এখন তিন গভীরতায় পড়া যায়, একটাও বাকি নেই।`
          : `${bn(totals.items)}টির মধ্যে ${bn(COVERAGE.covered)}টি বিষয়ের পুরো কথা এখন তিন গভীরতায় পড়া যায়, বাকি ${bn(COVERAGE.uncovered)}টি লেখা হচ্ছে।`}</p>
    </div>
    <div class="grid">
      {worlds.map((w, i) => <WorldCard w={w} i={i} />)}
    </div>
  </section>

  <section class="sec wrap how">
    <div class="sec-h">
      <h2>প্রতিটি ভুবন একই ভাবে চলে</h2>
      <p>একবার শিখে নিলে সব ভুবনে হাত চলে।</p>
    </div>
    <div class="steps">
      <div class="step">
        <svg viewBox="0 0 120 80" aria-hidden="true"><rect x="4" y="4" width="34" height="72" rx="6"/><rect x="9" y="12" width="24" height="10" rx="3" class="hi"/><rect x="9" y="27" width="24" height="10" rx="3"/><rect x="9" y="42" width="24" height="10" rx="3"/><rect x="44" y="4" width="72" height="72" rx="6"/></svg>
        <h3>বাঁয়ে বেছে নাও</h3><p>তালিকা থেকে একটা জিনিস - গ্রহ, মৌল, বর্ণ বা প্রাণী।</p>
      </div>
      <div class="step">
        <svg viewBox="0 0 120 80" aria-hidden="true"><rect x="4" y="4" width="112" height="72" rx="6"/><circle cx="60" cy="40" r="22" class="hi"/><ellipse cx="60" cy="40" rx="36" ry="10" transform="rotate(-20 60 40)"/><circle cx="92" cy="26" r="4" class="hi"/></svg>
        <h3>মাঝে ঘোরাও, টানো</h3><p>টেনে ঘোরাও, স্লাইডার বদলাও, জোড়া দাও - নিজে দেখো কী হয়।</p>
      </div>
      <div class="step">
        <svg viewBox="0 0 120 80" aria-hidden="true"><rect x="4" y="4" width="112" height="72" rx="6"/><rect x="12" y="14" width="60" height="6" rx="3"/><rect x="12" y="26" width="44" height="6" rx="3" class="hi"/><rect x="12" y="38" width="52" height="6" rx="3"/><rect x="12" y="54" width="96" height="14" rx="5" class="hi"/></svg>
        <h3>ডানে পড়ো, মিশন করো</h3><p>তোমার বয়স অনুযায়ী লেখা, তারপর ছোট চ্যালেঞ্জ - জ্ঞানবিন্দু জমে।</p>
      </div>
    </div>
  </section>

  <section class="sec wrap depth" style={`--w:${worlds[0]?.hue ?? '#5A6BD4'}`}>
    <div class="sec-h">
      <h2>একই জিনিস, তিন গভীরতা</h2>
      <p>শিশু আর বড় একই পাতায় আসে - বদলায় শুধু লেখার স্তর। নিজে বদলে দেখো:</p>
    </div>
    <div class="demo card" id="depth-demo">
      <div class="demo-h">
        <span class="orb" style="width:44px;height:44px;--w:#c9a15e"></span>
        <div><b>{saturn.bn}</b><span class="lbl">{saturn.tagline}</span></div>
        <div class="seg" role="group" aria-label="পড়ার গভীরতা">
          <button type="button" aria-pressed="true" data-l="l1">ছোট <small>৫–৮</small></button>
          <button type="button" aria-pressed="false" data-l="l2">মাঝারি <small>৯–১২</small></button>
          <button type="button" aria-pressed="false" data-l="l3">বড় <small>১৩+</small></button>
        </div>
      </div>
      <p class="demo-t" data-l1={saturn.l1} data-l2={saturn.l2} data-l3={saturn.l3}>{saturn.l1}</p>
    </div>
  </section>

  {/* The questions people actually arrive with, answered in full on the page
      itself. A short answer that stands on its own is what a search result or
      an assistant can quote, and what a hurried parent can read in one go. */}
  <section class="sec wrap" id="faq">
    {/* The eyebrow belongs above its heading, not beside it: .sec-h is a
        space-between row whose two children are the title and the lede, so an
        eyebrow left loose as the first child pushed this heading to the far
        right edge with nothing under it. */}
    <div class="sec-h">
      <div class="sec-t">
        <p class="eyebrow">সাধারণ প্রশ্ন</p>
        <h2>পসরা জিনিসটা আসলে কী</h2>
      </div>
      <p>যেগুলো সবচেয়ে বেশি জিজ্ঞেস করা হয়। উত্তর না পেলে নিচের ফর্মে লিখে পাঠাও।</p>
    </div>
    <div class="faq">
      {faqs.map((f) => (
        <details class="fq">
          <summary><h3>{f.q}</h3></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="sec wrap contact">
    <div class="card cbox">
      <div>
        <h2>প্রশ্ন? পরামর্শ? স্কুলের জন্য চাই?</h2>
        <p>সরাসরি হোয়াটসঅ্যাপে বলো, বা ইমেইল করো। সাধারণত এক দিনের মধ্যে উত্তর দিই।</p>
      </div>
      <div class="cta">
        <a class="btn btn-primary" href="https://wa.me/8801771553141" rel="noopener">হোয়াটসঅ্যাপ ০১৭৭১-৫৫৩১৪১</a>
        <a class="btn" href="/contact/">ফর্মে লেখো</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* FAQ: open one at a time by hand, but every answer is in the HTML from the
     first byte, so a crawler that runs no JavaScript still reads all of them. */
  .faq { display: flex; flex-direction: column; gap: 6px; max-width: 78ch; }
  .fq { border: 1px solid var(--line-soft); border-radius: 12px; background: var(--panel); overflow: hidden; }
  .fq summary { list-style: none; cursor: pointer; padding: 0.8rem 1rem; display: flex; align-items: center; gap: 0.6rem; transition: background 0.15s ease; }
  .fq summary::-webkit-details-marker { display: none; }
  .fq summary::after { content: "+"; margin-left: auto; font-family: var(--font-mono); font-size: 18px; color: var(--muted); line-height: 1; }
  .fq[open] summary::after { content: "−"; }
  .fq summary:hover { background: var(--panel-2); }
  .fq h3 { font-family: var(--font-display); font-size: 16px; font-weight: 700; }
  .fq p { padding: 0 1rem 1rem; font-size: 14.5px; line-height: 1.8; color: var(--ink-2); max-width: 72ch; }

  .hero { position: relative; display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 2rem; margin-top: 1.2rem; padding: clamp(1.5rem, 4vw, 3.2rem); overflow: hidden; border: 1px solid rgba(255,255,255,.1); border-radius: 32px; background: radial-gradient(circle at 78% 18%, rgba(255,111,189,.18), transparent 25%), radial-gradient(circle at 22% 58%, rgba(111,232,255,.12), transparent 28%), linear-gradient(145deg,#11184b,#090e35); box-shadow: var(--shadow-lg); }
  .hero::before, .hero::after { content: ""; position: absolute; width: 5px; height: 5px; border-radius: 50%; background: rgba(255,255,255,.65); box-shadow: 120px 45px rgba(111,232,255,.6), 280px 16px rgba(255,216,77,.65), 420px 112px rgba(255,255,255,.5), 650px 44px rgba(255,111,189,.55), 800px 140px rgba(255,255,255,.45); pointer-events: none; }
  .hero::before { top: 24px; left: 30%; }
  .hero::after { right: 12%; bottom: 18%; transform: scale(.65); }
  .copy { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 1.1rem; }
  h1 { font-size: clamp(2.4rem, 5.6vw, 4.2rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.01em; }
  h1 em { font-style: normal; color: var(--sun); position: relative; white-space: nowrap; }
  h1 em::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0.03em; height: 0.14em; background: var(--pink); opacity: 0.65; border-radius: 4px; z-index: -1; transform: rotate(-1deg); }
  .lede { font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: var(--ink-2); max-width: 34ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .hint { font-size: 13px; color: var(--muted); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-top: 1rem; }
  .stat { position: relative; overflow: hidden; background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.1rem; box-shadow: 4px 4px 0 color-mix(in oklab, var(--brand) 35%, transparent); }
  .stat:nth-child(2) { box-shadow-color: color-mix(in oklab, var(--pink) 45%, transparent); }
  .stat:nth-child(3) { box-shadow-color: color-mix(in oklab, var(--ok) 45%, transparent); }
  .stat:nth-child(4) { box-shadow-color: color-mix(in oklab, var(--sun) 45%, transparent); }
  .stat b { font-family: var(--font-display); font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 800; line-height: 1.1; color: var(--brand); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.9rem; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; }
  .step { background: linear-gradient(145deg,var(--panel),var(--panel-2)); border: 1px solid var(--line); border-radius: var(--r); padding: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; transition: transform .18s ease, box-shadow .18s ease; }
  .step:hover { transform: translateY(-4px); box-shadow: 5px 5px 0 color-mix(in oklab,var(--brand) 42%,transparent); }
  .step svg { width: 120px; height: 80px; fill: var(--panel-2); stroke: var(--line); stroke-width: 1.5; margin-bottom: 0.5rem; }
  .step svg .hi { fill: color-mix(in oklab, var(--brand) 28%, var(--panel)); stroke: var(--brand); }
  .step h3 { font-size: 18px; }
  .step p { color: var(--muted); font-size: 14.5px; }
  .demo { padding: 1.25rem 1.5rem 1.5rem; }
  .demo-h { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .demo-h b { font-family: var(--font-display); font-size: 22px; display: block; line-height: 1.1; }
  .seg { margin-left: auto; display: inline-flex; background: var(--panel-2); border: 1px solid var(--line-soft); border-radius: 999px; padding: 3px; }
  .seg button { padding: 0.35rem 0.9rem; border-radius: 999px; font-weight: 600; font-size: 14px; color: var(--muted); display: flex; gap: 0.3rem; align-items: baseline; }
  .seg button small { font-size: 11px; font-weight: 500; }
  .seg button[aria-pressed="true"] { background: var(--panel); color: var(--ink); box-shadow: var(--shadow-sm); }
  .demo-t { font-size: 17px; max-width: 70ch; min-height: 3.4em; color: var(--ink-2); }
  .cbox { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.75rem 2rem; background: linear-gradient(125deg,var(--brand-soft),color-mix(in oklab,var(--panel) 76%,var(--pink))); border-color: var(--line); }
  .cbox h2 { font-size: 1.5rem; margin-bottom: 0.3rem; }
  .cbox p { color: var(--ink-2); max-width: 44ch; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; text-align: center; border-radius: 24px; }
    .copy { align-items: center; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .steps { grid-template-columns: 1fr; }
    .cbox { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  import { bn } from '../lib/bn';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // count-up stats
  const io = new IntersectionObserver((ents) => {
    for (const en of ents) {
      if (!en.isIntersecting) continue;
      const el = en.target as HTMLElement; const target = +el.dataset.count!; io.unobserve(el);
      if (reduced) { el.textContent = bn(target); continue; }
      const t0 = performance.now(), dur = 900;
      const tick = (now: number) => { const p = Math.min(1, (now - t0) / dur); el.textContent = bn(Math.round(target * (1 - Math.pow(1 - p, 3)))); if (p < 1) requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
    }
  }, { threshold: 0.5 });
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => io.observe(el));

  // card tilt
  if (!reduced && matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const b = card.getBoundingClientRect(); const x = (e.clientX - b.left) / b.width - 0.5; const y = (e.clientY - b.top) / b.height - 0.5;
        card.style.setProperty('--ry', `${x * 8}deg`); card.style.setProperty('--rx', `${-y * 8}deg`);
      });
      card.addEventListener('pointerleave', () => { card.style.setProperty('--ry', '0deg'); card.style.setProperty('--rx', '0deg'); });
    });
  }

  // depth demo
  const demo = document.getElementById('depth-demo')!;
  const text = demo.querySelector<HTMLElement>('.demo-t')!;
  demo.querySelectorAll<HTMLButtonElement>('[data-l]').forEach((b) => b.addEventListener('click', () => {
    demo.querySelectorAll('[data-l]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    text.textContent = text.dataset[b.dataset.l as 'l1' | 'l2' | 'l3']!;
    if (!reduced) text.animate([{ opacity: 0.2, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'ease-out' });
  }));
</script>
