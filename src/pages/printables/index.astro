---
/**
 * ছাপার প্যাক - the index of free printable sheets.
 *
 * No email, no account, no gate. A parent who has never heard of পসরা should be
 * able to land here, print something useful in one click, and walk away happy.
 * That is what makes it worth offering the family plan to them later.
 */
import Base from '../../layouts/Base.astro';
import { sheets } from '../../data/printables';
import { bn } from '../../lib/bn';
import { COVERAGE } from '../../lib/coverage';

export const prerender = false;
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=600, stale-while-revalidate=3600');

// A real list of real downloads, so an answer engine asked for free Bangla
// worksheets can name the sheets rather than guess at them.
const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'পসরা', item: 'https://posora.com/' },
      { '@type': 'ListItem', position: 2, name: 'ছাপার প্যাক', item: 'https://posora.com/printables/' },
    ],
  },
  {
    '@type': 'ItemList',
    name: 'পসরার ফ্রি ছাপার প্যাক',
    numberOfItems: sheets.length,
    itemListElement: sheets.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.bn,
      description: s.tag,
      url: `https://posora.com/printables/${s.slug}/`,
    })),
  },
];
const accents: Record<string, string> = {
  letters: '#e6a921', kars: '#8a62d8', conjuncts: '#8a62d8', numbers: '#2c8dc3', space: '#315ad8', money: '#2b9d64',
};
---
<Base
  schema={schema}
  title="ছাপার প্যাক"
  description="পসরার ফ্রি ছাপার প্যাক - বাংলা বর্ণমালার হাতের লেখা, যুক্তবর্ণ চার্ট, সংখ্যা ০-১০০, সৌরজগৎ তথ্যপত্র। অ্যাকাউন্ট লাগে না, ইমেইল লাগে না।"
>
  <div class="wrap page">
    <p class="crumbs"><a href="/">পসরা</a> <span>/</span> ছাপার প্যাক</p>

    <header class="hero">
      <p class="eyebrow">ফ্রি · কিছু লাগে না</p>
      <h1>ছেপে নাও, পর্দা বন্ধ করো</h1>
      <p class="lede">
        {bn(sheets.length)}টি শিট, পসরার নিজের ডেটা থেকেই তৈরি। বর্ণমালার হাতের লেখা,
        যুক্তবর্ণ ভাঙা, সংখ্যা, সৌরজগৎ, টাকা। যেকোনোটা খুলে “ছাপাও” চাপলেই প্রিন্ট
        বা PDF হয়ে যাবে।
      </p>
      <p class="free">
        <b>কোনো অ্যাকাউন্ট নেই, ইমেইল চাওয়া হয় না, টাকা লাগে না।</b>
        ক্লাসে, বাসায়, যত খুশি ছাপান। এটাই সবচেয়ে সহজ উত্তর সেই প্রশ্নের -
        “বাচ্চা সারাদিন পর্দায় থাকে, কী করি?”
      </p>
    </header>

    <div class="how card">
      <span class="how-title">একটা শিট বাছুন</span>
      <span><b>১</b> খুলুন</span><i>→</i><span><b>২</b> একসঙ্গে করুন</span><i>→</i><span><b>৩</b> ছাপুন, খেলুন, টাঙান</span>
    </div>

    <div class="grid">
      {sheets.map((s) => (
        <a class="card sheet" style={`--sheet-accent:${accents[s.kind] ?? '#1b8f82'}`} href={`/printables/${s.slug}/`}>
          <span class="sheet-top"><span class="emoji" aria-hidden="true">{s.emoji}</span><span class="open">খুলে দেখো ↗</span></span>
          <h2>{s.bn}</h2>
          <p class="tag">{s.tag}</p>
          <p class="who">{s.who}</p>
          <span class="pages">{s.pages} · ছাপাও বা PDF</span>
        </a>
      ))}
    </div>

    <section class="card cta">
      <div>
        <p class="eyebrow">এরপর কী</p>
        <h2>শিটগুলো ভালো লাগলে</h2>
        <p>
          পসরার {bn(COVERAGE.total)}টি বিষয় ওয়েবসাইটেই ফ্রি, চিরকাল। আর যদি চান প্রতিটি সন্তানের
          নিজের হিসাব থাকুক, প্রতি সপ্তাহে আপনার কাছে একটা রিপোর্ট আসুক, আর
          অনুশীলনীর প্যাক ছাপাতে পারুন - সেটার জন্য পসরা পরিবার তৈরি হচ্ছে।
        </p>
      </div>
      <div class="cbtns">
        <a class="btn btn-primary" href="/digital-pack/">৳২৪৯ ডিজিটাল প্যাক দেখো →</a>
        <a class="btn" href="/family/">পসরা পরিবার দেখো →</a>
        <a class="btn" href="/#worlds">আগে ভুবনগুলো ঘুরে আসি</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .page { padding-block: 1rem 4rem; display: flex; flex-direction: column; gap: 2rem; }
  .crumbs { font-size: 13px; color: var(--muted); }
  .crumbs span { margin: 0 0.35rem; }
  .hero { display: flex; flex-direction: column; gap: 0.85rem; max-width: 60ch; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; line-height: 1.14; }
  .lede { font-size: clamp(1.04rem, 2vw, 1.2rem); color: var(--ink-2); line-height: 1.7; }
  .free { font-size: 14.5px; line-height: 1.7; color: var(--ink-2); background: color-mix(in oklab, var(--ok) 11%, var(--panel));
    border: 1px solid color-mix(in oklab, var(--ok) 34%, var(--line)); border-radius: var(--r-sm); padding: 0.85rem 1rem; }
  .free b { color: var(--ink); }

  .how { display: flex; align-items: center; gap: .7rem 1rem; flex-wrap: wrap; padding: .85rem 1rem; background: color-mix(in oklab, var(--brand) 9%, var(--panel)); border-color: color-mix(in oklab, var(--brand) 25%, var(--line)); color: var(--ink-2); font-size: 14px; }
  .how-title { color: var(--brand-ink); font-weight: 800; margin-right: .3rem; }
  .how b { display: inline-grid; place-items: center; width: 22px; height: 22px; margin-right: .25rem; border-radius: 50%; background: var(--brand); color: #fff; font-size: 12px; }
  .how i { color: var(--muted); font-style: normal; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(268px, 1fr)); gap: 0.9rem; }
  .sheet { position: relative; overflow: hidden; padding: 1.15rem 1.25rem 1.3rem; display: flex; flex-direction: column; gap: 0.28rem; border-top: 4px solid var(--sheet-accent); transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
  .sheet::after { content: ''; position: absolute; width: 90px; height: 90px; right: -34px; top: -34px; border-radius: 50%; background: color-mix(in oklab, var(--sheet-accent) 18%, transparent); }
  .sheet:hover { transform: translateY(-4px) rotate(-.3deg); box-shadow: 0 14px 28px rgba(20, 34, 48, .16); border-color: var(--sheet-accent); }
  .sheet-top { display: flex; justify-content: space-between; align-items: flex-start; min-height: 38px; }
  .emoji { font-size: 30px; line-height: 1; margin-bottom: 0.25rem; }
  .open { font-size: 11px; color: var(--sheet-accent); font-weight: 800; }
  .sheet h2 { font-size: 18px; font-weight: 700; line-height: 1.3; }
  .tag { font-size: 14px; color: var(--ink-2); line-height: 1.6; }
  .who { font-size: 12.5px; color: var(--muted); font-style: italic; }
  .pages { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; color: var(--brand-ink); margin-top: 0.45rem;
    background: color-mix(in oklab, var(--sheet-accent) 15%, #fff); border-radius: 999px; padding: 0.22rem 0.6rem; align-self: flex-start; }

  .cta { padding: 1.4rem 1.5rem 1.5rem; display: flex; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; align-items: center; background: var(--brand-soft); border-color: transparent; }
  .cta h2 { font-size: 1.4rem; font-weight: 800; color: var(--brand-ink); margin: 0.15rem 0 0.4rem; }
  .cta p { font-size: 14.5px; color: var(--brand-ink); max-width: 56ch; line-height: 1.7; }
  .cbtns { display: flex; flex-direction: column; gap: 0.5rem; }
  @media (max-width: 700px) { .cbtns { width: 100%; } }
</style>
