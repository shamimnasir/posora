---
import Base from '../../layouts/Base.astro';
import { bundle, digitalPacks } from '../../data/digital-packs';
import { bn } from '../../lib/bn';

export const prerender = false;
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=120');

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'পসরা', item: 'https://posora.com/' },
      { '@type': 'ListItem', position: 2, name: 'ডিজিটাল প্যাক', item: 'https://posora.com/digital-pack/' },
    ],
  },
  {
    '@type': 'ItemList',
    name: bundle.title,
    numberOfItems: bundle.packs,
    itemListElement: digitalPacks.map((p, i) => ({
      '@type': 'ListItem', position: i + 1, name: p.title, description: p.hook,
      url: `https://posora.com/digital-pack/#${p.slug}`,
    })),
  },
];
const activitiesPerPack = digitalPacks[0]?.activities.length ?? 0;
const bonusPerPack = digitalPacks[0]?.bonus.length ?? 0;
---

<Base
  title="৳২৪৯ ডিজিটাল প্যাক বান্ডল"
  description="পসরার ১১ ভুবনের ঘর, স্কুল ও ছাপার জন্য তৈরি ডিজিটাল লার্নিং প্যাক। ৮৮টি কার্যপত্র, ৩৩টি bonus asset, গাইড ও উত্তরপত্রের downloadable বান্ডল।"
  schema={schema}
>
  <div class="wrap page">
    <p class="crumbs"><a href="/">পসরা</a> <span>/</span> ডিজিটাল প্যাক</p>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">ডাউনলোড বান্ডল · পরিবার ও শিক্ষক</p>
        <h1>এক বান্ডলে <em>শেখার পুরো ঘর</em></h1>
        <p class="lede">
          স্ক্রিনের ভেতরের পসরাকে টেবিলে, খাতায় আর ক্লাসে নিয়ে যাওয়ার জন্য ১১টি ভুবনের
          ছোট ছোট খেলার প্যাক। এক পাতায় এক কাজ, সঙ্গে কার্ড, গাইড আর উত্তরপত্র।
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/digital-pack/checkout/">চেকআউট প্রস্তুতি দেখো →</a>
          <a class="btn preview-cta" href="#preview">ভেতরের preview দেখুন ↓</a>
          <a class="btn" href="/family/#join">লঞ্চ তালিকায় নাম লেখাও</a>
          <a class="btn" href="/printables/">ফ্রি শিট আগে দেখো</a>
        </div>
        <p class="fine">একবারের মূল্য <b>৳{bn(bundle.priceBdt)}</b>। পেমেন্ট যাচাই হলে আপনার account-এ re-download access থাকবে।</p>
      </div>
      <div class="price-card" aria-label="বান্ডলের সারাংশ">
        <span class="price-kicker">১১ ভুবন · ১ বান্ডল</span>
        <strong>৳{bn(bundle.priceBdt)}</strong>
        <span>পেমেন্টের পর নিরাপদ member library access</span>
        <div class="stat-row"><b>{bn(bundle.activitySheets)}</b><span>টি কার্যপত্র</span></div>
        <div class="stat-row"><b>{bn(bundle.packs)}</b><span>টি বিষয়ভিত্তিক প্যাক</span></div>
        <div class="stat-row"><b>{bn(bundle.bonusSets)}</b><span>টি কার্ড, গাইড ও উত্তরপত্র</span></div>
      </div>
    </section>

    <section class="value-strip" aria-label="বান্ডলে কী আছে">
      <div><span aria-hidden="true">✦</span><b>প্রিন্ট-রেডি</b><small>A4 · রঙিন ও সাদা-কালো</small></div>
      <div><span aria-hidden="true">↺</span><b>স্ক্রিন থেকে দূরে</b><small>টেবিলে বসে, একসঙ্গে</small></div>
      <div><span aria-hidden="true">✓</span><b>উত্তরপত্রসহ</b><small>অভিভাবক ও শিক্ষক দুজনের জন্য</small></div>
      <div><span aria-hidden="true">∞</span><b>একবার কিনে</b><small>নিজের ঘরে যতবার দরকার</small></div>
    </section>

    <section class="sec preview" id="preview">
      <div class="sec-h">
        <p class="eyebrow">কেনার আগে দেখে নিন</p>
        <h2>ভেতরের পাতার এক ঝলক</h2>
        <p>এগুলো preview mock-up: আসল paid PDF-এর কাজের ধরন, জায়গা আর presentation দেখাবে, কিন্তু কোনো সম্পূর্ণ paid sheet ফ্রি করে দেবে না।</p>
      </div>
      <div class="preview-tabs" role="tablist" aria-label="ডিজিটাল প্যাক preview">
        <button class="preview-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="preview-sheets" id="tab-sheets">কার্যপত্র</button>
        <button class="preview-tab" type="button" role="tab" aria-selected="false" aria-controls="preview-bonus" id="tab-bonus">বোনাস asset</button>
        <button class="preview-tab" type="button" role="tab" aria-selected="false" aria-controls="preview-guide" id="tab-guide">অভিভাবক guide</button>
      </div>
      <div class="preview-panel is-active" id="preview-sheets" role="tabpanel" aria-labelledby="tab-sheets">
        <div class="sample-page" aria-label="কার্যপত্রের sample preview">
          <div class="sample-top"><span>পসরা · গণিত খেলাঘর</span><span>পাতা ০৩</span></div>
          <span class="sample-pill">আজকের ছোট মিশন</span>
          <h3>গুনে দেখো, তারপর মিলিয়ে দাও</h3>
          <p>ছবিগুলো গুনে সঠিক সংখ্যার সঙ্গে দাগ টানো। শেষে নিজের উত্তরটি একবার ব্যাখ্যা করো।</p>
          <div class="sample-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
          <div class="sample-lines"><span>আমার উত্তর</span><b></b><span>আমি কী দেখলাম?</span><b></b></div>
          <small>এক পাতায়: নির্দেশনা · কাজের জায়গা · নিজের ব্যাখ্যা</small>
        </div>
        <div class="preview-copy"><span class="preview-index">০১</span><h3>শিশু শুধু টিক দেবে না</h3><p>প্রতিটি sheet-এ ছোট action, আঁকার বা লেখার জায়গা এবং “আমি কী দেখলাম?” reflection থাকে।</p><span class="preview-meta">A4 · রঙিন বা সাদা-কালো · ১৫ মিনিট</span></div>
      </div>
      <div class="preview-panel" id="preview-bonus" role="tabpanel" aria-labelledby="tab-bonus" hidden>
        <div class="bonus-preview" aria-label="বোনাস asset sample preview"><span class="bonus-sticker">কেটে নাও</span><div class="bonus-card"><b>আজকের লক্ষ্য</b><span>আমি আজ যে কাজটি নিজে চেষ্টা করব</span><i></i></div><div class="bonus-card"><b>মিশন ব্যাজ</b><span>আমি দেখেছি · ভেবেছি · বানিয়েছি</span><i></i></div><div class="bonus-card"><b>আবার চেষ্টা</b><span>ভুল মানে নতুন clue</span><i></i></div></div>
        <div class="preview-copy"><span class="preview-index">০২</span><h3>শেখার পরে ঘরে থাকে</h3><p>Goal card, mission badge, routine board, tracker এবং answer key—শিশুকে আবার বসতে সাহায্য করে।</p><span class="preview-meta">কাট-আউট · wall card · family routine</span></div>
      </div>
      <div class="preview-panel" id="preview-guide" role="tabpanel" aria-labelledby="tab-guide" hidden>
        <div class="guide-preview" aria-label="অভিভাবক guide sample preview"><span class="guide-label">অভিভাবকের ১৫ মিনিট</span><h3>প্রথমে প্রশ্ন করুন</h3><p>“তুমি কী লক্ষ্য করলে?”</p><div><span>১</span>শিশুকে আগে চেষ্টা করতে দিন</div><div><span>২</span>ভুলের উত্তর না বলে একটি clue দিন</div><div><span>৩</span>শেষে শিশুর নিজের ভাষা শুনুন</div></div>
        <div class="preview-copy"><span class="preview-index">০৩</span><h3>শুধু worksheet নয়</h3><p>প্রতিটি pack-এ age-aware prompt, ব্যবহার-পদ্ধতি, উত্তরপত্র এবং ঘরে কীভাবে কথাটি তুলবেন তার guide থাকে।</p><span class="preview-meta">পরিবার · শিক্ষক · ছোট group</span></div>
      </div>
    </section>

    <section class="sec research">
      <div class="sec-h">
        <p class="eyebrow">কেন এই জিনিসগুলো</p>
        <h2>যে কাজগুলো মানুষ সত্যিই খুঁজে নেয়</h2>
        <p>শুধু সুন্দর পাতা নয় - প্রতিটি প্যাক এমন কাজকে ছোট করেছে, যা বাড়ি বা ক্লাসে বারবার দরকার হয়।</p>
      </div>
      <div class="signal-grid">
        <article><b>অক্ষর লিখতে শেখা</b><p>ট্রেসিং, কার, যুক্তবর্ণ, ডিকটেশন ও ছবি-শব্দ - শুরুর বাংলা শেখার সবচেয়ে ঘন চাহিদা।</p></article>
        <article><b>গোনা ও হিসাব</b><p>সংখ্যা, যোগ-বিয়োগ, আকার, সময়, মাপ আর টাকা - একই পাতায় দেখা ও করার সুযোগ।</p></article>
        <article><b>সোর্ট, লেবেল, উত্তর</b><p>বিজ্ঞান শেখায় বাছাই, অংশের নাম, জীবনচক্র, খাদ্যশৃঙ্খল এবং আলাদা উত্তরপত্র।</p></article>
        <article><b>রুটিন ও অনুভূতি</b><p>ভিজ্যুয়াল রুটিন, প্রথমে-তারপর, অনুভূতি, বন্ধুত্ব ও শান্ত হওয়ার কার্ড - বাড়ির কাজ সহজ করে।</p></article>
      </div>
    </section>

    <section class="sec packs" id="packs">
      <div class="sec-h">
        <p class="eyebrow">ভেতরে যা পাবেন</p>
        <h2>১১টি প্যাক, ১১ রকমের “আজ কী করব?”</h2>
        <p>প্রতিটি প্যাকে {bn(activitiesPerPack)}টি ছোট কার্যপত্র, {bn(bonusPerPack)}টি সহায়ক বোনাস এবং বয়স অনুযায়ী ব্যবহার-পদ্ধতি।</p>
      </div>
      <div class="pack-grid">
        {digitalPacks.map((p, i) => (
          <article class="pack" id={p.slug} style={`--pack:${p.color}`}>
            <div class="pack-top"><span class="pack-no">{bn(i + 1)}</span><span class="world">{p.world}</span></div>
            <h3>{p.title}</h3>
            <p class="hook">{p.hook}</p>
            <p class="audience">{p.audience}</p>
            <ul>
              {p.activities.map((a) => <li>{a}</li>)}
            </ul>
            <div class="bonus"><b>বোনাস</b><span>{p.bonus.join(' · ')}</span></div>
            <p class="outcome"><b>ফল:</b> {p.outcome}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sec bundle" id="bundle">
      <div>
        <p class="eyebrow">সবচেয়ে সহজ পছন্দ</p>
        <h2>আলাদা আলাদা নয় - সব ১১টি একসঙ্গে</h2>
        <p>আজ বাংলা লিখবে, কাল গাছ দেখবে, পরশু দোকান খেলবে। শিশুর আগ্রহ বদলালেও প্যাক বদলাতে হবে না।</p>
      </div>
      <div class="bundle-price"><span>একবারের মূল্য</span><b>৳{bn(bundle.priceBdt)}</b><small>পেমেন্ট যাচাই হলে member library-তে re-download</small><a class="btn btn-primary" href="/digital-pack/checkout/">নিরাপদ চেকআউট →</a></div>
    </section>

    <section class="sec honest">
      <h2>একটা সৎ কথা</h2>
      <p>এখনকার ৬টি ফ্রি শিট ফ্রিই থাকবে। ৳২৪৯ বান্ডল হবে তার ওপরের স্তর - আরও খেলা, কার্ড, উত্তরপত্র, অভিভাবক-গাইড আর ১১ ভুবনের ধারাবাহিক কাজ। পেমেন্ট গেটওয়ে চালু হলে লঞ্চ তালিকার মানুষ আগে জানবেন।</p>
      <a href="/family/#join">লঞ্চ তালিকায় নাম লেখাও →</a>
    </section>
  </div>
</Base>

<script>
  const previewTabs = [...document.querySelectorAll<HTMLButtonElement>('.preview-tab')];
  const previewPanels = [...document.querySelectorAll<HTMLElement>('.preview-panel')];
  previewTabs.forEach((tab) => tab.addEventListener('click', () => {
    previewTabs.forEach((t) => { t.classList.toggle('is-active', t === tab); t.setAttribute('aria-selected', String(t === tab)); });
    previewPanels.forEach((panel) => { const active = panel.id === tab.getAttribute('aria-controls'); panel.hidden = !active; panel.classList.toggle('is-active', active); });
  }));
</script>

<style>
  .page { padding-block: 1rem 4rem; display: flex; flex-direction: column; gap: 3rem; }
  .crumbs { font-size: 13px; color: var(--muted); }
  .crumbs span { margin: 0 .35rem; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(260px, .7fr); gap: 2rem; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: .85rem; }
  h1 { font-size: clamp(2.35rem, 6vw, 4.5rem); line-height: 1.08; max-width: 12ch; }
  h1 em { color: var(--brand); font-style: normal; }
  .lede { font-size: clamp(1.08rem, 2vw, 1.28rem); line-height: 1.72; color: var(--ink-2); max-width: 54ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .2rem; }
  .fine { color: var(--muted); font-size: 12px; line-height: 1.6; }
  .fine b { color: var(--brand-ink); }
  .price-card { background: linear-gradient(155deg, color-mix(in oklab, var(--brand) 26%, var(--panel)), var(--panel)); border: 1px solid color-mix(in oklab, var(--brand) 55%, var(--line)); border-radius: 26px; padding: 1.6rem; display: flex; flex-direction: column; gap: .7rem; box-shadow: 0 20px 50px rgba(0,0,0,.16); }
  .price-kicker { font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .12em; font-size: 11px; color: var(--brand-ink); }
  .price-card > strong { font-family: var(--font-display); font-size: clamp(3.2rem, 8vw, 5rem); line-height: .95; color: var(--ink); }
  .price-card > span:not(.price-kicker) { color: var(--ink-2); font-size: 14px; }
  .stat-row { display: flex; align-items: baseline; gap: .5rem; border-top: 1px solid var(--line-soft); padding-top: .6rem; }
  .stat-row b { font-family: var(--font-display); color: var(--brand); font-size: 1.5rem; }
  .stat-row span { color: var(--ink-2); font-size: 13px; }
  .value-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: .7rem; }
  .value-strip > div { display: grid; grid-template-columns: 28px 1fr; column-gap: .55rem; align-items: center; padding: .8rem .9rem; border: 1px solid var(--line-soft); border-radius: var(--r-sm); background: var(--panel); }
  .value-strip span { grid-row: span 2; color: var(--brand); font-size: 1.4rem; }
  .value-strip b { font-size: 14px; }
  .value-strip small { color: var(--muted); font-size: 11px; }
  .preview { scroll-margin-top: 1rem; }
  .preview-tabs { display: flex; flex-wrap: wrap; gap: .55rem; border-bottom: 1px solid var(--line-soft); padding-bottom: .65rem; }
  .preview-tab { border: 1px solid var(--line); border-radius: 999px; padding: .65rem 1rem; background: var(--panel); color: var(--ink-2); font: inherit; cursor: pointer; }
  .preview-tab:hover, .preview-tab:focus-visible { border-color: var(--brand); color: var(--brand-ink); }
  .preview-tab.is-active { background: var(--brand); border-color: var(--brand); color: var(--on-brand); font-weight: 700; }
  .preview-panel { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(240px, .75fr); gap: 1.5rem; align-items: stretch; }
  .preview-panel[hidden] { display: none; }
  .sample-page, .bonus-preview, .guide-preview { min-height: 300px; border: 1px solid color-mix(in oklab, var(--brand) 35%, var(--line)); border-radius: 20px; padding: 1.35rem; background: linear-gradient(145deg, color-mix(in oklab, var(--brand) 16%, var(--panel)), var(--panel)); box-shadow: 0 18px 40px rgba(0,0,0,.1); }
  .sample-page { position: relative; overflow: hidden; }
  .sample-page::after { content: ''; position: absolute; width: 180px; height: 180px; border-radius: 50%; right: -65px; top: -70px; background: color-mix(in oklab, var(--brand) 28%, transparent); }
  .sample-top { display: flex; justify-content: space-between; color: var(--muted); font-size: 11px; font-family: var(--font-mono); }
  .sample-pill, .guide-label, .bonus-sticker { display: inline-block; margin-top: 1.5rem; padding: .4rem .7rem; border-radius: 999px; background: var(--brand); color: var(--on-brand); font-size: 11px; font-weight: 700; }
  .sample-page h3 { max-width: 18ch; margin: .75rem 0 .35rem; font-size: clamp(1.4rem, 3vw, 2rem); }
  .sample-page p, .guide-preview p { color: var(--ink-2); line-height: 1.65; max-width: 50ch; }
  .sample-dots { display: flex; gap: .55rem; margin: 1.35rem 0; }
