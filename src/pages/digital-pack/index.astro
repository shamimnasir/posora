<script>
  const previewTabs = [...document.querySelectorAll<HTMLButtonElement>('.preview-tab')];
  const previewPanels = [...document.querySelectorAll<HTMLElement>('.preview-panel')];
  previewTabs.forEach((tab) => tab.addEventListener('click', () => {
    previewTabs.forEach((t) => { t.classList.toggle('is-active', t === tab); t.setAttribute('aria-selected', String(t === tab)); });
    previewPanels.forEach((panel) => { const active = panel.id === tab.getAttribute('aria-controls'); panel.hidden = !active; panel.classList.toggle('is-active', active); });
  }));
</script>

