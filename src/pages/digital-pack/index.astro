---
import Base from '../../layouts/Base.astro';
import { bundle, digitalPacks } from '../../data/digital-packs';
import { bn } from '../../lib/bn';
import { digitalPackOnSale } from '../../lib/shop';
import { library } from '../../lib/pack-files';

export const prerender = false;
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=120');

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'পসরা', item: 'https://posora.com/' },
      { '@type': 'ListItem', position: 2, name: 'ডিজিটাল প্যাক', item: 'https://posora.com/digital-pack/' },
    ],
  },
  {
    '@type': 'ItemList',
    name: bundle.title,
    numberOfItems: bundle.packs,
    itemListElement: digitalPacks.map((p, i) => ({
      '@type': 'ListItem', position: i + 1, name: p.title, description: p.hook,
      url: `https://posora.com/digital-pack/#${p.slug}`,
    })),
  },
];
const previewVersion = '20261031-real';
const workPages = digitalPacks.reduce((n, p) => n + p.workPages, 0);
const checkoutLive = digitalPackOnSale();
// Page and file counts come from the uploaded library, so they match the download.
const lib = await library();
---

<Base
  title={`৳${bn(bundle.priceBdt)} সব-ডাউনলোড বান্ডল`}
  description={`পসরার ১১টি ভুবনের ছাপার প্যাক${lib.totalPages ? `, মোট ${bn(lib.totalPages)} পাতা` : ''}: তথ্য-কার্ড, অনুশীলনী, কুইজ, উত্তরপত্র, সনদ আর অভিভাবকের গাইড। বিকাশে পেমেন্ট, সঙ্গে সঙ্গে ডাউনলোড।`}
  schema={schema}
>
  <div class="wrap page">
    <p class="crumbs"><a href="/">পসরা</a> <span>/</span> সব-ডাউনলোড বান্ডল</p>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">ডাউনলোড বান্ডল · পরিবার ও শিক্ষক</p>
        <h1>এক বান্ডলে <em>শেখার পুরো ঘর</em></h1>
        <p class="lede">
          পসরার ১১টি ভুবন এবার কাগজে। প্রতিটি পাতা সাইটের যাচাই করা পাঠ থেকে বানানো: কেটে রাখার
          তথ্য-কার্ড, শূন্যস্থান আর মিলানোর অনুশীলনী, কুইজ, আর সবশেষে আলাদা উত্তরপত্র। একবার কিনে
          ফোন বা কম্পিউটারে রেখে দিন, যতবার খুশি ছাপুন।
        </p>
        <div class="hero-actions">
          {checkoutLive
            ? <a class="btn btn-primary" href="/digital-pack/checkout/">বান্ডল নিন · ৳{bn(bundle.priceBdt)} →</a>
            : <a class="btn btn-primary" href="/family/#join">বিক্রি শুরুর খবর নিন →</a>}
          <a class="btn preview-cta" href="#preview">ভেতরের নমুনা দেখুন ↓</a>
          <a class="btn" href="/printables/">ফ্রি শিট আগে দেখো</a>
        </div>
        <p class="fine">
          {checkoutLive
            ? <>একবারের মূল্য <b>৳{bn(bundle.priceBdt)}</b>, বিকাশে। পেমেন্টের সঙ্গে সঙ্গে ডাউনলোড, পরে অ্যাকাউন্ট থেকে আবার।</>
            : <>প্রস্তাবিত এককালীন মূল্য <b>৳{bn(bundle.priceBdt)}</b>। ফাইল ও পেমেন্ট যাচাই শেষ না হওয়া পর্যন্ত এখনো অর্ডার নেওয়া হচ্ছে না।</>}
        </p>
      </div>
      <div class="price-card" aria-label="বান্ডলের সারাংশ">
        <span class="price-kicker">১১ ভুবন · ১ বান্ডল</span>
        <strong>৳{bn(bundle.priceBdt)}</strong>
        <span>{checkoutLive ? 'বিকাশে পেমেন্ট · সঙ্গে সঙ্গে ডাউনলোড' : 'এখনো বিক্রি শুরু হয়নি · আগে নমুনা দেখে নিন'}</span>
        {lib.totalPages && <div class="stat-row"><b>{bn(lib.totalPages)}</b><span>টি ছাপার পাতা</span></div>}
        <div class="stat-row"><b>{bn(bundle.packs)}</b><span>টি ভুবনের প্যাক</span></div>
        <div class="stat-row"><b>{bn(lib.files.length)}</b><span>টি PDF, একটা ZIP-এও</span></div>
      </div>
    </section>

    <section class="value-strip" aria-label="বান্ডলে কী আছে">
      <div><span aria-hidden="true">✦</span><b>প্রিন্ট-রেডি</b><small>A4 · রঙিন ও সাদা-কালো</small></div>
      <div><span aria-hidden="true">↺</span><b>স্ক্রিন থেকে দূরে</b><small>টেবিলে বসে, একসঙ্গে</small></div>
      <div><span aria-hidden="true">✓</span><b>উত্তরপত্রসহ</b><small>অভিভাবক ও শিক্ষক দুজনের জন্য</small></div>
      <div><span aria-hidden="true">↓</span><b>সঙ্গে সঙ্গে ডাউনলোড</b><small>ফোন বা কম্পিউটারে, পরে অ্যাকাউন্ট থেকে আবার</small></div>
    </section>

    <aside class="free-worlds-note">
      <span aria-hidden="true">✦</span>
      <p><b>অনলাইন শেখার ভুবনগুলো আলাদা এবং ফ্রি।</b> মডেল দেখতে, বিষয় পড়তে ও ফ্রি ছাপার শিট ব্যবহার করতে কোনো কেনাকাটা লাগে না।</p>
      <a href="/#worlds">ফ্রি ভুবন ঘুরে দেখুন →</a>
    </aside>

    <section class="sec preview" id="preview">
      <div class="sec-h">
        <p class="eyebrow">কেনার আগে দেখে নিন</p>
        <h2>ভেতরের পাতার এক ঝলক</h2>
        <p>প্রতিটি কার্ডে সংশ্লিষ্ট প্যাকের নমুনা আছে। ট্রেসিং, সাজানো, মাপা, নকশা বা পরীক্ষার মতো কাজের ধরন আগে দেখে বেছে নিন।</p>
      </div>
      <div class="preview-tabs" role="tablist" aria-label="ডিজিটাল প্যাক preview">
        <button class="preview-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="preview-sheets" id="tab-sheets">কাজের পাতা</button>
        <button class="preview-tab" type="button" role="tab" aria-selected="false" aria-controls="preview-bonus" id="tab-bonus">দোকান খেলা</button>
        <button class="preview-tab" type="button" role="tab" aria-selected="false" aria-controls="preview-guide" id="tab-guide">অভিভাবকের গাইড</button>
      </div>
      <div class="preview-panel is-active" id="preview-sheets" role="tabpanel" aria-labelledby="tab-sheets">
        <figure class="real-preview"><img src={`/digital-pack-preview/math-worksheet.png?v=${previewVersion}`} alt="গণিত প্যাকের শূন্যস্থান পূরণের আসল পাতা" loading="lazy" /><figcaption>আসল PDF-এর পাতা · গণিত প্যাক, পৃষ্ঠা ১৫</figcaption></figure>
        <div class="preview-copy"><span class="preview-index">০১</span><h3>সাইটের পাঠ থেকেই প্রশ্ন</h3><p>প্রতিটি বিভাগের পাঠ পড়ার পর শব্দের ঝুড়ি থেকে শূন্যস্থান, তারপর মিলানো আর আট প্রশ্নের যাচাই। উত্তর প্যাকের শেষে, পৃষ্ঠা নম্বরসহ।</p><span class="preview-meta">A4 · সাদা পাতায় হালকা রং, কালি কম লাগে</span></div>
      </div>
      <div class="preview-panel" id="preview-bonus" role="tabpanel" aria-labelledby="tab-bonus" hidden>
        <figure class="real-preview"><img src={`/digital-pack-preview/math-bonus.png?v=${previewVersion}`} alt="গণিত প্যাকের দোকান খেলার আসল পাতা" loading="lazy" /><figcaption>আসল PDF-এর পাতা · বাংলাদেশের নোট-কয়েন আর দোকানের হিসাব</figcaption></figure>
        <div class="preview-copy"><span class="preview-index">০২</span><h3>হাতে-কলমে বিশেষ পাতা</h3><p>বাংলায় প্রতিটি বর্ণ, কার, ফলা আর ৩০টি যুক্তবর্ণ ট্রেসিং; গণিতে ০-১০০ সংখ্যার নাম, ঘড়ি পড়া আর দোকান খেলা; মহাকাশে গ্রহের আসল তথ্যের কার্ড।</p><span class="preview-meta">প্রতিটি ভুবনের সাইটের মিশনও কাগজে</span></div>
      </div>
      <div class="preview-panel" id="preview-guide" role="tabpanel" aria-labelledby="tab-guide" hidden>
        <figure class="real-preview"><img src={`/digital-pack-preview/math-guide.png?v=${previewVersion}`} alt="শুরু করার গাইডের আসল পাতা" loading="lazy" /><figcaption>আসল PDF-এর পাতা · অভিভাবকের শুরু করার গাইড</figcaption></figure>
        <div class="preview-copy"><span class="preview-index">০৩</span><h3>বড়দের জন্যও গুছানো</h3><p>শুরু করার গাইড, ৩০ দিনের পরিকল্পনা আর তারকা-চার্ট, ১২টি সনদ আর দেয়ালে টাঙানোর চার্ট। কোন দিন কোন পাতা, পরিকল্পনাতেই লেখা।</p><span class="preview-meta">পরিবার · শিক্ষক · ছোট দল</span></div>
      </div>
      <div class="preview-all-head"><h3>১১টি প্যাকের আলাদা নমুনা</h3><span>কার্ড খুলে বড় করে দেখুন</span></div>
      <div class="preview-grid">
        {digitalPacks.map((p) => (
          <a class="pack-preview-card" href={`/digital-pack-preview/${p.slug}.png?v=${previewVersion}`} target="_blank" rel="noreferrer" style={`--pack:${p.color}`}>
            <img src={`/digital-pack-preview/${p.slug}.png?v=${previewVersion}`} alt={`${p.title} আসল কাজের পাতার নমুনা`} loading="lazy" />
            <span class="pack-preview-info"><b>{p.title}</b><small>{bn(p.pdfPages)} পাতা · তার {bn(p.workPages)}টিতে লেখার কাজ</small><em>বড় করে দেখুন ↗</em></span>
          </a>
        ))}
      </div>
    </section>

    <section class="sec pack-standard" id="every-pack">
      <div class="sec-h"><p class="eyebrow">প্রতিটি প্যাকে যা থাকছে</p><h2>পড়া, লেখা, যাচাই, তারপর উত্তর</h2><p>প্রতিটি পাতা পসরার যাচাই করা পাঠ থেকে বানানো। নতুন কোনো তথ্য বানিয়ে বসানো হয়নি, তাই সাইটে যা পড়ে, কাগজেও তাই পায়।</p></div>
      <div class="standard-grid">
        <article><b>📖 পড়ো: কেটে রাখার কার্ড</b><p>প্রতিটি বিষয়ের নাম, মূল শব্দ, ছোট পাঠ আর একটা মজার তথ্য, কার্ডের মতো কেটে রাখা যায়।</p></article>
        <article><b>✏️ অনুশীলনী</b><p>শব্দের ঝুড়ি থেকে শূন্যস্থান পূরণ, তারপর দাগ টেনে মিলাও। প্রতিটি বিভাগে একটা করে।</p></article>
        <article><b>✅ আট প্রশ্নের যাচাই</b><p>চার বিকল্পের প্রশ্ন, নিচে নম্বর লেখার ঘর। সাইটের যাচাইয়ের মতোই।</p></article>
        <article><b>🧩 কাগজের মিশন</b><p>সাইটের মিশনগুলো কাগজে: সাজাও, মেলাও, হিসাব করো, চিনে নাও, পথ খোঁজো।</p></article>
        <article><b>🔑 শেষে পূর্ণ উত্তরপত্র</b><p>সব উত্তর প্যাকের শেষে, প্রতিটির পাশে কাজের পৃষ্ঠা নম্বর। পাতার উল্টো পিঠে উত্তর নেই।</p></article>
        <article><b>📅 গাইড, পরিকল্পনা, সনদ</b><p>শুরু করার গাইড, ৩০ দিনের পরিকল্পনা, ১২টি সনদ আর দেয়ালের চার্ট বান্ডলে আলাদা।</p></article>
      </div>
    </section>

    <section class="sec packs" id="packs">
      <div class="sec-h">
        <p class="eyebrow">ভেতরে যা পাবেন</p>
        <h2>১১টি প্যাক, ১১ রকমের “আজ কী করব?”</h2>
        <p>১১টি প্যাকে মোট {bn(workPages)}টি লেখার পাতা, প্রতিটির শেষে উত্তরপত্র। পুরো বান্ডলে আলাদা করে শুরু করার গাইড, ৩০ দিনের পরিকল্পনা, সনদ আর দেয়ালের চার্ট আছে।</p>
      </div>
      <div class="pack-grid">
        {digitalPacks.map((p, i) => (
          <article class="pack" id={p.slug} style={`--pack:${p.color}`}>
            <div class="pack-top"><span class="pack-no">{bn(i + 1)}</span><span class="world">{p.world}</span></div>
            <h3>{p.title}</h3>
            <p class="hook">{p.hook}</p>
            <p class="audience">{p.audience}</p>
            <ul>
              {p.activities.map((a) => <li>{a}</li>)}
            </ul>
            <div class="bonus"><b>বোনাস</b><span>{p.bonus.join(' · ')}</span></div>
            <p class="outcome"><b>ফল:</b> {p.outcome}</p>
            <a class="pack-free-link" href={`/${p.worldSlug}/`}>এই বিষয়ের ফ্রি অনলাইন ভুবন →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="sec bundle" id="bundle">
      <div>
        <p class="eyebrow">সবচেয়ে সহজ পছন্দ</p>
        <h2>আলাদা আলাদা নয় - সব ১১টি একসঙ্গে</h2>
        <p>আজ বাংলা লিখবে, কাল গাছ দেখবে, পরশু দোকান খেলবে। শিশুর আগ্রহ বদলালেও প্যাক বদলাতে হবে না।</p>
      </div>
      <div class="bundle-price"><span>{checkoutLive ? 'একবারের মূল্য' : 'প্রস্তাবিত এককালীন মূল্য'}</span><b>৳{bn(bundle.priceBdt)}</b><small>{checkoutLive ? 'বিকাশে পেমেন্ট, সঙ্গে সঙ্গে ডাউনলোড' : 'বিক্রি শুরু হলে জানাব, নমুনা এখনই দেখুন'}</small>{checkoutLive ? <a class="btn btn-primary" href="/digital-pack/checkout/">নিরাপদ চেকআউট →</a> : <a class="btn btn-primary" href="/family/#join">বিক্রির খবর নিন →</a>}</div>
    </section>

    <section class="sec honest">
      <h2>একটি জরুরি কথা</h2>
      <p>ফ্রি শিট আর অনলাইন ভুবন ফ্রিই থাকবে। এই বান্ডলে আছে ১১টি ভুবনের ছাপার প্যাক{lib.totalPages ? `, মোট ${bn(lib.totalPages)} পাতা` : ''}, প্রতিটির শেষে উত্তরপত্র, সঙ্গে সনদ, শুরু করার গাইড ও ৩০ দিনের পরিকল্পনা। প্রতিটি তথ্য সাইটের যাচাই করা পাঠ থেকে নেওয়া।{checkoutLive ? '' : ' বিক্রি এখনো শুরু হয়নি।'}</p>
