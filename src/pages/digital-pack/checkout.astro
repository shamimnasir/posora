---
import Base from '../../layouts/Base.astro';
import { digitalPackReady, usableGateways, liveGateways, DIGITAL_PACK_AMOUNT } from '../../lib/shop';
import { library } from '../../lib/pack-files';
import { bn } from '../../lib/bn';

export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store');
const rails = usableGateways();
const filesReady = digitalPackReady();
const ready = filesReady && rails.length > 0;
// A rail in sandbox mode takes no real money; say so plainly on the page.
const testMode = ready && liveGateways().length === 0;
const lib = await library();
const bkashError = Astro.url.searchParams.get('e') === 'bkash';
---

<Base title="সব-ডাউনলোড বান্ডল চেকআউট" description="পসরা সব-ডাউনলোড বান্ডলের নিরাপদ চেকআউট: বিকাশে পেমেন্ট, সঙ্গে সঙ্গে ডাউনলোড।" noindex>
  <div class="wrap page">
    <p class="crumbs"><a href="/digital-pack/">সব-ডাউনলোড বান্ডল</a> <span>/</span> চেকআউট</p>
    <div class="checkout-grid">
      <section class="card intro">
        <p class="eyebrow">পসরা সব-ডাউনলোড বান্ডল</p>
        <h1>চেকআউট</h1>
        <p class="lede">১১টি ভুবনের ছাপার প্যাক, তথ্য-কার্ড, অনুশীলনী, কুইজ, উত্তরপত্র, সনদ আর অভিভাবকের গাইড, সব এক ডাউনলোডে।</p>
        <div class="order"><span>একবারের দাম, কোনো সাবস্ক্রিপশন নয়</span><b>৳{bn(DIGITAL_PACK_AMOUNT)}</b></div>
        <ul>
          <li>পেমেন্টের সঙ্গে সঙ্গে এই পাতাতেই ডাউনলোড খুলবে, ফোনে বা কম্পিউটারে</li>
          <li>{lib.totalPages ? `মোট ${bn(lib.totalPages)} পাতা, ` : ''}{bn(lib.files.length)}টি PDF, একটা ZIP-এও</li>
          <li>ইমেইলেও ডাউনলোড লিংক যাবে; পরে অ্যাকাউন্ট থেকে আবার নামানো যাবে</li>
          <li>বিকাশের পিন বা কার্ডের তথ্য পসরা কখনো দেখে না, জমাও রাখে না</li>
        </ul>
        <a href="/digital-pack/">বান্ডলে কী কী আছে দেখো →</a>
      </section>

      {ready ? (
        <form class="card form" id="checkout-form" novalidate>
          {testMode && <p class="test">পরীক্ষামূলক মোড: এখন কোনো আসল টাকা কাটা হবে না।</p>}
          {bkashError && <p class="msg">বিকাশ থেকে ফেরার সময় অর্ডারটি খুঁজে পাওয়া যায়নি। আবার চেষ্টা করুন।</p>}
          <h2>আপনার তথ্য</h2>
          <p class="note">ডাউনলোড লিংক আর রসিদ এই ইমেইলে যাবে, আর ফাইলগুলো এই ইমেইলের অ্যাকাউন্টে থাকবে।</p>
          <label>আপনার নাম <input name="name" required minlength="2" maxlength="100" autocomplete="name" /></label>
          <label>ইমেইল <input name="email" type="email" required maxlength="254" autocomplete="email" inputmode="email" /></label>
          <label>বিকাশ / মোবাইল নম্বর <input name="phone" required minlength="6" maxlength="24" autocomplete="tel" inputmode="tel" placeholder="01XXXXXXXXX" /></label>
          <div class="hp"><label for="website-hp">Website</label><input id="website-hp" name="website" tabindex="-1" autocomplete="off" /></div>
          {rails.includes('bkash') && (
            <button class="btn btn-primary pay bkash" type="submit" data-rail="bkash">বিকাশে ৳{bn(DIGITAL_PACK_AMOUNT)} পেমেন্ট করুন →</button>
          )}
          {rails.includes('sslcommerz') && (
            <button class={`btn pay ${rails.includes('bkash') ? '' : 'btn-primary'}`} type="submit" data-rail="sslcommerz">{rails.includes('bkash') ? 'কার্ড, নগদ বা অন্য উপায়ে পেমেন্ট করুন' : `৳${bn(DIGITAL_PACK_AMOUNT)} পেমেন্ট করুন →`}</button>
          )}
          <p class="msg" id="checkout-msg" role="status" aria-live="polite"></p>
          {rails.includes('bkash') && <p class="fine">বোতাম চাপলে বিকাশের নিজের পাতা খুলবে। সেখানে বিকাশ নম্বর, ওটিপি আর পিন দিলেই পেমেন্ট হবে, তারপর আপনি এখানে ফিরে এসে ফাইল নামাবেন।</p>}
          <p class="fine">পেমেন্ট বাতিল বা ব্যর্থ হলে কোনো টাকা নেওয়া হয় না। অর্ডার দিলে <a href="/terms/">ব্যবহারের শর্ত</a> আর <a href="/privacy/">গোপনীয়তা নীতি</a> মেনে নিচ্ছেন।</p>
        </form>
      ) : (
        <section class="card setup">
          <p class="eyebrow">চেকআউট প্রস্তুত হচ্ছে</p>
          <h2>{rails.length === 0 ? 'পেমেন্ট এখনো চালু হয়নি' : 'ফাইল প্রকাশের কাজ চলছে'}</h2>
          <p>{rails.length === 0 ? 'বিকাশ পেমেন্ট চালু হলেই এই পাতায় চেকআউট খুলবে। এখন কোনো টাকা নেওয়া হচ্ছে না।' : 'পেমেন্ট নেওয়ার আগে সব ফাইল প্রকাশ করা হবে। প্রস্তুত হলেই এই পাতায় চেকআউট খুলবে।'}</p>
          <a class="btn btn-primary" href="/family/#join">খবর পেতে নাম লেখাও →</a>
        </section>
      )}
    </div>
  </div>
</Base>

{ready && <script>
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const msg = document.getElementById('checkout-msg')!;
  const buttons = [...form.querySelectorAll<HTMLButtonElement>('button.pay')];
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const rail = ((event as SubmitEvent).submitter as HTMLButtonElement | null)?.dataset.rail ?? buttons[0]?.dataset.rail ?? 'bkash';
    if (!form.reportValidity()) return;
    msg.textContent = rail === 'bkash' ? 'বিকাশের পাতা খুলছে...' : 'চেকআউট তৈরি হচ্ছে...';
    buttons.forEach((b) => { b.disabled = true; });
    const body = Object.fromEntries(new FormData(form).entries());
    try {
      const response = await fetch(`/api/${rail}/checkout`, {
        method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body),
      });
      const data = await response.json() as { ok?: boolean; gatewayUrl?: string; error?: string };
      if (data.ok && data.gatewayUrl) { location.href = data.gatewayUrl; return; }
      msg.textContent = data.error === 'invalid' ? 'নাম, ইমেইল আর মোবাইল নম্বর ঠিক করে দিন।' : 'পেমেন্ট এখন শুরু করা যাচ্ছে না। একটু পরে আবার চেষ্টা করুন।';
    } catch { msg.textContent = 'যোগাযোগে সমস্যা হয়েছে। একটু পরে আবার চেষ্টা করুন।'; }
    buttons.forEach((b) => { b.disabled = false; });
  });
</script>}

<style>
  .page { padding-block: 1rem 4rem; }
  .crumbs { font-size: 13px; color: var(--muted); margin-bottom: 2rem; }
  .crumbs span { margin: 0 .35rem; }
  .checkout-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(300px, 1fr); gap: 1.2rem; align-items: start; max-width: 960px; margin: 0 auto; }
  .intro, .form, .setup { padding: 1.5rem; }
  h1 { font-size: clamp(2.3rem, 5vw, 3.6rem); line-height: 1.1; }
  h2 { font-size: 1.35rem; }
  .lede, .intro li, .intro > a, .setup p, .note { color: var(--ink-2); line-height: 1.7; }
  .order { display: flex; justify-content: space-between; align-items: baseline; padding: .9rem 0; margin: .8rem 0; border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); }
  .order b { font-family: var(--font-display); color: var(--brand-ink); font-size: 2rem; }
  .intro ul { padding-left: 1.1rem; margin: 1rem 0 1.2rem; }
  .form { display: flex; flex-direction: column; gap: .8rem; }
  label { display: flex; flex-direction: column; gap: .3rem; font-size: 13px; color: var(--ink-2); }
  input { font: inherit; font-size: 15px; padding: .62rem .75rem; border-radius: 10px; border: 1px solid var(--line); background: var(--panel-2); color: var(--ink); }
  input:focus { outline: 2px solid var(--brand); outline-offset: 1px; border-color: transparent; }
  .note, .fine, .msg { font-size: 12.5px; }
  .fine { color: var(--muted); }
  .msg { min-height: 1.4em; color: var(--brand-ink); }
  button:disabled { opacity: .6; cursor: wait; }
  .setup { background: var(--brand-soft); }
  .setup p { margin: .5rem 0 1rem; }
  .pay { width: 100%; justify-content: center; }
  .bkash { background: #e2136e; border-color: #e2136e; color: #fff; }
  .bkash:hover { background: #c40f5f; }
  .test { margin: 0; padding: .55rem .8rem; border-radius: 10px; background: color-mix(in oklab, var(--sun) 25%, transparent); color: var(--ink); font-size: 13px; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  @media (max-width: 720px) { .checkout-grid { grid-template-columns: 1fr; } }
</style>
