---
/**
 * Where bKash and SSLCommerz send the buyer back. A paid order with its
 * download key in the URL shows the files right here, so the buyer can save
 * them on the phone or computer they paid from without signing in. Everything
 * else is a plain status message; nothing on this page changes an order.
 */
import Base from '../../layouts/Base.astro';
import PackDownloads from '../../components/PackDownloads.astro';
import { orderByTran, orderForKey, DOWNLOAD_KEY_DAYS } from '../../lib/shop';
import { bn } from '../../lib/bn';

export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');
const status = Astro.url.searchParams.get('status') ?? 'unknown';
const tranId = (Astro.url.searchParams.get('tran_id') ?? '').slice(0, 40);
const key = Astro.url.searchParams.get('k') ?? '';
const paid = tranId && key ? await orderForKey(tranId, key) : null;
const order = paid ?? (tranId ? await orderByTran(tranId).catch(() => null) : null);
const state = paid ? 'paid'
  : order?.status === 'paid' ? 'paid-nokey'
  : order?.status === 'held' || status === 'review' ? 'review'
  : status === 'cancelled' || order?.status === 'cancelled' ? 'cancelled'
  : status === 'pending' || order?.status === 'pending' ? 'pending'
  : 'failed';
const title = { paid: 'পেমেন্ট সফল! ফাইল তৈরি', 'paid-nokey': 'পেমেন্ট সফল', review: 'অর্ডার যাচাই হচ্ছে', cancelled: 'পেমেন্ট বাতিল হয়েছে', pending: 'পেমেন্ট এখনো নিশ্চিত হয়নি', failed: 'পেমেন্ট সম্পূর্ণ হয়নি' }[state];
const via = order?.gateway === 'bkash' ? 'বিকাশ' : 'SSLCommerz';
const query = paid ? `?order=${encodeURIComponent(paid.tran_id)}&k=${key}` : '';
---

<Base title={title} description="পসরা সব-ডাউনলোড বান্ডলের অর্ডারের অবস্থা।" noindex>
  <div class="wrap page">
    <section class={`card box ${paid ? 'wide' : ''}`}>
      <p class="eyebrow">পসরা সব-ডাউনলোড বান্ডল</p>
      <h1>{title}</h1>
      {state === 'paid' && paid ? (
        <>
          <p>আপনার ৳{bn(paid.amount_bdt)} পেমেন্ট {via} দিয়ে যাচাই হয়েছে{paid.bank_tran_id ? ` (ট্রানজেকশন ${paid.bank_tran_id})` : ''}। এখনই নিচ থেকে ফাইলগুলো এই ফোন বা কম্পিউটারে নামিয়ে নিন।</p>
          <PackDownloads query={query} />
          <p class="note">এই পাতার লিংক {bn(DOWNLOAD_KEY_DAYS)} দিন কাজ করবে, আর একই লিংক {paid.customer_email}-এ ইমেইলেও পাঠানো হয়েছে। পরে যেকোনো সময় <a href="/account/">অ্যাকাউন্ট</a> পাতায় এই ইমেইল দিয়ে ঢুকলে আবার নামাতে পারবেন।</p>
        </>
      ) : state === 'paid-nokey' ? (
        <>
          <p>এই অর্ডারের পেমেন্ট যাচাই হয়েছে। ফাইলগুলো পাবেন অর্ডারের ইমেইলে পাঠানো লিংকে, অথবা অর্ডারের ইমেইল দিয়ে অ্যাকাউন্টে ঢুকে।</p>
          <a class="btn btn-primary" href="/account/">অ্যাকাউন্টে যাও →</a>
        </>
      ) : state === 'review' ? (
        <p>পেমেন্টটি অতিরিক্ত যাচাইয়ের জন্য আটকে আছে। যাচাই শেষ না হওয়া পর্যন্ত ফাইল খুলবে না; প্রয়োজনে আমরা যোগাযোগ করব।</p>
      ) : state === 'cancelled' ? (
        <>
          <p>আপনি পেমেন্ট বন্ধ করেছেন। কোনো টাকা কাটা হয়নি, চাইলে আবার চেষ্টা করতে পারেন।</p>
          <a class="btn btn-primary" href="/digital-pack/checkout/">আবার চেষ্টা করো →</a>
        </>
      ) : state === 'pending' ? (
        <>
          <p>পেমেন্টের ফল এখনো আমাদের কাছে পৌঁছায়নি। টাকা কাটা গেলে কয়েক মিনিটের মধ্যে ইমেইলে ডাউনলোড লিংক পাবেন। না পেলে নিচের অর্ডার নম্বরসহ <a href="/contact/">যোগাযোগ</a> করুন, আমরা মিলিয়ে দেখব।</p>
        </>
      ) : (
        <>
          <p>পেমেন্ট সম্পূর্ণ হয়নি, তাই কোনো টাকা নেওয়া হয়নি। টাকা কাটা গেছে মনে হলে নিচের অর্ডার নম্বরসহ আমাদের <a href="/contact/">যোগাযোগ</a> করুন।</p>
          <a class="btn btn-primary" href="/digital-pack/checkout/">আবার চেষ্টা করো →</a>
        </>
      )}
      {tranId && <p class="fine">অর্ডার: {tranId}</p>}
      <p class="back"><a href="/digital-pack/">বান্ডলে ফিরে যাও</a> · <a href="/">পসরার হোম</a></p>
    </section>
  </div>
</Base>

<style>
  .page { padding-block: 3rem 5rem; display: grid; place-items: center; }
  .box { width: min(100%, 560px); padding: 1.6rem; display: flex; flex-direction: column; gap: .8rem; }
  .box.wide { width: min(100%, 760px); }
  h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; }
  p { color: var(--ink-2); line-height: 1.7; }
  .note { font-size: 14px; color: var(--muted); }
  .note a, p a { color: var(--brand-ink); }
  .fine { color: var(--muted); font-family: var(--font-mono); font-size: 11px; overflow-wrap: anywhere; }
  .back { font-size: 13px; color: var(--muted); }
</style>
