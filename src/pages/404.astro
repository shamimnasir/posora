---
import Base from '../layouts/Base.astro';

// Rendered on demand so the runtime world/space routes can Astro.rewrite() into
// it when a slug is unknown or still a draft - a prerendered route can't be a
// rewrite target from an on-demand one.
export const prerender = false;
Astro.response.status = 404;
---
<Base title="পাওয়া যায়নি" description="এই পাতাটি নেই।" noindex>
  <div class="wrap nf">
    <p class="eyebrow" style="--w:var(--brand)">৪০৪</p>
    <h1>এই কক্ষপথে কিছু নেই</h1>
    <p>পাতাটা হয়তো সরে গেছে, নয়তো ঠিকানায় ভুল। মহাকাশে ফিরে যাও, ওখানে অনেক কিছু আছে।</p>
    <div class="cta"><a class="btn btn-primary" href="/space/">মহাকাশে যাও</a><a class="btn" href="/">হোম</a></div>
  </div>
</Base>
<style>
  .nf { padding-block: 5rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.8rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); }
  p { color: var(--ink-2); max-width: 40ch; }
  .cta { display: flex; gap: 0.6rem; margin-top: 0.5rem; }
</style>
