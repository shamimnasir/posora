---
import Admin from '../../layouts/Admin.astro';
import { isLoggedIn } from '../../lib/auth';
import { db, recentAudit, selectWorlds } from '../../lib/db';
import { computeTotals, itemCount } from '../../lib/content';
import { bn, bnNum } from '../../lib/bn';
import { recentLetters, weekKey } from '../../lib/weekly';

export const prerender = false;

if (!(await isLoggedIn(Astro))) return Astro.redirect('/admin/login');

const d = db()!;
const all = await selectWorlds(d, false);
const seeded = all.length > 0;
const live = all.filter((w) => w.status === 'published');
const drafts = all.filter((w) => w.status === 'draft');
const totals = computeTotals(live);
const activity = await recentAudit(d, 6);
// The letters already sent. A run that shows nothing new is not a failure:
// the cron sends once a week and a repeat run is meant to be a no-op.
const letters = await recentLetters(8).catch(() => []);
const thisWeek = weekKey();
const sentThisWeek = letters.filter((l) => l.week === thisWeek).length;

const when = (ms: number) => new Intl.DateTimeFormat('bn-BD', { dateStyle: 'medium', timeStyle: 'short' }).format(ms);
/**
 * `weekKey()` is an ISO date because it is a database key. Printing it raw
 * put "2026-09-07" in front of a reader for whom every other date on this
 * panel reads ১২ সেপ, ২০২৬. Formatted in UTC so the day shown is the day the
 * key means, wherever the page is rendered.
 */
const weekWhen = (iso: string) =>
  new Intl.DateTimeFormat('bn-BD', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`));
const lastEdit = all.reduce((m, w) => Math.max(m, w.updatedAt), 0);
---

<Admin title="ড্যাশবোর্ড" section="dashboard">
  <div class="a-wrap">
    <h1 class="a-h">ড্যাশবোর্ড</h1>
    <p class="a-sub">
      {seeded ? `শেষ সম্পাদনা: ${lastEdit ? when(lastEdit) : '-'}` : 'ডেটাবেস এখনো খালি।'}
    </p>

    {
      !seeded && (
        <div class="card">
          <h2>প্রথম ধাপ</h2>
          <p>
            ডেটাবেসে এখনো কোনো ভুবন নেই। নিচের বোতামে ক্লিক করলে <code>src/data/</code>-এর বর্তমান সব
            কনটেন্ট D1-এ চলে আসবে। এতে সাইটের কিছুই বদলাবে না - শুধু সম্পাদনাযোগ্য হবে।
          </p>
          <button class="btn btn-primary" id="seed" type="button">কনটেন্ট আমদানি করো</button>
          <p class="note" id="seed-out"></p>
        </div>
      )
    }

    <div class="stat-row" style="margin-bottom:18px">
      <div class="s"><b>{bn(live.length)}</b><span>লাইভ ভুবন</span></div>
      <div class="s"><b>{bn(drafts.length)}</b><span>খসড়া</span></div>
      <div class="s"><b>{bn(totals.cats)}</b><span>বিভাগ</span></div>
      <div class="s"><b>{bnNum(totals.items)}</b><span>আইটেম</span></div>
    </div>

    <div class="card">
      <div class="spread" style="margin-bottom:14px">
        <h2 style="margin:0">ভুবনসমূহ</h2>
        <a class="btn btn-sm" href="/admin/worlds">সব দেখো →</a>
      </div>
      {
        seeded ? (
          <table class="a-list">
            <thead>
              <tr><th>নাম</th><th>বিভাগ</th><th>আইটেম</th><th>অবস্থা</th></tr>
            </thead>
            <tbody>
              {all.slice(0, 6).map((w) => (
                <tr>
                  <td>
                    <span class="swatch" style={`background:${w.hue}`} />
                    <a class="nm" href={`/admin/worlds/${w.slug}`}>{w.bn}</a>
                  </td>
                  <td>{bn(w.cats.length)}</td>
                  <td>{bn(itemCount(w))}</td>
                  <td>
                    <span class={`pill ${w.status === 'published' ? 'live' : 'draft'}`}>
                      {w.status === 'published' ? 'লাইভ' : 'খসড়া'}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="note">আমদানির পরে এখানে তালিকা দেখা যাবে।</p>
        )
      }
    </div>

    <div class="card">
      <h2>সপ্তাহের চিঠি</h2>
      <p class="note">
        প্রতি <b>শুক্রবার সকাল ৯টায়</b> (ঢাকা) নিজে থেকেই চলে যায়, পরিবার প্ল্যান চালু আছে এমন
        প্রতিটি অ্যাকাউন্টে - শুধু সেই সপ্তাহে, যে সপ্তাহে সত্যিই কিছু হয়েছে। চুপচাপ সপ্তাহে
        কোনো মেইল যায় না। এক সপ্তাহে একজন একটার বেশি চিঠি পাবেন না, তাই নিচের বোতাম
        চাপলেও আগের পাঠানো চিঠি আবার যাবে না।
      </p>
      <p class="note">
        এই সপ্তাহে ({weekWhen(thisWeek)} থেকে) পাঠানো হয়েছে <b>{bn(sentThisWeek)}টি</b>।
        হাতে চালাতে হলে আগে "দেখে নাও" চেপে লেখাটা পড়ুন, তারপর পাঠান।
      </p>
      <div class="wrow">
        <button type="button" class="btn" id="letter-dry">দেখে নাও (পাঠাবে না)</button>
        <button type="button" class="btn btn-primary" id="letter-send">সবাইকে পাঠাও</button>
      </div>
      <p class="note" id="letter-out" role="status" aria-live="polite"></p>
      <pre class="letter-pre" id="letter-pre" hidden></pre>

      {letters.length > 0 && (
        <table class="a-list">
          <tbody>
            {letters.map((l) => (
              <tr>
                <td style="width:34%"><b>{l.email ?? l.member_id}</b></td>
                <td class="note" style="padding-top:11px">{l.subject ?? ''}</td>
                <td style="text-align:right;white-space:nowrap" class="note">{when(l.sent_at)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      <p class="note">
        সময় বদলাতে হলে <code>wrangler.jsonc</code>-এ <code>triggers.crons</code>।
        চলার সময় দেখতে <code>npx wrangler tail</code>।
        বাইরের কোনো শিডিউলার থেকেও চালানো যায়: <code>CRON_SECRET</code> সেট করে
        <code>POST /api/cron/weekly</code>, হেডারে <code>Authorization: Bearer …</code>।
      </p>
    </div>

    {
      activity.length > 0 && (
        <div class="card">
          <h2>সাম্প্রতিক কার্যক্রম</h2>
          <table class="a-list">
            <tbody>
              {activity.map((a) => (
                <tr>
                  <td style="width:44%"><code>{a.action}</code> {a.target && <b>{a.target}</b>}</td>
                  <td class="note" style="padding-top:11px">{a.detail ?? ''}</td>
                  <td style="text-align:right;white-space:nowrap" class="note">{when(a.at)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</Admin>

<script>
  const btn = document.getElementById('seed') as HTMLButtonElement | null;
  const out = document.getElementById('seed-out');
  btn?.addEventListener('click', async () => {
    btn.disabled = true;
    if (out) out.textContent = 'আমদানি চলছে…';
    try {
      const res = await fetch('/api/admin/seed', { method: 'POST' });
      const data = (await res.json()) as { ok?: boolean; created?: number; error?: string };
      if (!res.ok || !data.ok) throw new Error(data.error ?? `HTTP ${res.status}`);
      if (out) out.textContent = `${data.created}টি ভুবন আমদানি হয়েছে। পেজ রিলোড হচ্ছে…`;
      location.reload();
    } catch (e) {
      btn.disabled = false;
      if (out) out.textContent = `ব্যর্থ: ${(e as Error).message}`;
    }
  });

  /* ---- the weekly letter ---- */
  type Run = { ok?: boolean; error?: string; members?: number; sent?: number; quiet?: number; already?: number; failed?: number;
    preview?: { to: string; subject: string; text: string }[] };
  const lOut = document.getElementById('letter-out');
  const lPre = document.getElementById('letter-pre') as HTMLPreElement | null;
  const run = async (dry: boolean) => {
    const dryBtn = document.getElementById('letter-dry') as HTMLButtonElement;
    const sendBtn = document.getElementById('letter-send') as HTMLButtonElement;
    if (!dry && !confirm('প্রতিটি পরিবার প্ল্যান অ্যাকাউন্টে চিঠি চলে যাবে। পাঠাব?')) return;
    dryBtn.disabled = sendBtn.disabled = true;
    if (lOut) lOut.textContent = dry ? 'চিঠি তৈরি হচ্ছে…' : 'পাঠানো হচ্ছে…';
    try {
      const res = await fetch(`/api/cron/weekly${dry ? '?dry=1' : ''}`, { method: 'POST' });
      const data = (await res.json()) as Run;
      if (!res.ok || !data.ok) throw new Error(data.error ?? `HTTP ${res.status}`);
      if (lOut) lOut.textContent = dry
        ? `${data.members}টি অ্যাকাউন্ট, ${data.preview?.length ?? 0}টি চিঠি তৈরি, ${data.quiet}টি চুপচাপ সপ্তাহ। কিছু পাঠানো হয়নি।`
        : `পাঠানো ${data.sent}টি · আগেই পাঠানো ছিল ${data.already}টি · চুপচাপ সপ্তাহ ${data.quiet}টি · ব্যর্থ ${data.failed}টি। পাতা রিলোড করলে নিচের তালিকা আপডেট হবে।`;
      if (lPre) {
        const list = data.preview ?? [];
        lPre.hidden = list.length === 0;
        lPre.textContent = list.map((p) => `→ ${p.to}\n${p.subject}\n${'-'.repeat(40)}\n${p.text}`).join('\n\n');
      }
    } catch (e) {
      if (lOut) lOut.textContent = `ব্যর্থ: ${(e as Error).message}`;
    } finally {
      dryBtn.disabled = sendBtn.disabled = false;
    }
  };
  document.getElementById('letter-dry')?.addEventListener('click', () => void run(true));
  document.getElementById('letter-send')?.addEventListener('click', () => void run(false));
</script>

<style>
  .wrow { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.8rem; }
  .letter-pre { margin-top: 0.9rem; padding: 0.9rem 1rem; border-radius: 10px; background: var(--sunk); border: 1px solid var(--line-soft);
    font-family: var(--font-mono); font-size: 12px; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; max-height: 420px; overflow-y: auto; }
</style>
