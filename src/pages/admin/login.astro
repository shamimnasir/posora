---
import Admin from '../../layouts/Admin.astro';
import { isLoggedIn } from '../../lib/auth';
import { dbEnv } from '../../lib/db';
import { googleReady } from '../../lib/google-auth';

export const prerender = false;

if (await isLoggedIn(Astro)) return Astro.redirect('/admin');

const env = dbEnv();
const google = googleReady();
/**
 * The password is the way back in when Google is not an option: a misconfigured
 * OAuth client, a Google outage, an address that changed. Losing the only door
 * you have is the failure this panel has already had once.
 */
const password = !!env.ADMIN_PASSWORD_HASH;
const noDb = !env.DB;
const noWay = !noDb && !google && !password;
const error = Astro.url.searchParams.get('e');
const messages: Record<string, string> = {
  bad: 'পাসওয়ার্ড মেলেনি।',
  locked: 'অনেকবার ভুল হয়েছে। কিছুক্ষণ পরে আবার চেষ্টা করো।',
  setup: 'অ্যাডমিন এখনো সেটআপ হয়নি।',
  gsetup: 'Google লগইন এখনো সেটআপ হয়নি।',
  gstate: 'লগইনটা শেষ হয়নি। আবার চেষ্টা করো।',
  gdenied: 'এই Google অ্যাকাউন্টের অনুমতি নেই।',
};
---

<Admin title="লগইন" bare>
  <div class="a-wrap login-box">
    <div class="card">
      <h1 class="a-h">পসরা অ্যাডমিন</h1>
      <p class="a-sub">সাইট পরিচালনা করতে লগইন করো।</p>

      {error && <p class="err">{messages[error] ?? 'লগইন ব্যর্থ হয়েছে।'}</p>}

      {noDb && (
        <>
          <p class="err">D1 ডেটাবেস বাঁধা হয়নি (binding `DB`)।</p>
          <p class="note">README-এর “Admin setup” অংশ দেখো।</p>
        </>
      )}

      {noWay && (
        <>
          <p class="err">কোনো লগইন পদ্ধতি সেট করা হয়নি।</p>
          <p class="note">
            Google-এর জন্য GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET আর ADMIN_EMAILS,
            অথবা পাসওয়ার্ডের জন্য ADMIN_PASSWORD_HASH। README-এর “Admin setup” দেখো।
          </p>
        </>
      )}

      {google && (
        <form method="post" action="/api/admin/oauth/start">
          <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center">
            Google দিয়ে ঢোকো
          </button>
        </form>
      )}

      {google && password && <p class="note or">অথবা</p>}

      {password && (
        <form method="post" action="/api/admin/login">
          <label class="f">
            <span>পাসওয়ার্ড</span>
            <input type="password" name="password" autocomplete="current-password" required autofocus={!google} />
          </label>
          <button class="btn" type="submit" style="width:100%;justify-content:center">লগইন</button>
        </form>
      )}
    </div>
  </div>
</Admin>

<style is:global>
  .login-box .or { text-align: center; margin: 0.9rem 0 0.6rem; }
</style>
