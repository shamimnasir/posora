      }
      // the image lands upside down, which is the surprising part
      rays.appendChild(el('line', { x1: EX + ER - 10, y1: EY + 6, x2: EX + ER - 10, y2: EY + 26, stroke: W, 'stroke-width': 4, 'stroke-linecap': 'round' }));
      rays.appendChild(el('polygon', { points: `${EX + ER - 10},${EY + 32} ${EX + ER - 5},${EY + 20} ${EX + ER - 15},${EY + 20}`, fill: W }));
      out.innerHTML = `জিনিসটা চোখ থেকে <b>${num(dist / 22)} মিটার</b> দূরে। লেন্স এখন <b>${dist < 140 ? 'মোটা' : 'পাতলা'}</b> হয়ে ছবিটা রেটিনার উপর ফেলছে।`
        + `<span class="cost">খেয়াল করো রেটিনার ছবিটা উল্টো। মস্তিষ্ক সেটা সোজা করে দেখায় - এতটাই অভ্যস্ত যে আমরা টেরও পাই না। কাছের জিনিস বেশিক্ষণ দেখলে চোখ ক্লান্ত লাগে, কারণ লেন্সের পেশিটা তখন টানটান থাকে।</span>`;
      credit('চোখ কীভাবে দেখে');
    }
    dragPoint({
      surface: svg, handle: arrow, view: { w: 620, h: 260 },
      bounds: { x0: 40, y0: EY, x1: EX - ER - 60, y1: EY },
      x: ox, y: EY, step: 12, label: 'জিনিসটা',
      onChange: (x) => { ox = x; render(); },
    });
    render();
  })();

  /* ---------- বর্ণান্ধতা ---------- */
  (function colourBlind() {
    const svg = $<SVGSVGElement>('#cb-svg');
    const row = el('g'); svg.appendChild(row);
    const out = $('#cb-out');
    const jumps = [...root.querySelectorAll<HTMLButtonElement>('#chokh .jump')];
    const SAMPLE: [number, number, number, string][] = [
      [224, 59, 47, 'লাল'], [232, 118, 44, 'কমলা'], [232, 198, 44, 'হলুদ'],
      [74, 168, 67, 'সবুজ'], [63, 127, 196, 'নীল'], [125, 63, 181, 'বেগুনি'], [140, 92, 60, 'বাদামি'],
    ];
    let mode = 'normal';

    /**
     * A rough stand-in, not a medical simulation: each kind of colour blindness
     * is shown by pulling one channel toward the average of the other two, which
     * gets the confusions roughly right without pretending to be exact.
     */
    function shift([r, g, b]: [number, number, number]): string {
      if (mode === 'protan') { const m = (g + b) / 2; return `rgb(${Math.round(r * 0.35 + m * 0.65)},${g},${b})`; }
      if (mode === 'deutan') { const m = (r + b) / 2; return `rgb(${r},${Math.round(g * 0.35 + m * 0.65)},${b})`; }
      if (mode === 'tritan') { const m = (r + g) / 2; return `rgb(${r},${g},${Math.round(b * 0.35 + m * 0.65)})`; }
      return `rgb(${r},${g},${b})`;
    }

    function render() {
      row.replaceChildren();
      SAMPLE.forEach((s, i) => {
        const x = 40 + i * 82;
        row.appendChild(el('rect', { x, y: 24, width: 64, height: 64, rx: 10, fill: shift([s[0], s[1], s[2]]) }));
        text(row, x + 32, 108, s[3], { 'font-size': 11 });
      });
      out.innerHTML = mode === 'normal'
        ? `স্বাভাবিক দৃষ্টিতে সাতটা রংই আলাদা দেখাচ্ছে। উপরের বোতামগুলো চেপে দেখো একেক রকম বর্ণান্ধতায় কোনগুলো মিলে যায়।`
        : `${mode === 'protan' ? 'লাল' : mode === 'deutan' ? 'সবুজ' : 'নীল'} কোনগুলো দুর্বল হলে পাশাপাশি রংগুলো কাছাকাছি হয়ে আসে - আলাদা করা কঠিন।`
          + `<span class="cost">প্রায় বারোজন ছেলের একজনের কোনো না কোনো বর্ণান্ধতা থাকে, মেয়েদের অনেক কম। এটা রোগ নয়, আর এজন্যই ভালো নকশায় শুধু রঙের উপর ভরসা করা হয় না - সঙ্গে লেখা বা আকার থাকে। এই ছবিটা আন্দাজের, ডাক্তারি পরীক্ষা নয়।</span>`;
      credit('বর্ণান্ধতা');
    }
    jumps.forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.v!;
      jumps.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }));
    jumps[0]!.setAttribute('aria-pressed', 'true');
    render();
  })();

  // Everything above has drawn its first frame; from here a change is a choice.
  live = true;
</script>
