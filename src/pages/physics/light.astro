            // where they only appear to have come from
            const k = (42 - surf) / (fy - surf);
            para.appendChild(el('line', { x1: x, y1: surf, x2: x + (x - CX) * Math.abs(k) * 1.4, y2: 42, stroke: RAY, 'stroke-width': 1.6, 'stroke-opacity': 0.7 }));
            para.appendChild(el('line', { x1: x, y1: surf, x2: CX, y2: fy, stroke: RAY, 'stroke-width': 1.2, 'stroke-dasharray': '4 4', 'stroke-opacity': 0.4 }));
