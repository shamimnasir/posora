---
import Base from '../../layouts/Base.astro';

export const prerender = true;

const HUE = '#2E7EA8';
---
<Base
  title="আলো"
  description="টর্চের সামনে জিনিসটা সরাও আর ছায়া বড় হোক। আয়নায় কোণ মাপো, পানিতে রশ্মি বাঁকাও, প্রিজমে সাত রং ছড়াও, আর দেখো চোখ কীভাবে সবটা করে।"
  hue={HUE}
>
  <div class="wrap page" id="lab">
    <p class="crumbs"><a href="/#worlds">ভুবন</a> <span>/</span> <a href="/physics/">পদার্থবিজ্ঞান</a> <span>/</span> আলো</p>

    <header class="head">
      <p class="eyebrow">পদার্থবিজ্ঞান ভুবন · বিভাগ পরিচিতি</p>
      <h1>আলো</h1>
      <p class="lede">
        আলো সোজা চলে - এই একটা কথা থেকেই ছায়া, আয়না, লেন্স, রংধনু সব বেরিয়ে আসে।
        নিচের প্রতিটাতে রশ্মিটা সত্যিকারের নিয়ম মেনে আঁকা হয়েছে, তাই যা টানবে তাই ঘটবে।
      </p>
      <nav class="quicknav" aria-label="দ্রুত যাওয়ার তালিকা">
        <a href="#chhaya" class="pill pill-w">ছায়া</a>
        <a href="#protifolon" class="pill pill-w">আয়না</a>
        <a href="#protisoron" class="pill pill-w">প্রতিসরণ ও লেন্স</a>
        <a href="#rongdhonu" class="pill pill-w">রং</a>
        <a href="#chokh" class="pill pill-w">চোখ</a>
      </nav>
    </header>

    <div class="tools">
      <!-- ১. সরলরেখায় চলা ও ছায়া -->
      <section class="tool card" id="chhaya">
        <h2><span class="no">০১</span> <span id="sorolrekha">সরলরেখায় চলা</span> ও ছায়া</h2>
        <p class="how">
          টর্চ থেকে আলো সোজা যায়, বাঁক নেয় না। মাঝের জিনিসটা ধরে টানো - টর্চের যত কাছে
          নেবে, ছায়া তত বড় হবে। কেন, সেটা রশ্মিগুলো দেখলেই বোঝা যায়।
        </p>
        <div class="wide">
          <svg id="shadow-svg" viewBox="0 0 620 300" role="img" aria-label="টর্চ, জিনিস আর দেয়াল"></svg>
        </div>
        <p class="readout" id="shadow-out" aria-live="polite"></p>
      </section>

      <!-- ২. প্রতিফলন ও আয়না -->
      <section class="tool card" id="protifolon">
        <h2><span class="no">০২</span> প্রতিফলন, <span id="somotol">সমতল</span> ও <span id="golio">গোলীয় আয়না</span></h2>
        <p class="how">
          আয়নায় পড়া রশ্মি যে কোণে আসে, ঠিক সেই কোণেই ফিরে যায়। রশ্মিটা ঘুরিয়ে দুটো
          কোণ মিলিয়ে দেখো। তারপর আয়নাটা বাঁকিয়ে দেখো সমান্তরাল রশ্মিগুলোর কী হয়।
        </p>
        <div class="wide">
          <svg id="mirror-svg" viewBox="0 0 620 300" role="img" aria-label="আয়না, রশ্মির কোণ টেনে বদলাও"></svg>
        </div>
        <div class="ctl-row">
          <label>আয়নার বাঁক
            <input type="range" id="curve" min="-60" max="60" step="5" value="0" aria-label="আয়নার বাঁক" />
            <b id="curve-v" class="num">০</b>
          </label>
        </div>
        <p class="readout" id="mirror-out" aria-live="polite"></p>
      </section>

      <!-- ৩. প্রতিসরণ ও লেন্স -->
      <section class="tool card" id="protisoron">
        <h2><span class="no">০৩</span> প্রতিসরণ ও <span id="lens">লেন্স</span></h2>
        <p class="how">
          আলো এক মাধ্যম থেকে আরেকটায় ঢুকলে গতি বদলায়, আর তাতেই বেঁকে যায়। সেজন্যই
          পানিতে রাখা কাঠি ভাঙা দেখায়। রশ্মিটা ঘুরিয়ে দেখো কতটা বাঁকছে।
        </p>
        <div class="two">
          <svg id="refr-svg" viewBox="0 0 320 280" role="img" aria-label="পানিতে ঢোকা রশ্মি"></svg>
          <div class="side">
            <p class="readout" id="refr-out" aria-live="polite"></p>
          </div>
        </div>
        <p class="strip-h">লেন্স</p>
        <div class="wide">
          <svg id="lens-svg" viewBox="0 0 620 250" role="img" aria-label="লেন্স, ফোকাস টেনে বদলাও"></svg>
        </div>
        <p class="readout" id="lens-out" aria-live="polite"></p>
      </section>

      <!-- ৪. রংধনু ও রঙের মিশ্রণ -->
      <section class="tool card" id="rongdhonu">
        <h2><span class="no">০৪</span> রংধনু ও <span id="rong">রঙের মিশ্রণ</span></h2>
        <p class="how">
          সাদা আলো আসলে সাত রঙের মিশেল। প্রিজমে ঢুকলে প্রতিটা রং আলাদা কোণে বাঁকে, তাই
          আলাদা হয়ে যায়। নিচের তিনটে হাতল দিয়ে উল্টোটাও করে দেখো - রং মিশিয়ে সাদা বানাও।
        </p>
        <div class="wide">
          <svg id="prism-svg" viewBox="0 0 620 250" role="img" aria-label="প্রিজম, সাদা আলো ছড়িয়ে সাত রং"></svg>
        </div>
        <div class="ctl-row">
          <label>লাল <input type="range" id="r" min="0" max="255" step="5" value="255" aria-label="লাল আলো" /> <b id="r-v" class="num">২৫৫</b></label>
          <label>সবুজ <input type="range" id="g" min="0" max="255" step="5" value="255" aria-label="সবুজ আলো" /> <b id="g-v" class="num">২৫৫</b></label>
          <label>নীল <input type="range" id="b" min="0" max="255" step="5" value="255" aria-label="নীল আলো" /> <b id="b-v" class="num">২৫৫</b></label>
        </div>
        <p class="readout" id="mix-out" aria-live="polite"></p>
      </section>

      <!-- ৫. চোখ -->
      <section class="tool card" id="chokh">
        <h2><span class="no">০৫</span> চোখ কীভাবে দেখে ও <span id="bornandhota">বর্ণান্ধতা</span></h2>
        <p class="how">
          চোখ একটা লেন্সওয়ালা ক্যামেরা। জিনিসটা কাছে এলে লেন্স মোটা হয়, দূরে গেলে পাতলা -
          তাতেই ছবিটা রেটিনার উপর ঠিক জায়গায় পড়ে। জিনিসটা টেনে সরাও।
        </p>
        <div class="wide">
          <svg id="eye-svg" viewBox="0 0 620 260" role="img" aria-label="চোখ, জিনিসটা টেনে কাছে-দূরে নাও"></svg>
        </div>
        <p class="readout" id="eye-out" aria-live="polite"></p>
        <p class="strip-h">বর্ণান্ধতা</p>
        <p class="how">
          রেটিনায় তিন রকম কোন থাকে - লাল, সবুজ আর নীলের জন্য। কারও কারও একটা ঠিকমতো কাজ
          করে না, তখন কিছু রং আলাদা করা কঠিন হয়ে যায়। বোতামে চেপে দেখো ছবিটা তখন কেমন লাগে।
        </p>
        <div class="jumps" role="group" aria-label="দৃষ্টি বাছো">
          <button type="button" class="jump" data-v="normal">স্বাভাবিক</button>
          <button type="button" class="jump" data-v="protan">লাল কম দেখা</button>
          <button type="button" class="jump" data-v="deutan">সবুজ কম দেখা</button>
          <button type="button" class="jump" data-v="tritan">নীল কম দেখা</button>
        </div>
        <div class="wide">
          <svg id="cb-svg" viewBox="0 0 620 150" role="img" aria-label="রঙের নমুনা"></svg>
        </div>
        <p class="readout" id="cb-out" aria-live="polite"></p>
      </section>
    </div>

    <p class="back"><a href="/physics/">← পদার্থবিজ্ঞান ভুবনে ফিরে যাও</a></p>
  </div>
</Base>

<style>
  .page { padding-block: 1rem 3rem; }
  .crumbs { font-size: 13px; color: var(--muted); margin-bottom: 0.75rem; }
  .crumbs span { margin: 0 0.35rem; }
  .head { padding-bottom: 1.5rem; border-bottom: 1px solid var(--line-soft); margin-bottom: 1.75rem; }
  .head h1 { font-size: clamp(2rem, 4.5vw, 3rem); margin: 0.2rem 0 0.6rem; }
  .lede { color: var(--ink-2); max-width: 62ch; font-size: 15.5px; line-height: 1.8; }
  .quicknav { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 1.1rem; }
  .quicknav .pill { font-size: 13px; }

  .tools { display: flex; flex-direction: column; gap: 1rem; }
  .tool { padding: 1.4rem 1.6rem 1.6rem; }
  .tool h2 { font-size: 20px; margin-bottom: 0.4rem; }
  .tool .no { font-family: var(--font-mono); font-size: 12px; color: var(--w); font-weight: 500; margin-right: 0.5rem; }
  .how { color: var(--muted); font-size: 13.5px; margin-bottom: 1.1rem; max-width: 62ch; line-height: 1.75; }
  .readout { margin-top: 0.9rem; font-size: 15px; color: var(--ink-2); line-height: 1.8; }
  .readout :global(b) { color: var(--ink); font-family: var(--font-display); font-size: 17px; }
  .readout :global(.cost) { color: var(--muted); font-size: 13.5px; display: block; margin-top: 0.15rem; }
  .strip-h { font-size: 12px; color: var(--muted); margin: 1.4rem 0 0.5rem; font-weight: 600; }

  .wide { overflow-x: auto; padding-bottom: 4px; }
  .wide svg { width: 100%; min-width: 440px; height: auto; display: block; touch-action: none; }
  .two { display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); gap: 1.6rem; align-items: center; }
  .two svg { width: 100%; height: auto; display: block; touch-action: none; }
  .side { display: flex; flex-direction: column; gap: 0.6rem; }

  .ctl-row { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 1rem; }
  label { font-size: 13.5px; color: var(--ink-2); display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  input[type="range"] { accent-color: var(--w); min-width: 7rem; flex: 1; }

  .jumps { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1rem; }
  .jump {
    font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer;
    padding: 0.35rem 0.75rem; border-radius: 999px;
    border: 1px solid var(--line); background: var(--panel-2); color: var(--ink-2);
  }
  .jump:hover { background: color-mix(in oklab, var(--w) 14%, var(--panel-2)); color: var(--ink); }
  .jump[aria-pressed="true"] { background: var(--w); border-color: var(--w); color: var(--on-brand); }
  .tool :global([role="slider"]:focus-visible),
  .tool :global([role="button"]:focus-visible) { outline: 2px solid var(--w); outline-offset: 2px; }

  .back { margin-top: 2rem; font-size: 14px; color: var(--muted); }
  .back a:hover { color: var(--brand-ink); }

  @media (max-width: 640px) { .two { grid-template-columns: 1fr; } }

  /* A finger is not a mouse pointer: the chips and tiles get a real target
     height on touch screens, where they were about thirty pixels tall. */
  @media (pointer: coarse) {
    .jump { min-height: 44px; padding-inline: 0.9rem; }
  }
</style>

<script>
  import { bn } from '../../lib/bn';
  import { svgEl as el, clamp, dragTrack, dragPoint, alongX, aroundCentre, useItem } from '../../lib/handson';

  const root = document.getElementById('lab')!;
  const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
  const WORLD = 'physics', CAT = 'আলো';
  let live = false;
  const credit = (item: string) => { if (live) useItem(WORLD, CAT, item); };
  const num = (n: number) => bn(n.toFixed(Math.abs(n) < 10 ? 1 : 0));

  const INK = 'var(--ink)', MUTED = 'var(--muted)', LINE = 'var(--line)', SOFT = 'var(--panel-2)', W = 'var(--w)';
  const RAY = '#e8a33d';
  const text = (p: SVGElement, x: number, y: number, s: string, o: Record<string, string | number> = {}) => {
    const t = el('text', { x, y, 'font-size': 12, fill: MUTED, 'text-anchor': 'middle', ...o });
    t.textContent = s; p.appendChild(t); return t;
  };
  const grip = () => {
    const g = el('g');
    g.append(
      el('rect', { x: -24, y: -24, width: 48, height: 48, fill: 'transparent' }),
      el('circle', { r: 12, fill: W }),
      el('circle', { r: 4, fill: 'var(--panel)' }),
    );
    return g;
  };

  /* ---------- ১. ছায়া ---------- */
  (function shadow() {
    const svg = $<SVGSVGElement>('#shadow-svg');
    const LAMP = 60, WALL = 540, CY = 140, OBJ_H = 44;
    svg.appendChild(el('rect', { x: WALL, y: 20, width: 26, height: 250, fill: SOFT, stroke: LINE, 'stroke-width': 2 }));
    text(svg, WALL + 13, 288, 'দেয়াল');
    const rays = el('g'); svg.appendChild(rays);
    const shade = el('rect', { x: WALL, fill: INK, 'fill-opacity': 0.55 });
    svg.appendChild(shade);
    svg.appendChild(el('circle', { cx: LAMP, cy: CY, r: 14, fill: RAY }));
    for (let i = 0; i < 8; i++) {
      const a = (i / 8) * Math.PI * 2;
      svg.appendChild(el('line', { x1: LAMP + Math.cos(a) * 18, y1: CY + Math.sin(a) * 18, x2: LAMP + Math.cos(a) * 24, y2: CY + Math.sin(a) * 24, stroke: RAY, 'stroke-width': 2.5, 'stroke-linecap': 'round' }));
    }
    text(svg, LAMP, 288, 'টর্চ');
    const obj = el('g');
    obj.append(
      el('rect', { x: -26, y: -26, width: 52, height: 52, fill: 'transparent' }),
      el('rect', { x: -9, y: -OBJ_H / 2, width: 18, height: OBJ_H, rx: 3, fill: W }),
    );
    svg.appendChild(obj);
    const out = $('#shadow-out');
    let ox = 250;

    function render() {
      obj.setAttribute('transform', `translate(${ox},${CY})`);
      // similar triangles: the shadow grows in the same ratio as the distances
      const scale = (WALL - LAMP) / Math.max(1, ox - LAMP);
      const sh = OBJ_H * scale;
      shade.setAttribute('y', String(CY - sh / 2));
      shade.setAttribute('height', String(sh));
      shade.setAttribute('width', '26');
      rays.replaceChildren();
      for (const s of [-1, 1]) {
        const y1 = CY + (s * OBJ_H) / 2, y2 = CY + (s * sh) / 2;
        rays.appendChild(el('line', { x1: LAMP, y1: CY, x2: WALL, y2, stroke: RAY, 'stroke-width': 2, 'stroke-opacity': 0.9 }));
        rays.appendChild(el('circle', { cx: ox, cy: y1, r: 2.5, fill: RAY }));
      }
      const d1 = (ox - LAMP) / 40, d2 = (WALL - LAMP) / 40;
      out.innerHTML = `টর্চ থেকে জিনিসটা <b>${num(d1)} মিটার</b>, দেয়াল <b>${num(d2)} মিটার</b>। জিনিসটা ${bn(Math.round(OBJ_H / 10))} সেমি লম্বা, ছায়া <b>${num(sh / 10)} সেমি</b> - ${num(scale)} গুণ বড়।`
        + `<span class="cost">আলো সোজা চলে বলেই দুই প্রান্তের রশ্মি দুটো ছড়িয়ে যায়, আর ছায়াটা দূরত্বের অনুপাতেই বড় হয়। টর্চের যত কাছে, তত বড়।</span>`;
      credit('সরলরেখায় চলা'); credit('ছায়া');
    }
    dragPoint({
      surface: svg, handle: obj, view: { w: 620, h: 300 },
      bounds: { x0: LAMP + 60, y0: CY, x1: WALL - 40, y1: CY },
      x: ox, y: CY, step: 10, label: 'জিনিসটা',
      onChange: (x) => { ox = x; render(); },
    });
    render();
  })();

  /* ---------- ২. আয়না ---------- */
  (function mirror() {
    const svg = $<SVGSVGElement>('#mirror-svg');
    const CX = 310, MY = 200;
    const face = el('path', { fill: 'none', stroke: INK, 'stroke-width': 4 });
    const back = el('path', { fill: MUTED, 'fill-opacity': 0.25, stroke: 'none' });
    svg.append(back, face);
    const normal = el('line', { stroke: MUTED, 'stroke-width': 1.6, 'stroke-dasharray': '5 4' });
    const inRay = el('line', { stroke: RAY, 'stroke-width': 3, 'stroke-linecap': 'round' });
    const outRay = el('line', { stroke: RAY, 'stroke-width': 3, 'stroke-linecap': 'round' });
    const para = el('g');
    svg.append(para, normal, inRay, outRay);
    const inLbl = text(svg, 0, 0, '', { fill: INK, 'font-weight': 700 });
    const outLbl = text(svg, 0, 0, '', { fill: INK, 'font-weight': 700 });
    svg.appendChild(el('line', { x1: 120, y1: 262, x2: 500, y2: 262, stroke: LINE, 'stroke-width': 3, 'stroke-linecap': 'round' }));
    const handle = grip(); svg.appendChild(handle);
    const curveIn = $<HTMLInputElement>('#curve'), curveV = $('#curve-v'), out = $('#mirror-out');
    let ang = 35;   // from the normal, in degrees

    function render() {
      const c = +curveIn.value;
      curveV.textContent = bn(c);
      handle.setAttribute('transform', `translate(${120 + (ang / 80) * 380},262)`);
      // The light arrives from above, so a mirror that cups toward it - middle
      // lower on screen than the edges - is the concave one. Bowing the middle
      // upward makes a dome, which is convex. Getting that backwards drew a
      // dome and called it অবতল.
      const HALF = 150;
      const sag = c * 0.9;                      // positive dips the middle away from the light
      const surfaceAt = (x: number) => MY + sag * (1 - ((x - CX) / HALF) ** 2);
      const vertex = MY + sag;
      const d = `M ${CX - HALF} ${MY} Q ${CX} ${MY + sag * 2} ${CX + HALF} ${MY}`;
      face.setAttribute('d', d);
      back.setAttribute('d', `${d} L ${CX + HALF} ${MY + 12} Q ${CX} ${MY + sag * 2 + 12} ${CX - HALF} ${MY + 12} Z`);
      normal.setAttribute('x1', String(CX)); normal.setAttribute('y1', String(vertex));
      normal.setAttribute('x2', String(CX)); normal.setAttribute('y2', String(vertex - 130));

      const rad = (ang * Math.PI) / 180, L = 150;
      inRay.setAttribute('x1', String(CX - Math.sin(rad) * L)); inRay.setAttribute('y1', String(vertex - Math.cos(rad) * L));
      inRay.setAttribute('x2', String(CX)); inRay.setAttribute('y2', String(vertex));
      outRay.setAttribute('x1', String(CX)); outRay.setAttribute('y1', String(vertex));
      outRay.setAttribute('x2', String(CX + Math.sin(rad) * L)); outRay.setAttribute('y2', String(vertex - Math.cos(rad) * L));
      inLbl.setAttribute('x', String(CX - Math.sin(rad) * 62 - 22)); inLbl.setAttribute('y', String(vertex - Math.cos(rad) * 62));
      inLbl.textContent = `${bn(ang)}°`;
      outLbl.setAttribute('x', String(CX + Math.sin(rad) * 62 + 22)); outLbl.setAttribute('y', String(vertex - Math.cos(rad) * 62));
      outLbl.textContent = `${bn(ang)}°`;

      // Parallel rays, so the focus is something you see rather than read
      // about. A shallow mirror's focal length is a quarter of half-width
      // squared over the sag, which is the half-radius rule written out.
      para.replaceChildren();
      if (c !== 0) {
        const f = HALF ** 2 / (4 * Math.abs(sag));
        const concave = sag > 0;
        const fy = concave ? vertex - f : vertex + f;
        for (let i = -2; i <= 2; i++) {
          if (i === 0) continue;                // the middle ray is the one already drawn
          const x = CX + i * 56;
          const surf = surfaceAt(x);
          para.appendChild(el('line', { x1: x, y1: 42, x2: x, y2: surf, stroke: RAY, 'stroke-width': 1.6, 'stroke-opacity': 0.5 }));
          if (concave) {
            para.appendChild(el('line', { x1: x, y1: surf, x2: CX, y2: fy, stroke: RAY, 'stroke-width': 1.6, 'stroke-opacity': 0.7 }));
          } else {
