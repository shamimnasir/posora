    const TOP = 40, BEAM_X0 = 40, BEAM_X1 = 320, REST = 150, TRAVEL = 110;
    svg.appendChild(el('rect', { x: BEAM_X0, y: TOP - 14, width: BEAM_X1 - BEAM_X0, height: 14, rx: 3, fill: SOFT, stroke: LINE }));
