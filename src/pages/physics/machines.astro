    text(svg, (TRI_X0 + TRI_X1) / 2, TRI_Y + 28, 'একই প্যাঁচ, খুলে সোজা করা', { 'font-size': 11 });
    const riseTxt = text(svg, TRI_X1 - 18, 0, '', { 'text-anchor': 'end', 'font-size': 11 });
    const grab = el('g');
    grab.append(
      el('rect', { x: -24, y: -24, width: 48, height: 48, fill: 'transparent' }),
