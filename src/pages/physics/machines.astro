      armR.setAttribute('x', String((fx + RIGHT) / 2)); armR.textContent = `তোমার বাহু ${num(effortArm / per)} মি`;

      out.innerHTML = `${bn(kg)} কেজি তুলতে দরকার <b>${num(need)} কেজি</b> বল। যান্ত্রিক সুবিধা <b>${num(ma)} গুণ</b>।`
        + `<span class="cost">বিনিময়ে তোমার হাতটা নামাতে হবে বোঝা যত ওঠে তার ${num(ma)} গুণ বেশি।</span>`;
