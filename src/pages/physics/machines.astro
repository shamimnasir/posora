    const wheel = el('g');
    const rim = el('circle', { cx: CX, cy: CY, fill: 'none', stroke: INK, 'stroke-width': 5, 'stroke-opacity': 0.8 });
    const spoke = el('line', { x1: CX, y1: CY, stroke: HUE, 'stroke-width': 5, 'stroke-linecap': 'round' });
    const knob = el('circle', { r: 9, fill: HUE });
    wheel.append(rim, spoke, knob);
    svg.appendChild(el('circle', { cx: CX, cy: CY, r: AXLE, fill: SOFT, stroke: LINE, 'stroke-width': 2 }));
    svg.appendChild(wheel);

    const rIn = $<HTMLInputElement>('#wheel-r'), rV = $('#wheel-r-v');
    const loadIn = $<HTMLInputElement>('#wheel-load'), loadV = $('#wheel-load-v'), out = $('#wheel-out');
    let turn = 0;   // degrees the handle has been wound

    function render() {
      const R = +rIn.value, kg = +loadIn.value;
      rV.textContent = bn(R); loadV.textContent = bn(kg);
      rim.setAttribute('r', String(R));
      const a = ((turn - 90) * Math.PI) / 180;
      const kx = CX + Math.cos(a) * R, ky = CY + Math.sin(a) * R;
      spoke.setAttribute('x2', String(kx)); spoke.setAttribute('y2', String(ky));
      knob.setAttribute('cx', String(kx)); knob.setAttribute('cy', String(ky));

      // winding the handle round once winds one axle circumference of rope
      const wound = (turn / 360) * 2 * Math.PI * AXLE;
      const by = clamp(240 - wound, CY + AXLE + 10, 240);
      rope.setAttribute('x1', String(CX + AXLE)); rope.setAttribute('y1', String(CY));
      rope.setAttribute('x2', String(CX + AXLE)); rope.setAttribute('y2', String(by));
      bucket.setAttribute('transform', `translate(${CX + AXLE},${by})`);

      const ma = R / AXLE, need = kg / ma;
      out.innerHTML = `চাকার ব্যাসার্ধ <b>${bn(R)} সেমি</b>, অক্ষের <b>${bn(AXLE)} সেমি</b> - সুবিধা <b>${num(ma)} গুণ</b>। ${bn(kg)} কেজির বালতি তুলতে হাতে লাগে <b>${num(need)} কেজি</b>।`
        + `<span class="cost">বদলে হাতটা ঘোরে বালতি যত ওঠে তার ${num(ma)} গুণ লম্বা পথ।</span>`;
      MA.wheel = { ma, cost: `হাত ${num(ma)} গুণ পথ ঘোরে` };
      drawTable();
    }

    const angleAt = aroundCentre(svg, 360, CX, CY);
    let last = 0;
    dragTrack({
      surface: svg, handle: wheel, min: 0, max: 1080, step: 5, value: 0,
      // A dial that must not wrap: the rope winds up, it does not teleport, so
      // an angle that jumps past twelve carries the whole turn with it.
      toValue: (x, y) => {
        const a = angleAt(x, y);
        let d = a - last;
        if (d > 180) d -= 360; else if (d < -180) d += 360;
        last = a;
        return turn + d;
      },
      onChange: (v) => { turn = v; render(); used('wheel'); },
      label: 'কুয়ার চাকা', text: () => `${num(turn / 360)} পাক ঘোরানো হয়েছে`,
    });
    wheel.addEventListener('pointerdown', (e) => { last = angleAt((e as PointerEvent).clientX, (e as PointerEvent).clientY); });
    rIn.addEventListener('input', () => { render(); used('wheel'); });
    loadIn.addEventListener('input', () => { render(); used('wheel'); });
    render();
  })();

  /* ---------- 7. গিয়ার ---------- */
  (function gears() {
    const svg = $<SVGSVGElement>('#gears-svg');
    const { w: W, h: H } = fitScene(svg, [480, 270], [340, 300]);
    const TEETH = [24, 12, 18];
    // The three gears in a row span twice the sum of their radii, so the module
    // is whatever makes that row fit the box it was given.
    const MODULE = Math.min(3.2, (W - 28) / (2 * TEETH.reduce((a, b) => a + b, 0)));
    const CY = H * 0.44;
    const R = TEETH.map((t) => t * MODULE);
    const LEFT = (W - 2 * (R[0]! + R[1]! + R[2]!)) / 2;
    const CXs = [LEFT + R[0]!, LEFT + 2 * R[0]! + R[1]!, LEFT + 2 * R[0]! + 2 * R[1]! + R[2]!];
    const COLOURS = [HUE, INK, HUE];

    /** A gear outline: alternating tips and roots round the circle. */
    const gearPoints = (r: number, teeth: number): string => {
      const pts: string[] = [];
      const steps = teeth * 4, root = r - MODULE * 2.1;
      for (let i = 0; i < steps; i++) {
        const a = (i / steps) * Math.PI * 2;
        const k = i % 4, rad = k === 1 || k === 2 ? r : root;
        pts.push(`${(Math.cos(a) * rad).toFixed(1)},${(Math.sin(a) * rad).toFixed(1)}`);
      }
      return pts.join(' ');
    };

    const groups = TEETH.map((teeth, i) => {
      const g = el('g');
      g.appendChild(el('polygon', { points: gearPoints(R[i]!, teeth), fill: COLOURS[i]!, 'fill-opacity': i === 1 ? 0.75 : 0.3, stroke: COLOURS[i]!, 'stroke-width': 2 }));
      g.appendChild(el('circle', { r: 9, fill: 'var(--panel)', stroke: LINE, 'stroke-width': 2 }));
      // one tooth marked, so a turn is visible rather than inferred
      g.appendChild(el('circle', { cx: 0, cy: -R[i]! + MODULE * 3, r: 5, fill: i === 1 ? 'var(--panel)' : COLOURS[i]! }));
      svg.appendChild(g);
      text(svg, CXs[i]!, H - 22, `${bn(teeth)} দাঁত`, { 'font-size': 11 });
      return g;
    });
    const grab = el('circle', { cx: CXs[0]!, cy: CY, r: R[0]!, fill: 'transparent' });
    svg.appendChild(grab);

    const out = $('#gears-out');
    let a0 = 0, last = 0;

    function render() {
      // meshed gears turn opposite ways, at the ratio of their tooth counts
      const a1 = -a0 * (TEETH[0]! / TEETH[1]!);
      const a2 = a0 * (TEETH[0]! / TEETH[2]!);
      const angles = [a0, a1, a2];
      groups.forEach((g, i) => g.setAttribute('transform', `translate(${CXs[i]},${CY}) rotate(${angles[i]})`));
      out.innerHTML = `বড় গিয়ার ঘুরেছে <b>${num(a0 / 360)} পাক</b>। ছোটটা ঘুরেছে <b>${num(Math.abs(a1) / 360)} পাক</b>, উল্টো দিকে। তৃতীয়টা <b>${num(Math.abs(a2) / 360)} পাক</b>।`
        + `<span class="cost">${bn(TEETH[0]!)} দাঁতের গিয়ার একবার ঘুরলে ${bn(TEETH[1]!)} দাঁতেরটা ঘোরে ${num(TEETH[0]! / TEETH[1]!)} বার - দাঁত যত কম, ঘোরা তত দ্রুত, বল তত কম।</span>`;
      MA.gears = { ma: TEETH[0]! / TEETH[1]!, cost: 'গতি বাড়ে, বল কমে' };
      drawTable();
    }

    const angleAt = aroundCentre(svg, W, CXs[0]!, CY);
    dragTrack({
      surface: svg, handle: grab, min: -3600, max: 3600, step: 5, value: 0,
      toValue: (x, y) => {
        const a = angleAt(x, y);
        let d = a - last;
        if (d > 180) d -= 360; else if (d < -180) d += 360;
        last = a;
        return a0 + d;
      },
      onChange: (v) => { a0 = v; render(); used('gears'); },
      label: 'বড় গিয়ার', text: () => `${num(a0 / 360)} পাক`,
    });
    grab.addEventListener('pointerdown', (e) => { last = angleAt((e as PointerEvent).clientX, (e as PointerEvent).clientY); });
    render();
  })();

  /* ---------- 8. যান্ত্রিক সুবিধা ---------- */
  (function advantage() {
    const NAMES: Record<string, string> = {
      lever: 'লিভার', pulley: 'কপিকল', ramp: 'ঢালু তল', screw: 'স্ক্রু', wedge: 'কীলক', wheel: 'চাকা ও অক্ষ', gears: 'গিয়ার',
    };
    const body = $('#ma-body');
    // Reading the seven cards above back as one table is the point of this
    // card: the rule is the same every time, only the shape changes.
    drawTable = () => {
      body.replaceChildren();
      for (const [key, name] of Object.entries(NAMES)) {
        const m = MA[key];
        if (!m) continue;
        const tr = document.createElement('tr');
        const td = (s: string, cls = '') => { const c = document.createElement('td'); c.textContent = s; if (cls) c.className = cls; return c; };
        const first = document.createElement('td'); first.textContent = name;
        tr.append(first, td(`${num(m.ma)} গুণ`, 'n'), td(m.cost, 'why'));
        body.appendChild(tr);
      }
    };
    drawTable();

    type Q = { q: string; unit: string; answer: number };
    const ASK: (() => Q)[] = [
      () => { const load = 20 + Math.round(Math.random() * 8) * 10, ma = 2 + Math.round(Math.random() * 6);
        return { q: `একটা লিভারের যান্ত্রিক সুবিধা ${bn(ma)} গুণ। ${bn(load)} কেজির একটা বস্তা তুলতে তোমার কত কেজি বল লাগবে?`, unit: 'কেজি', answer: load / ma }; },
      () => { const load = 30 + Math.round(Math.random() * 9) * 10, n = 2 + Math.round(Math.random() * 3);
        return { q: `একটা কপিকলে ${bn(n)}টা রশি বোঝাটা ধরে আছে। ${bn(load)} কেজি তুলতে কত কেজি বল লাগবে?`, unit: 'কেজি', answer: load / n }; },
      () => { const h = 1 + Math.round(Math.random() * 4) * 0.5, len = h * (2 + Math.round(Math.random() * 4));
        return { q: `একটা ঢালু তল ${num(len)} মিটার লম্বা আর ${num(h)} মিটার উঁচু। এর যান্ত্রিক সুবিধা কত গুণ?`, unit: 'গুণ', answer: len / h }; },
      () => { const load = 40 + Math.round(Math.random() * 8) * 10, force = 5 + Math.round(Math.random() * 3) * 5;
        return { q: `${bn(load)} কেজি বোঝা তুলতে তোমার বল লাগছে মাত্র ${bn(force)} কেজি। যন্ত্রটার যান্ত্রিক সুবিধা কত গুণ?`, unit: 'গুণ', answer: load / force }; },
      () => { const R = 40 + Math.round(Math.random() * 5) * 10, r = 5 + Math.round(Math.random() * 3) * 5;
        return { q: `কুয়ার চাকার ব্যাসার্ধ ${bn(R)} সেমি, অক্ষের ${bn(r)} সেমি। যান্ত্রিক সুবিধা কত গুণ?`, unit: 'গুণ', answer: R / r }; },
    ];

    const qEl = $('#ma-q'), unitEl = $('#ma-unit'), guess = $<HTMLInputElement>('#ma-guess'), out = $('#ma-out');
    let cur: Q = ASK[0]!();
    const paid = new Set<string>();
    function pick() { cur = ASK[Math.floor(Math.random() * ASK.length)]!(); qEl.textContent = cur.q; unitEl.textContent = cur.unit; guess.value = ''; out.textContent = ''; }

    $('#ma-check').addEventListener('click', () => {
      if (!guess.value) { out.textContent = 'আগে একটা সংখ্যা লেখো।'; return; }
      const g = +guess.value;
      const off = Math.abs(g - cur.answer) / cur.answer;
      const points = off < 0.02 ? 10 : off < 0.1 ? 6 : off < 0.25 ? 3 : 0;
      const word = off < 0.02 ? 'একদম ঠিক' : off < 0.1 ? 'প্রায় ঠিক' : off < 0.25 ? 'কাছাকাছি' : 'হলো না, আরেকবার কষে দেখো';
      const first = !paid.has(cur.q);
      if (first) paid.add(cur.q);
      out.innerHTML = `ঠিক উত্তর <b>${num(cur.answer)} ${cur.unit}</b>। ${word}।`
        + (first && points ? ` <b class="won">+${bn(points)} জ্ঞানবিন্দু</b>` : '');
      if (first && points) rewardCorrect(points);
      used('advantage');
    });
    $('#ma-next').addEventListener('click', pick);
    pick();
  })();

</script>
