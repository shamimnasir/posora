  /* ---------- 5. কীলক ---------- */
  (function wedge() {
    const svg = $<SVGSVGElement>('#wedge-svg');
    const { w: W, h: H } = fitScene(svg, [620, 250], [340, 280]);
    const LEN_PX = W * 0.21, LOG_X = W * 0.34, LOG_X1 = W * 0.9, MID = H * 0.5;
    const MM_PER_PX = 104 / LEN_PX;   // the wedge stays 104 mm long whatever the box
    const LOGH = H * 0.22;
    const half = (o: number) => el('rect', { x: LOG_X, y: 0, width: LOG_X1 - LOG_X, height: LOGH, rx: 4, fill: '#8a6b4a', 'fill-opacity': o });
    const top = half(0.85), bot = half(0.7);
    svg.append(top, bot);
    const wedgeShape = el('polygon', { fill: INK, 'fill-opacity': 0.85 });
    svg.appendChild(wedgeShape);
    // The wedge is drawn by moving its points rather than by a transform, so
    // the thing you grab is a separate pad that rides along with it. That also
    // gives the library something to widen for a fingertip; the polygon itself
    // is only twenty-odd pixels tall on a phone when the head is thin.
    const wedgeGrab = el('g');
    wedgeGrab.appendChild(el('rect', { x: -LEN_PX / 2, y: -26, width: LEN_PX, height: 52, fill: 'transparent' }));
    svg.appendChild(wedgeGrab);
    const hit = arrow(svg, MUTED);
    const splitA = arrow(svg, HUE), splitB = arrow(svg, HUE);
    text(svg, (LOG_X + LOG_X1) / 2, H - 14, 'কাঠের গুঁড়ি', { 'font-size': 11 });

    const wIn = $<HTMLInputElement>('#wedge-w'), wV = $('#wedge-w-v');
    const fIn = $<HTMLInputElement>('#wedge-f'), fV = $('#wedge-f-v'), out = $('#wedge-out');
    let depth = 45;   // how far in, 0 to 100

    function render() {
      const headMm = +wIn.value, hammer = +fIn.value;
      wV.textContent = bn(headMm); fV.textContent = bn(hammer);
      const headPx = headMm / MM_PER_PX / 2;          // half the head, each way
      const gap = headPx * (depth / 100);
      top.setAttribute('y', String(MID - LOGH - gap));
      bot.setAttribute('y', String(MID + gap));

      // tip first, then the two back corners: the wedge drives in from the left
      const tipX = LOG_X + LEN_PX * 0.2 + (depth / 100) * LEN_PX * 0.85, backX = tipX - LEN_PX;
      wedgeShape.setAttribute('points', `${tipX},${MID} ${backX},${MID - headPx} ${backX},${MID + headPx}`);
      wedgeGrab.setAttribute('transform', `translate(${(tipX + backX) / 2},${MID})`);

      const lenMm = LEN_PX * MM_PER_PX;
      const ma = lenMm / headMm;
      const force = hammer * ma;
      const px = W * 0.1 / Math.max(hammer, force);
      hit(backX - 18 - hammer * px, MID, hammer * px, 0);
      splitA(tipX - LEN_PX * 0.3, MID - headPx - 6, 0, -force * px * 0.5);
      splitB(tipX - LEN_PX * 0.3, MID + headPx + 6, 0, force * px * 0.5);

      out.innerHTML = `কীলকটা <b>${num(lenMm)} মিমি</b> লম্বা আর মাথা <b>${bn(headMm)} মিমি</b> চওড়া, তাই সুবিধা <b>${num(ma)} গুণ</b>। হাতুড়ির ${bn(hammer)} কেজি বল ভেতরে গিয়ে দাঁড়ায় <b>${num(force)} কেজিতে</b>।`
        + `<span class="cost">কীলক আসলে চলমান ঢালু তল - সরু মাথা মানে লম্বা ঢাল, তাই বেশি সুবিধা।</span>`;
      MA.wedge = { ma, cost: 'পুরো লম্বা পথ ঠুকে ঢোকাতে হয়' };
      drawTable();
    }

    const toX = alongX(svg, W, LOG_X + LEN_PX * 0.2, LEN_PX * 0.0085);
    dragTrack({
      surface: svg, handle: wedgeGrab, min: 0, max: 100, step: 2, value: depth,
      toValue: (x) => toX(x),
