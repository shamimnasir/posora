---
import Base from '../../layouts/Base.astro';

export const prerender = true;

const HUE = '#2E7EA8';
const items = [
  { id: 'lever', n: 'লিভার' },
  { id: 'pulley', n: 'কপিকল' },
  { id: 'ramp', n: 'ঢালু তল' },
  { id: 'screw', n: 'স্ক্রু' },
  { id: 'wedge', n: 'কীলক' },
  { id: 'wheel', n: 'চাকা ও অক্ষ' },
  { id: 'gears', n: 'গিয়ার' },
  { id: 'advantage', n: 'যান্ত্রিক সুবিধা' },
];
---
<Base
  title="সরল যন্ত্র"
  description="লিভার, কপিকল, ঢালু তল, স্ক্রু, কীলক, চাকা ও অক্ষ আর গিয়ার - সাতটা সরল যন্ত্র নিজের হাতে টেনে দেখো, প্রতিটার বল আর যান্ত্রিক সুবিধা সত্যিকারের হিসাবে বদলায়।"
  hue={HUE}
>
  <div class="wrap page">
    <p class="crumbs"><a href="/#worlds">ভুবন</a> <span>/</span> <a href="/physics/">পদার্থবিজ্ঞান</a> <span>/</span> সরল যন্ত্র</p>

    <header class="head">
      <p class="eyebrow">পদার্থবিজ্ঞান ভুবন · বিভাগ পরিচিতি</p>
      <h1>সরল যন্ত্র</h1>
      <p class="lede">
        সরল যন্ত্র বল কমায় না, বলটাকে ছড়িয়ে দেয়। কম বল লাগে, বদলে বেশি পথ পাড়ি দিতে হয় -
        গুণফলটা একই থাকে। নিচের আটটার প্রতিটাই টেনে দেখা যায়, আর প্রতিটা সংখ্যা সত্যিকারের হিসাব থেকে আসে।
      </p>
      <nav class="quicknav" aria-label="দ্রুত যাওয়ার তালিকা">
        {items.map((it) => <a href={`#${it.id}`} class="pill pill-w">{it.n}</a>)}
      </nav>
    </header>

    <div class="tools">
      <!-- 1. লিভার -->
      <section class="tool card" id="lever">
        <h2><span class="no">০১</span> লিভার</h2>
        <p class="how">ত্রিভুজ আলম্বটা টেনে সরাও। বোঝার দিকে সরালে তোমার বল কমে যাবে, কিন্তু হাতটা তত বেশি নামাতে হবে।</p>
        <div class="wide">
          <svg id="lever-svg" viewBox="0 0 640 250" role="img" aria-label="লিভার, আলম্ব টেনে সরাও"></svg>
        </div>
        <div class="ctl-row">
          <label>বোঝা <input type="range" id="lever-load" min="5" max="100" step="5" value="40" aria-label="বোঝার ওজন, কেজি" /> <b id="lever-load-v" class="num">৪০</b> কেজি</label>
        </div>
        <p class="readout" id="lever-out"></p>
      </section>

      <!-- 2. কপিকল -->
      <section class="tool card" id="pulley">
        <h2><span class="no">০২</span> কপিকল</h2>
        <p class="how">রশির মাথাটা নিচে টানো - বোঝা উঠবে। কয়টা রশি বোঝাটাকে ধরে আছে, বল ঠিক তত ভাগ হয়ে যায়।</p>
        <div class="two">
          <svg id="pulley-svg" viewBox="0 0 360 320" role="img" aria-label="কপিকল, রশি টেনে বোঝা তোলো"></svg>
          <div class="side">
            <label>কয়টা রশি ধরে আছে
              <input type="range" id="pulley-n" min="1" max="4" step="1" value="2" aria-label="বোঝা ধরে রাখা রশির সংখ্যা" />
              <b id="pulley-n-v" class="num">২</b>টা
            </label>
            <label>বোঝা <input type="range" id="pulley-load" min="10" max="120" step="10" value="60" aria-label="বোঝার ওজন, কেজি" /> <b id="pulley-load-v" class="num">৬০</b> কেজি</label>
            <p class="readout" id="pulley-out"></p>
          </div>
        </div>
      </section>

      <!-- 3. ঢালু তল -->
      <section class="tool card" id="ramp">
        <h2><span class="no">০৩</span> ঢালু তল</h2>
        <p class="how">ঢালটার মাথা টেনে লম্বা করো। উচ্চতা একই থাকবে, কিন্তু ঢাল যত লম্বা, ঠেলতে তত কম বল লাগবে।</p>
        <div class="wide">
          <svg id="ramp-svg" viewBox="0 0 620 260" role="img" aria-label="ঢালু তল, ঢালের দৈর্ঘ্য টেনে বদলাও"></svg>
        </div>
        <div class="ctl-row">
          <label>বোঝা <input type="range" id="ramp-load" min="10" max="150" step="10" value="60" aria-label="বোঝার ওজন, কেজি" /> <b id="ramp-load-v" class="num">৬০</b> কেজি</label>
        </div>
        <p class="readout" id="ramp-out"></p>
      </section>

      <!-- 4. স্ক্রু -->
      <section class="tool card" id="screw">
        <h2><span class="no">০৪</span> স্ক্রু</h2>
        <p class="how">প্যাঁচের ফাঁক টেনে বদলাও। ডানের ছবিটা দেখো - স্ক্রুর প্যাঁচ আসলে একটা ঢালু তল, কেবল গোল করে জড়ানো।</p>
        <div class="wide">
          <svg id="screw-svg" viewBox="0 0 620 250" role="img" aria-label="স্ক্রু আর তার খুলে দেওয়া ঢালু তল"></svg>
        </div>
        <p class="readout" id="screw-out"></p>
      </section>

      <!-- 5. কীলক -->
      <section class="tool card" id="wedge">
        <h2><span class="no">০৫</span> কীলক</h2>
        <p class="how">কীলকটা কাঠের ভেতর ঠেলে দাও, আর মাথাটা সরু-মোটা করে দেখো। সরু কীলক কম বলে বেশি ফাঁক করে।</p>
        <div class="wide">
          <svg id="wedge-svg" viewBox="0 0 620 250" role="img" aria-label="কীলক, কাঠে ঠেলে ঢোকাও"></svg>
        </div>
        <div class="ctl-row">
          <label>মাথার চওড়া <input type="range" id="wedge-w" min="10" max="70" step="5" value="30" aria-label="কীলকের মাথার চওড়া, মিলিমিটার" /> <b id="wedge-w-v" class="num">৩০</b> মিমি</label>
          <label>হাতুড়ির বল <input type="range" id="wedge-f" min="5" max="60" step="5" value="20" aria-label="হাতুড়ির বল, কেজি" /> <b id="wedge-f-v" class="num">২০</b> কেজি</label>
        </div>
        <p class="readout" id="wedge-out"></p>
      </section>

      <!-- 6. চাকা ও অক্ষ -->
      <section class="tool card" id="wheel">
        <h2><span class="no">০৬</span> চাকা ও অক্ষ</h2>
        <p class="how">কুয়ার চাকাটা ধরে ঘোরাও - বালতি উঠবে। চাকা যত বড়, হাতে তত কম বল, কিন্তু হাত ঘোরে তত লম্বা পথ।</p>
        <div class="two">
          <svg id="wheel-svg" viewBox="0 0 360 330" role="img" aria-label="কুয়ার চাকা, ঘুরিয়ে বালতি তোলো"></svg>
          <div class="side">
            <label>চাকার ব্যাসার্ধ
              <input type="range" id="wheel-r" min="30" max="90" step="5" value="70" aria-label="চাকার ব্যাসার্ধ, সেন্টিমিটার" />
              <b id="wheel-r-v" class="num">৭০</b> সেমি
            </label>
            <label>বালতি <input type="range" id="wheel-load" min="5" max="60" step="5" value="30" aria-label="বালতির ওজন, কেজি" /> <b id="wheel-load-v" class="num">৩০</b> কেজি</label>
            <p class="readout" id="wheel-out"></p>
          </div>
        </div>
      </section>

      <!-- 7. গিয়ার -->
      <section class="tool card" id="gears">
        <h2><span class="no">০৭</span> গিয়ার</h2>
        <p class="how">বড় গিয়ারটা ধরে ঘোরাও - পাশেরগুলোও ঘুরবে, উল্টো দিকে। দাঁত যত কম, গিয়ার তত দ্রুত ঘোরে।</p>
        <div class="wide">
          <svg id="gears-svg" viewBox="0 0 480 270" role="img" aria-label="তিনটে গিয়ার, বড়টা ধরে ঘোরাও"></svg>
        </div>
        <p class="readout" id="gears-out"></p>
      </section>

      <!-- 8. যান্ত্রিক সুবিধা -->
      <section class="tool card" id="advantage">
        <h2><span class="no">০৮</span> যান্ত্রিক সুবিধা</h2>
        <p class="how">
          যান্ত্রিক সুবিধা মানে একটাই সংখ্যা: বোঝা ভাগ তোমার বল। উপরের সাতটাই এই এক নিয়মে চলে -
          যতগুণ বল বাঁচে, ততগুণ পথ বেশি পাড়ি দিতে হয়। নিচের হিসাবটা নিজে কষে দেখো।
        </p>
        <p class="est-q" id="ma-q"></p>
        <div class="est-row">
          <input type="number" id="ma-guess" inputmode="decimal" step="0.1" placeholder="তোমার উত্তর" aria-label="তোমার উত্তর" />
          <span class="est-unit" id="ma-unit"></span>
          <button type="button" class="btn btn-primary" id="ma-check">মিলিয়ে দেখো</button>
          <button type="button" class="btn" id="ma-next">নতুন প্রশ্ন</button>
        </div>
        <p class="readout" id="ma-out"></p>
        <table class="ma-table">
          <caption>উপরে তুমি এখন যা যা সাজিয়েছ</caption>
          <thead><tr><th>যন্ত্র</th><th>যান্ত্রিক সুবিধা</th><th>যে দাম দিতে হয়</th></tr></thead>
          <tbody id="ma-body"></tbody>
        </table>
      </section>
    </div>

    <p class="back"><a href="/physics/">← পদার্থবিজ্ঞান ভুবনে ফিরে যাও</a></p>
  </div>
</Base>

<style>
  .page { padding-block: 1rem 3rem; }
  .crumbs { font-size: 13px; color: var(--muted); margin-bottom: 0.75rem; }
  .crumbs span { margin: 0 0.35rem; }
  .head { padding-bottom: 1.5rem; border-bottom: 1px solid var(--line-soft); margin-bottom: 1.75rem; }
  .head h1 { font-size: clamp(2rem, 4.5vw, 3rem); margin: 0.2rem 0 0.6rem; }
  .lede { color: var(--ink-2); max-width: 62ch; font-size: 15.5px; }
  .quicknav { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 1.1rem; }
  .quicknav .pill { font-size: 13px; }

  .tools { display: flex; flex-direction: column; gap: 1rem; }
  .tool { padding: 1.4rem 1.6rem 1.6rem; }
  .tool h2 { display: flex; align-items: baseline; gap: 0.6rem; font-size: 20px; margin-bottom: 0.4rem; }
  .tool .no { font-family: var(--font-mono); font-size: 12px; color: var(--w); font-weight: 500; }
  .how { color: var(--muted); font-size: 13.5px; margin-bottom: 1.1rem; max-width: 62ch; line-height: 1.7; }
  .readout { margin-top: 0.9rem; font-size: 15px; color: var(--ink-2); line-height: 1.75; }
  .readout :global(b) { color: var(--ink); font-family: var(--font-display); font-size: 17px; }
  .readout :global(.cost) { color: var(--muted); font-size: 13.5px; display: block; margin-top: 0.15rem; }

  /* every scene is an svg that fills its card and can be dragged */
  .wide { overflow-x: auto; padding-bottom: 4px; }
  .wide svg { width: 100%; min-width: 460px; height: auto; display: block; touch-action: none; }
  .two { display: grid; grid-template-columns: minmax(0, 240px) minmax(0, 1fr); gap: 1.4rem; align-items: center; }
  .two svg { width: 100%; height: auto; display: block; touch-action: none; }
  .side { display: flex; flex-direction: column; gap: 0.7rem; }

  .ctl-row { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 1rem; }
  label { font-size: 13.5px; color: var(--ink-2); display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .side label { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.35rem 0.5rem; }
  .side label input[type="range"] { grid-column: 1 / -1; }
  input[type="range"] { accent-color: var(--w); min-width: 8rem; flex: 1; }

  /* the focus ring has to land on the handle inside the svg, not the svg */
  .tool :global([role="slider"]:focus-visible) { outline: 2px solid var(--w); outline-offset: 2px; }

  .est-q { font-size: 15.5px; font-weight: 600; margin-bottom: 0.9rem; line-height: 1.7; }
  .est-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .est-unit { color: var(--muted); font-size: 13.5px; }
  input[type="number"] {
    font: inherit; font-size: 14.5px; padding: 0.45rem 0.65rem; border-radius: 9px;
    border: 1px solid var(--line); background: var(--panel-2); color: var(--ink); width: 8rem;
  }
  input[type="number"]:focus { outline: 2px solid var(--w); outline-offset: 1px; }
  .won { color: var(--ok); }

  .ma-table { width: 100%; border-collapse: collapse; margin-top: 1.4rem; font-size: 13.5px; }
  .ma-table caption { text-align: left; color: var(--muted); font-size: 12.5px; padding-bottom: 0.5rem; }
  .ma-table th, .ma-table td { text-align: left; padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--line-soft); }
  .ma-table th { color: var(--muted); font-weight: 600; font-size: 12px; }
  /* the rows are built by the script, so they never get Astro's scope stamp */
  .ma-table :global(td.n) { font-variant-numeric: tabular-nums; color: var(--ink); font-weight: 700; }
  .ma-table :global(td.why) { color: var(--muted); }

  .back { margin-top: 2rem; font-size: 14px; color: var(--muted); }
  .back a:hover { color: var(--brand-ink); }

  @media (max-width: 640px) {
    .two { grid-template-columns: 1fr; }
  }

  /* The scenes lay themselves out portrait below this width (the same
     breakpoint fitScene uses), so nothing has to be swiped sideways. */
  @media (max-width: 640px) {
    .wide { overflow-x: visible; }
    .wide svg { min-width: 0; }
  }

  /* A phone on its side has about three hundred usable pixels of height, and
     a scene laid out for width can easily be taller than that. Capping the
     height lets the drawing meet-fit inside its box: it scales down and
     centres rather than running off the bottom of the screen. */
  @media (orientation: landscape) and (max-height: 520px) {
    .tool svg { max-height: 74vh; }
  }
</style>

<script>
  import { bn } from '../../lib/bn';
  import { svgEl as el, clamp, dragTrack, alongX, alongY, aroundCentre, fitScene, useItem, rewardCorrect } from '../../lib/handson';

  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;

  /**
   * This page is পদার্থবিজ্ঞান's সরল যন্ত্র category rather than a toy beside
   * it, so moving a machine counts exactly as reading an item counts.
   */
  const WORLD = 'physics', CAT = 'সরল যন্ত্র';
  const ITEM: Record<string, string> = {
    lever: 'লিভার', pulley: 'কপিকল', ramp: 'ঢালু তল', screw: 'স্ক্রু',
    wedge: 'কীলক', wheel: 'চাকা ও অক্ষ', gears: 'গিয়ার', advantage: 'যান্ত্রিক সুবিধা',
  };
  const used = (id: string) => { useItem(WORLD, CAT, ITEM[id]!); };

  /** One decimal while the number is small, none once it is not. */
  const num = (n: number) => bn(n.toFixed(Math.abs(n) < 10 ? 1 : 0));

  /**
   * Every machine's current setting, so the last card can total them up.
   * The whole category is one idea repeated seven ways, and the table is where
   * a child gets to see that rather than be told it.
   */
  const MA: Record<string, { ma: number; cost: string }> = {};
  let drawTable = () => {};

  const INK = 'var(--ink)', LINE = 'var(--line)', SOFT = 'var(--panel-2)', HUE = 'var(--w)', MUTED = 'var(--muted)';

  /** An arrow, drawn as one line and one head, so force can be shown to scale. */
  function arrow(parent: SVGElement, colour: string): (x: number, y: number, dx: number, dy: number) => void {
    const line = el('line', { stroke: colour, 'stroke-width': 3, 'stroke-linecap': 'round' });
    const head = el('polygon', { fill: colour });
    parent.append(line, head);
    return (x, y, dx, dy) => {
      const len = Math.hypot(dx, dy) || 1;
      const ux = dx / len, uy = dy / len;
      const tipX = x + dx, tipY = y + dy;
      line.setAttribute('x1', String(x)); line.setAttribute('y1', String(y));
      line.setAttribute('x2', String(tipX - ux * 8)); line.setAttribute('y2', String(tipY - uy * 8));
      head.setAttribute('points', [
        `${tipX},${tipY}`,
        `${tipX - ux * 11 - uy * 5},${tipY - uy * 11 + ux * 5}`,
        `${tipX - ux * 11 + uy * 5},${tipY - uy * 11 - ux * 5}`,
      ].join(' '));
    };
  }

  const text = (parent: SVGElement, x: number, y: number, s: string, o: Record<string, string | number> = {}) => {
    const t = el('text', { x, y, 'font-size': 12, fill: MUTED, 'text-anchor': 'middle', ...o });
    t.textContent = s; parent.appendChild(t); return t;
  };

  /* ---------- 1. লিভার ---------- */
  (function lever() {
    const svg = $<SVGSVGElement>('#lever-svg');
    const { w: W, h: H } = fitScene(svg, [640, 250], [340, 300]);
    const LEFT = W * 0.11, RIGHT = W * 0.89, BEAM_Y = H * 0.58, GROUND = H * 0.82;
    const BOX = Math.min(52, W * 0.15), ARROW = H * 0.28;
    svg.appendChild(el('line', { x1: 10, y1: GROUND, x2: W - 10, y2: GROUND, stroke: LINE, 'stroke-width': 2 }));
    const beam = el('rect', { x: LEFT, y: BEAM_Y - 7, width: RIGHT - LEFT, height: 14, rx: 7, fill: SOFT, stroke: LINE });
    const load = el('rect', { x: LEFT - BOX / 2, y: BEAM_Y - BOX - 8, width: BOX, height: BOX, rx: 6, fill: HUE, 'fill-opacity': 0.85 });
    const loadTxt = text(svg, LEFT, BEAM_Y - BOX / 2 - 4, '', { fill: '#fff', 'font-weight': 700, 'font-size': 12 });
    svg.append(beam, load);
    svg.appendChild(loadTxt);

    const effort = arrow(svg, INK);
    const effortTxt = text(svg, RIGHT, BEAM_Y - ARROW - 26, '', { fill: INK, 'font-weight': 700, 'font-size': 12 });

    // The handle is deliberately bigger than the triangle it holds: a fulcrum
    // you cannot get a fingertip onto is not draggable on a phone.
    const grab = el('g');
    grab.append(
      el('rect', { x: -24, y: -4, width: 48, height: 68, fill: 'transparent' }),
      el('polygon', { points: `0,0 ${(GROUND - BEAM_Y) * 0.45},${GROUND - BEAM_Y} ${-(GROUND - BEAM_Y) * 0.45},${GROUND - BEAM_Y}`, fill: INK, 'fill-opacity': 0.85 }),
    );
    svg.appendChild(grab);
    const armL = text(svg, 0, GROUND + 24, '', { 'font-size': 11 }), armR = text(svg, 0, GROUND + 24, '', { 'font-size': 11 });

    const loadIn = $<HTMLInputElement>('#lever-load'), loadV = $('#lever-load-v'), out = $('#lever-out');
    // Start with the fulcrum near the load, where the lever is helping. Parked
