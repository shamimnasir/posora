    pull.insertBefore(pullRope, handle);

    const nIn = $<HTMLInputElement>('#pulley-n'), nV = $('#pulley-n-v');
    const loadIn = $<HTMLInputElement>('#pulley-load'), loadV = $('#pulley-load-v'), out = $('#pulley-out');
    let pulled = 40;

    function render() {
      const n = +nIn.value, kg = +loadIn.value;
      nV.textContent = bn(n); loadV.textContent = bn(kg);
      // Pulling the rope n metres raises the load one: that trade is the whole
      // point of the machine, so the drawing has to obey it too.
      const rise = (pulled / 100) * TRAVEL / n;
      const blockY = REST - rise;
