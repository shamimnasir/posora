      surface: svg, handle: grab, min: LEFT + (RIGHT - LEFT) * 0.12, max: RIGHT - (RIGHT - LEFT) * 0.12, step: 5, value: fx,
      toValue: (x) => toX(x),
      onChange: (v) => { fx = v; render(); used('lever'); },
      label: 'আলম্বের জায়গা', text: (v) => `বোঝা থেকে ${num((v - LEFT) / ((RIGHT - LEFT) / 5))} মিটার দূরে`,
    });
    loadIn.addEventListener('input', () => { render(); used('lever'); });
    render();
  })();

  /* ---------- 2. কপিকল ---------- */
  (function pulley() {
