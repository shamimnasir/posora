  /* ---------- 3. ঢালু তল ---------- */
  (function ramp() {
    const svg = $<SVGSVGElement>('#ramp-svg');
    const { w: W, h: H } = fitScene(svg, [620, 260], [340, 300]);
    const GROUND = H * 0.85, TOP_X = W * 0.9, RISE = H * 0.35;
    const PX_PER_M = RISE / 1.5;   // the platform is a metre and a half up
    const HEIGHT_M = RISE / PX_PER_M;
    svg.appendChild(el('line', { x1: 10, y1: GROUND, x2: W - 10, y2: GROUND, stroke: LINE, 'stroke-width': 2 }));
    svg.appendChild(el('rect', { x: TOP_X, y: GROUND - RISE, width: W - TOP_X - 6, height: RISE, fill: SOFT, stroke: LINE }));
    const slope = el('polygon', { fill: HUE, 'fill-opacity': 0.16, stroke: HUE, 'stroke-width': 2 });
    svg.appendChild(slope);
    const BOX = Math.min(44, W * 0.13), BOXH = BOX * 0.77;
    const box = el('rect', { width: BOX, height: BOXH, rx: 5, fill: HUE, 'fill-opacity': 0.9 });
    svg.appendChild(box);
    const push = arrow(svg, INK);
    const lift = arrow(svg, MUTED);
    const lenTxt = text(svg, 0, GROUND + 24, '', { 'font-size': 11 });
    const liftTxt = text(svg, W - 8, GROUND - RISE - H * 0.34, '', { 'font-size': 10.5, 'text-anchor': 'end' });
    const grab = el('g');
    grab.append(
      el('rect', { x: -22, y: -22, width: 44, height: 44, fill: 'transparent' }),
      el('circle', { r: 11, fill: INK, 'fill-opacity': 0.85 }),
      el('circle', { r: 4, fill: 'var(--panel)' }),
    );
    svg.appendChild(grab);

    const loadIn = $<HTMLInputElement>('#ramp-load'), loadV = $('#ramp-load-v'), out = $('#ramp-out');
    let fx = W * 0.3;

    function render() {
      const kg = +loadIn.value;
      loadV.textContent = bn(kg);
      slope.setAttribute('points', `${fx},${GROUND} ${TOP_X},${GROUND} ${TOP_X},${GROUND - RISE}`);
      grab.setAttribute('transform', `translate(${fx},${GROUND})`);

      const run = TOP_X - fx;
      const lenPx = Math.hypot(run, RISE), lenM = lenPx / PX_PER_M;
      const need = kg * HEIGHT_M / lenM;

      // the box sits on the slope, a third of the way up
      const t = 0.34, bx = fx + run * t, by = GROUND - RISE * t;
      const ang = (Math.atan2(-RISE, run) * 180) / Math.PI;
      box.setAttribute('transform', `translate(${bx},${by}) rotate(${ang}) translate(${-BOX / 2},${-BOXH})`);

      // one scale for both arrows: the ramp arrow is visibly the shorter one
      const px = H * 0.27 / Math.max(kg, need);
      // (ux, uy) points up the slope; the arrow starts behind the box and
      // pushes it that way.
      const ux = run / lenPx, uy = -RISE / lenPx;
      const len = need * px;
      push(bx - ux * (24 + len), by - uy * (24 + len), ux * len, uy * len);
      lift(TOP_X + (W - TOP_X) / 2, GROUND - RISE - 10, 0, -kg * px);
      liftTxt.setAttribute('y', String(GROUND - RISE - 18 - kg * px));
      liftTxt.textContent = `সোজা তুললে ${bn(kg)} কেজি`;
      lenTxt.setAttribute('x', String((fx + TOP_X) / 2));
      lenTxt.textContent = `ঢাল ${num(lenM)} মিটার`;

      out.innerHTML = `${num(HEIGHT_M)} মিটার উঁচুতে ${bn(kg)} কেজি তুলতে এই ঢালে দরকার <b>${num(need)} কেজি</b> বল। যান্ত্রিক সুবিধা <b>${num(lenM / HEIGHT_M)} গুণ</b>।`
        + `<span class="cost">বদলে ঠেলতে হয় ${num(lenM)} মিটার পথ, সোজা ${num(HEIGHT_M)} মিটারের বদলে।</span>`;
      MA.ramp = { ma: lenM / HEIGHT_M, cost: `${num(lenM)} মিটার ঠেলতে হয়` };
      drawTable();
    }

    const toX = alongX(svg, W, 0, 1);
    dragTrack({
      surface: svg, handle: grab, min: W * 0.12, max: TOP_X - W * 0.12, step: 5, value: fx,
      toValue: (x) => toX(x),
      onChange: (v) => { fx = v; render(); used('ramp'); },
      label: 'ঢালের গোড়া', text: () => `ঢাল ${num(Math.hypot(TOP_X - fx, RISE) / PX_PER_M)} মিটার`,
    });
    loadIn.addEventListener('input', () => { render(); used('ramp'); });
    render();
  })();

  /* ---------- 4. স্ক্রু ---------- */
  (function screw() {
