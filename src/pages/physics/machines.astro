        ropes.appendChild(el('line', { x1: x, y1: TOP, x2: x, y2: blockY + 6, stroke: MUTED, 'stroke-width': 2 }));
        ropes.appendChild(el('circle', { cx: x, cy: TOP, r: 9, fill: SOFT, stroke: LINE, 'stroke-width': 2 }));
      }
