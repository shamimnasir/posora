        + `<span class="cost">বদলে রশি টানতে হয় ${bn(n)} গুণ লম্বা - বোঝা এক হাত উঠলে তোমার হাত নামে ${bn(n)} হাত।</span>`;
      MA.pulley = { ma: n, cost: `রশি ${bn(n)} গুণ লম্বা টানতে হয়` };
      drawTable();
    }

    const toY = alongY(svg, 320, TOP + 40, TRAVEL / 100);
    dragTrack({
      surface: svg, handle, min: 0, max: 100, step: 2, value: pulled,
