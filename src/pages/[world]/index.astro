---
import Base from '../../layouts/Base.astro';
import { getWorld, getWorlds, itemCount } from '../../lib/content';
import { isLoggedIn } from '../../lib/auth';
import { bn, pad2, bnOf } from '../../lib/bn';
import { heroFor } from '../../data/heroes';
import { mathExplorer } from '../../data/math-explorer';
import { physicsExplorer } from '../../data/physics-explorer';
import { chemistryExplorer } from '../../data/chemistry-explorer';
import { lifeExplorer } from '../../data/life-explorer';
import { natureExplorer } from '../../data/nature-explorer';
import { foodExplorer } from '../../data/food-explorer';
import { moneyExplorer } from '../../data/money-explorer';
import { languageExplorer } from '../../data/language-explorer';
import { socialExplorer } from '../../data/social-explorer';
import { discoveryExplorer } from '../../data/discovery-explorer';
import type { ItemDetail } from '../../data/explorer-types';
import { getMember, hasPlan, activeChild, familyWeekIn } from '../../lib/members';
import { emojiFor } from '../../data/item-emoji';
import { chipsFor } from '../../lib/chips';
import { catEmoji } from '../../data/cat-emoji';
import { AWARDS, awardKey } from '../../lib/game';
import { missionSpec } from '../../data/missions';
import { sheets } from '../../data/printables';
import MissionRow from '../../components/explorer/MissionRow.astro';

export const prerender = false;

const wantsPreview = Astro.url.searchParams.get('preview') === '1';
const preview = wantsPreview && (await isLoggedIn(Astro));

const w = await getWorld(Astro.params.world!, { includeDrafts: preview, fresh: preview });
// Unknown slug, a draft without preview, or a world with its own bespoke
// explorer (space) - none of which this generic template should render.
if (!w || w.open) return Astro.rewrite('/404');

Astro.response.headers.set(
  'cache-control',
  preview ? 'private, no-store' : 'public, max-age=0, s-maxage=60, stale-while-revalidate=300',
);

const EXPLORERS: Record<string, (ItemDetail[] | null)[]> = {
  math: mathExplorer, physics: physicsExplorer, chemistry: chemistryExplorer,
  life: lifeExplorer, nature: natureExplorer, food: foodExplorer,
  money: moneyExplorer, language: languageExplorer, social: socialExplorer,
  discovery: discoveryExplorer,
};
const explorer = EXPLORERS[w.slug] ?? null;

/* Reading time is measured off the real text, never guessed: every character of
   every depth plus the fun fact, divided by a stated reading rate. The caption
   on the chart says which rate, so the number can be checked. */
const charsOf = (d: ItemDetail[] | null) =>
  d ? d.reduce((s, it) => s + it.l1.length + it.l2.length + it.l3.length + it.fun.length, 0) : 0;

/**
 * Which mission, if any, was built for each category.
 *
 * `missionCats` already records this, but the arrow only ever pointed one way:
 * playing a mission moves the model to the category it teaches, while a child
 * standing in that category was never told a game had been built for it.
 * Twenty-three of the eighty-seven categories had a mission and no door into
 * it from the one place a child is guaranteed to be looking.
 *
 * A mission with no data behind it yet is not a door, so it is not offered.
 */
/** How many missions stay open before the rest fold away. */
const MISS_SHOWN = 4;
const missionRows = w.missions.map((m, i) => ({ m, i, cat: w.missionCats[i] ?? null }));

const catMission = w.cats.map((_c, i) => {
  const mi = w.missionCats.findIndex((mc) => mc === i);
  return mi >= 0 && missionSpec(w.slug, mi) ? mi : null;
});

const payload = w.cats.map((c, i) => {
  const detail = explorer?.[i] ?? null;
  return {
    n: c.n, items: c.items, play: c.play, hero: heroFor(w.slug, w.hue, i, c.n),
    lab: c.lab, labAnchors: c.labAnchors, detail, chars: charsOf(detail),
    emoji: c.items.map((it) => emojiFor(w.slug, it)), mission: catMission[i] ?? null,
  };
});

// Family plan: which child this device is reading as. The page renders the
// same for everyone; a plan only adds the synced bucket and the gated links.
const member = await getMember(Astro);
const plan = hasPlan(member);
const child = plan ? activeChild(Astro, member) : null;
/**
 * Who else has been in this world this week.
 *
 * The page is a silent room: nothing on it suggests another person exists.
 * The only other people this site can honestly show a child are their own
 * siblings on the family plan - no strangers, no invented counts, and no new
 * data about anyone, only a narrower question asked of rows their own devices
 * already wrote. Without a plan, or with one child, there is nobody to show
 * and the strip does not appear.
 */
const family = member && plan && member.children.length > 1
  ? (await familyWeekIn(member.children, w.slug)).filter((r) => r.items > 0)
  : [];
const familyTop = family.slice().sort((a, b) => b.items - a.items);

const first = w.cats[0];
const firstDetail = payload[0].detail;
// Same test the client uses, so the server-rendered chips cannot disagree with
// what appears a moment later on hydration.
const firstReadable = !!firstDetail && firstDetail.length === first.items.length;
const firstItem = firstReadable ? firstDetail![0] : null;
const total = itemCount(w);
// Progress is measured against items that can actually be opened. A tool
// category links out instead, so its items are never marked.
const readableTotal = payload.reduce(
  (n, c) => n + (c.detail && c.detail.length === c.items.length ? c.items.length : 0),
  0,
);
// A ladder of the world hue so each category reads as its own colour without
// ever leaving the palette. Lightest at the top, steadily deeper down the rail.
/**
 * The three records that come from the shape of the world rather than from
 * this visitor: biggest category, smallest, longest read. They used to be
 * drawn by script alone, which left the card an empty box until it ran. The
 * personal record ("তুমি সবচেয়ে এগিয়ে") still comes from the browser, because
 * only the browser knows it.
 */
const seedRecords = (() => {
  const mins = (i: number) => {
    const d = payload[i]?.detail;
    return d ? Math.max(1, Math.round(payload[i]!.chars / 600)) : 0;
  };
  const n = (i: number) => w.cats[i]!.items.length;
  const idx = (f: (i: number) => number, better: (a: number, b: number) => boolean) =>
    w.cats.reduce((best, _c, i) => (better(f(i), f(best)) ? i : best), 0);
  const big = idx(n, (a, b) => a > b), small = idx(n, (a, b) => a < b), longest = idx(mins, (a, b) => a > b);
  return [
    { label: 'সবচেয়ে বড় বিভাগ', i: big, name: w.cats[big]!.n, val: `${bn(n(big))}টি` },
    { label: 'সবচেয়ে ছোট বিভাগ', i: small, name: w.cats[small]!.n, val: `${bn(n(small))}টি` },
    { label: 'সবচেয়ে লম্বা পড়া', i: longest, name: w.cats[longest]!.n, val: `${bn(mins(longest))} মিনিট` },
  ];
})();

const shade = (i: number) => `color-mix(in oklab, ${w.hue} ${96 - (i % 6) * 9}%, #8894a8)`;
const LEVELS = [['l1', 'ছোট', '৫–৮'], ['l2', 'মাঝারি', '৯–১২'], ['l3', 'বড়', '১৩+']] as const;
const GMETRICS = [['items', 'আইটেম সংখ্যা'], ['time', 'পড়ার সময়'], ['read', 'তুমি যত দেখেছ']] as const;
// How many of this world's missions are actually playable today. The card
// counts against this, never against the wish list, so the number is honest.
const playableMissions = w.missions.filter((_m, i) => missionSpec(w.slug, i)).length;
// Sideways links between worlds, so every world is two clicks from every
// other one rather than only reachable back through the home page.
const otherWorlds = (await getWorlds()).filter((o) => o.slug !== w.slug);
// The hands-on tools this world owns. They are reachable today only by landing
// on the one category that carries them, which means a child who never opens
// সরল যন্ত্র never learns the lever tool exists.
const labCats = w.cats.filter((c) => c.lab);

/**
 * What this world actually is, said in schema.org so a search or answer engine
 * can repeat it correctly: a free Bangla learning resource, what it teaches,
 * and the list of categories inside it. Every field is read from the same data
 * the page renders, so none of it can drift.
 */
const pageUrl = new URL(`/${w.slug}/`, Astro.site ?? 'https://posora.com').href;
const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'পসরা', item: 'https://posora.com/' },
      { '@type': 'ListItem', position: 2, name: 'ভুবন', item: 'https://posora.com/#worlds' },
      { '@type': 'ListItem', position: 3, name: w.bn, item: pageUrl },
    ],
  },
  {
    '@type': 'LearningResource',
    '@id': `${pageUrl}#resource`,
    name: `${w.bn} - পসরা`,
    url: pageUrl,
    inLanguage: 'bn',
    isAccessibleForFree: true,
    learningResourceType: ['interactive 3D model', 'reading', 'quiz', 'worksheet'],
    educationalUse: ['self study', 'classroom activity'],
    typicalAgeRange: w.age.replace('+', '-16'),
    teaches: w.cats.map((c) => c.n),
    about: w.cats.flatMap((c) => c.items).slice(0, 40),
    description: `${w.tag} - ${w.intro}`,
    provider: { '@id': 'https://posora.com/#org' },
    audience: { '@type': 'EducationalAudience', educationalRole: 'student' },
  },
  {
    '@type': 'ItemList',
    name: `${bnOf(w.bn)} বিভাগ`,
    numberOfItems: w.cats.length,
    itemListElement: w.cats.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.n, description: c.play,
    })),
  },
];
---
<Base title={w.bn} description={`${w.tag} - ${w.intro}`} hue={w.hue} bare schema={schema} crumbs={[{ name: 'পসরা', url: 'https://posora.com/' }]}>
  <div class="wrap page" id="world" data-slug={w.slug} data-total={total} data-child={child?.id} data-plan={plan ? '1' : '0'}>
    <p class="crumbs"><a href="/#worlds">ভুবন</a> <span>/</span> {w.bn}</p>

    <div class="xp">
      <aside class="rail card" aria-label="বিভাগের তালিকা">
        <div class="card-h"><span class="lbl">বিভাগ</span><span class="lbl num" id="seen-count">০ / {bn(readableTotal)} দেখা হয়েছে</span></div>
        <div class="rail-list">
          {w.cats.map((c, i) => (
            <button type="button" data-i={i} aria-current={i === 0 ? 'true' : undefined} style={`--o:${shade(i)}`}>
              <span class="rorb" aria-hidden="true">{catEmoji(w.slug, c.n)}</span>
              <span class="rt"><span class="nm">{c.n}</span><span class="tg">{bn(c.items.length)} আইটেম</span></span>
              <span class="no lbl">{pad2(i + 1)}</span>
            </button>
          ))}
        </div>
      </aside>

      <div class="mid">
        <section class="stage card">
          <header class="stage-h">
            <div>
              <p class="eyebrow">ভুবন · {w.en}</p>
              <h1>{w.bn}</h1>
              <p class="tag">{w.tag}</p>
            </div>
            <div class="chips top-chips">
              <span class="pill">{bn(w.cats.length)} বিভাগ</span>
              <span class="pill">{bn(total)} আইটেম</span>
              <span class="pill">বয়স {w.age}</span>
            </div>
          </header>
          {/* The player bar. Every number on it is earned on this device: points
              for items opened and games won, a title from the points, days in a
              row from the dates this browser opened a world. */}
          <details class="progress-drawer">
            <summary>আমার অগ্রগতি</summary>
          <div class="player" id="player">
            <span class="pl-lvl"><b id="pl-lvl">স্তর ১</b><span id="pl-title">নবীন</span><span class="pl-bar" aria-hidden="true"><i id="pl-bar"></i></span></span>
            <span class="pl-xp">⚡ <b id="pl-xp">০</b> জ্ঞানবিন্দু</span>
            <span class="pl-streak">🔥 <b id="pl-days">১</b> দিন</span>
            {/* Today's three things, and a way to the day's own page. The dots
                are the whole goal: filled, filled, empty means one left. */}
            <a class="pl-goal" id="pl-goal" href="/today/" title="আজকের লক্ষ্য - তিনটা কাজ">
              <span class="pg" aria-hidden="true"><i></i><i></i><i></i></span>আজ
            </a>
            <button type="button" class="pl-sound" id="pl-sound" aria-pressed="true" aria-label="খেলার শব্দ">🔔</button>
            <span class="xp-float" id="xp-float" aria-hidden="true"></span>
          </div>
          </details>

          {/* One thing to do next, named.

              The page is a good catalogue and was only a catalogue: everything
              available, nothing proposed. A child coming back had to pick from
              a wall. This names one thing - usually the next unread item, by
              its actual name - and takes them there. */}
          <p class="next" id="next-up" hidden>
            <span id="next-why"></span>
            <button type="button" id="next-go"></button>
          </p>
          <p class="lesson-cue"><b>করে দেখো</b><span id="lesson-cue">{first.play}</span></p>
          <div class="scene">
            <nav class="zoombar" aria-label="কোথায় আছো">
              <a class="crumb crumb-world" href="/#worlds">{w.bn}</a>
              <span class="sep sep-world" aria-hidden="true">›</span>
              <button type="button" class="crumb cur" id="crumb-cat">{first.n}</button>
              <span class="sep" id="crumb-sep2" aria-hidden="true">›</span>
              <button type="button" class="crumb" id="crumb-item">{first.items[0]}</button>
            </nav>
            <div class="host" id="hero-host" role="img" aria-label="থ্রিডি মডেল - টেনে ঘোরাও">
              <canvas></canvas>
              {/* The 3D engine is a 145KB download that starts after the text
                  has painted, so for a moment this box is empty. Saying so beats
                  looking broken. Removed the instant the model mounts. */}
              <div class="loading" id="hero-loading" aria-hidden="true"><span></span><span></span><span></span><p>মডেল আসছে…</p></div>
            </div>
            <canvas class="fx" id="fx" aria-hidden="true"></canvas>
            {/* খোঁজার খেলা: the model asks for one of its own items and the child has
                to click that badge on it. Nothing is read out; finding is the game. */}
            <div class="quest" id="quest" hidden>
              <div class="q-card" id="q-card" role="status" aria-live="polite">
                <span class="lbl q-l">খুঁজে বের করো</span>
                <span class="q-target"><span class="q-emoji" id="q-emoji"></span><b id="q-name"></b></span>
                <span class="q-meta"><span id="q-count">০ / ০</span> · <span id="q-time">০ সেকেন্ড</span></span>
                <button type="button" class="q-x" id="q-quit" aria-label="খেলা বন্ধ করো">✕</button>
              </div>
              <p class="q-hint" id="q-hint"></p>
            </div>
            <div class="qres" id="qres" hidden>
              <div class="qres-card">
                <p class="lbl">খোঁজার খেলা শেষ</p>
                <p class="q-stars" id="q-stars" aria-label="তারা">★★★</p>
                <h3 id="q-head">দারুণ!</h3>
                <p class="q-sum" id="q-sum"></p>
                <div class="q-btns">
                  <button type="button" id="q-again">আবার খেলো</button>
                  <button type="button" id="q-next" class="primary">পরের বিভাগ →</button>
                  <button type="button" id="q-read">পড়তে যাও</button>
                </div>
              </div>
            </div>
            <p class="award-toast" id="award-toast" role="status" aria-live="polite" hidden></p>
            <p class="hint" id="hero-hint">গোল ছবিগুলোয় ক্লিক করো · টেনে ঘোরাও · খুলে দেখো টানো</p>
            <p class="model-note">ধারণা বোঝানোর মডেল · মাপ ও দূরত্ব একই অনুপাতে নয়</p>
            <noscript><p class="hint">থ্রিডি মডেল দেখতে জাভাস্ক্রিপ্ট চালু করো।</p></noscript>
            <div class="scenebar">
              <label class="ctl-r"><span id="ctl-label" class="lbl">-</span><input type="range" id="ctl" min="0" max="100" value="50" aria-labelledby="ctl-label" /></label>
              {/* Every model comes apart: the engine slides the scene's own
                  pieces outward and the item badges ride with them. */}
              <label class="ctl-r ctl-x"><span id="ctl-x-label" class="lbl">খুলে দেখো</span><input type="range" id="ctl-x" min="0" max="100" value="0" aria-labelledby="ctl-x-label" /></label>
              <div class="hctl">
                <button type="button" id="q-start" class="q-start">🎯 খোঁজার খেলা</button>
                <button type="button" id="h-spin" aria-pressed="true">ঘোরানো থামাও</button>
                <button type="button" id="h-reset">সোজা করো</button>
                <button type="button" id="h-big" aria-pressed="false">⛶ পর্দাজুড়ে</button>
                <span class="hang" id="h-angle">কোণ ০°</span>
              </div>
            </div>
          </div>

          <div class="items" id="c-items">
            <div class="items-h">
              <div>
                <p class="lbl">বিভাগ <span id="c-no">০১</span></p>
                <h2 id="c-name" aria-live="polite">{first.n}</h2>
                <p class="play" id="c-play"><b>পর্দায়</b>{first.play}</p>
              </div>
              <span class="cat-prog" id="cat-prog"><b id="cat-prog-n">০</b> / {bn(first.items.length)} দেখা</span>
            </div>
            <p class="items-h-s" id="items-h-s">নিচের যেকোনোটিতে ক্লিক করো - ডানে তার পুরো কথা খুলবে</p>
            <div class="extras" id="extras" hidden={!firstReadable && !first.lab && catMission[0] === null}>
              <a class="xbtn" id="x-quiz" href={`/${w.slug}/quiz/0/`} hidden={!firstReadable}>যাচাই দাও{plan ? '' : ' · পরিবার'}</a>
              <a class="xbtn" id="x-ws" href={`/${w.slug}/worksheet/0/`} hidden={!firstReadable}>অনুশীলনী ছাপাও{plan ? '' : ' · পরিবার'}</a>
              <a class="xbtn" id="x-lab" href={first.lab ?? '/'} hidden={!first.lab}>হাতে-কলমে টুল</a>
              <button type="button" class="xbtn xbtn-play" id="x-mission" data-mi={catMission[0] ?? ''} hidden={catMission[0] === null}>এই বিভাগের মিশন ▶</button>
              {child && <span class="xwho">পড়ছে: <b>{child.nickname}</b> <a href="/account/">বদলাও</a></span>}
            </div>
            {/* Reading comes first when there is writing. A category can have
                both - সরল যন্ত্র is written *and* has a lab - and turning its
                chips into tool links would hide the writing that exists. The
                lab is offered beside the reading instead, as one more thing
                to do, and per item from the reading panel. */}
            <div class="chips" id="chips">
              {firstReadable
                ? first.items.map((it, j) => <button type="button" class="chip" data-di={j} aria-pressed={j === 0 ? 'true' : 'false'}>{it}</button>)
                : first.lab
                  ? first.items.map((it, j) => <a class="chip chip-real" href={`${first.lab}#${first.labAnchors![j]}`}><span class="check" aria-hidden="true">✓</span>{it}</a>)
                  : first.items.map((it) => <button type="button" class="chip" data-key={`${w.slug}:${first.n}:${it}`} aria-pressed="false"><span class="star" aria-hidden="true">★</span>{it}</button>)}
            </div>
            <p class="toast" id="star-toast" role="status" aria-live="polite"></p>
          </div>

          <div class="actions">
            <button type="button" data-act="prev">← আগেরটা</button>
            <button type="button" data-act="print" id="print-btn">
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M6 8V3h8v5M6 15H4v-5h12v5h-2M6 13h8v4H6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              ছাপাও
            </button>
            <button type="button" data-act="read" class="primary">
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M3 4h6a2 2 0 0 1 2 2v10a1.5 1.5 0 0 0-1.5-1.5H3zM17 4h-6a2 2 0 0 0-2 2v10a1.5 1.5 0 0 1 1.5-1.5H17z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
              পড়ো
            </button>
            <button type="button" data-act="next">পরেরটা →</button>
          </div>
        </section>

        <section class="card glance" id="glance">
          <div class="card-h">
            <span class="lbl">{w.bn} এক নজরে</span>
            <span class="lbl gauto" id="gauto">নিজে নিজে বদলাচ্ছে</span>
          </div>
          <div class="gseg" role="group" aria-label="কোন হিসাবে তুলনা">
            {GMETRICS.map(([id, label], i) => (
              <button type="button" data-m={id} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>
            ))}
          </div>
          <div class="gchart" id="gchart">
            {w.cats.map((c, i) => (
              <button type="button" class="grow" data-i={i} style={`--o:${shade(i)}`}>
                <span class="gn">{c.n}</span>
                <span class="gtrack"><i></i></span>
                <span class="gv"></span>
              </button>
            ))}
          </div>
          <p class="gcap" id="gcap"></p>
          <div class="agebox">
            <p class="kg"><b id="prog-line">এই ভুবনে তোমার যাত্রা সবে শুরু।</b></p>
            <span class="bar"><i id="prog-bar"></i></span>
            <button type="button" class="mini nextnew" id="next-new">পরের নতুনটা পড়ো →</button>
          </div>
        </section>

        {/* এরপর কোথায় - the pocket of empty column under the model.

            The right rail runs two to four hundred pixels taller than the
            middle one on every world, so এক নজরে ended on a hole. Meanwhile the
            only route to সংগ্রহশালা, পড়ার সিঁড়ি, the ছাপার প্যাক, this world's
            own hands-on tools or the other ten worlds was the footer, three
            screens down past everything. These are those destinations moved
            into the space that was already there, each saying what is actually
            behind it instead of only its name. */}
        <section class="card onward" id="onward">
          <div class="card-h"><span class="lbl">এরপর কোথায়</span><span class="lbl num">এই পাতার বাইরে</span></div>
          <div class="ow-grid">
            {labCats.map((c) => (
              <a class="ow ow-lab" href={c.lab}>
                <span class="ow-e" aria-hidden="true">🛠</span>
                <span class="ow-t"><b>{c.n} - হাতে-কলমে</b><small>{bn(c.items.length)}টি জিনিস নিজে টেনে চালিয়ে দেখো</small></span>
              </a>
            ))}
            <a class="ow" href="/today/">
              <span class="ow-e" aria-hidden="true">🌅</span>
              <span class="ow-t"><b>আজকের পসরা</b><small>রোজ নতুন - দিনের একটা জিনিস, তিনটা কাজ</small></span>
            </a>
            <a class="ow" href="/collection/">
              <span class="ow-e" aria-hidden="true">🗄</span>
              <span class="ow-t"><b>সংগ্রহশালা</b><small id="ow-coll">তুমি যা যা খুলেছ, সব এক তাকে সাজানো</small></span>
            </a>
            <a class="ow" href="/ladder/">
              <span class="ow-e" aria-hidden="true">🪜</span>
              <span class="ow-t"><b>পড়ার সিঁড়ি</b><small>সহজ থেকে কঠিন - মেপে সাজানো পথ</small></span>
            </a>
            <a class="ow" href="/printables/">
              <span class="ow-e" aria-hidden="true">🖨</span>
              <span class="ow-t"><b>ছাপার প্যাক</b><small>{bn(sheets.length)}টি শিট, ফ্রি - অ্যাকাউন্ট লাগে না</small></span>
            </a>
          </div>

          {/* The footer says "সব ১১টি ভুবন" and stops. Here each one can say how
              big it is and how far this browser has already got into it, which
              is the part a list of names can never do. */}
          <p class="ow-h lbl">বাকি {bn(otherWorlds.length)}টি ভুবন</p>
          <div class="ow-worlds">
            {otherWorlds.map((o) => (
              <a class="oww" href={o.slug === 'space' ? '/space/' : `/${o.slug}/`} style={`--o:${o.hue}`}
                 data-w={o.slug} data-n={itemCount(o)}>
                <span class="oww-n">{o.bn}</span>
                <b class="oww-m">{bn(itemCount(o))}টি</b>
              </a>
            ))}
          </div>

          <div class="ow-records">
            <div class="card-h"><span class="lbl">রেকর্ড</span><span class="lbl">এই ভুবনে</span></div>
            <div class="recs" id="recs">
              {seedRecords.map((r) => (
                <button type="button" data-i={r.i}>
                  <span>{r.label}</span><b>{r.name} <small>{r.val}</small></b>
                </button>
              ))}
            </div>
          </div>

          <p class="ow-foot">
            বড়দের জন্য: <a href="/family/">পসরা পরিবার</a> · <a href="/schools/">স্কুলের জন্য</a> · <a href="/contact/">প্রশ্ন বা পরামর্শ</a>
          </p>
        </section>
      </div>

      <aside class="info">
        <section class="card read" id="read">
          <div class="card-h">
            <span class="lbl">পড়ো</span>
            <div class="seg" role="group" aria-label="পড়ার গভীরতা">
              {LEVELS.map(([k, l, a]) => <button type="button" data-l={k} aria-pressed={k === 'l1' ? 'true' : 'false'}>{l} <small>{a}</small></button>)}
            </div>
          </div>
          <h3 class="item-name" id="item-name">{first.items[0]}</h3>
          {/* Shown only where a real Bangla voice exists; see src/lib/speak.ts
              for why an English voice reading Bangla is worse than silence. */}
          <button type="button" class="say" id="say" hidden>🔊 শুনে নাও</button>
          <div class="item-chips" id="item-chips">
            {firstItem && chipsFor(firstItem.chips, first.items[0]!).map((c) => <span class="pill">{c}</span>)}
          </div>
          <p class="text" id="item-text">{firstItem?.l1 ?? ''}</p>
          <p class="fun" id="item-fun-wrap"><span class="lbl">মজার তথ্য</span><span id="item-fun">{firstItem?.fun ?? ''}</span></p>
          <p class="text lab-note" id="lab-note" hidden></p>
        </section>

        {/* Missions sit directly under the reading card: they are the thing a
            child comes back for, so they are never below the fold of the rail. */}
        <section class="card miss-card" id="miss-card">
          <div class="card-h">
            <span class="lbl">মিশন</span>
            <span class="lbl num" id="miss-count">০ / {bn(playableMissions)}</span>
          </div>
          {/* The first few, then the rest behind a fold.
              A world used to have three missions and now has up to eleven, and
              eleven full-height rows push everything under them off the page.
              `details` rather than a script, so the fold works before any
              JavaScript runs and a keyboard opens it the usual way. */}
          <div class="miss">
            {missionRows.slice(0, MISS_SHOWN).map((r) => <MissionRow world={w.slug} i={r.i} n={r.m.n} d={r.m.d} cat={r.cat} />)}
          </div>
          {missionRows.length > MISS_SHOWN && (
            <details class="miss-more" id="miss-more">
              <summary>আরও {bn(missionRows.length - MISS_SHOWN)}টি মিশন</summary>
              <div class="miss">
                {missionRows.slice(MISS_SHOWN).map((r) => <MissionRow world={w.slug} i={r.i} n={r.m.n} d={r.m.d} cat={r.cat} />)}
              </div>
            </details>
          )}
          {playableMissions > 0 && <p class="miss-foot" id="miss-foot"></p>}
        </section>

        {familyTop.length > 0 && (
          <section class="card fam">
            <div class="card-h"><span class="lbl">পরিবারে এই সপ্তাহে</span><span class="lbl num">{w.bn}</span></div>
            <ul class="famlist">
              {familyTop.map((r) => (
                <li class={r.childId === child?.id ? 'me' : undefined}>
                  <span class="fn">{r.nickname}{r.childId === child?.id && <small>তুমি</small>}</span>
                  <span class="fb" aria-hidden="true"><i style={`width:${Math.round((r.items / familyTop[0]!.items) * 100)}%`}></i></span>
                  <span class="fnum"><b>{bn(r.items)}</b>টা</span>
                </li>
              ))}
            </ul>
            <p class="note">শুধু এই ভুবনে, শেষ সাত দিনে। এটা পরিবারের ভেতরের হিসাব - বাইরের কেউ নেই।</p>
          </section>
        )}

        <section class="card">
          <div class="card-h"><span class="lbl">অর্জন</span><span class="lbl num" id="aw-count">০ / {bn(AWARDS.length)}</span></div>
          {/* Eleven grey locks say "you have done nothing". This says which one
              is within reach and how far, so the grid has a way in. */}
          <p class="aw-near" id="aw-near" hidden></p>
          <div class="awards" id="awards">
            {AWARDS.map((a) => (
              <span class="aw" data-id={awardKey(a, w.slug)} title={a.desc}>
                <span class="aw-e" aria-hidden="true">{a.emoji}</span>
                <span class="aw-n">{a.name}</span>
                <span class="aw-d">{a.desc}</span>
              </span>
            ))}
          </div>
        </section>

        <section class="card">
          <div class="card-h"><span class="lbl">এই ভুবনে যা যা করা যাবে</span></div>
          <div class="keys">
            {w.keys.map((k, i) => w.keyCats[i] !== null ? (
              <button type="button" class="pill pill-w key-jump" data-cat={w.keyCats[i]}>{k}</button>
            ) : w.keyMissions?.[i] != null ? (
              <button type="button" class="pill pill-w key-mission" data-km={w.keyMissions[i]}>{k}<small>মিশন</small></button>
            ) : (
              <span class="pill key-soon">{k}<small>শীঘ্রই</small></span>
            ))}
          </div>
          <p class="intro">{w.intro}</p>
        </section>

        <a class="card cta" href="/space/">
          <span class="lbl">থ্রিডি সৌরজগৎ ঘুরে আসবে?</span>
          <b>মহাকাশ ভুবন খোলা আছে →</b>
        </a>

        <section class="card">
          <div class="card-h"><span class="lbl">ভুবন পরিচিতি</span></div>
          <div class="spec">
            <div class="row"><span class="k">কোন বয়সের জন্য</span><span class="v">{w.age}</span></div>
            <div class="row"><span class="k">বিভাগ</span><span class="v">{bn(w.cats.length)}</span></div>
            <div class="row"><span class="k">শেখার আইটেম</span><span class="v">{bn(total)}</span></div>
            <div class="row"><span class="k">আগে কী জানা দরকার</span><span class="v">{w.dep}</span></div>
            <div class="row"><span class="k">তুমি দেখেছ</span><span class="v" id="spec-read">০</span><span class="meter"><i id="spec-meter"></i></span></div>
          </div>
        </section>
      </aside>
    </div>

    {/* The whole world as plain text, in the HTML from the first byte.
        The explorer above shows one item at a time through JavaScript, which
        means the reading for the other eighty-odd items existed only inside a
        JSON blob: unreachable by find-on-page, unreadable without scripts, and
        invisible as prose to anything that reads the web. This section is the
        same readings as real markup. It costs about 20KB and it is the part of
        the page a search result or an assistant can actually quote. */}
    <section class="index" id="all">
      <div class="index-h">
        <div>
          <p class="eyebrow">সবকিছু এক জায়গায়</p>
          <h2>{w.bn} ভুবনের পুরো তালিকা</h2>
          <p class="index-s">
            {bn(w.cats.length)}টি বিভাগ, {bn(total)}টি বিষয়। নিচের যেকোনো শিরোনামে চাপলে
            ছোট লেখাটা খুলবে। পুরো লেখা আর তিনটি গভীরতা উপরের মডেলে।
          </p>
        </div>
        {/* Eighty-four things in a grid is a wall, and a wall is only useful to
            someone who already knows what they are looking for. Typing filters
            every name, every tag and every line of the reading at once, which
            is the difference between a list and a way in. Plain markup, so the
            list is still whole and quotable with scripts off. */}
        <div class="ix-find">
          <label class="lbl" for="ix-q">খুঁজে নাও</label>
          <input type="search" id="ix-q" placeholder={`${first.items[0]}, ${w.cats[1]?.items[0] ?? ''}…`} autocomplete="off" />
          <span class="lbl num" id="ix-count" role="status" aria-live="polite"></span>
        </div>
      </div>
      {/* The sideways links to the other ten worlds used to be a plain row of
          names here. এরপর কোথায় now carries the same ten as real links a few
          hundred pixels up, each with its size and how far this browser has
          got, so this line was the same list said worse, twice on one page. */}
      {payload.map((c, ci) => (
        <div class="index-cat" style={`--o:${shade(ci)}`}>
          <h3>
            <span class="ix-e" aria-hidden="true">{catEmoji(w.slug, c.n)}</span>
            <span class="lbl">বিভাগ {pad2(ci + 1)}</span>{c.n}
            <span class="lbl num ix-n">{bn(c.items.length)}টি</span>
          </h3>
          <p class="index-play">{c.play}</p>
          {c.detail && c.detail.length === c.items.length ? (
            <div class="index-items">
              {c.items.map((it, ii) => (
                <details class="ix">
                  <summary>
                    <span class="ix-i" aria-hidden="true">{c.emoji[ii] ?? '•'}</span>
                    {/* Name and tags wrap inside their own box, so the chevron
                        stays on the first line instead of being pushed onto a
                        second one by a long name. */}
                    <span class="ix-t"><b>{it}</b>{chipsFor(c.detail![ii].chips, it, 2).map((ch) => <span class="pill">{ch}</span>)}</span>
                  </summary>
                  <p>{c.detail![ii].l1}</p>
                  <p class="ix-fun"><span class="lbl">মজার তথ্য</span>{c.detail![ii].fun}</p>
                  <p class="ix-more">
                    <button type="button" class="ix-open" data-c={ci} data-i={ii}>উপরে মডেলে দেখাও →</button>
                  </p>
                </details>
              ))}
            </div>
          ) : c.lab ? (
            <p class="index-note">এই বিভাগের প্রতিটি আইটেম আলাদা একটা চালু টুল: {c.items.join(', ')}। <a href={c.lab}>{c.n} টুলে যাও →</a></p>
          ) : (
            <p class="index-note">এই বিভাগের লেখা এখনও তৈরি হয়নি। বিষয়গুলো হলো {c.items.join(', ')}।</p>
          )}
        </div>
      ))}
      <p class="ix-none" id="ix-none" hidden></p>
    </section>

    {/* Built on demand when someone presses ছাপাও, and only ever visible on
        paper. A teacher gets the whole category as a handout at the reading
        depth they already chose, with no 3D canvas and no navigation on it. */}
    <div class="printable" id="printable" aria-hidden="true"></div>

    <div class="status card">
      <span class="lbl">কতদূর হলো</span>
      <span class="bar"><i id="log-bar"></i></span>
      <span class="lbl num" id="log-text">০ / {bn(total)}</span>
    </div>
    <p class="back"><a href="/#worlds">← সব ভুবন</a> · <a href="/space/">মহাকাশ</a> · <a href="/contact/">প্রশ্ন বা পরামর্শ?</a></p>

    <script is:inline type="application/json" id="world-data" set:html={JSON.stringify(payload)}></script>
  </div>
</Base>

<style>
  .page { padding-block: 1rem 3.5rem; }
  /* Past this width the extra goes to the stage, because the two side columns
     are fixed. Below it nothing changes. */
  @media (min-width: 1400px) { .page { --wrap: 1540px; } }
  .crumbs { font-size: 13px; color: var(--muted); margin-bottom: 0.75rem; }
  .crumbs span { margin: 0 0.35rem; }
  .xp { display: grid; grid-template-columns: 250px minmax(0, 1fr) 292px; gap: 0.85rem; align-items: start; }
  .xp > * { min-width: 0; }
  .card-h { padding: 0.7rem 0.95rem; border-bottom: 1px solid var(--line-soft); display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }

  /* rail */
  .rail { overflow: hidden; border-color: color-mix(in oklab,var(--w) 34%,var(--line)); }
  .rail-list { padding: 6px; display: flex; flex-direction: column; gap: 2px; max-height: 640px; overflow-y: auto; }
  .rail-list button { display: flex; align-items: center; gap: 0.7rem; width: 100%; text-align: left; padding: 8px 9px; border-radius: 11px; border-left: 3px solid transparent; transition: background 0.15s ease; }
  .rail-list button:hover { background: var(--panel-2); }
  .rail-list button[aria-current="true"] { background: color-mix(in oklab, var(--o) 22%, var(--panel)); border-left-color: var(--o); box-shadow: inset 0 0 0 1px color-mix(in oklab,var(--o) 40%,transparent); }
  /* the subject of the row, not another identical bead */
  .rorb { width: 32px; height: 32px; border-radius: 11px; flex: none; display: grid; place-items: center; font-size: 17px; line-height: 1;
    background: color-mix(in oklab, var(--o) 18%, var(--panel)); border: 1px solid color-mix(in oklab, var(--o) 38%, var(--line)); transition: transform 0.2s ease, background 0.2s ease;
    /* The icon font is monochrome, so the mark takes the row's own colour
       instead of arriving in whatever hue the phone's emoji artist chose. */
    color: color-mix(in oklab, var(--o) 72%, var(--ink)); }
  .rail-list button:hover .rorb { transform: scale(1.1); }
  .rail-list button.done .rorb { border-color: var(--ok); box-shadow: 0 0 0 2px color-mix(in oklab, var(--ok) 28%, transparent); }
  .rt { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
  .nm { font-family: var(--font-display); font-weight: 700; font-size: 15px; }
  .tg { font-size: 11.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .no { margin-left: auto; font-size: 10px; }

  /* stage */
  .mid { display: flex; flex-direction: column; gap: 0.85rem; min-width: 0; }
  .stage { display: flex; flex-direction: column; min-height: 620px; overflow: hidden; border-color: color-mix(in oklab,var(--w) 42%,var(--line)); box-shadow: 6px 6px 0 color-mix(in oklab,var(--w) 28%,transparent),var(--shadow); }
  .stage-h { display: flex; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.4rem 0; flex-wrap: wrap; }
  .stage-h h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); letter-spacing: -0.01em; line-height: 1.15; font-weight: 800; margin-top: 0.1rem; overflow-wrap: anywhere; }
  .tag { color: var(--muted); font-size: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; }
  .top-chips { padding-top: 0.4rem; }

  /* progress stays available without competing with the lesson */
  .progress-drawer { margin: 0.7rem 1.4rem 0; align-self: flex-start; }
  .progress-drawer summary { cursor: pointer; list-style: none; width: max-content; font-size: 13px; font-weight: 700; color: var(--ink-2); padding: 0.35rem 0.75rem; border: 1px solid var(--line-soft); border-radius: 999px; background: var(--panel-2); }
  .progress-drawer summary::-webkit-details-marker { display: none; }
  .progress-drawer summary::after { content: ' +'; color: var(--w); }
  .progress-drawer[open] summary::after { content: ' −'; }
  .player { position: relative; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin: 0.8rem 1.4rem 0; }
  .progress-drawer .player { margin: 0.55rem 0 0; }
  .player > span, .pl-sound { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 12.5px; padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--panel-2); border: 1px solid var(--line-soft); color: var(--ink-2); }
  .player b { font-family: var(--font-display); font-size: 14px; color: var(--ink); }
  .pl-lvl { gap: 0.5rem; }
  .pl-lvl b { color: var(--w); }
  .pl-bar { display: block; width: 64px; height: 5px; border-radius: 3px; background: var(--sunk); overflow: hidden; }
  .pl-bar i { display: block; height: 100%; width: 0; background: var(--w); transition: width 0.6s ease; }
  .pl-sound { cursor: pointer; transition: background 0.15s ease; }
  .pl-sound[aria-pressed="false"] { opacity: 0.55; text-decoration: line-through; }
  .pl-goal { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 12.5px; padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--panel-2); border: 1px solid var(--line-soft); color: var(--ink-2); transition: border-color 0.15s ease, color 0.15s ease; }
  .pl-goal:hover { border-color: var(--w); color: var(--w); }
  .pl-goal.met { background: color-mix(in oklab, var(--w) 14%, var(--panel)); border-color: color-mix(in oklab, var(--w) 40%, var(--line-soft)); color: var(--w); font-weight: 700; }
  .pg { display: inline-flex; gap: 3px; }
  .pg i { width: 7px; height: 7px; border-radius: 50%; background: var(--line); display: block; transition: background 0.25s ease, transform 0.25s ease; }
  .pg i.on { background: var(--w); transform: scale(1.15); }
  .xp-float { position: absolute; left: 0; top: 0; pointer-events: none; font-family: var(--font-display); font-weight: 800; font-size: 15px; color: var(--w); opacity: 0; }
  .xp-float.go { animation: xpfloat 1.1s ease-out forwards; }
  @keyframes xpfloat { 0% { opacity: 0; transform: translateY(6px); } 15% { opacity: 1; } 100% { opacity: 0; transform: translateY(-34px); } }

  /* the find-it game, over the model */
  .fx { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; }
  .quest { position: absolute; top: 48px; left: 0; right: 0; z-index: 6; display: flex; flex-direction: column; align-items: center; gap: 0.4rem; pointer-events: none; }
  .q-card { pointer-events: auto; display: grid; grid-template-columns: auto auto; grid-template-rows: auto auto; column-gap: 0.9rem; align-items: center; padding: 0.55rem 0.9rem 0.55rem 1rem; border-radius: 16px; background: rgba(9, 14, 24, 0.86); border: 1px solid rgba(255, 255, 255, 0.2); color: #f4f8fc; backdrop-filter: blur(8px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35); }
  .q-card.shake { animation: shake 0.4s ease; }
  @keyframes shake { 0%, 100% { transform: none; } 20% { transform: translateX(-7px); } 40% { transform: translateX(6px); } 60% { transform: translateX(-4px); } 80% { transform: translateX(3px); } }
  .q-l { color: #cfe0f2; grid-column: 1; }
  .q-target { grid-column: 1; grid-row: 2; display: flex; align-items: center; gap: 0.5rem; }
  .q-emoji { font-size: 28px; line-height: 1; }
  .q-target b { font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; }
  .q-meta { grid-column: 2; grid-row: 2; font-family: var(--font-mono); font-size: 11px; color: rgba(226, 235, 245, 0.75); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .q-x { grid-column: 2; grid-row: 1; justify-self: end; width: 24px; height: 24px; border-radius: 50%; background: rgba(255, 255, 255, 0.12); color: #fff; font-size: 12px; }
  .q-x:hover { background: rgba(255, 255, 255, 0.28); }
  .q-hint { font-size: 12.5px; color: #ffe08a; background: rgba(9, 14, 24, 0.7); padding: 3px 12px; border-radius: 999px; min-height: 1.6em; text-align: center; max-width: 90%; }
  .q-hint:empty { display: none; }
  .q-start { background: linear-gradient(135deg, var(--w), color-mix(in oklab, var(--w) 60%, #f0b429)) !important; border-color: transparent !important; }
  .qres { position: absolute; inset: 0; z-index: 7; display: grid; place-items: center; background: rgba(5, 7, 14, 0.62); backdrop-filter: blur(3px); }
  .qres-card { text-align: center; padding: 1.3rem 1.5rem 1.2rem; border-radius: 20px; background: var(--panel); border: 2px solid var(--brand); box-shadow: 6px 6px 0 var(--pink),var(--shadow-lg, 0 20px 50px rgba(0,0,0,.4)); max-width: 92%; width: 380px; animation: pop 0.45s cubic-bezier(.2,.9,.3,1.3); }
  @keyframes pop { from { transform: scale(0.7); opacity: 0; } to { transform: none; opacity: 1; } }
  .q-stars { font-size: 34px; letter-spacing: 0.1em; color: var(--sun); line-height: 1.1; margin-top: 0.3rem; }
  .qres-card h3 { font-size: 1.5rem; font-weight: 800; margin-top: 0.2rem; }
  .q-sum { font-size: 13.5px; color: var(--ink-2); line-height: 1.6; margin-top: 0.4rem; }
  .q-btns { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; margin-top: 0.9rem; }
  .q-btns button { font-size: 13px; font-weight: 700; padding: 0.55rem 0.9rem; border-radius: 11px; border: 2px solid #070b2c; background: #f5f3ff; color: #172033; box-shadow: 3px 3px 0 #070b2c; transition: transform 0.15s ease,box-shadow .15s ease; }
  .q-btns button:hover { transform: translateY(-2px); box-shadow: 3px 5px 0 #070b2c; }
  .q-btns .primary { background: var(--sun); color: #101735; border-color: #070b2c; }
  .award-toast { position: absolute; bottom: 124px; left: 50%; transform: translate(-50%, 8px); z-index: 8; font-size: 13.5px; font-weight: 700; color: #1a1408; background: linear-gradient(135deg, #ffe08a, #f0b429); padding: 0.45rem 1rem; border-radius: 999px; box-shadow: 0 8px 24px rgba(0,0,0,.35); opacity: 0; transition: opacity 0.3s ease, transform 0.3s ease; pointer-events: none; }
  .award-toast.show { opacity: 1; transform: translate(-50%, 0); }
  @media (prefers-reduced-motion: reduce) { .q-card.shake, .qres-card, .xp-float.go { animation: none; } .xp-float.go { opacity: 1; } }

  /* awards shelf */
  .awards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 0.7rem 0.95rem 0.95rem; }
  .aw { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 2px; padding: 0.55rem 0.3rem 0.5rem; border-radius: 12px; background: var(--panel-2); border: 1px solid var(--line-soft); color: var(--muted); }
  .aw-e { font-size: 24px; line-height: 1; filter: grayscale(1); opacity: 0.45; transition: filter 0.3s ease, opacity 0.3s ease, transform 0.3s ease; }
  .aw-n { font-size: 11px; font-weight: 700; line-height: 1.25; }
  .aw-d { display: none; }
  .aw.on { background: color-mix(in oklab, var(--sun) 16%, var(--panel)); border-color: color-mix(in oklab, var(--sun) 55%, var(--line)); color: var(--ink); }
  .aw.near { border-color: color-mix(in oklab, var(--w) 60%, var(--line)); box-shadow: 0 0 0 3px color-mix(in oklab, var(--w) 18%, transparent); color: var(--ink-2); }
  .aw.near .aw-e { filter: grayscale(0.35); opacity: 0.8; }
  .famlist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .famlist li { display: grid; grid-template-columns: minmax(4.5rem, auto) 1fr auto; align-items: center; gap: 0.5rem; font-size: 13px; color: var(--ink-2); }
  .famlist li.me .fn { color: var(--ink); font-weight: 700; }
  .fn small { display: inline-block; margin-left: 0.3rem; font-size: 10px; font-weight: 600; color: var(--on-brand); background: var(--w); padding: 0.05rem 0.35rem; border-radius: 999px; vertical-align: 1px; }
  .fb { height: 8px; border-radius: 999px; background: var(--panel-2); overflow: hidden; }
  .fb i { display: block; height: 100%; border-radius: 999px; background: var(--w); }
  .fnum { font-variant-numeric: tabular-nums; font-size: 12.5px; white-space: nowrap; }
  .fnum b { color: var(--ink); font-family: var(--font-display); font-size: 15px; }

  .aw-near { font-size: 12.5px; color: var(--ink-2); line-height: 1.5; margin-bottom: 0.6rem; }
  .aw-near :global(b) { color: var(--ink); }
  .aw.on .aw-e { filter: none; opacity: 1; transform: scale(1.12); }

  /* the scene is the same dark stage the space explorer uses, so every world
     reads as one product; the hero canvas is transparent and sits on top of it */
  /**
   * The model is the product, so give it the room.
   *
   * 660px in a 711px column is a postage stamp on a 1600px display, and the
   * page around it was mostly margin. The wrap opens to 1540 past 1400px wide
   * - the rail and the reading column are fixed, so every pixel of that goes
   * to the stage - and the stage itself is taller. Measured on a 1700px
   * screen that takes the canvas from 709x646 to about 990x760: two and a half
   * times the area, for two numbers.
   */
  .scene { position: relative; flex: 1; min-height: min(86vh, 980px); overflow: hidden; margin-top: 1rem;
    background: radial-gradient(circle at 82% 14%,rgba(255,111,189,.14),transparent 24%), radial-gradient(ellipse at 50% 42%, color-mix(in oklab, var(--w) 24%, #141c2e) 0%, #0c122d 52%, #05070e 100%); }
  /* Nothing but the model. The engine's own ResizeObserver refits the camera,
     so going full screen costs no extra code on the 3D side. */
  .scene:fullscreen { min-height: 100vh; border-radius: 0; margin: 0; }
  .scene:fullscreen .scenebar { padding-bottom: 1.6rem; }
  .next {
    display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap;
    margin: 0 0 0.7rem; padding: 0.6rem 0.9rem; border-radius: 12px;
    font-size: 14px; color: var(--ink-2); line-height: 1.5;
    background: color-mix(in oklab, var(--w) 12%, var(--panel));
    border: 1px solid color-mix(in oklab, var(--w) 28%, var(--line));
  }
  .next span { flex: 1; min-width: 12ch; }
  .next :global(b) { color: var(--ink); font-weight: 700; }
  .next button {
    font: inherit; font-size: 13.5px; font-weight: 700; cursor: pointer; white-space: nowrap;
    padding: 0.45rem 0.95rem; border-radius: 999px; border: 1px solid transparent;
    background: var(--w); color: var(--on-brand);
    transition: transform 0.14s ease, filter 0.14s ease;
  }
  .next button:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .next button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  @media (pointer: coarse) { .next button { min-height: 44px; } }

  .host { position: absolute; inset: 0; cursor: grab; touch-action: none; overflow: hidden; }
  .host.dragging { cursor: grabbing; }
  .host.dragging canvas { filter: saturate(1.18) brightness(1.08); }
  /* set by the scene when an item is under the pointer: the canvas otherwise
     says "grab" everywhere and never that anything can be opened */
  .host.over-item { cursor: pointer; }
  .host canvas { width: 100%; height: 100%; }
  .lesson-cue { position: relative; z-index: 1; display: flex; align-items: baseline; gap: 0.65rem; margin: 0.65rem 0 0; padding: 0.25rem 0.15rem; max-width: 72ch; color: var(--ink-2); font-size: 13px; line-height: 1.45; }
  .lesson-cue b { flex: none; color: #ffd76a; }
  .model-note { position: absolute; right: 12px; bottom: 92px; z-index: 3; max-width: 30ch; padding: 0.25rem 0.6rem; border-radius: 8px; background: rgba(9, 14, 24, 0.72); color: rgba(226, 235, 245, 0.78); font-size: 12px; line-height: 1.4; text-align: right; pointer-events: none; }
  .loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; pointer-events: none; transition: opacity 0.35s ease; }
  .loading span { width: 44px; height: 44px; border-radius: 50%; background: color-mix(in oklab, var(--w) 55%, #0c1220); opacity: 0.25; animation: hb 1.4s ease-in-out infinite; }
  .loading span:nth-child(2) { width: 74px; height: 74px; animation-delay: 0.18s; }
  .loading span:nth-child(3) { width: 30px; height: 30px; animation-delay: 0.36s; }
  .loading p { margin-top: 0.7rem; font-size: 12px; color: rgba(214, 228, 244, 0.6); }
  .loading.gone { opacity: 0; }
  .loading.fallback { padding: 2rem; text-align: center; color: #eef4fb; opacity: 1; }
  .loading.fallback p { max-width: 42ch; font-size: 15px; line-height: 1.6; }
  .loading.fallback p + p { margin-top: 0.45rem; color: rgba(226, 235, 245, 0.72); font-size: 13.5px; }
  @keyframes hb { 0%, 100% { transform: scale(0.9); opacity: 0.18; } 50% { transform: scale(1.06); opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) { .loading span { animation: none; } }
  .zoombar { position: absolute; top: 10px; left: 12px; right: 12px; z-index: 3; display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .crumb { font-size: 12.5px; font-weight: 600; color: #e6eef8; background: rgba(9, 14, 24, 0.6); border: 1px solid rgba(255, 255, 255, 0.16); padding: 0.22rem 0.7rem; border-radius: 999px; backdrop-filter: blur(6px); transition: background 0.15s ease; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .crumb:hover { background: rgba(9, 14, 24, 0.9); color: #fff; }
  .crumb.cur { background: var(--w); color: #fff; border-color: transparent; }
  .zoombar .sep { color: rgba(226, 235, 245, 0.5); font-size: 12px; }
  .hint { position: absolute; bottom: 86px; left: 50%; transform: translateX(-50%); font-size: 12px; color: #d7e2f0; background: rgba(9, 14, 24, 0.72); padding: 3px 12px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.14); pointer-events: none; transition: opacity 0.4s ease; z-index: 2; }
  .scenebar { position: absolute; left: 0; right: 0; bottom: 0; z-index: 4; padding: 2rem 1.1rem 0.85rem;
    background: linear-gradient(to top, rgba(5, 7, 14, 0.94) 45%, rgba(5, 7, 14, 0.7) 74%, transparent);
    display: flex; flex-direction: column; gap: 0.5rem; pointer-events: none; }
  /* the bar's fade is see-through for clicks, so a badge low on the model
     (roots, feet) is still clickable; only the controls themselves take the pointer */
  .scenebar > * { pointer-events: auto; }
  .ctl-r { display: flex; align-items: center; gap: 0.75rem; }
  .ctl-r .lbl { white-space: nowrap; min-width: 6ch; color: #cfe0f2; }
  .ctl-r input { flex: 1; accent-color: var(--w); height: 4px; cursor: pointer; }
  .ctl-x .lbl { color: #ffd76a; }
  .ctl-x input { accent-color: #f0b429; }
  .hctl { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .hctl button { font-size: 12px; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 999px; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.22); color: #eef4fb; backdrop-filter: blur(4px); transition: background 0.15s ease, transform 0.15s ease; }
  .hctl button:hover { transform: translateY(-1px); background: rgba(255, 255, 255, 0.2); }
  .hctl button[aria-pressed="true"] { background: var(--w); color: #fff; border-color: transparent; }
  .hang { margin-left: auto; font-family: var(--font-mono); font-size: 11px; color: rgba(226, 235, 245, 0.66); font-variant-numeric: tabular-nums; }

  /* item strip */
  .items { padding: 1rem 1.4rem 1.1rem; }
  .items-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .items-h h2 { font-size: clamp(1.25rem, 2.4vw, 1.65rem); margin: 0.15rem 0 0.5rem; }
  .play { font-size: 14px; color: var(--ink-2); padding-left: 0.85rem; border-left: 2px solid color-mix(in oklab, var(--w) 50%, var(--line)); }
  .play :global(b) { display: block; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--w); }
  .cat-prog { flex: none; font-size: 12px; color: var(--w); background: color-mix(in oklab, var(--w) 12%, var(--panel)); border: 1px solid color-mix(in oklab, var(--w) 34%, var(--line)); border-radius: 999px; padding: 0.3rem 0.7rem; white-space: nowrap; }
  .cat-prog b { font-family: var(--font-display); font-size: 14px; }
  .items-h-s { font-size: 12.5px; color: var(--muted); margin: 0.85rem 0 0.6rem; }
  .extras { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 0 0 0.75rem; }
  .extras[hidden] { display: none; }
  .xbtn { font-size: 12.5px; font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 999px; border: 1px solid color-mix(in oklab, var(--w) 40%, var(--line)); background: color-mix(in oklab, var(--w) 10%, var(--panel)); color: var(--ink); transition: background 0.15s ease, transform 0.15s ease; }
  .xbtn:hover { transform: translateY(-1px); background: color-mix(in oklab, var(--w) 20%, var(--panel)); }
  /* A button, not a link, so it needs the family and the pointer said out loud. */
  .xbtn-play { font-family: inherit; cursor: pointer; line-height: inherit; }
  .xwho { margin-left: auto; font-size: 12.5px; color: var(--muted); }
  .xwho a { margin-left: 0.3rem; color: var(--brand-ink); font-weight: 600; }
  /* NOTE: the chips are rebuilt by the script on every category change, so their
     rules must be :global(). Astro stamps data-astro-cid onto elements at build
     time, and a JS-created <button class="chip"> never gets one, so a scoped
     .chip selector would match nothing and the list would render unstyled. */
  .chips :global(.chip) { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 13.5px; padding: 7px 13px; border-radius: 10px; background: var(--panel-2); border: 1px solid var(--line); color: var(--ink-2); transition: background 0.15s ease, transform 0.15s ease, border-color 0.15s ease; }
  .chips :global(.chip:hover) { background: color-mix(in oklab, var(--w) 14%, var(--panel)); border-color: color-mix(in oklab, var(--w) 34%, var(--line)); transform: translateY(-1px); }
  .chips :global(.chip[data-di][aria-pressed="true"]) { background: var(--w); border-color: transparent; color: #fff; font-weight: 700; }
  .chips :global(.chip.done) { border-color: color-mix(in oklab, var(--ok) 45%, var(--line)); }
  .chips :global(.chip.done::before) { content: "✓"; color: var(--ok); font-size: 12px; font-weight: 700; }
  .chips :global(.chip[data-di][aria-pressed="true"].done::before) { color: #fff; }
  .chips :global(.chip .star) { color: var(--line); font-size: 15px; line-height: 1; transition: color 0.15s ease, transform 0.2s ease; }
  .chips :global(.chip[data-key][aria-pressed="true"]) { border-color: color-mix(in oklab, var(--sun) 60%, var(--line)); background: color-mix(in oklab, var(--sun) 16%, var(--panel)); color: var(--ink); font-weight: 600; }
  .chips :global(.chip[data-key][aria-pressed="true"] .star) { color: var(--sun); transform: scale(1.3) rotate(-12deg); }
  .chips :global(.chip-real) { background: color-mix(in oklab, var(--ok) 12%, var(--panel)); border-color: color-mix(in oklab, var(--ok) 36%, var(--line)); color: var(--ink); font-weight: 600; }
  .chips :global(.chip-real:hover) { background: color-mix(in oklab, var(--ok) 20%, var(--panel)); }
  .chips :global(.chip-real .check) { color: var(--ok); font-size: 13px; }
  .toast { margin-top: 0.7rem; font-size: 12.5px; font-weight: 600; color: var(--brand-ink); opacity: 0; transition: opacity 0.25s ease; }
  .toast.show { opacity: 1; }

  .actions { display: flex; justify-content: center; gap: 6px; padding: 0.75rem; border-top: 1px solid var(--line-soft); background: var(--panel-2); margin-top: auto; }
  .actions button { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.58rem 1.05rem; border-radius: 11px; font-weight: 700; font-size: 14px; color: var(--ink-2); border: 1px solid var(--line); transition: background 0.15s ease, transform 0.15s ease; }
  .actions button:hover { background: var(--panel); transform: translateY(-1px); }
  .actions .primary { background: var(--sun); color: #101735; border-color: transparent; box-shadow: 3px 3px 0 var(--pink); }
  .actions .primary:hover { background: #ffe574; }

  /* এক নজরে - the animated comparison chart under the stage */
  .glance { overflow: hidden; }
  .gauto { color: var(--w); transition: opacity 0.3s ease; }
  .gauto[hidden] { display: none; }
  .gseg { display: flex; flex-wrap: wrap; gap: 6px; padding: 0.75rem 1.1rem 0.2rem; }
  .gseg button { font-size: 12.5px; font-weight: 700; padding: 0.28rem 0.8rem; border-radius: 999px; color: var(--ink-2);
    background: var(--panel-2); border: 1px solid var(--line-soft); transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease; }
  .gseg button:hover { transform: translateY(-1px); background: var(--panel); }
  .gseg button[aria-pressed="true"] { background: var(--w); color: #fff; border-color: transparent; }
  .gchart { padding: 0.6rem 1.1rem 0.2rem; display: flex; flex-direction: column; gap: 1px; }
  .grow { display: grid; grid-template-columns: 118px minmax(0, 1fr) auto; align-items: center; column-gap: 0.7rem;
    width: 100%; text-align: left; padding: 0.3rem 0.4rem; border-radius: 8px; transition: background 0.15s ease; }
  .grow:hover { background: color-mix(in oklab, var(--w) 8%, transparent); }
  .grow[aria-current="true"] { background: color-mix(in oklab, var(--o) 16%, transparent); }
  .gn { font-size: 13px; font-weight: 600; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .grow[aria-current="true"] .gn { color: var(--ink); font-weight: 800; }
  .gtrack { display: block; height: 13px; border-radius: 999px; background: var(--sunk); overflow: hidden; }
  .gtrack i { display: block; height: 100%; width: 0; border-radius: 999px;
    background: linear-gradient(90deg, color-mix(in oklab, var(--o) 55%, var(--panel)), var(--o));
    transition: width 0.75s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: calc(var(--i, 0) * 45ms); }
  .gv { font-size: 12.5px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; min-width: 84px; text-align: right; }
  .gv.none { color: var(--muted); font-weight: 500; font-size: 11.5px; }
  .gcap { padding: 0.5rem 1.15rem 0; font-size: 12px; color: var(--muted); line-height: 1.6; }
  .agebox { margin: 0.8rem 1.1rem 1rem; padding: 0.7rem 0.85rem; border-radius: 12px; background: var(--panel-2); border: 1px solid var(--line-soft); display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }
  .agebox .kg { font-size: 13px; color: var(--ink-2); }
  .agebox .kg b { color: var(--ink); }
  .agebox .bar { width: 100%; }
  .nextnew { align-self: flex-start; }
  @media (prefers-reduced-motion: reduce) { .gtrack i { transition: none; } }

  /* এরপর কোথায় - destinations, not another card each */
  .onward { overflow: hidden; }
  .ow-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(255px, 1fr)); gap: 5px; padding: 0.7rem 0.8rem 0.2rem; }
  .ow { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 0.7rem;
    padding: 0.5rem 0.6rem; border-radius: 12px; border: 1px solid transparent; transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease; }
  .ow:hover { background: var(--panel-2); border-color: var(--line-soft); transform: translateY(-1px); }
  .ow-e { width: 34px; height: 34px; flex: none; display: grid; place-items: center; font-size: 17px; line-height: 1; border-radius: 11px;
    background: var(--panel-2); border: 1px solid var(--line-soft); }
  .ow:hover .ow-e { background: var(--panel); }
  .ow-lab .ow-e { background: color-mix(in oklab, var(--w) 16%, var(--panel)); border-color: color-mix(in oklab, var(--w) 34%, var(--line)); }
  .ow-t { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .ow-t b { font-family: var(--font-display); font-weight: 700; font-size: 14.5px; }
  .ow-lab .ow-t b { color: var(--w); }
  .ow-t small { font-size: 11.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

