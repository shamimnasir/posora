<script>
  import { toggleStar, isStarred, getProgress, markSeen, addXp, grantAward, setBest, setMission, finishTask, todayState, freezeCount } from '../../lib/progress';
  import { levelOf, AWARDS, awardKey, starsFor, starText, secText, confetti, chime, soundOn, setSound } from '../../lib/game';
  import { praise } from '../../lib/praise';
  import { goalParts, goalDone, goalMet } from '../../lib/daily';
  import { beginSession, noteItem, noteAct, goalJustMet, reachedMilestone } from '../../lib/session';
  import { makeSpeaker, type Speaker } from '../../lib/speak';
  import { bn, pad2, bnOf } from '../../lib/bn';
  import { track, trackItem, trackCategory, trackDepth, trackPlay } from '../../lib/track';
  import { setProgressScope } from '../../lib/progress';
  import { syncWorld, pushSeen } from '../../lib/sync';
  import type { HeroHandle, HeroSpec } from '../../components/explorer/heroes';
  import type { ItemDetail } from '../../data/explorer-types';

  type Cat = {
    n: string; items: string[]; play: string; hero: HeroSpec;
    lab?: string; labAnchors?: string[]; detail: ItemDetail[] | null; chars: number;
    emoji: (string | undefined)[];
  };

  const root = document.getElementById('world')!;
  const slug = root.dataset.slug!;
  // A family plan child reads into their own bucket, mirrored to the server.
  const childId = root.dataset.child || null;
  setProgressScope(childId);
  const cats: Cat[] = JSON.parse(document.getElementById('world-data')!.textContent!);
  const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Only items that can actually be opened count toward progress. A tool
  // category (গণিত - পরিমাপ) links out and is never marked, so counting its
  // items here would cap the bar below 100% forever.
  const TOTAL = cats.reduce((s, c) => s + (c.detail && c.detail.length === c.items.length ? c.items.length : 0), 0);
  /** Characters a comfortable Bangla reader gets through in a minute. Stated in
      the chart caption so the estimate can be judged, not just trusted. */
  const CHARS_PER_MIN = 600;

  const rail = [...root.querySelectorAll<HTMLButtonElement>('.rail-list [data-i]')];
  const chips = $('#chips');
  const starToast = $('#star-toast');
  let toastTimer = 0;

  let curCat = 0, curItem = 0;
  let level = (localStorage.getItem('posora:level') as 'l1' | 'l2' | 'l3' | null) ?? 'l1';
  let hero: HeroHandle | null = null, lastDeg = -1;
  // "did this visitor actually touch the model", counted once per category so a
  // single drag does not turn into a hundred events
  let playCounted = false;
  let playedEver = false;
  const countPlay = () => {
    playedEver = true;
    checkAwards();
    if (playCounted) return;
    playCounted = true;
    trackPlay(slug, cats[curCat].n);
  };

  const readable = (c: Cat) => !!c.detail && c.detail.length === c.items.length;
  const keyOf = (ci: number, ii: number) => `${cats[ci].n}:${cats[ci].items[ii]}`;
  const seenList = () => getProgress().seen[slug] ?? [];
  const readCount = (ci: number, seen = new Set(seenList())) =>
    cats[ci].items.reduce((n, _it, ii) => n + (seen.has(keyOf(ci, ii)) ? 1 : 0), 0);
  const minutesOf = (c: Cat) => (c.chars ? Math.max(1, Math.round(c.chars / CHARS_PER_MIN)) : 0);

  /* ---- 3D hero: loaded after first paint so the text is readable immediately ---- */
  const host = $('#hero-host'), ctl = $<HTMLInputElement>('#ctl'), ctlLabel = $('#ctl-label');
  const ctlX = $<HTMLInputElement>('#ctl-x');
  const spinBtn = $<HTMLButtonElement>('#h-spin'), resetBtn = $<HTMLButtonElement>('#h-reset'), angleEl = $('#h-angle');
  const syncSpin = (on: boolean) => { spinBtn.setAttribute('aria-pressed', String(on)); spinBtn.textContent = on ? 'ঘোরানো থামাও' : 'ঘোরানো চালাও'; };
  const onHeroFrame = ({ yawDeg }: { yawDeg: number }) => {
    const d = Math.round(yawDeg); if (d === lastDeg) return;
    lastDeg = d; angleEl.textContent = `কোণ ${bn(d)}°`;
  };
  const heroItems = (c: Cat) => c.items.map((label, j) => ({ label, emoji: c.emoji[j] }));
  import('../../components/explorer/heroes').then(({ mountHero }) => {
    const loading = root.querySelector<HTMLElement>('#hero-loading');
    if (loading) { loading.classList.add('gone'); setTimeout(() => loading.remove(), 400); }
    hero = mountHero(host, cats[0].hero, onHeroFrame, (j) => {
      const c = cats[curCat];
      // A category with no writing yet still shows every item as a labelled
      // badge, so a click there used to fall into silence. Do what the chip
      // does instead: put it on the list and say so.
      if (!readable(c)) { starItem(keyOf(curCat, j), c.items[j] ?? ''); return; }
      if (quest.on) questPick(j); else selectItem(j);
    });
    ctlLabel.textContent = hero.set(cats[curCat].hero);
    ctl.value = String(Math.round((cats[curCat].hero.p ?? 0.5) * 100));
    hero.setItems(heroItems(cats[curCat]), curItem);
    syncSpin(hero.isAuto());
    host.addEventListener('pointerdown', () => { $('#hero-hint').style.opacity = '0'; }, { once: true });
  });
  spinBtn.addEventListener('click', () => { if (!hero) return; const on = !hero.isAuto(); hero.setAuto(on); syncSpin(on); });
  resetBtn.addEventListener('click', () => hero?.resetView());
  ctl.addEventListener('input', () => { hero?.setParam(+ctl.value / 100); countPlay(); });
  ctlX.addEventListener('input', () => { hero?.setExplode(+ctlX.value / 100); countPlay(); });
  host.addEventListener('pointerdown', countPlay);

  /* ---- the player bar: points, title, days in a row, today's three things ---- */
  const day = beginSession(slug);
  const streakDays = day.streak;
  const fx = confetti($<HTMLCanvasElement>('#fx'));
  const worldHue = getComputedStyle(root).getPropertyValue('--w').trim() || '#3E8E5A';
  function renderPlayer() {
    const xp = getProgress().xp, lv = levelOf(xp);
    $('#pl-lvl').textContent = `স্তর ${bn(lv.n)}`;
    $('#pl-title').textContent = lv.title;
    $('#pl-bar').style.width = `${Math.round(lv.frac * 100)}%`;
    $('#pl-xp').textContent = bn(xp);
    $('#pl-days').textContent = bn(streakDays);
    $('.pl-lvl').title = lv.next === null ? 'সর্বোচ্চ স্তর' : `পরের স্তরে যেতে আর ${bn(lv.next - xp)} জ্ঞানবিন্দু`;
    renderGoalPill();
  }
  /** The three dots: today's goal, small enough to live on the bar. */
  function renderGoalPill() {
    const t = todayState();
    const parts = goalParts(t.items, t.done);
    const dots = [...root.querySelectorAll<HTMLElement>('.pg i')];
    parts.forEach((p, i) => dots[i]?.classList.toggle('on', p.done));
    const pill = $('#pl-goal');
    pill.classList.toggle('met', goalMet(parts));
    pill.title = goalMet(parts)
      ? 'আজকের তিনটাই শেষ'
      : `আজকের লক্ষ্য: ${parts.filter((p) => !p.done).map((p) => p.label).join(', ')}`;
  }
  /**
   * Finishing the day's third thing is the one celebration a day gets, and it
   * can happen here as easily as on /today/, because a mission counts.
   */
  function checkGoal() {
    renderGoalPill();
    if (!goalJustMet()) return;
    const r = host.getBoundingClientRect();
    fx.burst(r.width / 2, r.height * 0.45, worldHue, true);
    chime('win');
    toast('🎉 আজকের লক্ষ্য পূরণ! কাল আবার নতুন কিছু।');
  }
  /** "+১০" drifting up from the points pill. */
  function floatXp(n: number) {
    const f = $('#xp-float'), pill = $('.pl-xp');
    f.textContent = `+${bn(n)}`;
    f.style.left = `${pill.offsetLeft + pill.offsetWidth / 2 - 14}px`; f.style.top = `${pill.offsetTop - 4}px`;
    f.classList.remove('go'); void f.offsetWidth; f.classList.add('go');
    renderPlayer();
  }
  const soundBtn = $<HTMLButtonElement>('#pl-sound');
  soundBtn.setAttribute('aria-pressed', String(soundOn()));
  soundBtn.addEventListener('click', () => { const on = !soundOn(); setSound(on); soundBtn.setAttribute('aria-pressed', String(on)); if (on) chime('ok'); });

  /* ---- awards: computed from what actually happened, celebrated once ---- */
  const toastEl = $('#award-toast');
  const toastQ: string[] = []; let toastBusy = false;
  function toast(text: string) {
    toastQ.push(text);
    if (toastBusy) return;
    toastBusy = true;
    const next = () => {
      const t = toastQ.shift();
      if (!t) { toastBusy = false; toastEl.hidden = true; return; }
      toastEl.hidden = false; toastEl.textContent = t; toastEl.classList.add('show');
      window.setTimeout(() => { toastEl.classList.remove('show'); window.setTimeout(next, 350); }, 2600);
    };
    next();
  }
  let questsDone = 0, perfectEver = false;
  function renderAwards() {
    const have = new Set(getProgress().awards);
    let n = 0;
    root.querySelectorAll<HTMLElement>('.aw[data-id]').forEach((el) => { const on = have.has(el.dataset.id!); el.classList.toggle('on', on); if (on) n++; });
    $('#aw-count').textContent = `${bn(n)} / ${bn(AWARDS.length)}`;
  }
  function checkAwards() {
    const seen = new Set(seenList());
    const mDone = getProgress().missions;
    const ctx = {
      seen: cats.reduce((s, _c, i) => s + readCount(i, seen), 0), total: TOTAL,
      catsDone: cats.filter((c, i) => readable(c) && readCount(i, seen) === c.items.length).length,
      played: playedEver, questsDone, perfect: perfectEver, streak: streakDays,
      missionsDone: missionKeys.filter((k) => (mDone[k] ?? 0) > 0).length, missionsTotal: missionKeys.length,
    };
    let any = false;
    for (const a of AWARDS) {
      if (!a.test(ctx)) continue;
      const key = awardKey(a, slug);
      if (grantAward(key)) { any = true; toast(`${a.emoji} নতুন অর্জন: ${a.name}`); track('award', { world: slug, award: a.id }); }
    }
    if (any) { chime('win'); renderAwards(); }
  }

  /* ---- missions: a real game each, run in their own panel ---- */
  const missionBtns = [...root.querySelectorAll<HTMLButtonElement>('.mission-play')];
  const missionKeys = missionBtns.map((b) => `${slug}:${b.dataset.mi}`);
  function renderMissions() {
    if (!missionBtns.length) return;
    const best = getProgress().missions;
    let done = 0;
    missionBtns.forEach((b, i) => {
      const s = best[missionKeys[i]!] ?? 0;
      if (s > 0) done++;
      b.classList.toggle('done', s > 0);
      const st = b.querySelector<HTMLElement>('.m-stars')!;
      st.textContent = '★'.repeat(s) + '☆'.repeat(3 - s);
      b.querySelector<HTMLElement>('.m-play')!.textContent = s > 0 ? 'আবার ▶' : 'খেলো ▶';
    });
    $('#miss-count').textContent = `${bn(done)} / ${bn(missionBtns.length)}`;
    const foot = root.querySelector<HTMLElement>('#miss-foot');
    if (foot) {
      const three = missionKeys.filter((k) => (best[k] ?? 0) === 3).length;
      foot.textContent = done === 0
        ? 'প্রতিটি মিশন একেকটা ছোট খেলা: তিনটি হৃদয়, দ্রুত উত্তরে বেশি পয়েন্ট, শেষে তারা।'
        : done < missionBtns.length
          ? `${bn(missionBtns.length - done)}টি মিশন এখনও বাকি। সব হৃদয় বাঁচিয়ে শেষ করলে তিন তারা।`
          : three === missionBtns.length
            ? 'সব মিশনে তিন তারা! এই ভুবনে তোমাকে আর কিছু শেখানোর নেই।'
            : `সব মিশন শেষ, ${bn(missionBtns.length - three)}টিতে এখনও তিন তারা বাকি।`;
    }
  }
  // a key on the "যা যা করা যাবে" card whose real answer is a mission opens it
  root.querySelectorAll<HTMLButtonElement>('.key-mission').forEach((b) => b.addEventListener('click', () => {
    const target = missionBtns.find((m) => m.dataset.mi === b.dataset.km);
    if (!target) return;
    target.scrollIntoView({ block: 'center', behavior: reduced ? 'auto' : 'smooth' });
    target.click();
  }));
  missionBtns.forEach((b, i) => b.addEventListener('click', async () => {
    const mi = +b.dataset.mi!;
    // one world's missions, not all eleven
    const { loadMission } = await import('../../data/mission-loader');
    const spec = await loadMission(slug, mi);
    if (!spec) return;
    const { playMission } = await import('../../components/explorer/missions');
    // If the mission belongs to a category, move the model there first, so
    // closing the panel leaves the child looking at what they just played with.
    const cat = b.dataset.cat;
    if (cat) showCat(+cat);
    track('mission_start', { world: slug, mission: mi });
    playMission(spec, {
      name: b.querySelector('b')!.textContent!,
      no: pad2(mi + 1),
      hue: worldHue,
      onDone(r) {
        addXp(r.points);
        const improved = setMission(missionKeys[i]!, r.stars);
        // A finished mission is the day's "একটা খেলা", the same as a খোঁজার
        // খেলা or কোনটা আলাদা. The child picks which one it was.
        finishTask('play');
        noteAct();
        renderMissions(); renderPlayer(); checkAwards();
        track('mission_done', { world: slug, mission: mi, stars: r.stars, points: r.points, seconds: r.seconds });
        if (improved && r.stars === 3) toast('🎖️ তিন তারা! নিখুঁত মিশন');
        checkGoal();
      },
      onClose() { renderMissions(); renderPlayer(); },
    });
  }));

  /* ---- খোঁজার খেলা: find each item on the model ---- */
  const quest = { on: false, order: [] as number[], i: 0, mistakes: 0, wrongHere: 0, t0: 0, timer: 0 };
  const qEl = $('#quest'), qCard = $('#q-card'), qHint = $('#q-hint'), qRes = $('#qres'), qStart = $<HTMLButtonElement>('#q-start');
  const questable = (c: Cat) => readable(c) && c.items.length >= 3;
  const bestKey = () => `${slug}:${cats[curCat].n}`;
  function renderQuestBtn() {
    const c = cats[curCat];
    qStart.hidden = !questable(c);
    const best = getProgress().best[bestKey()] ?? 0;
    qStart.textContent = best ? `🎯 খোঁজার খেলা ${starText(best)}` : '🎯 খোঁজার খেলা';
  }
  function questTarget() { return quest.order[quest.i]!; }
  function questShow() {
    const c = cats[curCat], j = questTarget();
    $('#q-emoji').textContent = c.emoji[j] ?? '';
    $('#q-name').textContent = c.items[j]!;
    $('#q-count').textContent = `${bn(quest.i + 1)} / ${bn(c.items.length)}`;
    qHint.textContent = '';
    hero?.focus(-1);   // no badge stays lit from a hint on the last one
    if (!reduced) qCard.animate([{ transform: 'scale(0.92)' }, { transform: 'none' }], { duration: 220, easing: 'ease-out' });
  }
  function questTick() { $('#q-time').textContent = secText(performance.now() - quest.t0); }
  function questStart() {
    const c = cats[curCat];
    if (!questable(c) || !hero) return;
    quest.on = true; quest.i = 0; quest.mistakes = 0; quest.wrongHere = 0; quest.t0 = performance.now();
    quest.order = c.items.map((_it, j) => j);
    for (let k = quest.order.length - 1; k > 0; k--) { const r = Math.floor(Math.random() * (k + 1)); [quest.order[k], quest.order[r]] = [quest.order[r]!, quest.order[k]!]; }
    hero.focus(-1);
    qRes.hidden = true; qEl.hidden = false; $('#hero-hint').style.opacity = '0';
    root.classList.add('questing');
    clearInterval(quest.timer); quest.timer = window.setInterval(questTick, 500); questTick();
    questShow();
    chime('tick');
    track('quest_start', { world: slug, category: c.n });
  }
  function questQuit(silent = false) {
    if (!quest.on) return;
    quest.on = false; clearInterval(quest.timer);
    qEl.hidden = true; root.classList.remove('questing');
    hero?.focus(curItem);
    if (!silent) track('quest_quit', { world: slug, category: cats[curCat].n, found: quest.i });
  }
  function questPick(j: number) {
    const c = cats[curCat], target = questTarget();
    if (j === target) {
      const gained = quest.wrongHere ? 2 : 5;
      addXp(gained); floatXp(gained); chime('ok');
      const at = hero?.badgeAt(j); const r = host.getBoundingClientRect();
      fx.burst(at?.x ?? r.width / 2, at?.y ?? r.height / 2, worldHue);
      quest.i++; quest.wrongHere = 0;
      if (quest.i >= quest.order.length) { questFinish(); return; }
      questShow();
      return;
    }
    quest.mistakes++; quest.wrongHere++;
    chime('no');
    qCard.classList.remove('shake'); void qCard.offsetWidth; qCard.classList.add('shake');
    if (quest.wrongHere >= 2) { hero?.focus(target); qHint.textContent = `ইঙ্গিত: যেটা বড় হয়ে জ্বলছে, সেটাই ${c.items[target]}`; }
    else qHint.textContent = `উঁহু, ওটা ${c.items[j]}। আবার খোঁজো - টেনে ঘোরাও, বা স্লাইডারে খুলে দেখো`;
  }
  function questFinish() {
    const c = cats[curCat], ms = performance.now() - quest.t0, stars = starsFor(quest.mistakes);
    const bonus = stars === 3 ? 20 : stars === 2 ? 10 : 0;
    if (bonus) { addXp(bonus); floatXp(bonus); }
    const improved = setBest(bestKey(), stars);
    questsDone++; if (stars === 3) perfectEver = true;
    quest.on = false; clearInterval(quest.timer); qEl.hidden = true; root.classList.remove('questing');
    $('#q-stars').textContent = starText(stars);
    $('#q-head').textContent = stars === 3 ? 'নিখুঁত!' : stars === 2 ? 'দারুণ!' : 'শেষ করেছ!';
    $('#q-sum').textContent = `${c.n}-এর ${bn(c.items.length)}টিই খুঁজে পেয়েছ ${secText(ms)}-এ, ভুল ${bn(quest.mistakes)}টি।${bonus ? ` বোনাস +${bn(bonus)} জ্ঞানবিন্দু।` : ''}${improved ? ' এটা এই বিভাগে তোমার সেরা।' : ''}`;
    qRes.hidden = false;
    const r = host.getBoundingClientRect(); fx.burst(r.width / 2, r.height * 0.45, worldHue, true);
    chime('win');
    finishTask('play');
    noteAct();
    renderQuestBtn(); renderPlayer();
    track('quest_done', { world: slug, category: c.n, stars, mistakes: quest.mistakes, seconds: Math.round(ms / 1000) });
    checkAwards();
    checkGoal();
  }
  qStart.addEventListener('click', questStart);
  $('#q-quit').addEventListener('click', () => questQuit());
  $('#q-again').addEventListener('click', () => { qRes.hidden = true; questStart(); });
  $('#q-read').addEventListener('click', () => { qRes.hidden = true; hero?.focus(curItem); $('#read').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' }); });
  $('#q-next').addEventListener('click', () => {
    qRes.hidden = true;
    for (let k = 1; k <= cats.length; k++) { const i = (curCat + k) % cats.length; if (questable(cats[i]!)) { showCat(i); questStart(); return; } }
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { if (!qRes.hidden) qRes.hidden = true; else questQuit(); } });

  /* ---- the reading card: one item, three depths ---- */
  const seg = [...root.querySelectorAll<HTMLButtonElement>('.seg [data-l]')];
  const itemName = $('#item-name'), itemChips = $('#item-chips'), itemText = $('#item-text');
  const funWrap = $('#item-fun-wrap'), itemFun = $('#item-fun'), labNote = $('#lab-note');

  /* ---- শুনে নাও: the reading, out loud, for a child who cannot decode it yet ---- */
  const sayBtn = $<HTMLButtonElement>('#say');
  let speaker: Speaker | null = null;
  let saying = false;
  function setSay(on: boolean) {
    saying = on;
    sayBtn.setAttribute('aria-pressed', String(on));
    sayBtn.textContent = on ? '⏹ থামাও' : '🔊 শুনে নাও';
  }
  void makeSpeaker(() => setSay(false)).then((s) => {
    speaker = s;
    // No Bangla voice installed: no button. An English voice reading Bangla
    // teaches a child the wrong sounds with total confidence.
    if (s) sayBtn.hidden = !readable(cats[curCat]);
  });
  sayBtn.addEventListener('click', () => {
    if (!speaker) return;
    if (saying) { speaker.stop(); setSay(false); return; }
    const text = `${itemName.textContent}। ${itemText.textContent}`;
    speaker.say(text);
    setSay(true);
    track('read_aloud', { world: slug, level });
  });
  function renderRead() {
    const c = cats[curCat];
    seg.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.l === level)));
    // A new reading stops the old one mid-sentence rather than talking over it.
    if (saying) { speaker?.stop(); setSay(false); }
    if (readable(c)) {
      const d = c.detail![curItem];
      itemName.hidden = false; itemName.textContent = c.items[curItem];
      itemChips.replaceChildren(...d.chips.map((t) => Object.assign(document.createElement('span'), { className: 'pill', textContent: t })));
      itemText.textContent = d[level];
      funWrap.hidden = false; itemFun.textContent = d.fun;
      // When the category also has a lab, the way in is per item: read about
      // the lever, then go and move one.
      labNote.hidden = !c.lab;
      if (c.lab) labNote.innerHTML = `<a href="${c.lab}#${c.labAnchors?.[curItem] ?? ''}">"${c.items[curItem]}" নিজের হাতে নেড়ে দেখো →</a>`;
      sayBtn.hidden = !speaker;
      return;
    }
    itemChips.replaceChildren();
    funWrap.hidden = true;
    sayBtn.hidden = true;
    if (c.lab) {
      itemName.hidden = false; itemName.textContent = c.n;
      itemText.textContent = 'এই বিভাগের প্রতিটি আইটেম আলাদা একটা চালু টুল - পড়ার বদলে সরাসরি নেড়েচেড়ে দেখা যায়।';
      labNote.hidden = false;
      labNote.innerHTML = `<a href="${c.lab}">${c.n} টুলে যাও →</a>`;
      return;
    }
    itemName.hidden = true;
    itemText.textContent = 'এই বিভাগের লেখা এখনও তৈরি হয়নি। নিচের তালিকায় ★ চেপে বলে দাও কোনটা আগে বানাবো - তোমার ভোট আমাদের কাছে জমা থাকবে।';
    labNote.hidden = true;
  }
  seg.forEach((b) => b.addEventListener('click', () => {
    level = b.dataset.l as typeof level;
    localStorage.setItem('posora:level', level);
    renderRead();
    trackDepth(slug, level);
  }));

  /* ---- the item strip ---- */
  function renderChips() {
    const c = cats[curCat], seen = new Set(seenList());
    if (readable(c)) {
      if (curItem >= c.items.length) curItem = 0;
      $('#items-h-s').textContent = 'নিচের যেকোনোটিতে ক্লিক করো - ডানে তার পুরো কথা খুলবে';
      chips.replaceChildren(...c.items.map((it, j) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'chip'; b.dataset.di = String(j);
        b.classList.toggle('done', seen.has(keyOf(curCat, j)));
        b.append(it);
        b.setAttribute('aria-pressed', String(j === curItem));
        return b;
      }));
      return;
    }
    if (c.lab) {
      $('#items-h-s').textContent = 'নিচে যেকোনোটায় ক্লিক করো - সরাসরি সেই টুলে চলে যাবে';
      chips.replaceChildren(...c.items.map((it, j) => {
        const a = document.createElement('a');
        a.className = 'chip chip-real'; a.href = `${c.lab}#${c.labAnchors![j]}`;
        a.innerHTML = '<span class="check" aria-hidden="true">✓</span>';
        a.append(it);
        return a;
      }));
      return;
    }
    $('#items-h-s').textContent = 'এখনও লেখা হয়নি - ★ চেপে বলো কোনটা আগে বানাবো';
    chips.replaceChildren(...c.items.map((it) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'chip'; b.dataset.key = `${slug}:${c.n}:${it}`;
      b.innerHTML = '<span class="star" aria-hidden="true">★</span>';
      b.append(it);
      b.setAttribute('aria-pressed', String(isStarred(b.dataset.key!)));
      return b;
    }));
  }

  /* ---- এক নজরে: one animated chart, three honest ways to compare ---- */
  const GIDS = ['items', 'time', 'read'] as const;
  const gseg = [...root.querySelectorAll<HTMLButtonElement>('.gseg [data-m]')];
  const grows = [...root.querySelectorAll<HTMLElement>('.gchart .grow')];
  let metric = 0, autoTimer = 0;

  function gValue(ci: number, id: string, seen: Set<string>): number {
    if (id === 'items') return cats[ci].items.length;
    if (id === 'time') return minutesOf(cats[ci]);
    return readCount(ci, seen);
  }
  function gLabel(id: string, ci: number, v: number): string {
    if (id === 'items') return `${bn(v)}টি`;
    if (id === 'time') return v ? `${bn(v)} মিনিট` : 'টুল';
    return `${bn(v)} / ${bn(cats[ci].items.length)}`;
  }
  function renderGlance() {
    const id = GIDS[metric], seen = new Set(seenList());
    const vals = cats.map((_c, i) => gValue(i, id, seen));
    const max = Math.max(...vals, 1);
    gseg.forEach((b, i) => b.setAttribute('aria-pressed', String(i === metric)));
    grows.forEach((row, i) => {
      const bar = row.querySelector<HTMLElement>('.gtrack i')!, out = row.querySelector<HTMLElement>('.gv')!;
      row.style.setProperty('--i', String(i));
      row.setAttribute('aria-current', String(i === curCat));
      const v = vals[i];
      // "তুমি যত পড়েছ" fills by how far through that category you are, so a short
      // category finished reads as full; the other two fill against the biggest.
      const frac = id === 'read' ? v / (cats[i].items.length || 1) : v / max;
      bar.style.width = v === 0 ? '0%' : `${Math.max(3, frac * 100)}%`;
      out.textContent = gLabel(id, i, v);
      out.classList.toggle('none', v === 0);
    });
    $('#gcap').textContent =
      id === 'items' ? 'প্রতিটি বারের লম্বা সরাসরি ওই বিভাগের আইটেম সংখ্যার অনুপাতে আঁকা।'
      : id === 'time' ? 'তিনটি গভীরতার পুরো লেখা মিলিয়ে আনুমানিক সময়, মিনিটে ৬০০ অক্ষর পড়ার হিসাবে। এটা আন্দাজ, মাপা সময় নয়।'
      : 'বার যত লম্বা, ওই বিভাগের তত বেশি অংশ তুমি খুলে দেখেছ। হিসাবটা শুধু এই ব্রাউজারে জমা থাকে, আমাদের কাছে আসে না।';
  }
  function stopAuto() { if (!autoTimer) return; clearInterval(autoTimer); autoTimer = 0; $('#gauto').hidden = true; }
  function startAuto() {
    if (autoTimer || reduced || $('#gauto').hidden) return;
    autoTimer = window.setInterval(() => { metric = (metric + 1) % GIDS.length; renderGlance(); }, 6500);
  }
  if (reduced) $('#gauto').hidden = true;
  else new IntersectionObserver((es) => {
    if ($('#gauto').hidden) return;
    if (es[0].isIntersecting) startAuto();
    else { clearInterval(autoTimer); autoTimer = 0; }
  }, { threshold: 0.25 }).observe($('#glance'));
  gseg.forEach((b, i) => b.addEventListener('click', () => { stopAuto(); metric = i; renderGlance(); }));
  $('#gchart').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-i]');
    if (b) { stopAuto(); showCat(+b.dataset.i!); }
  });

  /* ---- records: read straight off the structure, nothing invented ---- */
  function renderRecords() {
    const seen = new Set(seenList());
    const idxMax = (f: (i: number) => number) => cats.reduce((best, _c, i) => (f(i) > f(best) ? i : best), 0);
    const idxMin = (f: (i: number) => number) => cats.reduce((best, _c, i) => (f(i) < f(best) ? i : best), 0);
    const nItems = (i: number) => cats[i].items.length;
    const nRead = (i: number) => readCount(i, seen);

    const rows: { label: string; i: number; val: string }[] = [
      { label: 'সবচেয়ে বড় বিভাগ', i: idxMax(nItems), val: `${bn(nItems(idxMax(nItems)))}টি` },
      { label: 'সবচেয়ে ছোট বিভাগ', i: idxMin(nItems), val: `${bn(nItems(idxMin(nItems)))}টি` },
      { label: 'সবচেয়ে লম্বা পড়া', i: idxMax((i) => minutesOf(cats[i])), val: `${bn(minutesOf(cats[idxMax((i) => minutesOf(cats[i]))]))} মিনিট` },
    ];
    const top = idxMax(nRead);
    const box = $('#recs');
    const nodes: HTMLElement[] = rows.map((r) => {
      const btn = document.createElement('button');
      btn.type = 'button'; btn.dataset.i = String(r.i);
      btn.classList.toggle('is-cur', r.i === curCat);
      btn.innerHTML = `<span>${r.label}</span><b>${cats[r.i].n} <small style="font-weight:500;color:var(--muted)">${r.val}</small></b>`;
      return btn;
    });
    if (nRead(top) > 0) {
      const btn = document.createElement('button');
      btn.type = 'button'; btn.dataset.i = String(top);
      btn.classList.toggle('is-cur', top === curCat);
      btn.innerHTML = `<span>তুমি সবচেয়ে এগিয়ে</span><b>${cats[top].n} <small style="font-weight:500;color:var(--muted)">${bn(nRead(top))}টি দেখা</small></b>`;
      nodes.push(btn);
    } else {
      const p = document.createElement('p');
      p.className = 'rnone';
      p.textContent = 'তুমি এখনও কিছু খুলে দেখোনি, তাই তোমার নিজের রেকর্ড এখানে এখনও ফাঁকা।';
      nodes.push(p);
    }
    box.replaceChildren(...nodes);
  }
  $('#recs').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-i]');
    if (b) showCat(+b.dataset.i!);
  });

  /* ---- progress, everywhere it shows ---- */
  function renderProgress() {
    const seen = new Set(seenList());
    const done = cats.reduce((s, _c, i) => s + readCount(i, seen), 0);
    const pct = TOTAL ? (done / TOTAL) * 100 : 0;
    $('#seen-count').textContent = `${bn(done)} / ${bn(TOTAL)} দেখা হয়েছে`;
    $('#log-text').textContent = `${bn(done)} / ${bn(TOTAL)}`;
    $('#log-bar').style.width = `${pct}%`;
    $('#prog-bar').style.width = `${pct}%`;
    $('#spec-read').textContent = `${bn(done)} / ${bn(TOTAL)}`;
    $('#spec-meter').style.setProperty('--p', `${Math.round(pct)}%`);
    $('#prog-line').textContent = done === 0
      ? 'এই ভুবনে তোমার যাত্রা সবে শুরু।'
      : done === TOTAL
        ? `পুরো ${cats.length === 1 ? 'বিভাগ' : 'ভুবন'} শেষ! ${bn(TOTAL)}টি আইটেমই খুলে দেখা হয়ে গেছে।`
        : `তুমি ${bn(done)} / ${bn(TOTAL)} আইটেম খুলে দেখেছ, বাকি আছে ${bn(TOTAL - done)}টি।`;
    rail.forEach((b, i) => b.classList.toggle('done', readCount(i, seen) === cats[i].items.length));
    $('#cat-prog-n').textContent = bn(readCount(curCat, seen));
    $('#cat-prog').lastChild!.textContent = ` / ${bn(cats[curCat].items.length)} দেখা`;
    $('#cat-prog').hidden = !readable(cats[curCat]);
  }

  /* ---- selection ---- */
  function renderCrumbs() {
    $('#crumb-cat').textContent = cats[curCat].n;
    const item = $('#crumb-item'), sep = $('#crumb-sep2');
    const show = readable(cats[curCat]);
    item.hidden = sep.hidden = !show;
    $('#crumb-cat').classList.toggle('cur', !show);
    item.classList.toggle('cur', show);
    if (show) item.textContent = cats[curCat].items[curItem];
  }
  function selectItem(ii: number, mark = true) {
    const c = cats[curCat];
    if (!readable(c)) return;
    curItem = ii;
    chips.querySelectorAll<HTMLButtonElement>('.chip[data-di]').forEach((x) => x.setAttribute('aria-pressed', String(+x.dataset.di! === ii)));
    hero?.focus(ii);
    renderRead(); renderCrumbs();
    // the reading arrives, it does not just swap
    if (!reduced) $('#read').animate([{ opacity: 0.2, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }], { duration: 340, easing: 'cubic-bezier(.2,.8,.2,1)' });
    trackItem(slug, c.n, c.items[ii]);
    if (mark && markSeen(slug, keyOf(curCat, ii))) {
      const chip = chips.querySelector<HTMLElement>(`.chip[data-di="${ii}"]`);
      chip?.classList.add('done');
      if (childId) pushSeen(slug, keyOf(curCat, ii));
      noteItem(slug);
      renderProgress(); renderGlance(); renderRecords();
      /**
       * Reading something new is the commonest good thing that happens here,
       * and it used to happen in silence: the points floated up by the pill in
       * the header, a long way from the chip the child just pressed. Now the
       * chip itself answers - a soft tick, a tick mark that pops, and the ten
       * points leaving the place they were earned.
       */
      floatXp(10);
      if (chip) {
        praise({ at: chip, sound: 'tick', xp: 10 });
        if (!reduced) chip.animate(
          [{ transform: 'scale(1)' }, { transform: 'scale(1.09)' }, { transform: 'scale(1)' }],
          { duration: 280, easing: 'ease-out' },
        );
      }
      checkGoal();
      if (readCount(curCat) === c.items.length) {
        // the whole category has been opened: that is worth a moment
        const r = host.getBoundingClientRect(); fx.burst(r.width / 2, r.height * 0.45, worldHue, true);
        chime('win'); toast(`🧩 ${c.n} সম্পূর্ণ! সব ${bn(c.items.length)}টিই দেখা হয়ে গেছে`);
      }
      checkAwards();
    }
  }
  function showCat(i: number, item = 0) {
    questQuit(true); qRes.hidden = true;
    curCat = i; curItem = item; playCounted = false;
    rail.forEach((b) => { if (+b.dataset.i! === i) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); });
    const c = cats[i];
    trackCategory(slug, c.n);
    $('#c-no').textContent = pad2(i + 1);
    $('#c-name').textContent = c.n;
    $('#c-play').innerHTML = '<b>পর্দায়</b>';
    $('#c-play').append(c.play);
    if (hero) {
      ctlLabel.textContent = hero.set(c.hero);
      ctl.value = String(Math.round((c.hero.p ?? 0.5) * 100));
      // a new model starts whole, however the last one was left
      ctlX.value = '0'; hero.setExplode(0);
      hero.setItems(heroItems(c), curItem);
    }
    renderChips(); renderRead(); renderCrumbs(); renderProgress(); renderGlance(); renderRecords();
    if (readable(c)) { if (markSeen(slug, keyOf(i, curItem))) { if (childId) pushSeen(slug, keyOf(i, curItem)); noteItem(slug); renderProgress(); renderGlance(); renderRecords(); renderChips(); checkGoal(); } }
    // the gated features follow the category
    const extras = $('#extras');
    extras.hidden = !readable(c) && !c.lab;
    const quiz = $<HTMLAnchorElement>('#x-quiz'), ws = $<HTMLAnchorElement>('#x-ws'), lab = $<HTMLAnchorElement>('#x-lab');
    quiz.hidden = ws.hidden = !readable(c);
    quiz.href = `/${slug}/quiz/${i}/`;
    ws.href = `/${slug}/worksheet/${i}/`;
    lab.hidden = !c.lab;
    if (c.lab) lab.href = c.lab;
    renderQuestBtn();
    rail[i]?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduced ? 'auto' : 'smooth' });
    if (!reduced) $('.items-h').animate([{ opacity: 0.3, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'ease-out' });
  }
  /** Walk one item forward or back, rolling into the next category at the edges. */
  function step(d: number) {
    // A tool or unwritten category has no item cursor, so treat the whole
    // category as one stop and step straight out of it. Without this the index
    // stays in range, selectItem bails, and the button does nothing at all.
    let ci = curCat;
    let ii = readable(cats[curCat]) ? curItem + d : (d > 0 ? cats[curCat].items.length : -1);
    for (let guard = 0; guard < cats.length + 1; guard++) {
      if (ii >= 0 && ii < cats[ci].items.length) break;
      if (ii < 0) { ci = (ci - 1 + cats.length) % cats.length; ii = cats[ci].items.length - 1; }
      else { ci = (ci + 1) % cats.length; ii = 0; }
    }
    if (ci === curCat) selectItem(ii); else showCat(ci, ii);
  }

  /* ---- wiring ---- */
  rail.forEach((b) => b.addEventListener('click', () => showCat(+b.dataset.i!)));
  $('#crumb-cat').addEventListener('click', () => $('.stage')!.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' }));
  $('#crumb-item').addEventListener('click', () => $('#read').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' }));
  /**
   * Star an item that has no writing yet, and say so.
   *
   * Reachable from the chip and from the 3D scene, because the same item is
   * on screen twice and a click has to mean the same thing in both places.
   */
  function starItem(key: string, label: string, chip?: HTMLButtonElement) {
    const on = toggleStar(key);
    if (chip) {
      chip.setAttribute('aria-pressed', String(on));
      if (on && !reduced) chip.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.08)' }, { transform: 'scale(1)' }], { duration: 260 });
    }
    starToast.textContent = on ? `"${label}" এখন তোমার তালিকায় - আমরা এটাই আগে বানাবো` : `"${label}" তালিকা থেকে সরানো হলো`;
    starToast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => starToast.classList.remove('show'), 2600);
  }
  chips.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip'); if (!b) return;
    const di = b.dataset.di, key = b.dataset.key;
    if (di !== undefined) { selectItem(+di); return; }
    if (key === undefined) return;
    starItem(key, b.textContent!.replace('★', '').trim(), b);
  });
  root.querySelectorAll<HTMLButtonElement>('.key-jump').forEach((b) => b.addEventListener('click', () => {
    showCat(+b.dataset.cat!);
    $('.stage')!.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
  }));
  root.querySelector('[data-act="prev"]')!.addEventListener('click', () => step(-1));
  root.querySelector('[data-act="next"]')!.addEventListener('click', () => step(1));
  root.querySelector('[data-act="read"]')!.addEventListener('click', () => $('#read').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' }));

  /* ---- ছাপাও: the whole category as a paper handout ---- */
  const printBtn = $<HTMLButtonElement>('#print-btn');
  function buildPrintable() {
    const c = cats[curCat], box = $('#printable');
    const el = (tag: string, cls: string, text: string) => {
      const n = document.createElement(tag);
      n.className = cls; n.textContent = text;
      return n;
    };
    const head = document.createElement('header');
    head.className = 'p-h';
    head.append(
      el('h1', '', `${document.title.split(' · ')[0]} · ${c.n}`),
      el('p', '', `পসরা · posora.com · ${bn(c.items.length)}টি বিষয় · পড়ার গভীরতা: ${level === 'l1' ? 'ছোট' : level === 'l2' ? 'মাঝারি' : 'বড়'}`),
    );
    const parts: HTMLElement[] = [head];
    if (readable(c)) {
      c.detail!.forEach((d, j) => {
        const art = document.createElement('article');
        art.className = 'p-item';
        art.append(
          el('h2', '', `${pad2(j + 1)}. ${c.items[j]}`),
          el('p', 'p-chips', d.chips.join(' · ')),
          el('p', 'p-text', d[level]),
          el('p', 'p-fun', `মজার তথ্য: ${d.fun}`),
        );
        parts.push(art);
      });
    } else {
      parts.push(el('p', 'p-text', `${c.n}: ${c.items.join(', ')}`));
    }
    parts.push(el('p', 'p-foot', 'পসরা - বাংলায় ইন্টারঅ্যাকটিভ শেখার জায়গা। মডেলগুলো নাড়াচাড়া করতে posora.com খোলো।'));
    box.replaceChildren(...parts);
  }
  printBtn.addEventListener('click', () => {
    buildPrintable();
    track('print_category', { world: slug, category: cats[curCat].n });
    window.print();
  });
  $('#next-new').addEventListener('click', () => {
    const seen = new Set(seenList());
    for (let i = 0; i < cats.length; i++) {
      if (!readable(cats[i])) continue;
      const j = cats[i].items.findIndex((_it, ii) => !seen.has(keyOf(i, ii)));
      if (j >= 0) { showCat(i, j); $('#read').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' }); return; }
    }
    $('#prog-line').textContent = 'সব কটাই খুলে দেখা হয়ে গেছে! নতুন লেখা যোগ হলে এখানেই দেখাবে।';
  });
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (t.tagName === 'INPUT' || t.tagName === 'SELECT' || t.tagName === 'TEXTAREA') return;
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  });

  // the plain-text index at the bottom hands you back to the 3D explorer
  root.querySelector('#all')?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.ix-open');
    if (!b) return;
    showCat(+b.dataset.c!, +b.dataset.i!);
    $('.stage')!.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
  });

  renderChips(); renderRead(); renderCrumbs(); renderGlance(); renderRecords();
  if (readable(cats[0]) && markSeen(slug, keyOf(0, 0))) { noteItem(slug); if (childId) pushSeen(slug, keyOf(0, 0)); }
  renderProgress();
  renderChips();
  $('#extras').hidden = !readable(cats[0]);
  renderPlayer(); renderAwards(); renderQuestBtn(); renderMissions(); checkAwards();
  // Pull the child's progress from other devices, then repaint what it changes.
  if (childId) syncWorld(slug).then(() => { renderProgress(); renderGlance(); renderRecords(); renderChips(); renderPlayer(); checkAwards(); });
  // count the category and item the page lands on the same way a click is
  // counted, so the totals are not skewed toward whatever happens to be first
  trackCategory(slug, cats[0].n);
  if (readable(cats[0])) trackItem(slug, cats[0].n, cats[0].items[0]);

  /* ---- what today did to the streak ---- */
  if (day.froze) toast(`❄️ একটা বরফ খরচ হলো, ${bn(streakDays)} দিনের ধারা টিকে গেছে`);
  else if (day.broke && day.brokeAt >= 3) toast(`ধারা ভেঙেছে ${bn(day.brokeAt)} দিনে। আজ থেকে আবার শুরু।`);
  const mile = reachedMilestone(streakDays);
  if (mile) {
    window.setTimeout(() => {
      const r = host.getBoundingClientRect(); fx.burst(r.width / 2, r.height * 0.4, '#f0b429', true);
      chime('win');
      toast(`${mile.emoji} ${mile.name} টানা! ${mile.note}`);
      track('milestone', { at: mile.at });
    }, 900);
  }
  void freezeCount; void goalDone;

  /* ---- ?cat=N lands straight on a category, which is how /today/ links in ---- */
  const wantCat = Number(new URLSearchParams(location.search).get('cat'));
  if (Number.isInteger(wantCat) && wantCat > 0 && wantCat < cats.length) showCat(wantCat);
</script>
