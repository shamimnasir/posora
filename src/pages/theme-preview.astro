---
import Base from '../layouts/Base.astro';

const choices = [
  { id: 'toybox', name: 'Toybox · এখনকার', mood: 'রঙিন, গভীর, খেলাধুলার মতো', colors: ['#17102e', '#24194b', '#fff8ef', '#57e4d0', '#ffbd4a'], light: false },
  { id: 'daylight', name: 'সকালের আলো', mood: 'উষ্ণ কাগজ, গাঢ় লেখা, টিল রঙের অ্যাকসেন্ট', colors: ['#fffaf0', '#ffffff', '#18253c', '#126b7a', '#f2b52b'], light: true },
  { id: 'mint', name: 'পাতার খাতা', mood: 'হালকা সবুজ, শান্ত ও প্রকৃতির কাছাকাছি', colors: ['#f2fbf5', '#ffffff', '#15352e', '#16745c', '#edaa28'], light: true },
  { id: 'sky', name: 'নীল আকাশ', mood: 'পরিষ্কার আকাশি, বিশ্বাসযোগ্য ও শান্ত', colors: ['#f2f8ff', '#ffffff', '#172942', '#245eaa', '#e8a52b'], light: true },
];
const active = Astro.url.searchParams.get('palette') ?? 'toybox';
const selected = choices.find((choice) => choice.id === active) ?? choices[0];
---

<Base title="রঙের থিম বেছে নিন" description="পসরার জন্য কয়েকটি সাইটব্যাপী রঙের থিম বাস্তব পেজের উপাদানে দেখে নিন।" noindex>
  <section class="theme-page wrap">
    <header class="theme-intro">
      <p class="eyebrow">পসরা · থিম প্রিভিউ</p>
      <h1>কোন রঙে পড়া সহজ লাগে?</h1>
      <p>একটি থিম বেছে নিন। নিচে একই লেখা, কার্ড, বোতাম ও নেভিগেশন সেই রঙে দেখুন। এই প্রিভিউ বদলালে পুরো সাইটের পাতাতেও রঙ বদলাবে।</p>
      <div class="current-theme"><span class="live-dot"></span> এখন দেখছেন: <strong>{selected.name}</strong><span class="preview-only">শুধু প্রিভিউ · এখনো সাইটের ডিফল্ট বদলায়নি</span></div>
    </header>

    <div class="theme-options" aria-label="সাইটের রঙের থিম">
      {choices.map((choice) => (
        <a class:list={['theme-option', choice.id === selected.id && 'is-selected']} href={`/theme-preview/?palette=${choice.id}`} aria-current={choice.id === selected.id ? 'true' : undefined}>
          <span class="swatch-row" aria-label={`${choice.name} রঙের নমুনা`}>
            {choice.colors.map((color, i) => <i style={`--swatch:${color}`} aria-hidden="true" class={`swatch swatch-${i}`} />)}
          </span>
          <strong>{choice.name}</strong>
          <small>{choice.mood}</small>
          <span class="select-label">{choice.id === selected.id ? 'নির্বাচিত' : 'এই রঙ দেখুন'} <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>

    <section class="live-preview" aria-label="থিমের বাস্তব নমুনা">
      <nav class="sample-nav"><a href="/">পসরা</a><div><a href="/space/">মহাকাশ</a><a href="/nature/">প্রকৃতি</a><a href="/blog/">ব্লগ</a></div><a class="nav-cta" href="/digital-pack/">ডিজিটাল প্যাক</a></nav>
      <div class="sample-hero">
        <div class="hero-copy"><span class="sample-kicker">আজকের ছোট অভিযান</span><h2>প্রশ্ন করো, খুঁজে দেখো, শিখে ফেলো</h2><p>বাংলায় ইন্টারঅ্যাকটিভ শেখা, হাতে-কলমে মিশন আর পরিবারের সঙ্গে করার মতো নতুন নতুন কাজ।</p><div class="hero-actions"><a class="sample-button" href={`/nature/?palette=${selected.id}`}>প্রকৃতির ভুবন ঘুরে দেখো <span>→</span></a><a class="text-link" href={`/digital-pack/?palette=${selected.id}`}>প্যাকের নমুনা দেখুন</a></div></div>
        <div class="hero-art" aria-hidden="true"><span class="sun-disc"></span><span class="hill hill-back"></span><span class="hill hill-front"></span><span class="flower flower-a">✿</span><span class="flower flower-b">✿</span><span class="art-caption">দেখো · ভাবো · বানাও</span></div>
      </div>
      <div class="sample-content">
        <div class="sample-section-head"><div><span class="sample-kicker">শেখার একটি নমুনা</span><h3>পানিচক্র কীভাবে চলে?</h3></div><span class="age-pill">বয়স ৫–৯</span></div>
        <div class="sample-cards">
          <article class="sample-card"><span class="card-icon">☀️</span><div><h4>১. রোদে পানি গরম হয়</h4><p>সূর্যের তাপে নদী, পুকুর ও সাগরের পানি বাষ্প হয়ে ওপরে ওঠে।</p></div><span class="card-mark">দেখি</span></article>
          <article class="sample-card"><span class="card-icon">☁️</span><div><h4>২. মেঘ তৈরি হয়</h4><p>ওপরের ঠান্ডা বাতাসে জলীয় বাষ্প জমে ছোট ছোট পানির ফোঁটা হয়।</p></div><span class="card-mark">ভাবি</span></article>
          <article class="sample-card"><span class="card-icon">🌧️</span><div><h4>৩. বৃষ্টি নামে</h4><p>ফোঁটাগুলো ভারী হলে বৃষ্টি হয়ে মাটিতে ফেরে, তারপর আবার নদীতে যায়।</p></div><span class="card-mark">শিখি</span></article>
        </div>
        <aside class="sample-callout"><span>✦</span><p><strong>এবার তোমার পালা:</strong> বৃষ্টির পরে উঠোন বা জানালার বাইরে কোথায় পানি জমেছে, খুঁজে দেখো।</p><a href={`/nature/?palette=${selected.id}`}>প্রকৃতি ভুবনে যাও →</a></aside>
      </div>
    </section>

    <footer class="theme-footer"><p>রঙ পছন্দ হয়েছে? বাস্তব পেজে একই থিম দেখে নিন:</p><div><a href={`/blog/panichokro-kake-bole/?palette=${selected.id}`}>একটি ব্লগ পোস্ট</a><a href={`/digital-pack/?palette=${selected.id}`}>ডিজিটাল প্যাক</a><a href={`/nature/?palette=${selected.id}`}>প্রকৃতি ভুবন</a></div><small>থিম তুলনা করতে লিংকটি শেয়ার করুন; পছন্দ না হওয়া পর্যন্ত ডিফল্ট থিমে কোনো পরিবর্তন হবে না।</small></footer>
  </section>
</Base>

<style>
  .theme-page { padding-block: clamp(2rem, 6vw, 5rem); }
  .theme-intro { max-width: 800px; margin-bottom: 2rem; }
  .theme-intro h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin: .5rem 0 .7rem; }
  .theme-intro > p:not(.eyebrow) { color: var(--ink-2); max-width: 68ch; font-size: 1.05rem; }
  .current-theme { margin-top: 1.2rem; display: flex; align-items: center; flex-wrap: wrap; gap: .55rem; color: var(--ink-2); }
  .live-dot { width: .7rem; height: .7rem; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px color-mix(in oklab, var(--ok) 18%, transparent); }
  .preview-only { border: 1px solid var(--line); padding: .2rem .6rem; border-radius: 999px; font-size: .82rem; color: var(--muted); }
  .theme-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .85rem; margin: 1.2rem 0 2rem; }
  .theme-option { display: grid; gap: .3rem; padding: 1rem; min-width: 0; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .theme-option:hover { transform: translateY(-3px); border-color: var(--brand); }
  .theme-option.is-selected { border: 2px solid var(--brand); box-shadow: 0 0 0 3px color-mix(in oklab, var(--brand) 18%, transparent); }
  .swatch-row { display: flex; overflow: hidden; border-radius: 9px; height: 38px; margin-bottom: .45rem; border: 1px solid var(--line-soft); }
  .swatch { flex: 1; background: var(--swatch); }
  .theme-option strong { font-size: 1.03rem; color: var(--ink); }
  .theme-option small { color: var(--muted); line-height: 1.5; min-height: 2.8em; }
  .select-label { margin-top: .4rem; color: var(--brand-ink); font-size: .9rem; font-weight: 700; }
  .live-preview { border: 1px solid var(--line); border-radius: 24px; overflow: hidden; background: var(--paper); box-shadow: var(--shadow); }
  .sample-nav { min-height: 68px; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .8rem clamp(1rem, 3vw, 2rem); background: var(--panel); border-bottom: 1px solid var(--line-soft); }
  .sample-nav > a:first-child { color: var(--ink); font-size: 1.25rem; font-weight: 800; }
  .sample-nav > div { display: flex; gap: clamp(.6rem, 2vw, 1.5rem); color: var(--ink-2); }
  .sample-nav a { text-decoration: none; }
  .sample-nav a:hover, .text-link:hover { color: var(--brand-ink); }
  .sample-nav .nav-cta { padding: .45rem .8rem; border-radius: 999px; background: var(--brand); color: var(--on-brand); font-weight: 700; }
  .sample-hero { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 2rem; padding: clamp(1.4rem, 5vw, 4rem); background: linear-gradient(120deg, color-mix(in oklab, var(--brand) 10%, var(--paper)), var(--paper)); }
  .sample-kicker { color: var(--brand-ink); font-weight: 800; font-size: .92rem; }
  .hero-copy h2 { font-size: clamp(1.8rem, 4vw, 3rem); margin: .4rem 0 .7rem; max-width: 15ch; }
  .hero-copy > p { max-width: 54ch; color: var(--ink-2); }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; margin-top: 1.3rem; }
  .sample-button { display: inline-flex; gap: .6rem; align-items: center; background: var(--sun); color: #172033; padding: .7rem 1rem; border-radius: 12px; font-weight: 800; box-shadow: 0 4px 0 color-mix(in oklab, var(--sun) 70%, #6f4215); }
  .text-link { color: var(--brand-ink); font-weight: 700; }
  .hero-art { height: clamp(230px, 30vw, 350px); min-width: 0; overflow: hidden; position: relative; border: 1px solid var(--line); border-radius: 22px; background: linear-gradient(180deg, color-mix(in oklab, var(--brand) 18%, var(--panel)), var(--panel)); }
  .sun-disc { position: absolute; width: 76px; aspect-ratio: 1; border-radius: 50%; top: 16%; right: 19%; background: var(--sun); box-shadow: 0 0 0 12px color-mix(in oklab, var(--sun) 20%, transparent); }
  .hill { position: absolute; width: 125%; height: 58%; border-radius: 50% 50% 0 0; left: -12%; bottom: -27%; transform: rotate(-5deg); background: color-mix(in oklab, var(--ok) 75%, var(--panel)); }
  .hill-front { left: 26%; bottom: -35%; transform: rotate(8deg); background: color-mix(in oklab, var(--brand) 60%, var(--panel)); }
  .flower { position: absolute; color: var(--pink); font-size: clamp(2rem, 5vw, 3.5rem); text-shadow: 0 3px 0 color-mix(in oklab, var(--pink) 35%, #66354c); }
  .flower-a { left: 16%; bottom: 27%; } .flower-b { left: 26%; bottom: 38%; color: var(--sun); }
  .art-caption { position: absolute; right: 1rem; bottom: 1rem; color: var(--ink-2); background: color-mix(in oklab, var(--panel) 82%, transparent); border: 1px solid var(--line); border-radius: 999px; padding: .3rem .75rem; font-size: .83rem; }
  .sample-content { padding: clamp(1.3rem, 4vw, 3rem); }
  .sample-section-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1rem; }
  .sample-section-head h3 { font-size: clamp(1.5rem, 3vw, 2.1rem); margin-top: .25rem; }
  .age-pill { white-space: nowrap; color: var(--brand-ink); border: 1px solid var(--line); background: var(--brand-soft); border-radius: 999px; padding: .25rem .7rem; font-size: .85rem; font-weight: 700; }
  .sample-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; }
  .sample-card { display: grid; grid-template-columns: auto 1fr; align-content: start; gap: .2rem .75rem; padding: 1rem; border: 1px solid var(--line); border-radius: 16px; background: var(--panel); }
  .card-icon { grid-row: span 2; font-size: 1.7rem; }
  .sample-card h4 { font-size: 1rem; color: var(--ink); }
  .sample-card p { color: var(--ink-2); font-size: .93rem; line-height: 1.65; }
  .card-mark { grid-column: 2; color: var(--brand-ink); font-size: .8rem; margin-top: .4rem; }
  .sample-callout { margin-top: 1rem; display: flex; align-items: center; gap: .8rem; padding: .95rem 1rem; border-radius: 14px; background: var(--brand-soft); border: 1px solid var(--line); }
  .sample-callout > span { font-size: 1.5rem; color: var(--sun); }
  .sample-callout p { flex: 1; color: var(--ink-2); }
  .sample-callout strong { color: var(--ink); }
  .sample-callout a { color: var(--brand-ink); white-space: nowrap; font-weight: 800; }
  .theme-footer { display: grid; gap: .7rem; padding: 1.2rem .2rem 0; color: var(--ink-2); }
  .theme-footer > div { display: flex; flex-wrap: wrap; gap: .65rem; }
  .theme-footer a { padding: .45rem .8rem; border: 1px solid var(--line); border-radius: 999px; color: var(--brand-ink); background: var(--panel); }
  .theme-footer small { color: var(--muted); }
  @media (max-width: 760px) { .theme-options { grid-template-columns: repeat(2, minmax(0, 1fr)); } .sample-hero { grid-template-columns: 1fr; } .hero-art { height: 230px; } .sample-cards { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .sample-nav > div { display: none; } .sample-nav { min-height: 58px; } .theme-option { padding: .8rem; } .sample-callout { align-items: start; flex-wrap: wrap; } .sample-callout a { margin-left: 2.3rem; } .sample-section-head { align-items: start; } }
</style>
