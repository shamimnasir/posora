---
/**
 * Admin chrome. Deliberately does not extend Base: no analytics, no public
 * header/footer, and noindex so the panel never reaches a search engine.
 */
/**
 * The font is preloaded the way Base does it, from the one self-hosted woff2
 * `scripts/make-font.py` builds, and the @font-face comes in with admin.css.
 *
 * This used to be `<Font cssVariable="--font-body" />` from astro:assets,
 * which needs a `fonts` entry in astro.config to have declared that family.
 * There is none, and there never was: the component threw FontFamilyNotFound
 * *during* the streamed render, after the 200 and the headers had already
 * gone out, so every page in the admin panel answered with a valid response
 * and an empty body. Login included. Nobody could get in.
 */
import { FONT_URL } from '../data/font';
import '../styles/admin.css';

interface Props {
  title: string;
  /** Which nav item to mark current. Omit on the login screen. */
  section?: 'dashboard' | 'worlds' | 'data' | 'members' | 'activity';
  /** Hide the nav entirely (login). */
  bare?: boolean;
}
const { title, section, bare = false } = Astro.props;

const nav = [
  { key: 'dashboard', href: '/admin', label: 'ড্যাশবোর্ড' },
  { key: 'worlds', href: '/admin/worlds', label: 'ভুবন' },
  { key: 'data', href: '/admin/data', label: 'ডেটা' },
  { key: 'members', href: '/admin/members', label: 'সদস্য' },
  { key: 'activity', href: '/admin/activity', label: 'কার্যক্রম' },
] as const;
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · পসরা অ্যাডমিন</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={FONT_URL} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="admin">
    {
      !bare && (
        <header class="a-top">
          <span class="brand">পসরা</span>
          <nav>
            {nav.map((n) => (
              <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>
                {n.label}
              </a>
            ))}
          </nav>
          <a class="btn btn-sm" href="/" target="_blank" rel="noopener">সাইট দেখো ↗</a>
          <form method="post" action="/api/admin/logout">
            <button class="btn btn-sm" type="submit">লগআউট</button>
          </form>
        </header>
      )
    }
    <slot />
  </body>
</html>
