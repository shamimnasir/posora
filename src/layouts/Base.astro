---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  /** World accent colour, applied as --w on <body>. */
  hue?: string;
  /** Hide the global footer (explorer pages have their own status bar). */
  bare?: boolean;
}
const { title, description, hue, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'পসরা' ? 'পসরা - শেখা হোক খেলার মতো' : `${title} · পসরা`;
---
<!doctype html>
<html lang="bn" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#e9edf2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1116" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:site_name" content="পসরা" />
    {/* summary, not summary_large_image: there is no share image yet, and
        claiming one produces an empty card. */}
    <meta name="twitter:card" content="summary" />
    {/* Not executed, so the CSP's script-src does not apply to it. Describes
        only what the site actually is; no ratings, no prices, nothing unearned. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'পসরা',
      alternateName: 'Posora',
      url: 'https://posora.com/',
      inLanguage: 'bn',
      description: 'বাংলায় ইন্টারঅ্যাকটিভ শেখার জায়গা - ১১টি ভুবন, প্রতিটি বিষয়ে থ্রিডি মডেল ও তিন গভীরতার লেখা।',
      isAccessibleForFree: true,
      publisher: { '@type': 'Organization', name: 'পসরা', url: 'https://posora.com/', email: 'support@posora.com' },
    })} />
    {/* Preload only the Bengali faces the first paint needs; Latin + other weights load on demand. */}
    <Font cssVariable="--font-body" preload={[{ subset: 'bengali', weight: 400 }]} />
    <Font cssVariable="--font-display" preload={[{ subset: 'bengali' }]} />
    <Analytics />
  </head>
  <body style={hue ? `--w:${hue}` : undefined}>
    {/* Keyboard users land here first and can jump past the header, which on a
        world page sits in front of a long category rail. */}
    <a class="skip" href="#main">মূল অংশে যাও</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <WhatsAppFab />
  </body>
</html>
