---
import { FONT_URL } from '../data/font';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Analytics from '../components/Analytics.astro';
import { COVERAGE } from '../lib/coverage';
import { bn } from '../lib/bn';

interface Props {
  title: string;
  description: string;
  /** World accent colour, applied as --w on <body>. */
  hue?: string;
  /** Hide the global footer (explorer pages have their own status bar). */
  bare?: boolean;
  /**
   * Keep this page out of search results. For pages that are gated, personal,
   * or one of many near-identical generated sheets: indexing them would spend
   * the site's crawl budget on pages nobody can arrive at cold.
   */
  noindex?: boolean;
  /** Extra schema.org objects for this page, appended to the site-wide graph. */
  schema?: Record<string, unknown>[];
  /**
   * The trail this page sits at the end of, for a BreadcrumbList.
   *
   * Only pass what the page actually shows: structured data that disagrees
   * with the page is worse than none, and Google treats it as a reason to stop
   * trusting the rest. The page itself is not included - it is added here.
   */
  crumbs?: { name: string; url: string }[];
}
const { title, description, hue, bare = false, noindex = false, schema = [], crumbs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'পসরা' ? 'পসরা - শেখা হোক খেলার মতো' : `${title} · পসরা`;
const ogImage = new URL('/og.png', Astro.site ?? 'https://posora.com').href;

/**
 * Meta descriptions, cut where a search engine would cut them.
 *
 * Google shows about 155 characters and drops the rest mid-word. Several
 * pages ran to 197, so what a searcher saw ended in a broken Bangla word and
 * no full stop. Clamping here rather than at each page means a long
 * description written later cannot reintroduce it, and the cut lands on a
 * space so no conjunct is severed. The full text stays in the JSON-LD, which
 * has no such limit.
 */
const META_MAX = 155;
const metaDescription = description.length <= META_MAX
  ? description
  : `${description.slice(0, META_MAX).replace(/\s+\S*$/, '')}…`;

/**
 * One linked graph rather than a pile of loose blocks, so a crawler reading
 * any page can see that the organisation, the site and this page are the same
 * three things everywhere. Every claim here is something the site really does.
 */
const graph = [
  {
    '@type': 'EducationalOrganization',
    '@id': 'https://posora.com/#org',
    name: 'পসরা',
    alternateName: ['Posora', 'GyanerPosora'],
    url: 'https://posora.com/',
    logo: 'https://posora.com/og-square.png',
    image: ogImage,
    email: 'support@posora.com',
    telephone: '+8801771553141',
    areaServed: 'BD',
    inLanguage: 'bn',
    description: 'বাংলা ভাষায় শিশুদের জন্য ইন্টারঅ্যাকটিভ শেখার ওয়েবসাইট।',
  },
  {
    '@type': 'WebSite',
    '@id': 'https://posora.com/#site',
    name: 'পসরা',
    alternateName: 'Posora',
    url: 'https://posora.com/',
    inLanguage: 'bn',
    isAccessibleForFree: true,
    publisher: { '@id': 'https://posora.com/#org' },
    description: `বাংলায় ইন্টারঅ্যাকটিভ শেখার জায়গা - ${bn(COVERAGE.worlds)}টি ভুবন, প্রতিটি বিষয়ে থ্রিডি মডেল ও তিন গভীরতার লেখা।`,
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical.href}#page`,
    url: canonical.href,
    name: fullTitle,
    description,
    inLanguage: 'bn',
    isPartOf: { '@id': 'https://posora.com/#site' },
    primaryImageOfPage: ogImage,
  },
  ...(crumbs.length
    ? [{
      '@type': 'BreadcrumbList',
      '@id': `${canonical.href}#crumbs`,
      itemListElement: [...crumbs, { name: title, url: canonical.href }].map((c, i) => ({
        '@type': 'ListItem', position: i + 1, name: c.name, item: c.url,
      })),
    }]
    : []),
  ...schema,
];
---
<!doctype html>
<html lang="bn" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" hreflang="bn" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* The home-screen icon is the only return trigger this site can honestly
        have: a website cannot notify a child, and should not. Pull, not push. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="পসরা" />
    <meta name="theme-color" content="#e9edf2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1116" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:site_name" content="পসরা" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="পসরা - বাংলায় ইন্টারঅ্যাকটিভ শেখার জায়গা" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    {/* Not executed, so the CSP's script-src does not apply to it. Describes
        only what the site actually is; no ratings, no prices, nothing unearned. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    {/* One file, every weight, preloaded because nearly every glyph on the
        page comes out of it. Built by scripts/make-font.py; the @font-face
        itself lives in src/styles/font.css, imported by global.css. */}
    <link rel="preload" href={FONT_URL} as="font" type="font/woff2" crossorigin />
    <Analytics />
  </head>
  <body style={hue ? `--w:${hue}` : undefined}>
    {/* Keyboard users land here first and can jump past the header, which on a
        world page sits in front of a long category rail. */}
    <a class="skip" href="#main">মূল অংশে যাও</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <WhatsAppFab />
  </body>
</html>
