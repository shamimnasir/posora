{
  "name": "posora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "admin:hash": "node scripts/hash-password.mjs",
    "db:create": "wrangler d1 create posora",
    "db:migrate": "wrangler d1 migrations apply posora --remote",
    "db:migrate:local": "wrangler d1 migrations apply posora --local",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "astro": "^7.3.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/three": "^0.185.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.0"
  }
}
