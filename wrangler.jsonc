{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posora",
  // Astro's own entry is `{ fetch: handle }`; src/worker.ts is that plus a
  // `scheduled` handler, because a cron trigger calls `scheduled` and nothing
  // else. Everything the site serves still goes through the adapter's handler.
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "r2_buckets": [
    { "binding": "PACK_FILES", "bucket_name": "posora-digital-packs" }
  ],
  "routes": [
    { "pattern": "posora.com", "custom_domain": true },
    { "pattern": "www.posora.com", "custom_domain": true }
  ],
  // One-time setup before any mail can leave:
  //   npx wrangler email sending enable posora.com
  // The contact form and the weekly parent letter both use this binding.
  "send_email": [{ "name": "EMAIL" }],

  // The weekly letter to parents. 03:00 UTC on Friday is 09:00 in Dhaka, and
  // Friday is the first day of the Bangladeshi weekend: the letter lands while
  // the family is together, so the question it suggests can be asked that same
  // evening rather than five days later.
  //
  // Cron triggers are at-least-once, so the run is idempotent by week (see
  // src/lib/weekly.ts) and a double fire cannot mean two letters.
  //
  // Watch a real run with:  npx wrangler tail
  // Fire one locally with:  npx wrangler dev --local
  //   then  curl 'http://127.0.0.1:8787/cdn-cgi/handler/scheduled'
  // (not /__scheduled: this project builds through the adapter's redirected
  //  config, and wrangler's --test-scheduled route does not get installed.)
  "triggers": { "crons": ["0 3 * * 5"] },
  // Admin panel content store. The binding name `DB` is what src/lib/db.ts reads -
  // it is deliberately not the database name. Schema changes:
  //   npx wrangler d1 migrations apply posora --remote
  "d1_databases": [
    { "binding": "DB", "database_name": "posora", "database_id": "88792376-d23c-475b-8b26-4c49afb1344c", "migrations_dir": "migrations" }
  ],
  // SITE_ORIGIN is what the weekly letter's links point at. The scheduled
  // handler has no request to read an origin from, so it has to be told.
  "vars": { "CONTACT_TO": "support@posora.com", "CONTACT_FROM": "no-reply@posora.com", "SITE_ORIGIN": "https://posora.com" },
  "observability": { "enabled": true }
}
