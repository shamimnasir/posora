{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posora",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "routes": [
    { "pattern": "posora.com", "custom_domain": true },
    { "pattern": "www.posora.com", "custom_domain": true }
  ],
  // One-time setup before the contact form can send email:
  //   npx wrangler email sending enable posora.com
  //
  // The weekly parent letter goes out through the same binding. Cloudflare's
  // cron triggers call a worker's `scheduled` handler and the Astro adapter
  // owns the worker entry, so the run is an endpoint instead: POST
  // /api/cron/weekly, fired by hand from the admin panel or by any scheduler
  // holding the shared secret. To enable the machine path:
  //   npx wrangler secret put CRON_SECRET
  // then have the scheduler send `Authorization: Bearer <secret>` and
  // `content-type: application/json` weekly.
  "send_email": [{ "name": "EMAIL" }],
  // Admin panel content store. The binding name `DB` is what src/lib/db.ts reads -
  // it is deliberately not the database name. Schema changes:
  //   npx wrangler d1 migrations apply posora --remote
  "d1_databases": [
    { "binding": "DB", "database_name": "posora", "database_id": "88792376-d23c-475b-8b26-4c49afb1344c", "migrations_dir": "migrations" }
  ],
  "vars": { "CONTACT_TO": "support@posora.com", "CONTACT_FROM": "no-reply@posora.com" },
  "observability": { "enabled": true }
}
